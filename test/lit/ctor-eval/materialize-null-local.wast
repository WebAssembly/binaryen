;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: wasm-ctor-eval %s -all --ctors=test,non_nullable --kept-exports=test,non_nullable --ignore-external-input -S -o - \
;; RUN:     | filecheck %s

;; Check that materializing a non-data null local, which at time of writing uses
;; Builder::makeConstantExpression, does not trigger an assertion failure.

(module
 ;; CHECK:      (type $struct (struct))
 (type $struct (struct))

 ;; CHECK:      (type $1 (func (param externref)))

 ;; CHECK:      (type $2 (func (result (ref $struct))))

 ;; CHECK:      (import "env" "g" (global $g i32))
 (import "env" "g" (global $g i32))

 (func $test (export "test") (param $0 externref)
  (local $3 anyref)
  (local.set $3
   (any.convert_extern
    (local.get $0)
   )
  )
 )

 (func $non_nullable (export "non_nullable") (result (ref $struct))
  ;; Partially evaluate the first statement, then stop on the imported global.
  ;; Do not emit an invalid (local.set $unset (ref.null none)) for the
  ;; uninitialized non-nullable local, and ensure the initialized non-nullable
  ;; local $init structurally dominates its use in the remaining body.
  (local $init (ref $struct))
  (local $unset (ref $struct))
  (local.set $init
   (struct.new $struct)
  )
  (if
   (global.get $g)
   (then
    (return
     (local.get $init)
    )
   )
  )
  (local.set $unset
   (struct.new $struct)
  )
  (if
   (global.get $g)
   (then
    (local.set $unset
     (local.get $init)
    )
   )
  )
  (local.get $unset)
 )
)
;; CHECK:      (global $ctor-eval$global (ref (exact $struct)) (struct.new_default $struct))

;; CHECK:      (export "test" (func $test_2))

;; CHECK:      (export "non_nullable" (func $non_nullable_3))

;; CHECK:      (func $test_2 (type $1) (param $0 externref)
;; CHECK-NEXT:  (local $3 anyref)
;; CHECK-NEXT:  (nop)
;; CHECK-NEXT: )

;; CHECK:      (func $non_nullable_3 (type $2) (result (ref $struct))
;; CHECK-NEXT:  (local $0 (ref (exact $struct)))
;; CHECK-NEXT:  (local $1 (ref (exact $struct)))
;; CHECK-NEXT:  (local.set $0
;; CHECK-NEXT:   (global.get $ctor-eval$global)
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (if
;; CHECK-NEXT:   (global.get $g)
;; CHECK-NEXT:   (then
;; CHECK-NEXT:    (return
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (local.set $1
;; CHECK-NEXT:   (struct.new_default $struct)
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (if
;; CHECK-NEXT:   (global.get $g)
;; CHECK-NEXT:   (then
;; CHECK-NEXT:    (local.set $1
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (local.get $1)
;; CHECK-NEXT: )
