;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; Test that we write explicit label names to the name section with -g, and
;; that we do not write the names we generate ourselves.

;; RUN: wasm-as %s -all -g -o %t.wasm
;; RUN: wasm-dis %t.wasm -all -o - | filecheck %s --check-prefix=DEBUG
;; RUN: wasm-as %s -all -o %t.nodebug.wasm
;; RUN: wasm-dis %t.nodebug.wasm -all -o - | filecheck %s --check-prefix=NODEBUG
;; RUN: wasm-opt %s -all -g --inlining -o %t.inline.wasm
;; RUN: wasm-dis %t.inline.wasm -all -o - | filecheck %s --check-prefix=INLINE

(module
 ;; DEBUG:      (type $0 (func (param i32) (result i32)))

 ;; DEBUG:      (type $1 (func (result i32)))

 ;; DEBUG:      (func $f (type $0) (param $p i32) (result i32)
 ;; DEBUG-NEXT:  (drop
 ;; DEBUG-NEXT:   (i32.const 0)
 ;; DEBUG-NEXT:  )
 ;; DEBUG-NEXT:  (block $named-block (result i32)
 ;; DEBUG-NEXT:   (loop $named-loop
 ;; DEBUG-NEXT:    (br_if $named-loop
 ;; DEBUG-NEXT:     (local.get $p)
 ;; DEBUG-NEXT:    )
 ;; DEBUG-NEXT:   )
 ;; DEBUG-NEXT:   (block $block
 ;; DEBUG-NEXT:    (br_if $block
 ;; DEBUG-NEXT:     (local.get $p)
 ;; DEBUG-NEXT:    )
 ;; DEBUG-NEXT:   )
 ;; DEBUG-NEXT:   (block $unused-block
 ;; DEBUG-NEXT:   )
 ;; DEBUG-NEXT:   (block $used-if
 ;; DEBUG-NEXT:    (if
 ;; DEBUG-NEXT:     (local.get $p)
 ;; DEBUG-NEXT:     (then
 ;; DEBUG-NEXT:      (br $used-if)
 ;; DEBUG-NEXT:     )
 ;; DEBUG-NEXT:    )
 ;; DEBUG-NEXT:   )
 ;; DEBUG-NEXT:   (i32.const 42)
 ;; DEBUG-NEXT:  )
 ;; DEBUG-NEXT: )
 ;; INLINE:      (type $0 (func (param i32) (result i32)))

 ;; INLINE:      (type $1 (func (result i32)))

 ;; INLINE:      (func $f (type $0) (param $p i32) (result i32)
 ;; INLINE-NEXT:  (drop
 ;; INLINE-NEXT:   (i32.const 0)
 ;; INLINE-NEXT:  )
 ;; INLINE-NEXT:  (block $named-block (result i32)
 ;; INLINE-NEXT:   (loop $named-loop
 ;; INLINE-NEXT:    (br_if $named-loop
 ;; INLINE-NEXT:     (local.get $p)
 ;; INLINE-NEXT:    )
 ;; INLINE-NEXT:   )
 ;; INLINE-NEXT:   (block $block
 ;; INLINE-NEXT:    (br_if $block
 ;; INLINE-NEXT:     (local.get $p)
 ;; INLINE-NEXT:    )
 ;; INLINE-NEXT:   )
 ;; INLINE-NEXT:   (block $unused-block
 ;; INLINE-NEXT:   )
 ;; INLINE-NEXT:   (block $used-if
 ;; INLINE-NEXT:    (if
 ;; INLINE-NEXT:     (local.get $p)
 ;; INLINE-NEXT:     (then
 ;; INLINE-NEXT:      (br $used-if)
 ;; INLINE-NEXT:     )
 ;; INLINE-NEXT:    )
 ;; INLINE-NEXT:   )
 ;; INLINE-NEXT:   (i32.const 42)
 ;; INLINE-NEXT:  )
 ;; INLINE-NEXT: )
 (func $f (param $p i32) (result i32)
  (drop (i32.const 0))
  (block $named-block (result i32)
   (loop $named-loop
    (br_if $named-loop (local.get $p))
   )
   (block                            ;; unnamed: still takes a label index
    (br_if 0 (local.get $p))
   )
   (block $unused-block)
   (if $used-if (local.get $p) (then (br $used-if)))
   (i32.const 42)
  )
 )

 ;; Branches to a try target a block wrapping it, and delegates target the try
 ;; itself. The explicit name goes to whichever is used first, and the other
 ;; one gets a name derived from it.
 ;; DEBUG:      (func $try (type $0) (param $p i32) (result i32)
 ;; DEBUG-NEXT:  (drop
 ;; DEBUG-NEXT:   (block $branch-only (result i32)
 ;; DEBUG-NEXT:    (try (result i32)
 ;; DEBUG-NEXT:     (do
 ;; DEBUG-NEXT:      (drop
 ;; DEBUG-NEXT:       (br_if $branch-only
 ;; DEBUG-NEXT:        (i32.const 0)
 ;; DEBUG-NEXT:        (local.get $p)
 ;; DEBUG-NEXT:       )
 ;; DEBUG-NEXT:      )
 ;; DEBUG-NEXT:      (i32.const 1)
 ;; DEBUG-NEXT:     )
 ;; DEBUG-NEXT:     (catch_all
 ;; DEBUG-NEXT:      (i32.const 2)
 ;; DEBUG-NEXT:     )
 ;; DEBUG-NEXT:    )
 ;; DEBUG-NEXT:   )
 ;; DEBUG-NEXT:  )
 ;; DEBUG-NEXT:  (block $both (result i32)
 ;; DEBUG-NEXT:   (try $both0 (result i32)
 ;; DEBUG-NEXT:    (do
 ;; DEBUG-NEXT:     (drop
 ;; DEBUG-NEXT:      (br_if $both
 ;; DEBUG-NEXT:       (i32.const 0)
 ;; DEBUG-NEXT:       (local.get $p)
 ;; DEBUG-NEXT:      )
 ;; DEBUG-NEXT:     )
 ;; DEBUG-NEXT:     (try
 ;; DEBUG-NEXT:      (do
 ;; DEBUG-NEXT:       (nop)
 ;; DEBUG-NEXT:      )
 ;; DEBUG-NEXT:      (delegate $both0)
 ;; DEBUG-NEXT:     )
 ;; DEBUG-NEXT:     (i32.const 1)
 ;; DEBUG-NEXT:    )
 ;; DEBUG-NEXT:    (catch_all
 ;; DEBUG-NEXT:     (i32.const 2)
 ;; DEBUG-NEXT:    )
 ;; DEBUG-NEXT:   )
 ;; DEBUG-NEXT:  )
 ;; DEBUG-NEXT: )
 ;; INLINE:      (func $try (type $0) (param $p i32) (result i32)
 ;; INLINE-NEXT:  (drop
 ;; INLINE-NEXT:   (block $branch-only (result i32)
 ;; INLINE-NEXT:    (try (result i32)
 ;; INLINE-NEXT:     (do
 ;; INLINE-NEXT:      (drop
 ;; INLINE-NEXT:       (br_if $branch-only
 ;; INLINE-NEXT:        (i32.const 0)
 ;; INLINE-NEXT:        (local.get $p)
 ;; INLINE-NEXT:       )
 ;; INLINE-NEXT:      )
 ;; INLINE-NEXT:      (i32.const 1)
 ;; INLINE-NEXT:     )
 ;; INLINE-NEXT:     (catch_all
 ;; INLINE-NEXT:      (i32.const 2)
 ;; INLINE-NEXT:     )
 ;; INLINE-NEXT:    )
 ;; INLINE-NEXT:   )
 ;; INLINE-NEXT:  )
 ;; INLINE-NEXT:  (block $both (result i32)
 ;; INLINE-NEXT:   (try $both0 (result i32)
 ;; INLINE-NEXT:    (do
 ;; INLINE-NEXT:     (drop
 ;; INLINE-NEXT:      (br_if $both
 ;; INLINE-NEXT:       (i32.const 0)
 ;; INLINE-NEXT:       (local.get $p)
 ;; INLINE-NEXT:      )
 ;; INLINE-NEXT:     )
 ;; INLINE-NEXT:     (try
 ;; INLINE-NEXT:      (do
 ;; INLINE-NEXT:       (nop)
 ;; INLINE-NEXT:      )
 ;; INLINE-NEXT:      (delegate $both0)
 ;; INLINE-NEXT:     )
 ;; INLINE-NEXT:     (i32.const 1)
 ;; INLINE-NEXT:    )
 ;; INLINE-NEXT:    (catch_all
 ;; INLINE-NEXT:     (i32.const 2)
 ;; INLINE-NEXT:    )
 ;; INLINE-NEXT:   )
 ;; INLINE-NEXT:  )
 ;; INLINE-NEXT: )
 (func $try (param $p i32) (result i32)
  (drop
   (try $branch-only (result i32)
    (do (drop (br_if $branch-only (i32.const 0) (local.get $p))) (i32.const 1))
    (catch_all (i32.const 2))
   )
  )
  (try $both (result i32)
   (do
    (drop (br_if $both (i32.const 0) (local.get $p)))
    (try (do (nop)) (delegate $both))
    (i32.const 1)
   )
   (catch_all (i32.const 2))
  )
 )

 ;; Inlining names the block it creates for the inlined body. That name is
 ;; generated, not explicit, so it must not be written.
 ;; DEBUG:      (func $callee (type $1) (result i32)
 ;; DEBUG-NEXT:  (i32.const 42)
 ;; DEBUG-NEXT: )
 (func $callee (result i32) (i32.const 42))
 ;; DEBUG:      (func $caller (type $1) (result i32)
 ;; DEBUG-NEXT:  (call $callee)
 ;; DEBUG-NEXT: )
 ;; INLINE:      (func $caller (type $1) (result i32)
 ;; INLINE-NEXT:  (i32.const 42)
 ;; INLINE-NEXT: )
 (func $caller (result i32) (call $callee))
)
;; NODEBUG:      (type $0 (func (param i32) (result i32)))

;; NODEBUG:      (type $1 (func (result i32)))

;; NODEBUG:      (func $0 (type $0) (param $0 i32) (result i32)
;; NODEBUG-NEXT:  (drop
;; NODEBUG-NEXT:   (i32.const 0)
;; NODEBUG-NEXT:  )
;; NODEBUG-NEXT:  (block (result i32)
;; NODEBUG-NEXT:   (loop $label
;; NODEBUG-NEXT:    (br_if $label
;; NODEBUG-NEXT:     (local.get $0)
;; NODEBUG-NEXT:    )
;; NODEBUG-NEXT:   )
;; NODEBUG-NEXT:   (block $block
;; NODEBUG-NEXT:    (br_if $block
;; NODEBUG-NEXT:     (local.get $0)
;; NODEBUG-NEXT:    )
;; NODEBUG-NEXT:   )
;; NODEBUG-NEXT:   (block
;; NODEBUG-NEXT:   )
;; NODEBUG-NEXT:   (block $block1
;; NODEBUG-NEXT:    (if
;; NODEBUG-NEXT:     (local.get $0)
;; NODEBUG-NEXT:     (then
;; NODEBUG-NEXT:      (br $block1)
;; NODEBUG-NEXT:     )
;; NODEBUG-NEXT:    )
;; NODEBUG-NEXT:   )
;; NODEBUG-NEXT:   (i32.const 42)
;; NODEBUG-NEXT:  )
;; NODEBUG-NEXT: )

;; NODEBUG:      (func $1 (type $0) (param $0 i32) (result i32)
;; NODEBUG-NEXT:  (drop
;; NODEBUG-NEXT:   (block $block (result i32)
;; NODEBUG-NEXT:    (try (result i32)
;; NODEBUG-NEXT:     (do
;; NODEBUG-NEXT:      (drop
;; NODEBUG-NEXT:       (br_if $block
;; NODEBUG-NEXT:        (i32.const 0)
;; NODEBUG-NEXT:        (local.get $0)
;; NODEBUG-NEXT:       )
;; NODEBUG-NEXT:      )
;; NODEBUG-NEXT:      (i32.const 1)
;; NODEBUG-NEXT:     )
;; NODEBUG-NEXT:     (catch_all
;; NODEBUG-NEXT:      (i32.const 2)
;; NODEBUG-NEXT:     )
;; NODEBUG-NEXT:    )
;; NODEBUG-NEXT:   )
;; NODEBUG-NEXT:  )
;; NODEBUG-NEXT:  (block $block1 (result i32)
;; NODEBUG-NEXT:   (try $label (result i32)
;; NODEBUG-NEXT:    (do
;; NODEBUG-NEXT:     (drop
;; NODEBUG-NEXT:      (br_if $block1
;; NODEBUG-NEXT:       (i32.const 0)
;; NODEBUG-NEXT:       (local.get $0)
;; NODEBUG-NEXT:      )
;; NODEBUG-NEXT:     )
;; NODEBUG-NEXT:     (try
;; NODEBUG-NEXT:      (do
;; NODEBUG-NEXT:       (nop)
;; NODEBUG-NEXT:      )
;; NODEBUG-NEXT:      (delegate $label)
;; NODEBUG-NEXT:     )
;; NODEBUG-NEXT:     (i32.const 1)
;; NODEBUG-NEXT:    )
;; NODEBUG-NEXT:    (catch_all
;; NODEBUG-NEXT:     (i32.const 2)
;; NODEBUG-NEXT:    )
;; NODEBUG-NEXT:   )
;; NODEBUG-NEXT:  )
;; NODEBUG-NEXT: )

;; NODEBUG:      (func $2 (type $1) (result i32)
;; NODEBUG-NEXT:  (i32.const 42)
;; NODEBUG-NEXT: )

;; NODEBUG:      (func $3 (type $1) (result i32)
;; NODEBUG-NEXT:  (call $2)
;; NODEBUG-NEXT: )
