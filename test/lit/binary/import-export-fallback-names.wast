;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t sh -c 'wasm-as "$0" --all-features -o "$0.wasm" && wasm-dis "$0.wasm" --all-features -o -' | filecheck %s --check-prefix=FALLBACK
;; RUN: foreach %s %t sh -c 'wasm-as "$0" --all-features -g -o "$0.wasm" && wasm-dis "$0.wasm" --all-features -o -' | filecheck %s --check-prefix=EXPLICIT
;; RUN: foreach %s %t sh -c 'wasm-as "$0" --all-features -o "$0.wasm" && wasm-dis "$0.wasm" --all-features -o "$0.wat" && wasm-as "$0.wat" --all-features -o "$0.roundtrip.wasm"'

;; Without a name section, use import and export names for internal names.
;; Explicit names from a name section continue to take priority.

(module
  ;; EXPLICIT:      (type $tag_type (func))
  (type $tag_type (func))
  ;; EXPLICIT:      (import "env" "" (memory $empty_memory 1))

  ;; EXPLICIT:      (import "env" "import_memory" (memory $internal_import_memory 1))

  ;; EXPLICIT:      (import "env" "" (table $empty_table 1 funcref))

  ;; EXPLICIT:      (import "env" "import_table" (table $internal_import_table 1 funcref))

  ;; EXPLICIT:      (import "env" "" (global $empty_global i32))

  ;; EXPLICIT:      (import "env" "import_global" (global $internal_import_global i32))

  ;; EXPLICIT:      (import "env" "" (func $empty_func (type $tag_type)))
  (import "env" "" (func $empty_func))
  (import "env" "" (table $empty_table 1 funcref))
  (import "env" "" (memory $empty_memory 1))
  (import "env" "" (global $empty_global i32))
  ;; EXPLICIT:      (import "env" "import_func" (func $internal_import_func (type $tag_type)))

  ;; EXPLICIT:      (import "other" "import_func" (func $internal_second_import_func (type $tag_type)))

  ;; EXPLICIT:      (import "env" "" (tag $empty_tag (type $tag_type)))
  (import "env" "" (tag $empty_tag (type $tag_type)))
  (import "env" "import_func" (func $internal_import_func))
  (import "other" "import_func" (func $internal_second_import_func))
  (import "env" "import_table" (table $internal_import_table 1 funcref))
  (import "env" "import_memory" (memory $internal_import_memory 1))
  (import "env" "import_global" (global $internal_import_global i32))
  ;; EXPLICIT:      (import "env" "import_tag" (tag $internal_import_tag (type $tag_type)))
  (import "env" "import_tag" (tag $internal_import_tag (type $tag_type)))
  ;; EXPLICIT:      (global $internal_export_global i32 (i32.const 0))

  ;; EXPLICIT:      (memory $internal_export_memory 1)

  ;; EXPLICIT:      (memory $internal_colliding_memory 1)

  ;; EXPLICIT:      (table $internal_export_table 1 funcref)

  ;; EXPLICIT:      (tag $internal_export_tag (type $tag_type))

  ;; EXPLICIT:      (export "" (func $internal_export_func))

  ;; EXPLICIT:      (export "export_func" (func $internal_export_func))

  ;; EXPLICIT:      (export "second_export_func" (func $internal_export_func))

  ;; EXPLICIT:      (export "export_table" (table $internal_export_table))

  ;; EXPLICIT:      (export "export_memory" (memory $internal_export_memory))

  ;; EXPLICIT:      (export "second_export_memory" (memory $internal_export_memory))

  ;; EXPLICIT:      (export "import_memory" (memory $internal_colliding_memory))

  ;; EXPLICIT:      (export "export_global" (global $internal_export_global))

  ;; EXPLICIT:      (export "export_tag" (tag $internal_export_tag))

  ;; EXPLICIT:      (func $internal_export_func (type $tag_type)
  ;; EXPLICIT-NEXT: )
  (func $internal_export_func
    (export "")
    (export "export_func")
    (export "second_export_func")
  )
  (table $internal_export_table (export "export_table") 1 funcref)
  (memory $internal_export_memory
    (export "export_memory")
    (export "second_export_memory") 1)
  (memory $internal_colliding_memory (export "import_memory") 1)
  (global $internal_export_global (export "export_global") i32 (i32.const 0))
  (tag $internal_export_tag (export "export_tag") (type $tag_type))
)

;; An empty export without a usable alternative keeps its generated name.
;; FALLBACK:      (type $0 (func))

;; FALLBACK:      (import "env" "" (memory $mimport$0 1))

;; FALLBACK:      (import "env" "import_memory" (memory $import_memory 1))

;; FALLBACK:      (import "env" "" (table $timport$0 1 funcref))

;; FALLBACK:      (import "env" "import_table" (table $import_table 1 funcref))

;; FALLBACK:      (import "env" "" (global $gimport$0 i32))

;; FALLBACK:      (import "env" "import_global" (global $import_global i32))

;; FALLBACK:      (import "env" "" (func $fimport$0 (type $0)))

;; FALLBACK:      (import "env" "import_func" (func $import_func (type $0)))

;; FALLBACK:      (import "other" "import_func" (func $import_func_2 (type $0)))

;; FALLBACK:      (import "env" "" (tag $eimport$0 (type $0)))

;; FALLBACK:      (import "env" "import_tag" (tag $import_tag (type $0)))

;; FALLBACK:      (global $export_global i32 (i32.const 0))

;; FALLBACK:      (memory $export_memory 1)

;; FALLBACK:      (memory $import_memory_3 1)

;; FALLBACK:      (table $export_table 1 funcref)

;; FALLBACK:      (tag $export_tag (type $0))

;; FALLBACK:      (export "" (func $export_func))

;; FALLBACK:      (export "export_func" (func $export_func))

;; FALLBACK:      (export "second_export_func" (func $export_func))

;; FALLBACK:      (export "export_table" (table $export_table))

;; FALLBACK:      (export "export_memory" (memory $export_memory))

;; FALLBACK:      (export "second_export_memory" (memory $export_memory))

;; FALLBACK:      (export "import_memory" (memory $import_memory_3))

;; FALLBACK:      (export "export_global" (global $export_global))

;; FALLBACK:      (export "export_tag" (tag $export_tag))

;; FALLBACK:      (func $export_func (type $0)
;; FALLBACK-NEXT: )
(module
  ;; EXPLICIT:      (type $0 (func (result i32)))

  ;; EXPLICIT:      (export "" (func $internal_empty_export))

  ;; EXPLICIT:      (func $internal_empty_export (type $0) (result i32)
  ;; EXPLICIT-NEXT:  (i32.const 42)
  ;; EXPLICIT-NEXT: )
  (func $internal_empty_export (export "") (result i32)
    (i32.const 42)
  )
)
;; FALLBACK:      (type $0 (func (result i32)))

;; FALLBACK:      (export "" (func $0))

;; FALLBACK:      (func $0 (type $0) (result i32)
;; FALLBACK-NEXT:  (i32.const 42)
