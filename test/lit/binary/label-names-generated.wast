;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; Test that we do not write to the name section the label names that we
;; generated ourselves.

;; A generated name usually cannot be told apart in the output: reading one
;; back gives the same name that regenerating it would. Inlining is the
;; exception, as it names the block it creates after the function it inlined,
;; which is a name the reader never invents. So CHECK-TEXT below shows the name
;; we generated, and CHECK-BIN shows that it does not survive the binary
;; format: with the name dropped, the block is unnamed and unbranched, and is
;; flattened away when read.

;; RUN: wasm-opt %s -all -g --inlining -S -o - | filecheck %s --check-prefix=CHECK-TEXT
;; RUN: wasm-opt %s -all -g --inlining -o %t.wasm
;; RUN: wasm-dis %t.wasm -all -o - | filecheck %s --check-prefix=CHECK-BIN

(module
 (func $callee (result i32) (i32.const 42))
 ;; CHECK-TEXT:      (type $0 (func (result i32)))

 ;; CHECK-TEXT:      (export "caller" (func $caller))

 ;; CHECK-TEXT:      (func $caller (type $0) (result i32)
 ;; CHECK-TEXT-NEXT:  (block $__inlined_func$callee (result i32)
 ;; CHECK-TEXT-NEXT:   (i32.const 42)
 ;; CHECK-TEXT-NEXT:  )
 ;; CHECK-TEXT-NEXT: )
 ;; CHECK-BIN:      (type $0 (func (result i32)))

 ;; CHECK-BIN:      (export "caller" (func $caller))

 ;; CHECK-BIN:      (func $caller (type $0) (result i32)
 ;; CHECK-BIN-NEXT:  (i32.const 42)
 ;; CHECK-BIN-NEXT: )
 (func $caller (export "caller") (result i32) (call $callee))
)
