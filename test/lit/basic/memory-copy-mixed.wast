;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; Test that memory.copy between 32-bit and 64-bit memories is parsed,
;; validated and round-tripped through the binary format: the size has the
;; narrower address type.

;; RUN: wasm-opt %s -all -o %t.text.wast -g -S
;; RUN: wasm-as %s -all -g -o %t.wasm
;; RUN: wasm-dis %t.wasm -all -o %t.bin.wast
;; RUN: wasm-as %s -all -o %t.nodebug.wasm
;; RUN: wasm-dis %t.nodebug.wasm -all -o %t.bin.nodebug.wast
;; RUN: cat %t.text.wast | filecheck %s --check-prefix=CHECK-TEXT
;; RUN: cat %t.bin.wast | filecheck %s --check-prefix=CHECK-BIN
;; RUN: cat %t.bin.nodebug.wast | filecheck %s --check-prefix=CHECK-BIN-NODEBUG

(module
  ;; CHECK-TEXT:      (type $0 (func (param i32 i64 i32)))

  ;; CHECK-TEXT:      (type $1 (func (param i64 i32 i32)))

  ;; CHECK-TEXT:      (memory $m32 1)
  ;; CHECK-BIN:      (type $0 (func (param i32 i64 i32)))

  ;; CHECK-BIN:      (type $1 (func (param i64 i32 i32)))

  ;; CHECK-BIN:      (memory $m32 1)
  (memory $m32 1)
  ;; CHECK-TEXT:      (memory $m64 i64 1)
  ;; CHECK-BIN:      (memory $m64 i64 1)
  (memory $m64 i64 1)

  ;; CHECK-TEXT:      (func $copy-64-to-32 (type $0) (param $dest i32) (param $src i64) (param $size i32)
  ;; CHECK-TEXT-NEXT:  (memory.copy $m32 $m64
  ;; CHECK-TEXT-NEXT:   (local.get $dest)
  ;; CHECK-TEXT-NEXT:   (local.get $src)
  ;; CHECK-TEXT-NEXT:   (local.get $size)
  ;; CHECK-TEXT-NEXT:  )
  ;; CHECK-TEXT-NEXT: )
  ;; CHECK-BIN:      (func $copy-64-to-32 (type $0) (param $dest i32) (param $src i64) (param $size i32)
  ;; CHECK-BIN-NEXT:  (memory.copy $m32 $m64
  ;; CHECK-BIN-NEXT:   (local.get $dest)
  ;; CHECK-BIN-NEXT:   (local.get $src)
  ;; CHECK-BIN-NEXT:   (local.get $size)
  ;; CHECK-BIN-NEXT:  )
  ;; CHECK-BIN-NEXT: )
  (func $copy-64-to-32 (param $dest i32) (param $src i64) (param $size i32)
    (memory.copy $m32 $m64
      (local.get $dest)
      (local.get $src)
      (local.get $size)
    )
  )

  ;; CHECK-TEXT:      (func $copy-32-to-64 (type $1) (param $dest i64) (param $src i32) (param $size i32)
  ;; CHECK-TEXT-NEXT:  (memory.copy $m64 $m32
  ;; CHECK-TEXT-NEXT:   (local.get $dest)
  ;; CHECK-TEXT-NEXT:   (local.get $src)
  ;; CHECK-TEXT-NEXT:   (local.get $size)
  ;; CHECK-TEXT-NEXT:  )
  ;; CHECK-TEXT-NEXT: )
  ;; CHECK-BIN:      (func $copy-32-to-64 (type $1) (param $dest i64) (param $src i32) (param $size i32)
  ;; CHECK-BIN-NEXT:  (memory.copy $m64 $m32
  ;; CHECK-BIN-NEXT:   (local.get $dest)
  ;; CHECK-BIN-NEXT:   (local.get $src)
  ;; CHECK-BIN-NEXT:   (local.get $size)
  ;; CHECK-BIN-NEXT:  )
  ;; CHECK-BIN-NEXT: )
  (func $copy-32-to-64 (param $dest i64) (param $src i32) (param $size i32)
    (memory.copy $m64 $m32
      (local.get $dest)
      (local.get $src)
      (local.get $size)
    )
  )
)
;; CHECK-BIN-NODEBUG:      (type $0 (func (param i32 i64 i32)))

;; CHECK-BIN-NODEBUG:      (type $1 (func (param i64 i32 i32)))

;; CHECK-BIN-NODEBUG:      (memory $0 1)

;; CHECK-BIN-NODEBUG:      (memory $1 i64 1)

;; CHECK-BIN-NODEBUG:      (func $0 (type $0) (param $0 i32) (param $1 i64) (param $2 i32)
;; CHECK-BIN-NODEBUG-NEXT:  (memory.copy $0 $1
;; CHECK-BIN-NODEBUG-NEXT:   (local.get $0)
;; CHECK-BIN-NODEBUG-NEXT:   (local.get $1)
;; CHECK-BIN-NODEBUG-NEXT:   (local.get $2)
;; CHECK-BIN-NODEBUG-NEXT:  )
;; CHECK-BIN-NODEBUG-NEXT: )

;; CHECK-BIN-NODEBUG:      (func $1 (type $1) (param $0 i64) (param $1 i32) (param $2 i32)
;; CHECK-BIN-NODEBUG-NEXT:  (memory.copy $1 $0
;; CHECK-BIN-NODEBUG-NEXT:   (local.get $0)
;; CHECK-BIN-NODEBUG-NEXT:   (local.get $1)
;; CHECK-BIN-NODEBUG-NEXT:   (local.get $2)
;; CHECK-BIN-NODEBUG-NEXT:  )
;; CHECK-BIN-NODEBUG-NEXT: )
