;; Test tags

(module
  (rec
    ;; CHECK-TEXT:      (type $0 (func (param i32 f32)))

    ;; CHECK-TEXT:      (type $1 (func (param i32)))

    ;; CHECK-TEXT:      (rec
    ;; CHECK-TEXT-NEXT:  (type $super (sub (func)))
    ;; CHECK-BIN:      (type $0 (func (param i32 f32)))

    ;; CHECK-BIN:      (type $1 (func (param i32)))

    ;; CHECK-BIN:      (rec
