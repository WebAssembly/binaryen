;; NOTE: Assertions have been generated by update_lit_checks.py --output=fuzz-exec and should not be edited.

;; RUN: foreach %s %t wasm-opt -all --fuzz-exec-before -q -o /dev/null 2>&1 | filecheck %s

;; A maximal memory64 declares 2^48 pages, exactly 2^64 bytes, which cannot be
;; allocated (and whose byte size does not even fit in 64 bits). Instantiation
;; must fail as a host limit, not wrap the size to zero and then spuriously
;; trap on the active segment (which optimizations may legitimately remove,
;; changing the spurious behavior).
(module
 ;; CHECK:      [host limit memory too large]
 (memory $0 i64 281474976710656 281474976710656 shared)
 (data $0 (i64.const 0) "\00")
)

;; An initial memory larger than the interpreter's 1 GiB (16384 64KiB pages)
;; allocation cap must also fail instantiation as a host limit rather than
;; succeeding and then failing subsequent memory.grow(0) calls.
(module
 ;; CHECK:      [host limit memory too large]
 (memory $0 i64 16385 16385)
 (func $test (export "test") (result i64)
  (memory.grow
   (i64.const 0)
  )
 )
)

;; Growing a memory past the interpreter's 1 GiB cap while remaining within the
;; declared maximum size must also signal a host limit rather than returning -1
;; so differential fuzzing ignores runs that hit the cap instead of reporting a
;; false positive when other VMs succeed.
(module
 (memory $0 i64 1 16385)
 ;; CHECK:      [fuzz-exec] export grow-0
 ;; CHECK-NEXT: [fuzz-exec] note result: grow-0 => 1
 (func $grow-0 (export "grow-0") (result i64)
  (memory.grow
   (i64.const 0)
  )
 )
 ;; CHECK:      [fuzz-exec] export grow-past-host-limit
 ;; CHECK-NEXT: [host limit memory too large]
 (func $grow-past-host-limit (export "grow-past-host-limit") (result i64)
  (memory.grow
   (i64.const 16384)
  )
 )
)
