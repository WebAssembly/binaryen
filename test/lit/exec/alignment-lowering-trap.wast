 ;; ALIGN:      [fuzz-exec] export store-in-bounds
 ;; I64:      [fuzz-exec] export store-in-bounds
 (func $store-in-bounds (export "store-in-bounds")
  (i64.store align=1 (i32.const 100) (i64.const 0x0102030405060708))
 )
 ;; ALIGN:      [fuzz-exec] export load-low
 ;; ALIGN-NEXT: [fuzz-exec] note result: load-low => 84281096
