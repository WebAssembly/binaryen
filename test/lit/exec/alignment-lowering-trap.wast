;; NOTE: Assertions have been generated by update_lit_checks.py --output=fuzz-exec and should not be edited.

;; RUN: wasm-opt %s --alignment-lowering --fuzz-exec -q \
;; RUN:   | filecheck %s --check-prefix=ALIGN
;; RUN: wasm-opt %s --flatten --i64-to-i32-lowering --fuzz-exec -q \
;; RUN:   | filecheck %s --check-prefix=I64

;; Lowered stores must not write anything when the original store would trap.
;; The pieces are stored from the highest address down, so an out of bounds
;; store traps before memory is modified. Each store function first clears the
;; last word of memory, and the following peek function reads it back after the
;; trap, so a partial write makes --fuzz-exec report a changed result. The
;; stored values have a distinct nonzero byte at every address, so any byte
;; written before the trap changes the peek. The last group stores an i64 in
;; bounds and reads both halves back, to check that the reordered pieces still
;; write the right values. The trap messages name the address of the piece that
;; trapped, so the two RUN lines need separate prefixes.

(module
 (memory 1 1)

 ;; ALIGN:      [fuzz-exec] export store-i32-align1
 ;; ALIGN-NEXT: [trap highest > memory: 65534 > 65532]
 ;; I64:      [fuzz-exec] export store-i32-align1
 ;; I64-NEXT: [trap highest > memory: 65534 > 65532]
 (func $store-i32-align1 (export "store-i32-align1")
  (i32.store (i32.const 65532) (i32.const 0))
  (i32.store align=1 (i32.const 65534) (i32.const 0x01020304))
 )
 ;; ALIGN:      [fuzz-exec] export peek-i32-align1
 ;; ALIGN-NEXT: [fuzz-exec] note result: peek-i32-align1 => 0
 ;; I64:      [fuzz-exec] export peek-i32-align1
 ;; I64-NEXT: [fuzz-exec] note result: peek-i32-align1 => 0
 (func $peek-i32-align1 (export "peek-i32-align1") (result i32)
  (i32.load (i32.const 65532))
 )

 ;; ALIGN:      [fuzz-exec] export store-i32-align2
 ;; ALIGN-NEXT: [trap highest > memory: 65534 > 65532]
 ;; I64:      [fuzz-exec] export store-i32-align2
 ;; I64-NEXT: [trap highest > memory: 65534 > 65532]
 (func $store-i32-align2 (export "store-i32-align2")
  (i32.store (i32.const 65532) (i32.const 0))
  (i32.store align=2 (i32.const 65534) (i32.const 0x01020304))
 )
 ;; ALIGN:      [fuzz-exec] export peek-i32-align2
 ;; ALIGN-NEXT: [fuzz-exec] note result: peek-i32-align2 => 0
 ;; I64:      [fuzz-exec] export peek-i32-align2
 ;; I64-NEXT: [fuzz-exec] note result: peek-i32-align2 => 0
 (func $peek-i32-align2 (export "peek-i32-align2") (result i32)
  (i32.load (i32.const 65532))
 )

 ;; ALIGN:      [fuzz-exec] export store-i32-16-align1
 ;; ALIGN-NEXT: [trap highest > memory: 65535 > 65534]
 ;; I64:      [fuzz-exec] export store-i32-16-align1
 ;; I64-NEXT: [trap highest > memory: 65535 > 65534]
 (func $store-i32-16-align1 (export "store-i32-16-align1")
  (i32.store (i32.const 65532) (i32.const 0))
  (i32.store16 align=1 (i32.const 65535) (i32.const 0x0102))
 )
 ;; ALIGN:      [fuzz-exec] export peek-i32-16-align1
 ;; ALIGN-NEXT: [fuzz-exec] note result: peek-i32-16-align1 => 0
 ;; I64:      [fuzz-exec] export peek-i32-16-align1
 ;; I64-NEXT: [fuzz-exec] note result: peek-i32-16-align1 => 0
 (func $peek-i32-16-align1 (export "peek-i32-16-align1") (result i32)
  (i32.load (i32.const 65532))
 )

 ;; ALIGN:      [fuzz-exec] export store-f32-align1
 ;; ALIGN-NEXT: [trap highest > memory: 65533 > 65532]
 ;; I64:      [fuzz-exec] export store-f32-align1
 ;; I64-NEXT: [trap highest > memory: 65533 > 65532]
 (func $store-f32-align1 (export "store-f32-align1")
  (i32.store (i32.const 65532) (i32.const 0))
  (f32.store align=1 (i32.const 65533) (f32.const 0x1.020406p+0))
 )
 ;; ALIGN:      [fuzz-exec] export peek-f32-align1
 ;; ALIGN-NEXT: [fuzz-exec] note result: peek-f32-align1 => 0
 ;; I64:      [fuzz-exec] export peek-f32-align1
 ;; I64-NEXT: [fuzz-exec] note result: peek-f32-align1 => 0
 (func $peek-f32-align1 (export "peek-f32-align1") (result i32)
  (i32.load (i32.const 65532))
 )

 ;; ALIGN:      [fuzz-exec] export store-i64-32-align2
 ;; ALIGN-NEXT: [trap highest > memory: 65534 > 65532]
 ;; I64:      [fuzz-exec] export store-i64-32-align2
 ;; I64-NEXT: [trap highest > memory: 65534 > 65532]
 (func $store-i64-32-align2 (export "store-i64-32-align2")
  (i32.store (i32.const 65532) (i32.const 0))
  (i64.store32 align=2 (i32.const 65534) (i64.const 0x01020304))
 )
 ;; ALIGN:      [fuzz-exec] export peek-i64-32-align2
 ;; ALIGN-NEXT: [fuzz-exec] note result: peek-i64-32-align2 => 0
 ;; I64:      [fuzz-exec] export peek-i64-32-align2
