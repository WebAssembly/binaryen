 ;; ALIGN-NEXT: [trap highest > memory: 65532 > 65528]
 ;; I64:      [fuzz-exec] export store-i64
 ;; I64-NEXT: [trap highest > memory: 65532 > 65528]
 (func $store-i64 (export "store-i64")
  (i32.store (i32.const 65532) (i32.const 0))
  (i64.store (i32.const 65532) (i64.const 0x0102030405060708))
 )
 ;; ALIGN:      [fuzz-exec] export peek-i64
 ;; ALIGN-NEXT: [fuzz-exec] note result: peek-i64 => 0
 ;; I64:      [fuzz-exec] export peek-i64
 ;; I64-NEXT: [fuzz-exec] note result: peek-i64 => 0
 (func $peek-i64 (export "peek-i64") (result i32)
  (i32.load (i32.const 65532))
 )

 ;; The offset immediate moves the store from 65528 to 65532.
 ;; ALIGN:      [fuzz-exec] export store-i64-offset-align1
 ;; ALIGN-NEXT: [trap highest > memory: 65532 > 65528]
 ;; I64:      [fuzz-exec] export store-i64-offset-align1
 ;; I64-NEXT: [trap highest > memory: 65532 > 65528]
 (func $store-i64-offset-align1 (export "store-i64-offset-align1")
  (i32.store (i32.const 65532) (i32.const 0))
  (i64.store offset=4 align=1 (i32.const 65528) (i64.const 0x0102030405060708))
 )
 ;; ALIGN:      [fuzz-exec] export peek-i64-offset-align1
 ;; ALIGN-NEXT: [fuzz-exec] note result: peek-i64-offset-align1 => 0
 ;; I64:      [fuzz-exec] export peek-i64-offset-align1
 ;; I64-NEXT: [fuzz-exec] note result: peek-i64-offset-align1 => 0
 (func $peek-i64-offset-align1 (export "peek-i64-offset-align1") (result i32)
  (i32.load (i32.const 65532))
 )

 ;; ALIGN:      [fuzz-exec] export store-f64-align2
 ;; ALIGN-NEXT: [trap highest > memory: 65530 > 65528]
 ;; I64:      [fuzz-exec] export store-f64-align2
 ;; I64-NEXT: [trap highest > memory: 65530 > 65528]
 (func $store-f64-align2 (export "store-f64-align2")
  (i32.store (i32.const 65532) (i32.const 0))
  (f64.store align=2 (i32.const 65530) (f64.const 0x1.1121314151617p+0))
 )
 ;; ALIGN:      [fuzz-exec] export peek-f64-align2
 ;; ALIGN-NEXT: [fuzz-exec] note result: peek-f64-align2 => 0
 ;; I64:      [fuzz-exec] export peek-f64-align2
