;; NOTE: Assertions have been generated by update_lit_checks.py --output=fuzz-exec and should not be edited.

;; RUN: wasm-opt %s -all --fuzz-exec-before -q -o /dev/null 2>&1 | filecheck %s

;; The memory here is over 2GB in size. We grow it by size 0, that is, just
;; retrieve the size without changing it. We should not error on an OOM here.

(module
 (memory i64 32769)

 ;; CHECK:      [fuzz-exec] export measure
 ;; CHECK-NEXT: [fuzz-exec] note result: measure => 32769
 (func $measure (export "measure") (result i64)
  ;; This will return the size, 32769, and not -1 to indicate an OOM.
  (memory.grow
   (i64.const 0)
  )
 )
)
