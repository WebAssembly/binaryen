;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; Check that heap types used as instruction immediates are collected and emitted
;; properly even when their operand is an unnamed block elided by StackIR. If the
;; type immediates were not counted properly, they would not be counted at all
;; because the only other place they appear in the IR is on the unnamed blocks,
;; which StackIR will elide and not count. This would lead to assertion failures
;; when the binary writer could not look up an index for the type immediates.

;; RUN: wasm-opt %s -all --generate-stack-ir --roundtrip -S -o - | filecheck %s

(module
  (rec
    ;; CHECK:      (type $0 (func))

    ;; CHECK:      (type $1 (func (result anyref)))

    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $s-desc-eq (descriptor $d-desc-eq) (struct (field i32)))
    (type $s-desc-eq (descriptor $d-desc-eq) (struct (field i32)))
    ;; CHECK:       (type $d-desc-eq (describes $s-desc-eq) (struct (field i32)))
    (type $d-desc-eq (describes $s-desc-eq) (struct (field i32)))
  )
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $s-desc-eq-fail (descriptor $d-desc-eq-fail) (struct (field i64)))
    (type $s-desc-eq-fail (descriptor $d-desc-eq-fail) (struct (field i64)))
    ;; CHECK:       (type $d-desc-eq-fail (describes $s-desc-eq-fail) (struct (field i64)))
    (type $d-desc-eq-fail (describes $s-desc-eq-fail) (struct (field i64)))
  )
  (type $unused-br-cast-desc-eq (struct (field f32)))
  (type $unused-br-cast-desc-eq-fail (struct (field f64)))

  ;; CHECK:      (type $unused-br-cast-super (sub (struct (field i32))))
  (type $unused-br-cast-super (sub (struct (field i32))))
  ;; CHECK:      (type $unused-br-cast-fail-super (sub (struct (field i64))))

  ;; CHECK:      (type $unused-br-cast-sub (sub $unused-br-cast-super (struct (field i32) (field i32))))
  (type $unused-br-cast-sub (sub $unused-br-cast-super (struct (field i32 i32))))
  (type $unused-br-cast-fail-super (sub (struct (field i64))))
  ;; CHECK:      (type $unused-br-cast-fail-sub (sub $unused-br-cast-fail-super (struct (field i64) (field i64))))
  (type $unused-br-cast-fail-sub (sub $unused-br-cast-fail-super (struct (field i64 i64))))
  (type $unused-br-null (struct (field i32 i64)))
  (type $unused-br-non-null (struct (field i64 i32)))

  (rec
    (type $unused-get-desc (descriptor $unused-get-desc-d) (struct (field f32 f32)))
    (type $unused-get-desc-d (describes $unused-get-desc) (struct))
  )

  (type $unused-struct-rmw (shared (struct (field (mut i32)))))
  (type $unused-struct-cmpxchg (shared (struct (field i32) (field (mut i32)))))
  (type $unused-array-rmw (shared (array (mut i32))))
  (type $unused-array-cmpxchg (shared (array (mut i64))))
  (type $unused-array-load (array i8))
  (type $unused-array-store (array (mut i8)))

  ;; CHECK:      (func $br-on-cast-desc-eq (type $1) (result anyref)
  ;; CHECK-NEXT:  (block $b (result anyref)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (br_on_cast_desc_eq $b (ref (exact $s-desc-eq)) (ref (exact $s-desc-eq))
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:     (struct.new_default $d-desc-eq)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $br-on-cast-desc-eq (result anyref)
    ;; The binary writer emits $unused-br-cast-desc-eq from the elided block
    ;; (which would fail an assertion without the fix), but the binary reader
    ;; drops that input type when the operand is unreachable, and the text
    ;; printer substitutes the target type $s-desc-eq instead.
    (block $b (result anyref)
      (drop
        (br_on_cast_desc_eq $b (ref $unused-br-cast-desc-eq) (ref $s-desc-eq)
          (block (result (ref $unused-br-cast-desc-eq))
            (unreachable)
          )
          (struct.new_default $d-desc-eq)
        )
      )
      (unreachable)
    )
  )

  ;; CHECK:      (func $br-on-cast-desc-eq-fail (type $1) (result anyref)
  ;; CHECK-NEXT:  (block $b (result anyref)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (br_on_cast_desc_eq_fail $b (ref (exact $s-desc-eq-fail)) (ref (exact $s-desc-eq-fail))
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:     (struct.new_default $d-desc-eq-fail)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $br-on-cast-desc-eq-fail (result anyref)
    ;; As above, the binary writer emits $unused-br-cast-desc-eq-fail, while
    ;; roundtripping drops it on the unreachable operand and prints the target
    ;; type $s-desc-eq-fail instead.
    (block $b (result anyref)
      (drop
        (br_on_cast_desc_eq_fail $b (ref $unused-br-cast-desc-eq-fail) (ref $s-desc-eq-fail)
          (block (result (ref $unused-br-cast-desc-eq-fail))
            (unreachable)
          )
          (struct.new_default $d-desc-eq-fail)
        )
      )
      (unreachable)
    )
  )

  ;; CHECK:      (func $br-on-cast (type $1) (result anyref)
  ;; CHECK-NEXT:  (block $b (result anyref)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (br_on_cast $b (ref $unused-br-cast-sub) (ref $unused-br-cast-sub)
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $br-on-cast (result anyref)
    (block $b (result anyref)
      (drop
        (br_on_cast $b (ref $unused-br-cast-super) (ref $unused-br-cast-sub)
          (block (result (ref $unused-br-cast-super))
            (unreachable)
          )
        )
      )
      (unreachable)
    )
  )

  ;; CHECK:      (func $br-on-cast-fail (type $1) (result anyref)
  ;; CHECK-NEXT:  (block $b (result anyref)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (br_on_cast_fail $b (ref $unused-br-cast-fail-sub) (ref $unused-br-cast-fail-sub)
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $br-on-cast-fail (result anyref)
    (block $b (result anyref)
      (drop
        (br_on_cast_fail $b (ref $unused-br-cast-fail-super) (ref $unused-br-cast-fail-sub)
          (block (result (ref $unused-br-cast-fail-super))
            (unreachable)
          )
        )
      )
      (unreachable)
    )
  )

  ;; CHECK:      (func $br-on-null (type $0)
  ;; CHECK-NEXT:  (block $b
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (br_on_null $b
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $br-on-null
    ;; Non-cast br_on* instructions do not emit heap type immediates.
    (block $b
      (drop
        (br_on_null $b
          (block (result (ref null $unused-br-null))
            (unreachable)
          )
        )
      )
    )
  )

  ;; CHECK:      (func $br-on-non-null (type $0)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block $b (result anyref)
  ;; CHECK-NEXT:    (br_on_non_null $b
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $br-on-non-null
    ;; Non-cast br_on* instructions do not emit heap type immediates.
    (block $b (result anyref)
      (br_on_non_null $b
        (block (result (ref null $unused-br-non-null))
          (unreachable)
        )
      )
      (unreachable)
    )
    (drop)
  )

  ;; CHECK:      (func $ref-get-desc (type $0)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable RefGetDesc we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-get-desc
    ;; Roundtripping replaces the unreachable instruction with a block and drops
    ;; $unused-get-desc, so this just checks that there is no assertion failure.
    (drop
      (ref.get_desc $unused-get-desc
        (block (result (ref $unused-get-desc))
          (unreachable)
        )
      )
    )
  )

  ;; CHECK:      (func $struct-rmw (type $0)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable StructRMW we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $struct-rmw
    ;; Roundtripping replaces the unreachable instruction with a block and drops
    ;; $unused-struct-rmw, so this just checks that there is no assertion failure.
    (drop
      (struct.atomic.rmw.add $unused-struct-rmw 0
        (block (result (ref $unused-struct-rmw))
          (unreachable)
        )
        (i32.const 1)
      )
    )
  )

  ;; CHECK:      (func $struct-cmpxchg (type $0)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable StructCmpxchg we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $struct-cmpxchg
    ;; Roundtripping replaces the unreachable instruction with a block and drops
    ;; $unused-struct-cmpxchg, so this just checks that there is no assertion failure.
    (drop
      (struct.atomic.rmw.cmpxchg $unused-struct-cmpxchg 1
        (block (result (ref $unused-struct-cmpxchg))
          (unreachable)
        )
        (i32.const 1)
        (i32.const 2)
      )
    )
  )

  ;; CHECK:      (func $array-rmw (type $0)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable ArrayRMW we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-rmw
    ;; Roundtripping replaces the unreachable instruction with a block and drops
    ;; $unused-array-rmw, so this just checks that there is no assertion failure.
    (drop
      (array.atomic.rmw.add $unused-array-rmw
        (block (result (ref $unused-array-rmw))
          (unreachable)
        )
        (i32.const 0)
        (i32.const 1)
      )
    )
  )

  ;; CHECK:      (func $array-cmpxchg (type $0)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable ArrayCmpxchg we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i64.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i64.const 2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-cmpxchg
    ;; Roundtripping replaces the unreachable instruction with a block and drops
    ;; $unused-array-cmpxchg, so this just checks that there is no assertion failure.
    (drop
      (array.atomic.rmw.cmpxchg $unused-array-cmpxchg
        (block (result (ref $unused-array-cmpxchg))
          (unreachable)
        )
        (i32.const 0)
        (i64.const 1)
        (i64.const 2)
      )
    )
  )

  ;; CHECK:      (func $array-load (type $0)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable ArrayLoad we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-load
    ;; Roundtripping replaces the unreachable instruction with a block and drops
    ;; $unused-array-load, so this just checks that there is no assertion failure.
    (drop
      (i32.load8_u (type $unused-array-load)
        (block (result (ref $unused-array-load))
          (unreachable)
        )
        (i32.const 0)
      )
    )
  )

  ;; CHECK:      (func $array-store (type $0)
  ;; CHECK-NEXT:  (block ;; (replaces unreachable ArrayStore we can't emit)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-store
    ;; Roundtripping replaces the unreachable instruction with a block and drops
    ;; $unused-array-store, so this just checks that there is no assertion failure.
    (i32.store8 (type $unused-array-store)
      (block (result (ref $unused-array-store))
        (unreachable)
      )
      (i32.const 0)
      (i32.const 1)
    )
  )
)
