  (func $exact (export "exact")
    (param $exact (ref (exact $A)))
    (param $inexact (ref $A))
    (result i32)
    (local $e (ref (exact $A)))
    (local $i (ref $A))
    (local.set $e (local.get $exact))
    (local.set $i (local.get $inexact))
    (call $unwind)
    (i32.and
      (ref.eq (local.get $e) (local.get $e))
      (ref.eq (local.get $i) (local.get $i)))
  )
)
