  (func $reference-locals (export "reference-locals")
    (param $e externref)
    (result i32)
    (local $e2 externref)
    (local $e3 externref)
    (local.set $e2 (local.get $e))
    (local.set $e3 (ref.null extern))
    (call $unwind)
    (i32.and (ref.is_null (local.get $e2)) (ref.is_null (local.get $e3)))
  )

