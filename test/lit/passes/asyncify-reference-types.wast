  ;; CHECK:      (memory $0 1)

  ;; CHECK:      (table $__asyncify_ref_table_extern 2 67108864 externref)

  ;; CHECK:      (table $__asyncify_ref_table_func 4 67108864 funcref)

  ;; CHECK:      (table $__asyncify_ref_table_A_exact 1 67108864 (ref null (exact $A)))

  ;; CHECK:      (table $__asyncify_ref_table_A 1 67108864 (ref null $A))

  ;; CHECK:      (elem declare func $target)

  ;; CHECK:      (export "reference-locals" (func $reference-locals))

  ;; CHECK:      (export "funcref-local" (func $funcref-local))

