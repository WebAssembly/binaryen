;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --asyncify --all-features -S -o - | filecheck %s

;; Reference locals are spilled to one table per heap type. The initial size
;; covers the reference locals of that type that are live across calls, and the
;; table grows on unwind.
(module
  ;; CHECK:      (type $A (struct))

  ;; CHECK:      (type $1 (func))

  ;; CHECK:      (type $2 (func (result i32)))

  ;; CHECK:      (type $3 (func (param i32)))

  ;; CHECK:      (type $4 (func (result (ref func))))

  ;; CHECK:      (type $5 (func (param (ref func))))

  ;; CHECK:      (type $6 (func (param externref) (result i32)))

  ;; CHECK:      (type $7 (func (param funcref) (result i32)))

  ;; CHECK:      (type $8 (func (param (ref (exact $A)) (ref $A)) (result i32)))

  ;; CHECK:      (import "env" "unwind" (func $unwind (type $1)))
  (import "env" "unwind" (func $unwind))
  ;; CHECK:      (import "env" "get_func" (func $get_func (type $4) (result (ref func))))
  (import "env" "get_func" (func $get_func (result (ref func))))
  ;; CHECK:      (import "env" "use" (func $use (type $5) (param (ref func))))
  (import "env" "use" (func $use (param (ref func))))
  (type $A (struct))
  (memory 1)
