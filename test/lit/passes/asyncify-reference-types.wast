    (result i32)
    (local $f (ref func))
    (call $unwind)
    (local.set $f (ref.func $target))
    (call $use (local.get $f))
    (ref.is_null (local.get $f))
  )

  ;; Exact references need their own tables, since the table element type must
  ;; be exact as well.
