;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: wasm-opt %s --enable-reference-types --string-lifting -S -o - | filecheck %s

(module
  ;; CHECK:      (import "wasm:js-string" "cast" (func $cast (param externref) (result (ref extern))))
  (import "wasm:js-string" "cast" (func $cast (param externref) (result (ref extern))))

  ;; CHECK:      (func $cast_test (param $x externref) (result externref)
  ;; CHECK-NEXT:  (ref.cast (ref string)
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cast_test (param $x externref) (result externref)
    (call $cast
      (local.get $x)
    )
  )

  ;; CHECK:      (func $cast_null (result externref)
  ;; CHECK-NEXT:  (ref.cast (ref noextern)
  ;; CHECK-NEXT:   (ref.null noextern)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cast_null (result externref)
    (call $cast
      (ref.null noextern)
    )
  )

  ;; CHECK:      (func $cast_unreachable (result externref)
  ;; CHECK-NEXT:  (block ;; (replaces unreachable RefCast we can't emit)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cast_unreachable (result externref)
    (call $cast
      (unreachable)
    )
  )
)
