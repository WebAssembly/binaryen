;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; Test that --inline-max-combined-binary-size takes into account repeated
;; inlinings into a function. We can inline $A, $B, $C into $caller, but if we
;; did so with all of them, we'd end up with too large a size, so we stop after
;; $A.

;; RUN: foreach %s %t wasm-opt --inlining --inline-max-combined-binary-size=40 -S -o - | filecheck %s

;; Without a very high limit, we inline them all.

;; RUN: foreach %s %t wasm-opt --inlining --inline-max-combined-binary-size=40 -S -o - | filecheck %s --check-prefix=VHIGH

;; Ditto without a specified limit, as the default is infinity.

;; RUN: foreach %s %t wasm-opt --inlining                                      -S -o - | filecheck %s --check-prefix=VHIGH

(module
  (func $A
    ;; 10 nops
    (nop) (nop) (nop) (nop) (nop) (nop) (nop) (nop) (nop) (nop)
  )

  ;; CHECK:      (type $0 (func))

  ;; CHECK:      (func $B
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  (func $B
    (nop) (nop) (nop) (nop) (nop) (nop) (nop) (nop) (nop) (nop)
  )

  ;; CHECK:      (func $C
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  (func $C
    (nop) (nop) (nop) (nop) (nop) (nop) (nop) (nop) (nop) (nop)
  )

  ;; CHECK:      (func $caller
  ;; CHECK-NEXT:  (block $__inlined_func$A
  ;; CHECK-NEXT:   (block
  ;; CHECK-NEXT:    (nop)
  ;; CHECK-NEXT:    (nop)
  ;; CHECK-NEXT:    (nop)
  ;; CHECK-NEXT:    (nop)
  ;; CHECK-NEXT:    (nop)
  ;; CHECK-NEXT:    (nop)
  ;; CHECK-NEXT:    (nop)
  ;; CHECK-NEXT:    (nop)
  ;; CHECK-NEXT:    (nop)
  ;; CHECK-NEXT:    (nop)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $B)
  ;; CHECK-NEXT:  (call $C)
  ;; CHECK-NEXT: )
  (func $caller
    (call $A)
    (call $B)
    (call $C)
  )
)

