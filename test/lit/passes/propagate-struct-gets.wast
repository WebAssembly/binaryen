  (func $extra-local.get (result i32)
    (local $ref (ref null $struct))
    ;; An extra local.get - which is not consumed by a struct.get - stops us.
    (local.set $ref
      (struct.new $struct
        (i32.const 42)
      )
    )
    (local.set $ref
      (struct.new $struct
        (i32.const 42)
      )
    )
    (drop
      (local.get $ref)  ;; this stops us
    )
    (i32.add
      (struct.get $struct 0
        (local.get $ref)
      )
      (struct.get $struct 0
        (local.get $ref)
      )
    )
  )

