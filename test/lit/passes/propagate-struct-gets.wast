  (func $unreachable (result i32)
    ;; We ignore unreachable struct.gets code, but still optimize the rest.
    (local $ref (ref null $struct))
    (local.set $ref
      (struct.new $struct
        (i32.const 42)
      )
    )
    (local.set $ref
      (struct.new $struct
        (i32.const 42)
      )
    )
    (i32.add
      (struct.get $struct 0
        (local.get $ref)
      )
      (struct.get $struct 0
        (unreachable)
      )
    )
  )

