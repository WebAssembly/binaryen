  ;; H2L-NEXT:       )
  ;; H2L-NEXT:       (local.get $12)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (local.set $5
  ;; H2L-NEXT:      (block (result i64)
  ;; H2L-NEXT:       (drop
  ;; H2L-NEXT:        (ref.null none)
  ;; H2L-NEXT:       )
  ;; H2L-NEXT:       (local.get $14)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (local.get $4)
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (return
  ;; H2L-NEXT:    (i64.const 0)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
