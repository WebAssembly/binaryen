  ;; CHECK:      (func $no-param-value (type $9) (param $ref (ref $struct)) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $ref
  ;; CHECK-NEXT:     (struct.new $struct
  ;; CHECK-NEXT:      (i32.const 1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $ref
  ;; CHECK-NEXT:     (struct.new $struct
  ;; CHECK-NEXT:      (i32.const 2)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.get $struct 0
  ;; CHECK-NEXT:   (local.get $ref)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; H2L:      (func $no-param-value (type $7) (param $ref (ref $struct)) (param $x i32) (result i32)
  ;; H2L-NEXT:  (local $2 i32)
  ;; H2L-NEXT:  (local $3 i32)
  ;; H2L-NEXT:  (if
  ;; H2L-NEXT:   (local.get $x)
  ;; H2L-NEXT:   (then
  ;; H2L-NEXT:    (drop
  ;; H2L-NEXT:     (block (result nullref)
  ;; H2L-NEXT:      (local.set $3
  ;; H2L-NEXT:       (i32.const 1)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.set $2
  ;; H2L-NEXT:       (local.get $3)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (ref.null none)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (local.set $ref
  ;; H2L-NEXT:     (struct.new $struct
  ;; H2L-NEXT:      (i32.const 2)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (struct.get $struct 0
  ;; H2L-NEXT:   (local.get $ref)
  ;; H2L-NEXT:  )
  ;; H2L-NEXT: )
  (func $no-param-value (param $ref (ref $struct)) (param $x i32) (result i32)
    ;; Do not optimize here even though the param is non-nullable, as the param
    ;; may be used. In such cases Heap2Local will not be able to optimize
    ;; anyhow.
    (if
      (local.get $x)
      (then
        (local.set $ref
          (struct.new $struct (i32.const 1))
        )
        (local.set $ref
          (struct.new $struct (i32.const 2))
        )
      )
    )
    (struct.get $struct 0
      (local.get $ref)
    )
  )

