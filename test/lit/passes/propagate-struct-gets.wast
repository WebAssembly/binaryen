  ;; H2L-NEXT:   (return
  ;; H2L-NEXT:    (i32.const 0)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (struct.get $struct 0
  ;; H2L-NEXT:   (local.get $ref)
  ;; H2L-NEXT:  )
  ;; H2L-NEXT: )
  (func $no-project-struct-get-tee-mutable (param $s1 (ref $struct)) (param $s2 (ref $struct)) (result i32)
    ;; Do not project when tees write arbitrary struct references and the field
    ;; is mutable.
    (local $ref (ref null $struct))
    (block $err
      (br_if $err
        (struct.get $struct 0
          (local.tee $ref
            (local.get $s1)
          )
        )
      )
      (br_if $err
        (struct.get $struct 0
          (local.tee $ref
            (local.get $s2)
          )
        )
      )
      (return
        (i32.const 0)
      )
    )
    (struct.get $struct 0
      (local.get $ref)
    )
  )

  ;; CHECK:      (func $no-project-struct-get-different-fields (type $4) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (local $ref (ref null $struct-2fields))
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $ref
  ;; CHECK-NEXT:     (struct.new_default $struct-2fields)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (local.set $ref
  ;; CHECK-NEXT:     (struct.new $struct-2fields
  ;; CHECK-NEXT:      (i32.const 10)
  ;; CHECK-NEXT:      (i32.const 20)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (struct.get $struct-2fields 0
  ;; CHECK-NEXT:    (local.get $ref)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (struct.get $struct-2fields 1
  ;; CHECK-NEXT:    (local.get $ref)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; H2L:      (func $no-project-struct-get-different-fields (type $3) (param $x i32) (result i32)
  ;; H2L-NEXT:  (local $ref (ref null $struct-2fields))
  ;; H2L-NEXT:  (if
  ;; H2L-NEXT:   (local.get $x)
  ;; H2L-NEXT:   (then
  ;; H2L-NEXT:    (local.set $ref
  ;; H2L-NEXT:     (struct.new_default $struct-2fields)
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (else
  ;; H2L-NEXT:    (local.set $ref
  ;; H2L-NEXT:     (struct.new $struct-2fields
  ;; H2L-NEXT:      (i32.const 10)
  ;; H2L-NEXT:      (i32.const 20)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (i32.add
  ;; H2L-NEXT:   (struct.get $struct-2fields 0
  ;; H2L-NEXT:    (local.get $ref)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (struct.get $struct-2fields 1
  ;; H2L-NEXT:    (local.get $ref)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT: )
  (func $no-project-struct-get-different-fields (param $x i32) (result i32)
    ;; Do not project when gets of $ref read different fields (field 0 vs
    ;; field 1).
    (local $ref (ref null $struct-2fields))
    (if
      (local.get $x)
      (then
        (local.set $ref
          (struct.new_default $struct-2fields)
        )
      )
      (else
        (local.set $ref
          (struct.new $struct-2fields
            (i32.const 10)
            (i32.const 20)
          )
        )
      )
    )
    (i32.add
      (struct.get $struct-2fields 0
        (local.get $ref)
      )
      (struct.get $struct-2fields 1
        (local.get $ref)
      )
    )
  )

  ;; CHECK:      (func $project-single-set (type $9) (result i32)
  ;; CHECK-NEXT:  (local $ref (ref null $struct))
  ;; CHECK-NEXT:  (local.set $ref
  ;; CHECK-NEXT:   (struct.new $struct
  ;; CHECK-NEXT:    (i32.const 42)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (struct.get $struct 0
  ;; CHECK-NEXT:    (local.get $ref)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (struct.get $struct 0
  ;; CHECK-NEXT:    (local.get $ref)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; H2L:      (func $project-single-set (type $9) (result i32)
  ;; H2L-NEXT:  (local $ref (ref null $struct))
  ;; H2L-NEXT:  (local $1 i32)
  ;; H2L-NEXT:  (local $2 i32)
  ;; H2L-NEXT:  (drop
  ;; H2L-NEXT:   (block (result nullref)
  ;; H2L-NEXT:    (local.set $2
  ;; H2L-NEXT:     (i32.const 42)
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (local.set $1
  ;; H2L-NEXT:     (local.get $2)
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (ref.null none)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (i32.add
  ;; H2L-NEXT:   (block (result i32)
  ;; H2L-NEXT:    (drop
  ;; H2L-NEXT:     (ref.null none)
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (local.get $1)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (block (result i32)
  ;; H2L-NEXT:    (drop
  ;; H2L-NEXT:     (ref.null none)
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (local.get $1)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT: )
  (func $project-single-set (result i32)
    ;; We leave a single local.set for Heap2Local (that situation has no
    ;; overlapping live ranges etc.), and do not optimize.
    (local $ref (ref null $struct))
    (local.set $ref
      (struct.new $struct
        (i32.const 42)
      )
    )
    (i32.add
      (struct.get $struct 0
        (local.get $ref)
      )
      (struct.get $struct 0
        (local.get $ref)
      )
    )
  )
)
