;; NOTE: Assertions have been generated by update_lit_checks.py and should not be edited.

;; Test the pass by itself, and also followed up by Heap2Local, to verify that
;; we emit things Heap2Local can handle.

;; RUN: foreach %s %t wasm-opt --propagate-struct-gets -all -S -o - | filecheck %s
;; RUN: foreach %s %t wasm-opt --propagate-struct-gets --heap2local -all -S -o - | filecheck %s --check-prefix=H2L

(module
  ;; CHECK:      (type $struct (struct (field (mut i32))))
  ;; H2L:      (type $struct (struct (field (mut i32))))
  (type $struct (struct (field (mut i32))))

  (type $struct-3fields-mixed (struct (field i32) (field (mut i32)) (field i64)))

  (type $struct-nn-ref (struct (field (ref struct))))

  ;; CHECK:      (type $struct-immutable (struct (field i32)))
  ;; H2L:      (type $struct-immutable (struct (field i32)))
  (type $struct-immutable (struct (field i32)))

  ;; CHECK:      (type $struct-2fields (struct (field i32) (field i32)))
  ;; H2L:      (type $struct-2fields (struct (field i32) (field i32)))
  (type $struct-2fields (struct (field i32) (field i32)))

  ;; CHECK:      (type $struct-packed (struct (field i8) (field i16)))
  ;; H2L:      (type $struct-packed (struct (field i8) (field i16)))
  (type $struct-packed (struct (field i8) (field i16)))

  ;; CHECK:      (type $super (sub (struct (field i32))))
  ;; H2L:      (type $super (sub (struct (field i32))))
  (type $super (sub (struct (field i32))))

  ;; CHECK:      (type $sub (sub $super (struct (field i32))))
  (type $sub (sub $super (struct (field i32))))

  ;; CHECK:      (tag $tag (type $7) (param i32))
  ;; H2L:      (tag $tag (type $4) (param i32))
  (tag $tag (param i32))

  ;; CHECK:      (func $optimize-struct-get-if (type $6) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (local $ref (ref null $struct))
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $ref
  ;; CHECK-NEXT:     (struct.new_default $struct)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (struct.get $struct 0
  ;; CHECK-NEXT:      (local.get $ref)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (local.set $ref
  ;; CHECK-NEXT:     (struct.new $struct
  ;; CHECK-NEXT:      (i32.const 42)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (struct.get $struct 0
  ;; CHECK-NEXT:      (local.get $ref)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $2)
  ;; CHECK-NEXT: )
  ;; H2L:      (func $optimize-struct-get-if (type $3) (param $x i32) (result i32)
  ;; H2L-NEXT:  (local $ref (ref null $struct))
  ;; H2L-NEXT:  (local $2 i32)
  ;; H2L-NEXT:  (local $3 i32)
  ;; H2L-NEXT:  (local $4 i32)
  ;; H2L-NEXT:  (local $5 i32)
  ;; H2L-NEXT:  (if
  ;; H2L-NEXT:   (local.get $x)
  ;; H2L-NEXT:   (then
  ;; H2L-NEXT:    (drop
  ;; H2L-NEXT:     (block (result nullref)
  ;; H2L-NEXT:      (local.set $3
  ;; H2L-NEXT:       (i32.const 0)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (ref.null none)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (local.set $2
  ;; H2L-NEXT:     (block (result i32)
  ;; H2L-NEXT:      (drop
  ;; H2L-NEXT:       (ref.null none)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.get $3)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (else
  ;; H2L-NEXT:    (drop
  ;; H2L-NEXT:     (block (result nullref)
  ;; H2L-NEXT:      (local.set $5
  ;; H2L-NEXT:       (i32.const 42)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.set $4
  ;; H2L-NEXT:       (local.get $5)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (ref.null none)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (local.set $2
  ;; H2L-NEXT:     (block (result i32)
  ;; H2L-NEXT:      (drop
  ;; H2L-NEXT:       (ref.null none)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.get $4)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (local.get $2)
  ;; H2L-NEXT: )
  (func $optimize-struct-get-if (param $x i32) (result i32)
    ;; Even when the field is mutable, we can optimize $ref to an i32 local
    ;; holding field 0 because every set is a fresh struct.new and every get
    ;; reads field 0. Heap2Local can then eliminate both allocations.
    (local $ref (ref null $struct))
    (if
      (local.get $x)
      (then
        (local.set $ref
          (struct.new_default $struct)
        )
      )
      (else
        (local.set $ref
          (struct.new $struct
            (i32.const 42)
          )
        )
      )
    )
    (struct.get $struct 0
      (local.get $ref)
    )
  )

  ;; CHECK:      (func $no-optimize-struct-get-uninitialized (type $8) (param $x i32) (param $y i32) (result i32)
  ;; CHECK-NEXT:  (local $ref (ref null $struct))
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (if
  ;; CHECK-NEXT:     (local.get $y)
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (local.set $ref
  ;; CHECK-NEXT:       (struct.new_default $struct)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (else
  ;; CHECK-NEXT:      (local.set $ref
  ;; CHECK-NEXT:       (struct.new $struct
  ;; CHECK-NEXT:        (i32.const 42)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.get $struct 0
  ;; CHECK-NEXT:   (local.get $ref)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; H2L:      (func $no-optimize-struct-get-uninitialized (type $5) (param $x i32) (param $y i32) (result i32)
  ;; H2L-NEXT:  (local $ref (ref null $struct))
  ;; H2L-NEXT:  (if
  ;; H2L-NEXT:   (local.get $x)
  ;; H2L-NEXT:   (then
  ;; H2L-NEXT:    (if
  ;; H2L-NEXT:     (local.get $y)
  ;; H2L-NEXT:     (then
  ;; H2L-NEXT:      (local.set $ref
  ;; H2L-NEXT:       (struct.new_default $struct)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (else
  ;; H2L-NEXT:      (local.set $ref
  ;; H2L-NEXT:       (struct.new $struct
  ;; H2L-NEXT:        (i32.const 42)
  ;; H2L-NEXT:       )
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (struct.get $struct 0
  ;; H2L-NEXT:   (local.get $ref)
  ;; H2L-NEXT:  )
  ;; H2L-NEXT: )
  (func $no-optimize-struct-get-uninitialized (param $x i32) (param $y i32) (result i32)
    ;; Similar to $optimize-struct-get-if, but $ref is not initialized on all
    ;; paths reaching the struct.get, so it can be null and trap. Do not optimize
    ;; to an i32 local, which would not trap.
    (local $ref (ref null $struct))
    (if
      (local.get $x)
      (then
        (if
          (local.get $y)
          (then
            (local.set $ref
              (struct.new_default $struct)
            )
          )
          (else
            (local.set $ref
              (struct.new $struct
                (i32.const 42)
              )
            )
          )
        )
      )
    )
    (struct.get $struct 0
      (local.get $ref)
    )
  )

