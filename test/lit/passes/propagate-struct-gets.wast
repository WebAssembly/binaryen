  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; H2L:      (func $no-project-struct-get-uninitialized (type $4) (param $x i32) (param $y i32) (result i32)
  ;; H2L-NEXT:  (local $ref (ref null $struct))
  ;; H2L-NEXT:  (if
  ;; H2L-NEXT:   (local.get $x)
  ;; H2L-NEXT:   (then
  ;; H2L-NEXT:    (if
  ;; H2L-NEXT:     (local.get $y)
  ;; H2L-NEXT:     (then
  ;; H2L-NEXT:      (local.set $ref
  ;; H2L-NEXT:       (struct.new_default $struct)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (else
  ;; H2L-NEXT:      (local.set $ref
  ;; H2L-NEXT:       (struct.new $struct
  ;; H2L-NEXT:        (i32.const 42)
  ;; H2L-NEXT:       )
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (struct.get $struct 0
  ;; H2L-NEXT:   (local.get $ref)
  ;; H2L-NEXT:  )
  ;; H2L-NEXT: )
  (func $no-project-struct-get-uninitialized (param $x i32) (param $y i32) (result i32)
    ;; Similar to $project-struct-get-if, but $ref is not initialized on all
    ;; paths reaching the struct.get, so it can be null and trap. Do not project
    ;; to an i32 local, which would not trap.
    (local $ref (ref null $struct))
    (if
      (local.get $x)
      (then
        (if
          (local.get $y)
          (then
            (local.set $ref
              (struct.new_default $struct)
            )
          )
          (else
            (local.set $ref
              (struct.new $struct
                (i32.const 42)
              )
            )
          )
        )
      )
    )
    (struct.get $struct 0
      (local.get $ref)
    )
  )

  ;; CHECK:      (func $project-struct-get-tee-immutable (type $5) (param $x i32) (param $y i32) (result i32)
  ;; CHECK-NEXT:  (local $cur (ref $struct-immutable))
  ;; CHECK-NEXT:  (local $ref (ref null $struct-immutable))
  ;; CHECK-NEXT:  (local $4 i32)
  ;; CHECK-NEXT:  (block $err
  ;; CHECK-NEXT:   (local.set $cur
  ;; CHECK-NEXT:    (struct.new $struct-immutable
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (br_if $err
  ;; CHECK-NEXT:    (local.tee $4
  ;; CHECK-NEXT:     (struct.get $struct-immutable 0
  ;; CHECK-NEXT:      (local.get $cur)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.set $cur
  ;; CHECK-NEXT:    (struct.new $struct-immutable
  ;; CHECK-NEXT:     (local.get $y)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (br_if $err
  ;; CHECK-NEXT:    (local.tee $4
  ;; CHECK-NEXT:     (struct.get $struct-immutable 0
  ;; CHECK-NEXT:      (local.get $cur)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (return
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $4)
  ;; CHECK-NEXT: )
  ;; H2L:      (func $project-struct-get-tee-immutable (type $4) (param $x i32) (param $y i32) (result i32)
  ;; H2L-NEXT:  (local $cur (ref $struct-immutable))
  ;; H2L-NEXT:  (local $ref (ref null $struct-immutable))
  ;; H2L-NEXT:  (local $4 i32)
  ;; H2L-NEXT:  (local $5 i32)
  ;; H2L-NEXT:  (local $6 i32)
  ;; H2L-NEXT:  (local $7 i32)
  ;; H2L-NEXT:  (local $8 i32)
  ;; H2L-NEXT:  (block $err
  ;; H2L-NEXT:   (drop
  ;; H2L-NEXT:    (block (result nullref)
  ;; H2L-NEXT:     (local.set $6
  ;; H2L-NEXT:      (local.get $x)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (local.set $5
  ;; H2L-NEXT:      (local.get $6)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (ref.null none)
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (br_if $err
  ;; H2L-NEXT:    (local.tee $4
  ;; H2L-NEXT:     (block (result i32)
  ;; H2L-NEXT:      (drop
  ;; H2L-NEXT:       (ref.null none)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.get $5)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (drop
  ;; H2L-NEXT:    (block (result nullref)
  ;; H2L-NEXT:     (local.set $8
  ;; H2L-NEXT:      (local.get $y)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (local.set $7
  ;; H2L-NEXT:      (local.get $8)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (ref.null none)
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (br_if $err
  ;; H2L-NEXT:    (local.tee $4
  ;; H2L-NEXT:     (block (result i32)
  ;; H2L-NEXT:      (drop
  ;; H2L-NEXT:       (ref.null none)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.get $7)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (return
  ;; H2L-NEXT:    (i32.const 0)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (local.get $4)
  ;; H2L-NEXT: )
  (func $project-struct-get-tee-immutable (param $x i32) (param $y i32) (result i32)
    ;; Two independent allocations in $cur are tee'd into a shared local $ref
    ;; inside struct.get of an immutable field before branching to a shared
    ;; block that reads the same field from $ref. Projecting $ref to an i32
    ;; local disentangles the two allocations so Heap2Local can optimize both.
    (local $cur (ref $struct-immutable))
    (local $ref (ref null $struct-immutable))
    (block $err
      (local.set $cur
        (struct.new $struct-immutable
          (local.get $x)
        )
      )
      (br_if $err
        (struct.get $struct-immutable 0
          (local.tee $ref
            (local.get $cur)
          )
        )
      )
      (local.set $cur
        (struct.new $struct-immutable
          (local.get $y)
        )
      )
      (br_if $err
        (struct.get $struct-immutable 0
          (local.tee $ref
            (local.get $cur)
          )
        )
      )
      (return
        (i32.const 0)
      )
    )
    (struct.get $struct-immutable 0
      (local.get $ref)
    )
  )

  ;; CHECK:      (func $project-struct-get-tee-immutable-nn-ref (type $7) (param $x i32) (param $b1 (ref $struct-nn-ref)) (param $b2 (ref $struct-nn-ref)) (result (ref struct))
  ;; CHECK-NEXT:  (local $ref (ref null $struct-nn-ref))
  ;; CHECK-NEXT:  (local $4 structref)
  ;; CHECK-NEXT:  (block $err
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.as_non_null
  ;; CHECK-NEXT:     (local.tee $4
  ;; CHECK-NEXT:      (struct.get $struct-nn-ref 0
  ;; CHECK-NEXT:       (local.get $b1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (br_if $err
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.as_non_null
  ;; CHECK-NEXT:     (local.tee $4
  ;; CHECK-NEXT:      (struct.get $struct-nn-ref 0
  ;; CHECK-NEXT:       (local.get $b2)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (br_if $err
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.as_non_null
  ;; CHECK-NEXT:   (local.get $4)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; H2L:      (func $project-struct-get-tee-immutable-nn-ref (type $7) (param $x i32) (param $b1 (ref $struct-nn-ref)) (param $b2 (ref $struct-nn-ref)) (result (ref struct))
  ;; H2L-NEXT:  (local $ref (ref null $struct-nn-ref))
  ;; H2L-NEXT:  (local $4 structref)
  ;; H2L-NEXT:  (block $err
  ;; H2L-NEXT:   (drop
  ;; H2L-NEXT:    (ref.as_non_null
  ;; H2L-NEXT:     (local.tee $4
  ;; H2L-NEXT:      (struct.get $struct-nn-ref 0
  ;; H2L-NEXT:       (local.get $b1)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (br_if $err
  ;; H2L-NEXT:    (local.get $x)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (drop
  ;; H2L-NEXT:    (ref.as_non_null
  ;; H2L-NEXT:     (local.tee $4
  ;; H2L-NEXT:      (struct.get $struct-nn-ref 0
  ;; H2L-NEXT:       (local.get $b2)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (br_if $err
  ;; H2L-NEXT:    (local.get $x)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (unreachable)
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (ref.as_non_null
  ;; H2L-NEXT:   (local.get $4)
  ;; H2L-NEXT:  )
  ;; H2L-NEXT: )
  (func $project-struct-get-tee-immutable-nn-ref (param $x i32) (param $b1 (ref $struct-nn-ref)) (param $b2 (ref $struct-nn-ref)) (result (ref struct))
    ;; As above, but the immutable field has a non-nullable reference type
    ;; ((ref struct)). The projected local uses a nullable type with
    ;; ref.as_non_null on the tees and get so validation succeeds across blocks.
    (local $ref (ref null $struct-nn-ref))
    (block $err
      (drop
        (struct.get $struct-nn-ref 0
          (local.tee $ref
            (local.get $b1)
          )
        )
      )
      (br_if $err
        (local.get $x)
      )
      (drop
        (struct.get $struct-nn-ref 0
          (local.tee $ref
            (local.get $b2)
          )
        )
      )
      (br_if $err
        (local.get $x)
      )
      (unreachable)
    )
    (struct.get $struct-nn-ref 0
      (local.get $ref)
    )
  )

