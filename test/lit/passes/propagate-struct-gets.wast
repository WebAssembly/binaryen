  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (br_if $err
  ;; CHECK-NEXT:    (struct.get $struct 0
  ;; CHECK-NEXT:     (local.tee $ref
  ;; CHECK-NEXT:      (local.get $s2)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (return
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.get $struct 0
  ;; CHECK-NEXT:   (local.get $ref)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; H2L:      (func $no-optimize-struct-get-tee-mutable (type $8) (param $s1 (ref $struct)) (param $s2 (ref $struct)) (result i32)
  ;; H2L-NEXT:  (local $ref (ref null $struct))
  ;; H2L-NEXT:  (block $err
  ;; H2L-NEXT:   (br_if $err
  ;; H2L-NEXT:    (struct.get $struct 0
  ;; H2L-NEXT:     (local.tee $ref
  ;; H2L-NEXT:      (local.get $s1)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (br_if $err
  ;; H2L-NEXT:    (struct.get $struct 0
  ;; H2L-NEXT:     (local.tee $ref
  ;; H2L-NEXT:      (local.get $s2)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (return
  ;; H2L-NEXT:    (i32.const 0)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (struct.get $struct 0
  ;; H2L-NEXT:   (local.get $ref)
  ;; H2L-NEXT:  )
  ;; H2L-NEXT: )
  (func $no-optimize-struct-get-tee-mutable (param $s1 (ref $struct)) (param $s2 (ref $struct)) (result i32)
    ;; Do not optimize when tees write arbitrary struct references and the field
    ;; is mutable: the references may be modified by something else with a
    ;; reference.
    (local $ref (ref null $struct))
    (block $err
      (br_if $err
        (struct.get $struct 0
          (local.tee $ref
            (local.get $s1)
          )
        )
      )
      (br_if $err
        (struct.get $struct 0
          (local.tee $ref
            (local.get $s2)
          )
        )
      )
      (return
        (i32.const 0)
      )
    )
    (struct.get $struct 0
      (local.get $ref)
    )
  )

