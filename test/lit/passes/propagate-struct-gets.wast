  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (local.set $2
  ;; H2L-NEXT:    (block (result i32)
  ;; H2L-NEXT:     (drop
  ;; H2L-NEXT:      (ref.null none)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (local.get $3)
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (if
  ;; H2L-NEXT:   (local.get $x)
  ;; H2L-NEXT:   (then
  ;; H2L-NEXT:    (drop
  ;; H2L-NEXT:     (block (result nullref)
  ;; H2L-NEXT:      (local.set $6
  ;; H2L-NEXT:       (i32.const 2)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.set $5
  ;; H2L-NEXT:       (local.get $6)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (ref.null none)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (local.set $2
  ;; H2L-NEXT:     (block (result i32)
  ;; H2L-NEXT:      (drop
  ;; H2L-NEXT:       (ref.null none)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.get $5)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (local.get $2)
  ;; H2L-NEXT: )
  (func $yes-overwritten-param-value (param $ref (ref $struct)) (param $x i32) (result i32)
    ;; As above, but the param is overwritten, and never used. We can optimize.
    ;; That is, this checks that we can optimize a param and not just a var.
    (local.set $ref
      (struct.new $struct (i32.const 1))
    )
    (if
      (local.get $x)
      (then
        (local.set $ref
          (struct.new $struct (i32.const 2))
        )
      )
    )
    (struct.get $struct 0
      (local.get $ref)
    )
  )

