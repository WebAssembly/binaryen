  ;; CHECK-NEXT:   (catch $tag
  ;; CHECK-NEXT:    (block
  ;; CHECK-NEXT:     (local.set $ref
  ;; CHECK-NEXT:      (struct.new $struct
  ;; CHECK-NEXT:       (pop i32)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (local.set $2
  ;; CHECK-NEXT:      (struct.get $struct 0
  ;; CHECK-NEXT:       (local.get $ref)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (nop)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $2)
  ;; CHECK-NEXT: )
  ;; H2L:      (func $try-pop (type $3) (param $x i32) (result i32)
  ;; H2L-NEXT:  (local $ref (ref null $struct))
  ;; H2L-NEXT:  (local $2 i32)
  ;; H2L-NEXT:  (local $3 i32)
  ;; H2L-NEXT:  (local $4 i32)
  ;; H2L-NEXT:  (local $5 i32)
  ;; H2L-NEXT:  (local $6 i32)
  ;; H2L-NEXT:  (local $7 i32)
  ;; H2L-NEXT:  (block
  ;; H2L-NEXT:   (drop
  ;; H2L-NEXT:    (block (result nullref)
  ;; H2L-NEXT:     (local.set $3
  ;; H2L-NEXT:      (i32.const 0)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (ref.null none)
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (local.set $2
  ;; H2L-NEXT:    (block (result i32)
  ;; H2L-NEXT:     (drop
  ;; H2L-NEXT:      (ref.null none)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (local.get $3)
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (try
  ;; H2L-NEXT:   (do
  ;; H2L-NEXT:    (drop
  ;; H2L-NEXT:     (block (result nullref)
  ;; H2L-NEXT:      (local.set $5
  ;; H2L-NEXT:       (i32.const 42)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.set $4
  ;; H2L-NEXT:       (local.get $5)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (ref.null none)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (local.set $2
  ;; H2L-NEXT:     (block (result i32)
  ;; H2L-NEXT:      (drop
  ;; H2L-NEXT:       (ref.null none)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.get $4)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (catch $tag
  ;; H2L-NEXT:    (block
  ;; H2L-NEXT:     (drop
  ;; H2L-NEXT:      (block (result nullref)
  ;; H2L-NEXT:       (local.set $7
  ;; H2L-NEXT:        (pop i32)
  ;; H2L-NEXT:       )
  ;; H2L-NEXT:       (local.set $6
  ;; H2L-NEXT:        (local.get $7)
  ;; H2L-NEXT:       )
  ;; H2L-NEXT:       (ref.null none)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (local.set $2
  ;; H2L-NEXT:      (block (result i32)
  ;; H2L-NEXT:       (drop
  ;; H2L-NEXT:        (ref.null none)
  ;; H2L-NEXT:       )
  ;; H2L-NEXT:       (local.get $6)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (nop)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (local.get $2)
  ;; H2L-NEXT: )
  (func $try-pop (param $x i32) (result i32)
    ;; After we optimize here, a pop is inside an unnamed block (which is ok).
    (local $ref (ref null $struct))
    (local.set $ref
      (struct.new_default $struct)
    )
    (try
      (do
        (local.set $ref
          (struct.new $struct
            (i32.const 42)
          )
        )
      )
      (catch $tag
        (local.set $ref
          (struct.new $struct
            (pop i32)
          )
        )
        (nop) ;; add a second instruction so that there is a block here,
              ;; which forces the fixup
      )
    )
    (struct.get $struct 0
      (local.get $ref)
    )
  )

  ;; CHECK:      (func $nullref (type $3) (result i32)
  ;; CHECK-NEXT:  (local $ref nullref)
  ;; CHECK-NEXT:  (local.set $ref
  ;; CHECK-NEXT:   (ref.null none)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $ref
  ;; CHECK-NEXT:   (ref.null none)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block ;; (replaces unreachable StructGet we can't emit)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (local.get $ref)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; H2L:      (func $nullref (type $2) (result i32)
  ;; H2L-NEXT:  (local $ref nullref)
  ;; H2L-NEXT:  (local.set $ref
  ;; H2L-NEXT:   (ref.null none)
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (local.set $ref
  ;; H2L-NEXT:   (ref.null none)
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (block ;; (replaces unreachable StructGet we can't emit)
  ;; H2L-NEXT:   (drop
  ;; H2L-NEXT:    (local.get $ref)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (unreachable)
  ;; H2L-NEXT:  )
  ;; H2L-NEXT: )
  (func $nullref (result i32)
    ;; We should ignore struct.get operations on a nullref. We only optimize
    ;; locals with struct types.
    (local $ref nullref)
    (local.set $ref
      (ref.null none)
    )
    (local.set $ref
      (ref.null none)
    )
    (struct.get $struct 0
      (local.get $ref)
    )
  )

