  ;; H2L:      (func $optimize-struct-get-tee-immutable (type $4) (param $x i32) (param $y i32) (result i32)
  ;; H2L-NEXT:  (local $curr (ref $struct-immutable))
  ;; H2L-NEXT:  (local $ref (ref null $struct-immutable))
  ;; H2L-NEXT:  (local $4 i32)
