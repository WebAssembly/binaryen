;; NOTE: Assertions have been generated by update_lit_checks.py and should not be edited.

;; RUN: wasm-opt %s --propagate-struct-gets -all -S -o - | filecheck %s
;; RUN: wasm-opt %s --propagate-struct-gets --heap2local -all -S -o - | filecheck %s --check-prefix=H2L

