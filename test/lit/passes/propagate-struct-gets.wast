  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $2)
  ;; CHECK-NEXT: )
  ;; H2L:      (func $project-struct-get-if (type $3) (param $x i32) (result i32)
  ;; H2L-NEXT:  (local $ref (ref null $struct))
  ;; H2L-NEXT:  (local $2 i32)
  ;; H2L-NEXT:  (local $3 i32)
  ;; H2L-NEXT:  (local $4 i32)
  ;; H2L-NEXT:  (local $5 i32)
  ;; H2L-NEXT:  (if
  ;; H2L-NEXT:   (local.get $x)
  ;; H2L-NEXT:   (then
  ;; H2L-NEXT:    (local.set $2
  ;; H2L-NEXT:     (block (result i32)
  ;; H2L-NEXT:      (drop
  ;; H2L-NEXT:       (block (result nullref)
  ;; H2L-NEXT:        (local.set $3
  ;; H2L-NEXT:         (i32.const 0)
  ;; H2L-NEXT:        )
  ;; H2L-NEXT:        (ref.null none)
  ;; H2L-NEXT:       )
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.get $3)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (else
  ;; H2L-NEXT:    (local.set $2
  ;; H2L-NEXT:     (block (result i32)
  ;; H2L-NEXT:      (drop
  ;; H2L-NEXT:       (block (result nullref)
  ;; H2L-NEXT:        (local.set $5
  ;; H2L-NEXT:         (i32.const 42)
  ;; H2L-NEXT:        )
  ;; H2L-NEXT:        (local.set $4
  ;; H2L-NEXT:         (local.get $5)
  ;; H2L-NEXT:        )
  ;; H2L-NEXT:        (ref.null none)
  ;; H2L-NEXT:       )
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.get $4)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (local.get $2)
  ;; H2L-NEXT: )
  (func $project-struct-get-if (param $x i32) (result i32)
    ;; Even when the field is mutable, we can project $ref to an i32 local
    ;; holding field 0 because every set is a fresh struct.new and every get
    ;; reads field 0. Heap2Local can then eliminate both allocations.
    (local $ref (ref null $struct))
    (if
      (local.get $x)
      (then
        (local.set $ref
          (struct.new_default $struct)
        )
      )
      (else
        (local.set $ref
          (struct.new $struct
            (i32.const 42)
          )
        )
      )
    )
    (struct.get $struct 0
      (local.get $ref)
    )
  )

  ;; CHECK:      (func $sink-struct-get-if (type $4) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (if (result i32)
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (struct.get $struct 0
  ;; CHECK-NEXT:     (struct.new_default $struct)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (struct.get $struct 0
  ;; CHECK-NEXT:     (struct.new $struct
  ;; CHECK-NEXT:      (i32.const 42)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; H2L:      (func $sink-struct-get-if (type $3) (param $x i32) (result i32)
  ;; H2L-NEXT:  (local $1 i32)
  ;; H2L-NEXT:  (local $2 i32)
  ;; H2L-NEXT:  (local $3 i32)
  ;; H2L-NEXT:  (if (result i32)
  ;; H2L-NEXT:   (local.get $x)
  ;; H2L-NEXT:   (then
  ;; H2L-NEXT:    (drop
  ;; H2L-NEXT:     (block (result nullref)
  ;; H2L-NEXT:      (local.set $1
  ;; H2L-NEXT:       (i32.const 0)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (ref.null none)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (local.get $1)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (else
  ;; H2L-NEXT:    (drop
  ;; H2L-NEXT:     (block (result nullref)
  ;; H2L-NEXT:      (local.set $3
  ;; H2L-NEXT:       (i32.const 42)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.set $2
  ;; H2L-NEXT:       (local.get $3)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (ref.null none)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (local.get $2)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT: )
  (func $sink-struct-get-if (param $x i32) (result i32)
    ;; A struct.get directly consuming an if that allocates structs in its arms
    ;; should be sunk into the arms so Heap2Local can eliminate both
    ;; allocations.
    (struct.get $struct 0
      (if (result (ref $struct))
        (local.get $x)
        (then
          (struct.new_default $struct)
        )
        (else
          (struct.new $struct
            (i32.const 42)
          )
        )
      )
    )
  )

  ;; CHECK:      (func $no-sink-struct-get-if-no-alloc (type $6) (param $x i32) (param $s1 (ref $struct)) (param $s2 (ref $struct)) (result i32)
  ;; CHECK-NEXT:  (struct.get $struct 0
  ;; CHECK-NEXT:   (if (result (ref $struct))
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (local.get $s1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (else
  ;; CHECK-NEXT:     (local.get $s2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; H2L:      (func $no-sink-struct-get-if-no-alloc (type $6) (param $x i32) (param $s1 (ref $struct)) (param $s2 (ref $struct)) (result i32)
  ;; H2L-NEXT:  (struct.get $struct 0
  ;; H2L-NEXT:   (if (result (ref $struct))
  ;; H2L-NEXT:    (local.get $x)
  ;; H2L-NEXT:    (then
  ;; H2L-NEXT:     (local.get $s1)
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (else
  ;; H2L-NEXT:     (local.get $s2)
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT: )
  (func $no-sink-struct-get-if-no-alloc (param $x i32) (param $s1 (ref $struct)) (param $s2 (ref $struct)) (result i32)
    ;; Do not sink struct.get into an if when neither arm allocates a struct.new.
    (struct.get $struct 0
      (if (result (ref $struct))
        (local.get $x)
        (then
          (local.get $s1)
        )
        (else
          (local.get $s2)
        )
      )
    )
  )

  ;; CHECK:      (func $no-project-struct-get-uninitialized (type $5) (param $x i32) (param $y i32) (result i32)
  ;; CHECK-NEXT:  (local $ref (ref null $struct))
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (if
  ;; CHECK-NEXT:     (local.get $y)
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (local.set $ref
  ;; CHECK-NEXT:       (struct.new_default $struct)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (else
  ;; CHECK-NEXT:      (local.set $ref
  ;; CHECK-NEXT:       (struct.new $struct
  ;; CHECK-NEXT:        (i32.const 42)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.get $struct 0
