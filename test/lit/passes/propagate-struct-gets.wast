  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (ref.null none)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (local.set $2
  ;; H2L-NEXT:     (block (result i32)
  ;; H2L-NEXT:      (drop
  ;; H2L-NEXT:       (ref.null none)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.get $4)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (drop
  ;; H2L-NEXT:   (struct.get $struct 0
  ;; H2L-NEXT:    (call $get-struct)
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (local.get $2)
  ;; H2L-NEXT: )
  (func $struct.get-unknown-child (param $x i32) (result i32)
    (local $ref (ref null $struct))
    ;; We can optimize here, and do not error on an extra struct.get with no
    ;; relevant child.
    (local.set $ref
      (struct.new_default $struct)
    )
    (if
      (local.get $x)
      (then
        (local.set $ref
          (struct.new $struct
            (i32.const 42)
          )
        )
      )
    )
    (drop
      (struct.get $struct 0
        (call $get-struct)   ;; this child is not a local.tee or a local.get
      )
    )
    (struct.get $struct 0
      (local.get $ref)
    )
  )

  ;; CHECK:      (func $get-struct (type $15) (result (ref $struct))
  ;; CHECK-NEXT:  (struct.new_default $struct)
  ;; CHECK-NEXT: )
  ;; H2L:      (func $get-struct (type $14) (result (ref $struct))
  ;; H2L-NEXT:  (struct.new_default $struct)
  ;; H2L-NEXT: )
  (func $get-struct (result (ref $struct))
    (struct.new_default $struct)
  )
)

;; Shared data is optimizable too.
(module
  ;; CHECK:      (type $struct-mut (shared (struct (field (mut i32)))))

  ;; CHECK:      (type $struct (shared (struct (field i32))))
  ;; H2L:      (type $struct (shared (struct (field i32))))
  (type $struct (shared (struct (field i32))))

  ;; H2L:      (type $struct-mut (shared (struct (field (mut i32)))))
  (type $struct-mut (shared (struct (field (mut i32)))))

  ;; CHECK:      (func $struct.get-atomic (type $2) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (local $ref (ref null $struct-mut))
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (local.set $ref
  ;; CHECK-NEXT:    (struct.new_default $struct-mut)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.set $2
  ;; CHECK-NEXT:    (struct.get $struct-mut 0
  ;; CHECK-NEXT:     (local.get $ref)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $ref
  ;; CHECK-NEXT:     (struct.new $struct-mut
  ;; CHECK-NEXT:      (i32.const 42)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (struct.get $struct-mut 0
  ;; CHECK-NEXT:      (local.get $ref)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $2)
  ;; CHECK-NEXT: )
  ;; H2L:      (func $struct.get-atomic (type $2) (param $x i32) (result i32)
  ;; H2L-NEXT:  (local $ref (ref null $struct-mut))
  ;; H2L-NEXT:  (local $2 i32)
  ;; H2L-NEXT:  (local $3 i32)
  ;; H2L-NEXT:  (local $4 i32)
  ;; H2L-NEXT:  (local $5 i32)
  ;; H2L-NEXT:  (block
  ;; H2L-NEXT:   (drop
  ;; H2L-NEXT:    (block (result (ref null (shared none)))
  ;; H2L-NEXT:     (local.set $3
  ;; H2L-NEXT:      (i32.const 0)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (ref.null (shared none))
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (local.set $2
  ;; H2L-NEXT:    (block (result i32)
  ;; H2L-NEXT:     (drop
  ;; H2L-NEXT:      (ref.null (shared none))
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (local.get $3)
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (if
  ;; H2L-NEXT:   (local.get $x)
  ;; H2L-NEXT:   (then
  ;; H2L-NEXT:    (drop
  ;; H2L-NEXT:     (block (result (ref null (shared none)))
  ;; H2L-NEXT:      (local.set $5
  ;; H2L-NEXT:       (i32.const 42)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.set $4
  ;; H2L-NEXT:       (local.get $5)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (ref.null (shared none))
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:    (local.set $2
  ;; H2L-NEXT:     (block (result i32)
  ;; H2L-NEXT:      (drop
  ;; H2L-NEXT:       (ref.null (shared none))
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:      (local.get $4)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (local.get $2)
  ;; H2L-NEXT: )
  (func $struct.get-atomic (param $x i32) (result i32)
    (local $ref (ref null $struct-mut))
    ;; That the data is shared and accessed atomically is not a problem: while
    ;; the field is mutable, we see all the allocations.
    (local.set $ref
      (struct.new_default $struct-mut)
    )
    (if
      (local.get $x)
      (then
        (local.set $ref
          (struct.new $struct-mut
            (i32.const 42)
          )
        )
      )
    )
    (struct.atomic.get acqrel $struct-mut 0
      (local.get $ref)
    )
  )


  ;; CHECK:      (func $no-allocations (type $5) (param $param (ref $struct)) (result i32)
  ;; CHECK-NEXT:  (local $ref (ref $struct))
  ;; CHECK-NEXT:  (local.set $ref
  ;; CHECK-NEXT:   (local.get $param)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $ref
  ;; CHECK-NEXT:   (local.get $param)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.get $struct 0
  ;; CHECK-NEXT:   (local.get $ref)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; H2L:      (func $no-allocations (type $5) (param $param (ref $struct)) (result i32)
  ;; H2L-NEXT:  (local $ref (ref $struct))
  ;; H2L-NEXT:  (local.set $ref
  ;; H2L-NEXT:   (local.get $param)
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (local.set $ref
  ;; H2L-NEXT:   (local.get $param)
  ;; H2L-NEXT:  )
  ;; H2L-NEXT:  (struct.get $struct 0
  ;; H2L-NEXT:   (local.get $ref)
  ;; H2L-NEXT:  )
  ;; H2L-NEXT: )
  (func $no-allocations (param $param (ref $struct)) (result i32)
    ;; We do not optimize when there are no allocations, as then Heap2Local has
    ;; no optimization to do afterwards. Even two local.sets is not enough.
    (local $ref (ref $struct))
    (local.set $ref
      (local.get $param)
    )
    (local.set $ref
      (local.get $param)
    )
    (struct.get $struct 0
      (local.get $ref)
    )
  )
)

