  ;; H2L-NEXT:    )
  ;; H2L-NEXT:   )
  ;; H2L-NEXT:   (br_if $err
  ;; H2L-NEXT:    (block (result i32)
  ;; H2L-NEXT:     (drop
  ;; H2L-NEXT:      (ref.null none)
  ;; H2L-NEXT:     )
  ;; H2L-NEXT:     (local.set $4
  ;; H2L-NEXT:      (block (result i32)
  ;; H2L-NEXT:       (drop
  ;; H2L-NEXT:        (ref.null none)
  ;; H2L-NEXT:       )
  ;; H2L-NEXT:       (local.get $5)
  ;; H2L-NEXT:      )
  ;; H2L-NEXT:     )
