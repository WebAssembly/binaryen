  (func $array-new-data-uniform
    ;; Size 1 non-zero becomes array.new_fixed of size 1 (more compact than
    ;; array.new).
    (drop
      (array.new_data $arr-i8 $uniform
        (i32.const 0)
        (i32.const 1)
      )
    )
    ;; Size >= 2 with identical non-zero elements becomes array.new.
    (drop
      (array.new_data $arr-i8 $uniform
        (i32.const 0)
        (i32.const 4)
      )
    )
    (drop
      (array.new_data $arr-i16 $uniform
