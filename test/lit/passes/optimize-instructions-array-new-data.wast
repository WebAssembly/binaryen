  ;; TNH-NEXT:    (i32.const 1)
  ;; TNH-NEXT:   )
  ;; TNH-NEXT:  )
  ;; TNH-NEXT:  (drop
  ;; TNH-NEXT:   (array.new_data $arr-i8 $mixed
  ;; TNH-NEXT:    (i32.const 0)
  ;; TNH-NEXT:    (i32.const -1)
  ;; TNH-NEXT:   )
  ;; TNH-NEXT:  )
  ;; TNH-NEXT:  (drop
  ;; TNH-NEXT:   (array.new_data $arr-i8 $active
  ;; TNH-NEXT:    (i32.const 0)
  ;; TNH-NEXT:    (i32.const 1)
  ;; TNH-NEXT:   )
  ;; TNH-NEXT:  )
  ;; TNH-NEXT:  (drop
  ;; TNH-NEXT:   (array.new_data $arr-i8 $mixed
  ;; TNH-NEXT:    (call $get-i32)
  ;; TNH-NEXT:    (i32.const 1)
  ;; TNH-NEXT:   )
  ;; TNH-NEXT:  )
  ;; TNH-NEXT:  (drop
  ;; TNH-NEXT:   (array.new_data $arr-i8 $mixed
  ;; TNH-NEXT:    (i32.const 0)
  ;; TNH-NEXT:    (call $get-i32)
  ;; TNH-NEXT:   )
  ;; TNH-NEXT:  )
  ;; TNH-NEXT: )
  ;; NO_TNH:      (func $array-new-data-negative (type $1)
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (array.new_data $arr-i8 $large
  ;; NO_TNH-NEXT:    (i32.const 0)
  ;; NO_TNH-NEXT:    (i32.const 65)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (array.new_data $arr-i8 $mixed
  ;; NO_TNH-NEXT:    (i32.const 21)
  ;; NO_TNH-NEXT:    (i32.const 0)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (array.new_data $arr-i32 $mixed
  ;; NO_TNH-NEXT:    (i32.const 18)
  ;; NO_TNH-NEXT:    (i32.const 1)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (array.new_data $arr-i8 $mixed
  ;; NO_TNH-NEXT:    (i32.const 0)
  ;; NO_TNH-NEXT:    (i32.const -1)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (array.new_data $arr-i8 $active
  ;; NO_TNH-NEXT:    (i32.const 0)
  ;; NO_TNH-NEXT:    (i32.const 1)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (array.new_data $arr-i8 $mixed
  ;; NO_TNH-NEXT:    (call $get-i32)
  ;; NO_TNH-NEXT:    (i32.const 1)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (array.new_data $arr-i8 $mixed
  ;; NO_TNH-NEXT:    (i32.const 0)
  ;; NO_TNH-NEXT:    (call $get-i32)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $array-new-data-negative
    ;; Size > 64 with non-uniform elements is not lowered.
    (drop
      (array.new_data $arr-i8 $large
        (i32.const 0)
        (i32.const 65)
      )
    )
    ;; Out-of-bounds offset or size is not lowered.
    (drop
      (array.new_data $arr-i8 $mixed
        (i32.const 21)
        (i32.const 0)
      )
    )
    (drop
      (array.new_data $arr-i32 $mixed
        (i32.const 18)
        (i32.const 1)
      )
    )
    ;; Negative (i.e. huge unsigned) size is out of bounds and not lowered.
    (drop
      (array.new_data $arr-i8 $mixed
        (i32.const 0)
        (i32.const -1)
      )
    )
    ;; Active segment is not lowered.
    (drop
      (array.new_data $arr-i8 $active
        (i32.const 0)
        (i32.const 1)
      )
    )
    ;; Non-constant offset or size is not lowered.
    (drop
      (array.new_data $arr-i8 $mixed
        (call $get-i32)
        (i32.const 1)
      )
    )
    (drop
      (array.new_data $arr-i8 $mixed
        (i32.const 0)
        (call $get-i32)
      )
    )
  )

  ;; TNH:      (func $array-new-data-large-uniform (type $1)
  ;; TNH-NEXT:  (drop
  ;; TNH-NEXT:   (array.new_default $arr-i8
  ;; TNH-NEXT:    (i32.const 72)
  ;; TNH-NEXT:   )
  ;; TNH-NEXT:  )
  ;; TNH-NEXT:  (drop
  ;; TNH-NEXT:   (array.new $arr-i8
  ;; TNH-NEXT:    (i32.const 7)
  ;; TNH-NEXT:    (i32.const 72)
  ;; TNH-NEXT:   )
  ;; TNH-NEXT:  )
  ;; TNH-NEXT: )
  ;; NO_TNH:      (func $array-new-data-large-uniform (type $1)
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (array.new_data $arr-i8 $large-zeros
  ;; NO_TNH-NEXT:    (i32.const 0)
  ;; NO_TNH-NEXT:    (i32.const 72)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (array.new_data $arr-i8 $large-uniform
  ;; NO_TNH-NEXT:    (i32.const 0)
  ;; NO_TNH-NEXT:    (i32.const 72)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $array-new-data-large-uniform
    ;; Uniform slices are lowered regardless of size, even above the
    ;; array.new_fixed limit.
    (drop
      (array.new_data $arr-i8 $large-zeros
        (i32.const 0)
        (i32.const 72)
      )
    )
    (drop
      (array.new_data $arr-i8 $large-uniform
        (i32.const 0)
        (i32.const 72)
      )
    )
  )

  ;; TNH:      (func $array-new-data-floats (type $1)
  ;; TNH-NEXT:  (drop
  ;; TNH-NEXT:   (array.new $arr-f32
  ;; TNH-NEXT:    (f32.const -0)
  ;; TNH-NEXT:    (i32.const 2)
  ;; TNH-NEXT:   )
  ;; TNH-NEXT:  )
  ;; TNH-NEXT:  (drop
  ;; TNH-NEXT:   (array.new $arr-f32
  ;; TNH-NEXT:    (f32.const nan:0x400000)
  ;; TNH-NEXT:    (i32.const 2)
  ;; TNH-NEXT:   )
  ;; TNH-NEXT:  )
  ;; TNH-NEXT: )
  ;; NO_TNH:      (func $array-new-data-floats (type $1)
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (array.new_data $arr-f32 $floats
  ;; NO_TNH-NEXT:    (i32.const 0)
  ;; NO_TNH-NEXT:    (i32.const 2)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (array.new_data $arr-f32 $floats
  ;; NO_TNH-NEXT:    (i32.const 8)
  ;; NO_TNH-NEXT:    (i32.const 2)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $array-new-data-floats
    ;; -0.0 is not the default value, so this becomes array.new, not
    ;; array.new_default.
    (drop
      (array.new_data $arr-f32 $floats
        (i32.const 0)
        (i32.const 2)
      )
    )
    ;; NaNs with identical bits are uniform.
    (drop
      (array.new_data $arr-f32 $floats
        (i32.const 8)
        (i32.const 2)
      )
    )
  )

  ;; TNH:      (func $array-new-data-overflow (type $1)
  ;; TNH-NEXT:  (drop
  ;; TNH-NEXT:   (array.new_data $arr-i8 $mixed
  ;; TNH-NEXT:    (i32.const -1)
  ;; TNH-NEXT:    (i32.const 2)
  ;; TNH-NEXT:   )
  ;; TNH-NEXT:  )
  ;; TNH-NEXT: )
  ;; NO_TNH:      (func $array-new-data-overflow (type $1)
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (array.new_data $arr-i8 $mixed
  ;; NO_TNH-NEXT:    (i32.const -1)
  ;; NO_TNH-NEXT:    (i32.const 2)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $array-new-data-overflow
    ;; offset + size overflows 32 bits and is out of bounds; not lowered.
    (drop
      (array.new_data $arr-i8 $mixed
        (i32.const -1)
        (i32.const 2)
      )
    )
  )

  ;; TNH:      (func $array-new-data-unreachable (type $1)
  ;; TNH-NEXT:  (drop
  ;; TNH-NEXT:   (block ;; (replaces unreachable ArrayNewData we can't emit)
  ;; TNH-NEXT:    (drop
  ;; TNH-NEXT:     (unreachable)
  ;; TNH-NEXT:    )
  ;; TNH-NEXT:    (drop
  ;; TNH-NEXT:     (i32.const 1)
  ;; TNH-NEXT:    )
  ;; TNH-NEXT:    (unreachable)
  ;; TNH-NEXT:   )
  ;; TNH-NEXT:  )
  ;; TNH-NEXT: )
  ;; NO_TNH:      (func $array-new-data-unreachable (type $1)
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (block ;; (replaces unreachable ArrayNewData we can't emit)
  ;; NO_TNH-NEXT:    (drop
  ;; NO_TNH-NEXT:     (unreachable)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:    (drop
  ;; NO_TNH-NEXT:     (i32.const 1)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:    (unreachable)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $array-new-data-unreachable
    ;; Unreachable code is not lowered.
    (drop
      (array.new_data $arr-i8 $mixed
        (unreachable)
        (i32.const 1)
      )
    )
  )
)
