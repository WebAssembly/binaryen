  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (array.new_data $arr-i8 $mixed
  ;; NO_TNH-NEXT:    (i32.const 4)
  ;; NO_TNH-NEXT:    (i32.const 0)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $array-new-data-empty
    ;; Offset 0 and size 0 never traps (even if the segment was dropped), so it
    ;; can be lowered to array.new_fixed 0 even without trapsNeverHappen.
    (drop
      (array.new_data $arr-i8 $mixed
        (i32.const 0)
        (i32.const 0)
      )
    )
    ;; Non-zero in-bounds offset with size 0 traps if the segment was dropped at
    ;; runtime, so it is only lowered with trapsNeverHappen.
    (drop
      (array.new_data $arr-i8 $mixed
        (i32.const 4)
        (i32.const 0)
      )
    )
  )

