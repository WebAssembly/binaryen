;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --generate-global-effects --local-cse -all -S -o - \
;; RUN:   | filecheck %s

(module
  ;; CHECK:      (type $array (array (mut i32)))
  (type $array (array (mut i32)))

  ;; CHECK:      (type $1 (func (param i32)))

  ;; CHECK:      (type $2 (func))

  ;; CHECK:      (type $3 (func (param i32) (result i32)))

  ;; CHECK:      (type $4 (func (param i32 (ref $array))))

  ;; CHECK:      (import "a" "b" (func $use1 (type $1) (param i32)))
  (import "a" "b" (func $use1 (param i32)))
  ;; CHECK:      (import "a" "c" (func $use2 (type $1) (param i32)))
  (import "a" "c" (func $use2 (param i32)))

  ;; CHECK:      (global $initialized (mut i32) (i32.const 0))
  (global $initialized (mut i32) (i32.const 0))
  ;; CHECK:      (global $other (mut i32) (i32.const 0))
  (global $other (mut i32) (i32.const 0))
  ;; CHECK:      (global $cache (ref null $array) (ref.null none))
  (global $cache (ref null $array) (ref.null none))

  ;; CHECK:      (@binaryen.idempotent)
  ;; CHECK-NEXT: (func $box (type $3) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (global.set $initialized
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (array.get $array
  ;; CHECK-NEXT:   (global.get $cache)
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (@binaryen.idempotent)
  (func $box (param $x i32) (result i32)
    ;; Mirrors a boxing valueOf in Java: writes a $clinit global and reads
    ;; a mutable array. With --generate-global-effects, this has non-empty
    ;; effects (writesGlobal + readsMutableArray).
    (global.set $initialized
      (i32.const 1)
    )
    (array.get $array
      (global.get $cache)
      (local.get $x)
    )
  )

  ;; CHECK:      (func $intervening-call (type $1) (param $x i32)
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (call $use1
  ;; CHECK-NEXT:   (local.tee $1
  ;; CHECK-NEXT:    (call $box
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $use2
  ;; CHECK-NEXT:   (local.get $1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $intervening-call (param $x i32)
    ;; Intervening side-effecting call $use1 does not invalidate $box when its
    ;; operand is a local: we can CSE the call to $box.
    (call $use1
      (call $box
        (local.get $x)
      )
    )
    (call $use2
      (call $box
        (local.get $x)
      )
    )
  )

  ;; CHECK:      (func $intervening-array-write (type $4) (param $x i32) (param $arr (ref $array))
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (local.tee $2
  ;; CHECK-NEXT:    (call $box
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (global.set $initialized
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (array.set $array
  ;; CHECK-NEXT:   (local.get $arr)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 42)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (local.get $2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $intervening-array-write (param $x i32) (param $arr (ref $array))
    ;; Even an intervening mutable array write and write to $initialized do not
    ;; invalidate $box when its operand is a local, because $box is
    ;; idempotent.
    (drop
      (call $box
        (local.get $x)
      )
    )
    (global.set $initialized
      (i32.const 2)
    )
    (array.set $array
      (local.get $arr)
      (i32.const 0)
      (i32.const 42)
    )
    (drop
      (call $box
        (local.get $x)
      )
    )
  )

  ;; CHECK:      (func $disjoint-global-operand (type $2)
  ;; CHECK-NEXT:  (local $0 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (local.tee $0
  ;; CHECK-NEXT:    (call $box
  ;; CHECK-NEXT:     (global.get $other)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (global.set $initialized
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $disjoint-global-operand
    ;; $box writes $initialized, NOT $other, so using $other as an operand can
    ;; be deduplicated across a write to $initialized.
    (drop
      (call $box
        (global.get $other)
      )
    )
    (global.set $initialized
      (i32.const 2)
    )
    (drop
      (call $box
        (global.get $other)
      )
    )
  )

  ;; CHECK:      (func $disjoint-global-operand-invalidated (type $2)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $box
  ;; CHECK-NEXT:    (global.get $other)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (global.set $other
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $box
  ;; CHECK-NEXT:    (global.get $other)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $disjoint-global-operand-invalidated
    ;; Writing to $other in between DOES invalidate the copy, because the
    ;; operand value may have changed by the first call to $box.
    (drop
      (call $box
        (global.get $other)
      )
    )
    (global.set $other  ;; this changed
      (i32.const 2)
    )
    (drop
      (call $box
        (global.get $other)
      )
    )
  )

  ;; CHECK:      (func $same-global-operand (type $2)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $box
  ;; CHECK-NEXT:    (global.get $initialized)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $box
  ;; CHECK-NEXT:    (global.get $initialized)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $same-global-operand
    ;; $box itself writes $initialized, so using $initialized as an operand
    ;; cannot be deduplicated because the first call may change the operand.
    (drop
      (call $box
        (global.get $initialized)
      )
    )
    (drop
      (call $box
        (global.get $initialized)
      )
    )
  )
)

(module
  ;; CHECK:      (type $struct (shared (struct (field (mut i32)))))
  (type $struct (shared (struct (field (mut i32)))))

  ;; CHECK:      (type $1 (func (param i32) (result i32)))

  ;; CHECK:      (type $2 (func (param (ref $struct))))

  ;; CHECK:      (memory $mem 1 1 shared)
  (memory $mem 1 1 shared)

  ;; CHECK:      (@binaryen.idempotent)
  ;; CHECK-NEXT: (func $acquire-mem (type $1) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.atomic.load acqrel
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $x)
  ;; CHECK-NEXT: )
  (@binaryen.idempotent)
  (func $acquire-mem (param $x i32) (result i32)
    (drop
      (i32.atomic.load acqrel
        (local.get $x)
      )
    )
    (local.get $x)
  )

  ;; CHECK:      (@binaryen.idempotent)
  ;; CHECK-NEXT: (func $release-mem (type $1) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (i32.atomic.store acqrel
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $x)
  ;; CHECK-NEXT: )
  (@binaryen.idempotent)
  (func $release-mem (param $x i32) (result i32)
    (i32.atomic.store acqrel
      (local.get $x)
      (local.get $x)
    )
    (local.get $x)
  )

  ;; CHECK:      (func $release-allows-cse (type $2) (param $s (ref $struct))
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (local.tee $1
  ;; CHECK-NEXT:    (call $release-mem
  ;; CHECK-NEXT:     (struct.get $struct 0
  ;; CHECK-NEXT:      (local.get $s)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (local.get $1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $release-allows-cse (param $s (ref $struct))
    ;; The release store in the first call does not force the second struct.get
    ;; to see a new value from another thread, so we can deduplicate.
    (drop
      (call $release-mem
        (struct.get $struct 0
          (local.get $s)
        )
      )
    )
    (drop
      (call $release-mem
        (struct.get $struct 0
          (local.get $s)
        )
      )
    )
  )

  ;; CHECK:      (func $acquire-blocks-cse (type $2) (param $s (ref $struct))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $acquire-mem
  ;; CHECK-NEXT:    (struct.get $struct 0
  ;; CHECK-NEXT:     (local.get $s)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $acquire-mem
  ;; CHECK-NEXT:    (struct.get $struct 0
  ;; CHECK-NEXT:     (local.get $s)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $acquire-blocks-cse (param $s (ref $struct))
    ;; The acquire load in the first call establishes synchronization, so the
    ;; second struct.get might see a different value and we cannot deduplicate.
    (drop
      (call $acquire-mem
        (struct.get $struct 0
          (local.get $s)
        )
      )
    )
    (drop
      (call $acquire-mem
        (struct.get $struct 0
          (local.get $s)
        )
      )
    )
  )
)
