 ;; TNH-NEXT:  )
 ;; TNH-NEXT: )
 ;; TNH_NO_CD:      (func $br_on_cast_fail (type $3) (param $exact (ref (exact $foo))) (result anyref)
 ;; TNH_NO_CD-NEXT:  (local $x (ref null (exact $foo)))
 ;; TNH_NO_CD-NEXT:  (local.set $x
