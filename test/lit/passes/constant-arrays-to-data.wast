;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-opt --constant-arrays-to-data -all -S -o - | filecheck %s

(module
  ;; CHECK:      (type $i32 (array (mut i32)))

  ;; CHECK:      (type $1 (func (result (ref $i32))))

  ;; CHECK:      (type $i8 (array (mut i8)))
  (type $i8 (array (mut i8)))
  ;; CHECK:      (type $i16 (array (mut i16)))
  (type $i16 (array (mut i16)))
  (type $i32 (array (mut i32)))
  ;; CHECK:      (type $i64 (array (mut i64)))
  (type $i64 (array (mut i64)))
  ;; CHECK:      (type $f32 (array (mut f32)))
  (type $f32 (array (mut f32)))
  ;; CHECK:      (type $f64 (array (mut f64)))
  (type $f64 (array (mut f64)))
  ;; CHECK:      (type $v128 (array (mut v128)))
  (type $v128 (array (mut v128)))
  ;; CHECK:      (type $ref (array (mut anyref)))
  (type $ref (array (mut anyref)))

  ;; An existing passive segment, which can be reused. It contains the i32s
  ;; 10000, 20000, 30000 and 40000.
  ;; CHECK:      (type $9 (func (param i32) (result (ref $i32))))

  ;; CHECK:      (type $10 (func (result (ref $i8))))

  ;; CHECK:      (type $11 (func (result (ref $i16))))

  ;; CHECK:      (type $12 (func (result (ref $i64))))

  ;; CHECK:      (type $13 (func (result (ref $f32))))

  ;; CHECK:      (type $14 (func (result (ref $f64))))

  ;; CHECK:      (type $15 (func (result (ref $v128))))

  ;; CHECK:      (type $16 (func (result (ref $ref))))

  ;; CHECK:      (global $global (ref $i32) (array.new_fixed $i32 4
  ;; CHECK-NEXT:  (i32.const 100000)
  ;; CHECK-NEXT:  (i32.const 200000)
  ;; CHECK-NEXT:  (i32.const 300000)
  ;; CHECK-NEXT:  (i32.const 400000)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (data $existing "\10\'\00\00 N\00\000u\00\00@\9c\00\00")
  (data $existing "\10\27\00\00\20\4e\00\00\30\75\00\00\40\9c\00\00")

  ;; A segment that is dropped, which cannot be reused. It contains the i32s
  ;; 50000, 60000, 70000 and 80000.
  ;; CHECK:      (data $dropped "P\c3\00\00`\ea\00\00p\11\01\00\808\01\00")
  (data $dropped "\50\c3\00\00\60\ea\00\00\70\11\01\00\80\38\01\00")

  ;; Global initializers must remain constant expressions.
  (global $global (ref $i32) (array.new_fixed $i32 4
    (i32.const 100000)
    (i32.const 200000)
    (i32.const 300000)
    (i32.const 400000)
  ))

  ;; CHECK:      (data $constant-array-data "@B\0f\00\80{\e1\ff\c0\c6-\00\00\t=\00@KL\00\80\8d[\00\c0\cfj\00\00\12z\00\c8\c9\ca\cb\cc\cd\ff4@\9cA\9cB\9cC\9c\ff\ff\ff\ff\ff\ff\ff\7f\fe\ff\ff\ff\ff\ff\ff\7f\fd\ff\ff\ff\ff\ff\ff\7f\fc\ff\ff\ff\ff\ff\ff\7f\00\00\00?\00\00\c0?\00\00 @\00\00`@\00\00\90@\00\00\b0@\00\00\d0@\00\00\f0@\9a\99\99\99\99\99\b9?\9a\99\99\99\99\99\c9?333333\d3?\9a\99\99\99\99\99\d9?\00\00\00\00\00\00\e0?333333\e3?ffffff\e6?\04\00\00\00\00\00\f0\7f\01\00\00\00\02\00\00\00\03\00\00\00\04\00\00\00\05\00\00\00\06\00\00\00\07\00\00\00\08\00\00\00\t\00\00\00\n\00\00\00\0b\00\00\00\0c\00\00\00\r\00\00\00\0e\00\00\00\0f\00\00\00\10\00\00\00")

  ;; CHECK:      (export "i32" (func $i32))

  ;; CHECK:      (export "i32-same" (func $i32-same))

  ;; CHECK:      (export "i32-subsequence" (func $i32-subsequence))

  ;; CHECK:      (export "i32-existing" (func $i32-existing))

  ;; CHECK:      (export "i32-dropped" (func $i32-dropped))

  ;; CHECK:      (export "i32-small" (func $i32-small))

  ;; CHECK:      (export "i32-nonconstant" (func $i32-nonconstant))

  ;; CHECK:      (export "i8" (func $i8))

  ;; CHECK:      (export "i16" (func $i16))

  ;; CHECK:      (export "i64" (func $i64))

  ;; CHECK:      (export "f32" (func $f32))

  ;; CHECK:      (export "f64" (func $f64))

  ;; CHECK:      (export "v128" (func $v128))

  ;; CHECK:      (export "ref" (func $ref))

  ;; CHECK:      (export "empty" (func $empty))

  ;; CHECK:      (export "global" (func $global))

  ;; CHECK:      (func $i32 (type $1) (result (ref $i32))
  ;; CHECK-NEXT:  ;;@ src.cpp:10:5
  ;; CHECK-NEXT:  (array.new_data $i32 $constant-array-data
  ;; CHECK-NEXT:   ;;@
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   ;;@
  ;; CHECK-NEXT:   (i32.const 8)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i32 (export "i32") (result (ref $i32))
    ;; This is smaller as array.new_data. The debug location is kept.
    ;;@ src.cpp:10:5
    (array.new_fixed $i32 8
      (i32.const 1000000)
      (i32.const -2000000)
      (i32.const 3000000)
      (i32.const 4000000)
      (i32.const 5000000)
      (i32.const 6000000)
      (i32.const 7000000)
      (i32.const 8000000)
    )
  )

  ;; CHECK:      (func $i32-same (type $1) (result (ref $i32))
  ;; CHECK-NEXT:  (array.new_data $i32 $constant-array-data
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 8)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i32-same (export "i32-same") (result (ref $i32))
    ;; The same payload as before, which reuses the same bytes.
    (array.new_fixed $i32 8
      (i32.const 1000000)
      (i32.const -2000000)
      (i32.const 3000000)
      (i32.const 4000000)
      (i32.const 5000000)
      (i32.const 6000000)
      (i32.const 7000000)
      (i32.const 8000000)
    )
  )

  ;; CHECK:      (func $i32-subsequence (type $1) (result (ref $i32))
  ;; CHECK-NEXT:  (array.new_fixed $i32 2
  ;; CHECK-NEXT:   (i32.const 3000000)
  ;; CHECK-NEXT:   (i32.const 4000000)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i32-subsequence (export "i32-subsequence") (result (ref $i32))
    ;; A subsequence of the previous payload. We do not look for payloads inside
    ;; other data (see the TODO in the pass), and alone this is not worth
    ;; converting.
    (array.new_fixed $i32 2
      (i32.const 3000000)
      (i32.const 4000000)
    )
  )

  ;; CHECK:      (func $i32-existing (type $1) (result (ref $i32))
  ;; CHECK-NEXT:  (array.new_data $i32 $existing
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 4)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i32-existing (export "i32-existing") (result (ref $i32))
    ;; An existing segment with identical contents is reused.
    (array.new_fixed $i32 4
      (i32.const 10000)
      (i32.const 20000)
      (i32.const 30000)
      (i32.const 40000)
    )
  )

  ;; CHECK:      (func $i32-dropped (type $1) (result (ref $i32))
  ;; CHECK-NEXT:  (data.drop $dropped)
  ;; CHECK-NEXT:  (array.new_fixed $i32 4
  ;; CHECK-NEXT:   (i32.const 50000)
  ;; CHECK-NEXT:   (i32.const 60000)
  ;; CHECK-NEXT:   (i32.const 70000)
  ;; CHECK-NEXT:   (i32.const 80000)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i32-dropped (export "i32-dropped") (result (ref $i32))
    ;; The dropped segment cannot be reused, and it is not worth adding new
    ;; bytes.
    (data.drop $dropped)
    (array.new_fixed $i32 4
      (i32.const 50000)
      (i32.const 60000)
      (i32.const 70000)
      (i32.const 80000)
    )
  )

  ;; CHECK:      (func $i32-small (type $1) (result (ref $i32))
  ;; CHECK-NEXT:  (array.new_fixed $i32 4
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (i32.const 3)
  ;; CHECK-NEXT:   (i32.const 5)
  ;; CHECK-NEXT:   (i32.const 7)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i32-small (export "i32-small") (result (ref $i32))
    ;; Small values have short encodings, so this is smaller as it is.
    (array.new_fixed $i32 4
      (i32.const 1)
      (i32.const 3)
      (i32.const 5)
      (i32.const 7)
    )
  )

  ;; CHECK:      (func $i32-nonconstant (type $9) (param $x i32) (result (ref $i32))
  ;; CHECK-NEXT:  (array.new_fixed $i32 4
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (i32.const 2000000)
  ;; CHECK-NEXT:   (i32.const 3000000)
  ;; CHECK-NEXT:   (i32.const 4000000)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i32-nonconstant (export "i32-nonconstant") (param $x i32) (result (ref $i32))
    ;; Non-constant values prevent the optimization.
    (array.new_fixed $i32 4
      (local.get $x)
      (i32.const 2000000)
      (i32.const 3000000)
      (i32.const 4000000)
    )
  )

  ;; CHECK:      (func $i8 (type $10) (result (ref $i8))
  ;; CHECK-NEXT:  (array.new_data $i8 $constant-array-data
  ;; CHECK-NEXT:   (i32.const 32)
  ;; CHECK-NEXT:   (i32.const 8)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i8 (export "i8") (result (ref $i8))
    ;; Packed fields store the low bits of each value.
    (array.new_fixed $i8 8
      (i32.const 200)
      (i32.const 201)
      (i32.const 202)
      (i32.const 203)
      (i32.const 204)
      (i32.const 205)
      (i32.const -1)
      (i32.const 0x1234)
    )
  )

  ;; CHECK:      (func $i16 (type $11) (result (ref $i16))
  ;; CHECK-NEXT:  (array.new_data $i16 $constant-array-data
  ;; CHECK-NEXT:   (i32.const 40)
  ;; CHECK-NEXT:   (i32.const 4)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i16 (export "i16") (result (ref $i16))
    (array.new_fixed $i16 4
      (i32.const 40000)
      (i32.const 40001)
      (i32.const 40002)
      (i32.const 40003)
    )
  )

  ;; CHECK:      (func $i64 (type $12) (result (ref $i64))
  ;; CHECK-NEXT:  (array.new_data $i64 $constant-array-data
  ;; CHECK-NEXT:   (i32.const 48)
  ;; CHECK-NEXT:   (i32.const 4)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i64 (export "i64") (result (ref $i64))
    (array.new_fixed $i64 4
      (i64.const 0x7fffffffffffffff)
      (i64.const 0x7ffffffffffffffe)
      (i64.const 0x7ffffffffffffffd)
      (i64.const 0x7ffffffffffffffc)
    )
  )

  ;; CHECK:      (func $f32 (type $13) (result (ref $f32))
  ;; CHECK-NEXT:  (array.new_data $f32 $constant-array-data
  ;; CHECK-NEXT:   (i32.const 80)
  ;; CHECK-NEXT:   (i32.const 8)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $f32 (export "f32") (result (ref $f32))
    (array.new_fixed $f32 8
      (f32.const 0.5)
      (f32.const 1.5)
      (f32.const 2.5)
      (f32.const 3.5)
      (f32.const 4.5)
      (f32.const 5.5)
      (f32.const 6.5)
      (f32.const 7.5)
    )
  )

  ;; CHECK:      (func $f64 (type $14) (result (ref $f64))
  ;; CHECK-NEXT:  (array.new_data $f64 $constant-array-data
  ;; CHECK-NEXT:   (i32.const 112)
  ;; CHECK-NEXT:   (i32.const 8)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $f64 (export "f64") (result (ref $f64))
    (array.new_fixed $f64 8
      (f64.const 0.1)
      (f64.const 0.2)
      (f64.const 0.3)
      (f64.const 0.4)
      (f64.const 0.5)
      (f64.const 0.6)
      (f64.const 0.7)
      (f64.const nan:0x4)
    )
  )

  ;; CHECK:      (func $v128 (type $15) (result (ref $v128))
  ;; CHECK-NEXT:  (array.new_data $v128 $constant-array-data
  ;; CHECK-NEXT:   (i32.const 176)
  ;; CHECK-NEXT:   (i32.const 4)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $v128 (export "v128") (result (ref $v128))
    (array.new_fixed $v128 4
      (v128.const i32x4 1 2 3 4)
      (v128.const i32x4 5 6 7 8)
      (v128.const i32x4 9 10 11 12)
      (v128.const i32x4 13 14 15 16)
    )
  )

  ;; CHECK:      (func $ref (type $16) (result (ref $ref))
  ;; CHECK-NEXT:  (array.new_fixed $ref 2
  ;; CHECK-NEXT:   (ref.null none)
  ;; CHECK-NEXT:   (ref.null none)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref (export "ref") (result (ref $ref))
    ;; Non-numeric arrays are not optimized.
    (array.new_fixed $ref 2
      (ref.null none)
      (ref.null none)
    )
  )

  ;; CHECK:      (func $empty (type $1) (result (ref $i32))
  ;; CHECK-NEXT:  (array.new_fixed $i32 0)
  ;; CHECK-NEXT: )
  (func $empty (export "empty") (result (ref $i32))
    ;; Empty arrays are not optimized.
    (array.new_fixed $i32 0)
  )

  ;; CHECK:      (func $global (type $1) (result (ref $i32))
  ;; CHECK-NEXT:  (global.get $global)
  ;; CHECK-NEXT: )
  (func $global (export "global") (result (ref $i32))
    (global.get $global)
  )
)

;; When the savings do not pay for a new segment, it is not added, but existing
;; segments are still reused.
(module
  ;; CHECK:      (type $i32 (array (mut i32)))
  (type $i32 (array (mut i32)))

  ;; CHECK:      (type $1 (func (result (ref $i32))))

  ;; CHECK:      (data $existing "\10\'\00\00 N\00\000u\00\00@\9c\00\00")
  (data $existing "\10\27\00\00\20\4e\00\00\30\75\00\00\40\9c\00\00")

  ;; CHECK:      (export "existing" (func $existing))

  ;; CHECK:      (export "new" (func $new))

  ;; CHECK:      (func $existing (type $1) (result (ref $i32))
  ;; CHECK-NEXT:  (array.new_data $i32 $existing
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 4)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $existing (export "existing") (result (ref $i32))
    (array.new_fixed $i32 4
      (i32.const 10000)
      (i32.const 20000)
      (i32.const 30000)
      (i32.const 40000)
    )
  )

  ;; CHECK:      (func $new (type $1) (result (ref $i32))
  ;; CHECK-NEXT:  (array.new_fixed $i32 8
  ;; CHECK-NEXT:   (i32.const 1000000)
  ;; CHECK-NEXT:   (i32.const -1000000)
  ;; CHECK-NEXT:   (i32.const 1000001)
  ;; CHECK-NEXT:   (i32.const 4000000)
  ;; CHECK-NEXT:   (i32.const 5000000)
  ;; CHECK-NEXT:   (i32.const 6000000)
  ;; CHECK-NEXT:   (i32.const 7000000)
  ;; CHECK-NEXT:   (i32.const 8000000)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $new (export "new") (result (ref $i32))
    ;; This would save 1 byte, which does not pay for the new segment's flags
    ;; and size.
    (array.new_fixed $i32 8
      (i32.const 1000000)
      (i32.const -1000000)
      (i32.const 1000001)
      (i32.const 4000000)
      (i32.const 5000000)
      (i32.const 6000000)
      (i32.const 7000000)
      (i32.const 8000000)
    )
  )
)
