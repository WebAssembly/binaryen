;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --type-generalizing --traps-never-happen -all -S -o - | filecheck %s --check-prefix=TNH
;; RUN: foreach %s %t wasm-opt --type-generalizing                      -all -S -o - | filecheck %s --check-prefix=NO_TNH

(module
 ;; TNH:      (type $Top (sub (struct (field i32))))
 ;; NO_TNH:      (type $Top (sub (struct (field i32))))
 (type $Top (sub (struct (field i32))))
 ;; TNH:      (type $Mid (sub $Top (struct (field i32) (field i64))))
 ;; NO_TNH:      (type $Mid (sub $Top (struct (field i32) (field i64))))
 (type $Mid (sub $Top (struct (field i32) (field i64))))
 ;; NO_TNH:      (type $Bot (sub $Mid (struct (field i32) (field i64) (field f32))))
 (type $Bot (sub $Mid (struct (field i32) (field i64) (field f32))))

 ;; TNH:      (type $2 (func (param anyref) (result (ref null $Top))))

 ;; TNH:      (type $3 (func (param anyref)))

 ;; TNH:      (type $4 (func (param (ref $Top)) (result anyref)))

 ;; TNH:      (type $5 (func (param (ref any)) (result anyref)))

 ;; TNH:      (type $6 (func (param anyref) (result (ref $Mid))))

 ;; TNH:      (type $7 (func (param anyref) (result i32)))

 ;; TNH:      (type $8 (func (result anyref)))

 ;; TNH:      (func $dropped (type $3) (param $any anyref)
 ;; TNH-NEXT:  (drop
 ;; TNH-NEXT:   (ref.cast anyref
 ;; TNH-NEXT:    (local.get $any)
 ;; TNH-NEXT:   )
 ;; TNH-NEXT:  )
 ;; TNH-NEXT: )
 ;; NO_TNH:      (type $3 (func (param anyref) (result (ref null $Top))))

 ;; NO_TNH:      (type $4 (func (param anyref)))

 ;; NO_TNH:      (type $5 (func (param (ref $Top)) (result anyref)))

 ;; NO_TNH:      (type $6 (func (param (ref any)) (result anyref)))

 ;; NO_TNH:      (type $7 (func (param anyref) (result (ref $Mid))))

 ;; NO_TNH:      (type $8 (func (param anyref) (result i32)))

 ;; NO_TNH:      (type $9 (func (result anyref)))

 ;; NO_TNH:      (func $dropped (type $4) (param $any anyref)
 ;; NO_TNH-NEXT:  (drop
 ;; NO_TNH-NEXT:   (ref.cast (ref $Bot)
 ;; NO_TNH-NEXT:    (local.get $any)
 ;; NO_TNH-NEXT:   )
 ;; NO_TNH-NEXT:  )
 ;; NO_TNH-NEXT: )
 (func $dropped (param $any anyref)
  ;; Dropped cast generalizes all the way to anyref in TNH mode.
  (drop
   (ref.cast (ref $Bot)
    (local.get $any)
   )
  )
 )

 ;; TNH:      (func $weaken-to-super (type $2) (param $any anyref) (result (ref null $Top))
 ;; TNH-NEXT:  (ref.cast (ref null $Top)
 ;; TNH-NEXT:   (local.get $any)
 ;; TNH-NEXT:  )
 ;; TNH-NEXT: )
 ;; NO_TNH:      (func $weaken-to-super (type $3) (param $any anyref) (result (ref null $Top))
 ;; NO_TNH-NEXT:  (ref.cast (ref $Bot)
 ;; NO_TNH-NEXT:   (local.get $any)
 ;; NO_TNH-NEXT:  )
 ;; NO_TNH-NEXT: )
 (func $weaken-to-super (param $any anyref) (result (ref null $Top))
  ;; Cast from anyref to (ref $Bot) weakens to (ref null $Top) in TNH mode.
  (ref.cast (ref $Bot)
   (local.get $any)
  )
 )

 ;; TNH:      (func $weaken-to-input (type $4) (param $top (ref $Top)) (result anyref)
 ;; TNH-NEXT:  (ref.cast (ref $Top)
 ;; TNH-NEXT:   (local.get $top)
 ;; TNH-NEXT:  )
 ;; TNH-NEXT: )
 ;; NO_TNH:      (func $weaken-to-input (type $5) (param $top (ref $Top)) (result anyref)
 ;; NO_TNH-NEXT:  (ref.cast (ref $Bot)
 ;; NO_TNH-NEXT:   (local.get $top)
 ;; NO_TNH-NEXT:  )
 ;; NO_TNH-NEXT: )
 (func $weaken-to-input (param $top (ref $Top)) (result anyref)
  ;; Cast weakens to anyref and refinalizes with the input to (ref $Top),
  ;; making it trivial so OptimizeInstructions can remove it.
  (ref.cast (ref $Bot)
   (local.get $top)
  )
 )

 ;; TNH:      (func $nonnull-input-nullable-req (type $5) (param $nn (ref any)) (result anyref)
 ;; TNH-NEXT:  (ref.cast (ref any)
 ;; TNH-NEXT:   (local.get $nn)
 ;; TNH-NEXT:  )
 ;; TNH-NEXT: )
 ;; NO_TNH:      (func $nonnull-input-nullable-req (type $6) (param $nn (ref any)) (result anyref)
 ;; NO_TNH-NEXT:  (ref.cast (ref i31)
 ;; NO_TNH-NEXT:   (local.get $nn)
 ;; NO_TNH-NEXT:  )
 ;; NO_TNH-NEXT: )
 (func $nonnull-input-nullable-req (param $nn (ref any)) (result anyref)
  ;; Refinalization keeps the cast non-nullable when its input is non-nullable.
  (ref.cast (ref i31)
   (local.get $nn)
  )
 )

 ;; TNH:      (func $chained (type $6) (param $any anyref) (result (ref $Mid))
 ;; TNH-NEXT:  (ref.cast (ref $Mid)
 ;; TNH-NEXT:   (ref.cast anyref
 ;; TNH-NEXT:    (local.get $any)
 ;; TNH-NEXT:   )
 ;; TNH-NEXT:  )
 ;; TNH-NEXT: )
 ;; NO_TNH:      (func $chained (type $7) (param $any anyref) (result (ref $Mid))
 ;; NO_TNH-NEXT:  (ref.cast (ref $Bot)
 ;; NO_TNH-NEXT:   (ref.cast (ref $Mid)
 ;; NO_TNH-NEXT:    (local.get $any)
 ;; NO_TNH-NEXT:   )
 ;; NO_TNH-NEXT:  )
 ;; NO_TNH-NEXT: )
 (func $chained (param $any anyref) (result (ref $Mid))
  ;; Inner cast weakens to anyref; outer cast weakens to (ref $Mid).
  (ref.cast (ref $Bot)
   (ref.cast (ref $Mid)
    (local.get $any)
   )
  )
 )

 ;; TNH:      (func $cast-and-struct-get (type $7) (param $any anyref) (result i32)
 ;; TNH-NEXT:  (struct.get $Top 0
 ;; TNH-NEXT:   (ref.cast (ref null $Top)
 ;; TNH-NEXT:    (local.get $any)
 ;; TNH-NEXT:   )
 ;; TNH-NEXT:  )
 ;; TNH-NEXT: )
 ;; NO_TNH:      (func $cast-and-struct-get (type $8) (param $any anyref) (result i32)
 ;; NO_TNH-NEXT:  (struct.get $Bot 0
 ;; NO_TNH-NEXT:   (ref.cast (ref $Bot)
 ;; NO_TNH-NEXT:    (local.get $any)
 ;; NO_TNH-NEXT:   )
 ;; NO_TNH-NEXT:  )
 ;; NO_TNH-NEXT: )
 (func $cast-and-struct-get (param $any anyref) (result i32)
  ;; Weakening the cast from (ref $Bot) to (ref null $Top) also generalizes the
  ;; struct.get from $Bot to $Top.
  (struct.get $Bot 0
   (ref.cast (ref $Bot)
    (local.get $any)
   )
  )
 )

 ;; TNH:      (func $cast-through-local (type $2) (param $any anyref) (result (ref null $Top))
 ;; TNH-NEXT:  (local $x (ref null $Top))
 ;; TNH-NEXT:  (local.set $x
 ;; TNH-NEXT:   (ref.cast (ref null $Top)
 ;; TNH-NEXT:    (local.get $any)
 ;; TNH-NEXT:   )
 ;; TNH-NEXT:  )
 ;; TNH-NEXT:  (local.get $x)
 ;; TNH-NEXT: )
 ;; NO_TNH:      (func $cast-through-local (type $3) (param $any anyref) (result (ref null $Top))
 ;; NO_TNH-NEXT:  (local $x (ref null $Top))
 ;; NO_TNH-NEXT:  (local.set $x
 ;; NO_TNH-NEXT:   (ref.cast (ref $Bot)
 ;; NO_TNH-NEXT:    (local.get $any)
 ;; NO_TNH-NEXT:   )
 ;; NO_TNH-NEXT:  )
 ;; NO_TNH-NEXT:  (local.get $x)
 ;; NO_TNH-NEXT: )
 (func $cast-through-local (param $any anyref) (result (ref null $Top))
  ;; Both the local and the cast feeding it generalize to (ref null $Top).
  (local $x (ref null $Bot))
  (local.set $x
   (ref.cast (ref $Bot)
    (local.get $any)
   )
  )
  (local.get $x)
 )

 ;; TNH:      (func $unreachable-cast (type $8) (result anyref)
 ;; TNH-NEXT:  (unreachable)
 ;; TNH-NEXT: )
 ;; NO_TNH:      (func $unreachable-cast (type $9) (result anyref)
 ;; NO_TNH-NEXT:  (unreachable)
 ;; NO_TNH-NEXT: )
 (func $unreachable-cast (result anyref)
  ;; Unreachable casts are folded away by the initial DCE step (and would be
  ;; skipped by canGeneralizeCast even without DCE).
  (ref.cast (ref $Bot)
   (unreachable)
  )
 )
)

;; Descriptor casts are left unchanged for now.
(module
 (rec
  ;; TNH:      (rec
  ;; TNH-NEXT:  (type $A (sub (descriptor $A.desc) (struct)))
  ;; NO_TNH:      (rec
  ;; NO_TNH-NEXT:  (type $A (sub (descriptor $A.desc) (struct)))
  (type $A (sub (descriptor $A.desc) (struct)))
  ;; TNH:       (type $A.desc (sub (describes $A) (struct)))
  ;; NO_TNH:       (type $A.desc (sub (describes $A) (struct)))
  (type $A.desc (sub (describes $A) (struct)))
  ;; TNH:       (type $B (sub $A (descriptor $B.desc) (struct)))
  ;; NO_TNH:       (type $B (sub $A (descriptor $B.desc) (struct)))
  (type $B (sub $A (descriptor $B.desc) (struct)))
  ;; TNH:       (type $B.desc (sub $A.desc (describes $B) (struct)))
  ;; NO_TNH:       (type $B.desc (sub $A.desc (describes $B) (struct)))
  (type $B.desc (sub $A.desc (describes $B) (struct)))
 )

 ;; TNH:      (type $4 (func (param anyref (ref $A.desc))))

 ;; TNH:      (type $5 (func (param anyref (ref (exact $B.desc))) (result (ref null $A))))

 ;; TNH:      (type $6 (func (param anyref) (result (ref null $A))))

 ;; TNH:      (func $ref.cast_desc_eq (type $4) (param $any anyref) (param $desc (ref $A.desc))
 ;; TNH-NEXT:  (drop
 ;; TNH-NEXT:   (ref.cast_desc_eq (ref $A)
 ;; TNH-NEXT:    (local.get $any)
 ;; TNH-NEXT:    (local.get $desc)
 ;; TNH-NEXT:   )
 ;; TNH-NEXT:  )
 ;; TNH-NEXT: )
 ;; NO_TNH:      (type $4 (func (param anyref (ref $A.desc))))

 ;; NO_TNH:      (type $5 (func (param anyref (ref (exact $B.desc))) (result (ref null $A))))

 ;; NO_TNH:      (type $6 (func (param anyref) (result (ref null $A))))

 ;; NO_TNH:      (func $ref.cast_desc_eq (type $4) (param $any anyref) (param $desc (ref $A.desc))
 ;; NO_TNH-NEXT:  (drop
 ;; NO_TNH-NEXT:   (ref.cast_desc_eq (ref $A)
 ;; NO_TNH-NEXT:    (local.get $any)
 ;; NO_TNH-NEXT:    (local.get $desc)
 ;; NO_TNH-NEXT:   )
 ;; NO_TNH-NEXT:  )
 ;; NO_TNH-NEXT: )
 (func $ref.cast_desc_eq (param $any anyref) (param $desc (ref $A.desc))
  (drop
   (ref.cast_desc_eq (ref $A)
    (local.get $any)
    (local.get $desc)
   )
  )
 )

 ;; TNH:      (func $ref.cast_desc_eq-sub (type $5) (param $any anyref) (param $desc (ref (exact $B.desc))) (result (ref null $A))
 ;; TNH-NEXT:  (local $d (ref null (exact $B.desc)))
 ;; TNH-NEXT:  (local.set $d
 ;; TNH-NEXT:   (local.get $desc)
 ;; TNH-NEXT:  )
 ;; TNH-NEXT:  (ref.cast_desc_eq (ref (exact $B))
 ;; TNH-NEXT:   (local.get $any)
 ;; TNH-NEXT:   (local.get $d)
 ;; TNH-NEXT:  )
 ;; TNH-NEXT: )
 ;; NO_TNH:      (func $ref.cast_desc_eq-sub (type $5) (param $any anyref) (param $desc (ref (exact $B.desc))) (result (ref null $A))
 ;; NO_TNH-NEXT:  (local $d (ref null (exact $B.desc)))
 ;; NO_TNH-NEXT:  (local.set $d
 ;; NO_TNH-NEXT:   (local.get $desc)
 ;; NO_TNH-NEXT:  )
 ;; NO_TNH-NEXT:  (ref.cast_desc_eq (ref (exact $B))
 ;; NO_TNH-NEXT:   (local.get $any)
 ;; NO_TNH-NEXT:   (local.get $d)
 ;; NO_TNH-NEXT:  )
 ;; NO_TNH-NEXT: )
 (func $ref.cast_desc_eq-sub (param $any anyref) (param $desc (ref (exact $B.desc))) (result (ref null $A))
  ;; Even though only (ref null $A) is required of the result, we do not
  ;; generalize ref.cast_desc_eq or weaken the descriptor local's heap type or
  ;; exactness (only its nullability generalizes).
  (local $d (ref (exact $B.desc)))
  (local.set $d
   (local.get $desc)
  )
  (ref.cast_desc_eq (ref (exact $B))
   (local.get $any)
   (local.get $d)
  )
 )

 ;; TNH:      (func $ref.cast_desc_eq-unreachable (type $6) (param $any anyref) (result (ref null $A))
 ;; TNH-NEXT:  (drop
 ;; TNH-NEXT:   (local.get $any)
 ;; TNH-NEXT:  )
 ;; TNH-NEXT:  (unreachable)
 ;; TNH-NEXT: )
 ;; NO_TNH:      (func $ref.cast_desc_eq-unreachable (type $6) (param $any anyref) (result (ref null $A))
 ;; NO_TNH-NEXT:  (drop
 ;; NO_TNH-NEXT:   (local.get $any)
 ;; NO_TNH-NEXT:  )
 ;; NO_TNH-NEXT:  (unreachable)
 ;; NO_TNH-NEXT: )
 (func $ref.cast_desc_eq-unreachable (param $any anyref) (result (ref null $A))
  (ref.cast_desc_eq (ref $A)
   (local.get $any)
   (unreachable)
  )
 )
)
