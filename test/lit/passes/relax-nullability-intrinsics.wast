;; NOTE: Assertions have been generated by update_lit_checks.py and should not be edited.
;; RUN: foreach %s %t wasm-opt -all --relax-nullability -S -o - | filecheck %s

(module
  ;; CHECK:      (type $unrelaxed (func (param (ref any))))
  (type $unrelaxed (func (param (ref any))))

  (rec
   ;; CHECK:      (rec
   ;; CHECK-NEXT:  (type $relaxed (func (param anyref)))
   (type $relaxed (func (param (ref any))))
   (type $brand (struct))
  )

  (import "binaryen-intrinsics" "call.without.effects"
    (func $cwe-unrelaxed (param (ref any) (ref $unrelaxed))))

  (import "binaryen-intrinsics" "call.without.effects"
    (func $cwe-relaxed (param (ref any) (ref $relaxed))))

  ;; CHECK:      (func $relaxed (type $relaxed) (param $x anyref)
  ;; CHECK-NEXT: )
  (func $relaxed (type $relaxed) (param $x (ref any)))

  ;; CHECK:      (func $unrelaxed (type $unrelaxed) (param $x (ref any))
  ;; CHECK-NEXT: )
  (func $unrelaxed (export "unrelaxed") (type $unrelaxed) (param $x (ref any)))

  ;; CHECK:      (func $caller (type $4) (param $ref anyref)
  ;; CHECK-NEXT:  (call $cwe-unrelaxed
  ;; CHECK-NEXT:   (ref.as_non_null
  ;; CHECK-NEXT:    (local.get $ref)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (ref.func $unrelaxed)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $cwe-relaxed
  ;; CHECK-NEXT:   (local.get $ref)
  ;; CHECK-NEXT:   (ref.func $relaxed)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $caller (param $ref (ref any))
   ;; $unrelaxed has a public type. Insert a ref.as_non_null as if this were
   ;; a direct call to $unrelaxed.
   (call $cwe-unrelaxed (local.get $ref) (ref.func $unrelaxed))

   ;; $relaxed has a private type and was relaxed.
   ;; No need to insert ref.as_non_null.
   (call $cwe-relaxed (local.get $ref) (ref.func $relaxed))
  )
)
