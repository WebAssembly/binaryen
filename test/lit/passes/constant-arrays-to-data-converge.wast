;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; With --converge, the last set of opts runs in every iteration. Arrays that
;; OptimizeInstructions lowers back to array.new_fixed are then converted again,
;; and must not duplicate their bytes.

;; RUN: wasm-opt %s -O2 --converge --traps-never-happen -all -S -o - | filecheck %s

(module
  ;; CHECK:      (type $i32 (array (mut i32)))
  (type $i32 (array (mut i32)))

  ;; CHECK:      (type $1 (func (result (ref $i32))))

  ;; CHECK:      (data $constant-array-data "\00\00\00@\01\00\00@\02\00\00@\03\00\00@\04\00\00@\05\00\00@\06\00\00@\07\00\00@\08\00\00@\t\00\00@\n\00\00@\0b\00\00@\0c\00\00@\r\00\00@\0e\00\00@\0f\00\00@\10\00\00@\11\00\00@\12\00\00@\13\00\00@\14\00\00@\15\00\00@\16\00\00@\17\00\00@\18\00\00@\19\00\00@\1a\00\00@\1b\00\00@\1c\00\00@\1d\00\00@\1e\00\00@\1f\00\00@ \00\00@!\00\00@\"\00\00@#\00\00@$\00\00@%\00\00@&\00\00@\'\00\00@(\00\00@)\00\00@*\00\00@+\00\00@,\00\00@-\00\00@.\00\00@/\00\00@0\00\00@1\00\00@2\00\00@3\00\00@4\00\00@5\00\00@6\00\00@7\00\00@8\00\00@9\00\00@:\00\00@;\00\00@<\00\00@=\00\00@>\00\00@?\00\00@@\00\00@")

  ;; CHECK:      (data $constant-array-data_1 "\00\01\00@\01\01\00@\02\01\00@\03\01\00@\04\01\00@\05\01\00@\06\01\00@\07\01\00@")

  ;; CHECK:      (export "large" (func $large))

  ;; CHECK:      (export "small" (func $small))

  ;; CHECK:      (func $large (type $1) (result (ref $i32))
  ;; CHECK-NEXT:  (array.new_data $i32 $constant-array-data
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 65)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $large (export "large") (result (ref $i32))
    ;; This has more than 64 elements, so OptimizeInstructions does not lower
    ;; it back to array.new_fixed, and its segment remains.
    (array.new_fixed $i32 65
      (i32.const 0x40000000) (i32.const 0x40000001) (i32.const 0x40000002)
      (i32.const 0x40000003) (i32.const 0x40000004) (i32.const 0x40000005)
      (i32.const 0x40000006) (i32.const 0x40000007) (i32.const 0x40000008)
      (i32.const 0x40000009) (i32.const 0x4000000a) (i32.const 0x4000000b)
      (i32.const 0x4000000c) (i32.const 0x4000000d) (i32.const 0x4000000e)
      (i32.const 0x4000000f) (i32.const 0x40000010) (i32.const 0x40000011)
      (i32.const 0x40000012) (i32.const 0x40000013) (i32.const 0x40000014)
      (i32.const 0x40000015) (i32.const 0x40000016) (i32.const 0x40000017)
      (i32.const 0x40000018) (i32.const 0x40000019) (i32.const 0x4000001a)
      (i32.const 0x4000001b) (i32.const 0x4000001c) (i32.const 0x4000001d)
      (i32.const 0x4000001e) (i32.const 0x4000001f) (i32.const 0x40000020)
      (i32.const 0x40000021) (i32.const 0x40000022) (i32.const 0x40000023)
      (i32.const 0x40000024) (i32.const 0x40000025) (i32.const 0x40000026)
      (i32.const 0x40000027) (i32.const 0x40000028) (i32.const 0x40000029)
      (i32.const 0x4000002a) (i32.const 0x4000002b) (i32.const 0x4000002c)
      (i32.const 0x4000002d) (i32.const 0x4000002e) (i32.const 0x4000002f)
      (i32.const 0x40000030) (i32.const 0x40000031) (i32.const 0x40000032)
      (i32.const 0x40000033) (i32.const 0x40000034) (i32.const 0x40000035)
      (i32.const 0x40000036) (i32.const 0x40000037) (i32.const 0x40000038)
      (i32.const 0x40000039) (i32.const 0x4000003a) (i32.const 0x4000003b)
      (i32.const 0x4000003c) (i32.const 0x4000003d) (i32.const 0x4000003e)
      (i32.const 0x4000003f) (i32.const 0x40000040)
    )
  )

  ;; CHECK:      (func $small (type $1) (result (ref $i32))
  ;; CHECK-NEXT:  (array.new_data $i32 $constant-array-data_1
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 8)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $small (export "small") (result (ref $i32))
    ;; OptimizeInstructions lowers this back to array.new_fixed in the next
    ;; iteration, and then we convert it again.
    (array.new_fixed $i32 8
      (i32.const 0x40000100) (i32.const 0x40000101) (i32.const 0x40000102)
      (i32.const 0x40000103) (i32.const 0x40000104) (i32.const 0x40000105)
      (i32.const 0x40000106) (i32.const 0x40000107)
    )
  )
)
