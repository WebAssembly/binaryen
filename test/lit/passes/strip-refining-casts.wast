  ;; TNH:      (func $call (type $10) (param $x (ref $Super)) (param $ns (ref null $Super)) (param $any anyref)
  ;; TNH-NEXT:  (call $callee
  ;; TNH-NEXT:   (local.get $x)
  ;; TNH-NEXT:  )
