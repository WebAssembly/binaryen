  ;; TNH-NEXT:    (local.get $any)
  ;; TNH-NEXT:   )
  ;; TNH-NEXT:  )
  ;; TNH-NEXT:  (call $cwe
  ;; TNH-NEXT:   (ref.cast (ref $Sub)
  ;; TNH-NEXT:    (local.get $x)
  ;; TNH-NEXT:   )
  ;; TNH-NEXT:   (ref.func $target-sub)
  ;; TNH-NEXT:  )
  ;; TNH-NEXT: )
  ;; NO_TNH:      (func $call (type $10) (param $x (ref $Super)) (param $ns (ref null $Super)) (param $any anyref)
  ;; NO_TNH-NEXT:  (call $callee
  ;; NO_TNH-NEXT:   (ref.cast (ref $Sub)
  ;; NO_TNH-NEXT:    (local.get $x)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (call $callee
  ;; NO_TNH-NEXT:   (ref.cast (ref $SubSub)
  ;; NO_TNH-NEXT:    (ref.cast (ref $Sub)
  ;; NO_TNH-NEXT:     (local.get $x)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (call $callee
  ;; NO_TNH-NEXT:   (ref.cast (ref $Sub)
  ;; NO_TNH-NEXT:    (ref.as_non_null
  ;; NO_TNH-NEXT:     (local.get $ns)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (call $callee
  ;; NO_TNH-NEXT:   (ref.cast (ref $Sub)
  ;; NO_TNH-NEXT:    (local.get $any)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (call $cwe
  ;; NO_TNH-NEXT:   (ref.cast (ref $Sub)
  ;; NO_TNH-NEXT:    (local.get $x)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:   (ref.func $target-sub)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $call (param $x (ref $Super)) (param $ns (ref null $Super)) (param $any anyref)
    ;; The operand $x already satisfies the parameter type (ref $Super), so the
    ;; downcast to $Sub can be skipped in TNH mode.
    (call $callee
      (ref.cast (ref $Sub)
        (local.get $x)
      )
    )
    ;; Chained casts where the innermost operand already satisfies the parameter
    ;; type are all stripped.
    (call $callee
      (ref.cast (ref $SubSub)
        (ref.cast (ref $Sub)
          (local.get $x)
        )
      )
    )
    ;; Here $ns is nullable while the parameter requires (ref $Super), so the
    ;; outer cast to (ref $Sub) is stripped down to (ref.as_non_null $ns), which
    ;; is kept because $ns does not satisfy (ref $Super).
    (call $callee
      (ref.cast (ref $Sub)
        (ref.as_non_null
          (local.get $ns)
        )
      )
    )
    ;; Here $any is not a subtype of (ref $Super), so the cast must be kept.
    (call $callee
      (ref.cast (ref $Sub)
        (local.get $any)
      )
    )
    ;; Arguments of call.without.effects must match the parameters of the actual
    ;; target, not the intrinsic import, so casts on them must be kept.
    (call $cwe
      (ref.cast (ref $Sub)
        (local.get $x)
      )
      (ref.func $target-sub)
    )
  )

