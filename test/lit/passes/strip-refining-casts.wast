  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $call-ref (param $fn (ref $Sig)) (param $x (ref $Super)) (param $any anyref)
    (call_ref $Sig
      (ref.cast (ref $Sub)
        (local.get $x)
      )
      (local.get $fn)
    )
    (call_ref $Sig
      (ref.cast (ref $Sub)
        (local.get $any)
      )
      (local.get $fn)
    )
  )

