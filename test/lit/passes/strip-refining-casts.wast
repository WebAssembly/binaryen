  ;; NO_TNH-NEXT:   (ref.test (ref $Super)
  ;; NO_TNH-NEXT:    (block ;; (replaces unreachable RefCast we can't emit)
  ;; NO_TNH-NEXT:     (drop
  ;; NO_TNH-NEXT:      (unreachable)
  ;; NO_TNH-NEXT:     )
  ;; NO_TNH-NEXT:     (unreachable)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $keep-descriptor-and-unreachable (param $c i32) (param $x anyref) (param $d (ref $Desc))
    (local $l anyref)
    ;; Descriptor casts can be removed if the descriptor has no side effects.
    (local.set $l
      (ref.cast_desc_eq (ref $Described)
        (local.get $x)
        (local.get $d)
      )
    )
    ;; Descriptor casts must not be removed if the descriptor has side effects.
    (local.set $l
      (ref.cast_desc_eq (ref $Described)
        (local.get $x)
        (block (result (ref $Desc))
          (call $callee
            (struct.new_default $Super)
          )
          (local.get $d)
        )
      )
    )
    ;; Unreachable expressions must be handled safely.
    (drop
      (struct.new $Container
        (unreachable)
      )
    )
    (drop
      (array.new $Arr
        (unreachable)
        (i32.const 1)
      )
    )
    (drop
      (array.new_fixed $Arr 1
        (unreachable)
      )
    )
    (drop
      (select (result anyref)
        (ref.as_non_null
          (local.get $x)
        )
        (unreachable)
        (local.get $c)
      )
    )
    (drop
      (ref.test (ref $Super)
        (ref.cast (ref any)
          (unreachable)
        )
      )
    )
  )

