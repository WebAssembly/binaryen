  ;; NO_TNH-NEXT:    (local.get $ns)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (local.tee $l
  ;; NO_TNH-NEXT:    (ref.cast (ref $Sub)
  ;; NO_TNH-NEXT:     (local.get $x)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (local.set $l
  ;; NO_TNH-NEXT:   (ref.as_non_null
  ;; NO_TNH-NEXT:    (unreachable)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (local.set $l
  ;; NO_TNH-NEXT:   (ref.cast (ref $Sub)
  ;; NO_TNH-NEXT:    (local.get $any)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (global.set $g
  ;; NO_TNH-NEXT:   (ref.cast (ref $Sub)
  ;; NO_TNH-NEXT:    (local.get $x)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (global.set $g
  ;; NO_TNH-NEXT:   (ref.as_non_null
  ;; NO_TNH-NEXT:    (local.get $ns)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (global.set $g-any
  ;; NO_TNH-NEXT:   (any.convert_extern
  ;; NO_TNH-NEXT:    (local.get $ext)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $local-and-global-set (param $x (ref $Super)) (param $ns (ref null $Super)) (param $any anyref) (param $ext externref)
    (local $l (ref null $Super))
    (local.set $l
      (ref.cast (ref $Sub)
        (local.get $x)
      )
    )
    (local.set $l
      (ref.as_non_null
        (local.get $ns)
      )
    )
    ;; In Binaryen IR, local.tee has the type of the local, so its cast is also
    ;; removed.
    (drop
      (local.tee $l
        (ref.cast (ref $Sub)
          (local.get $x)
        )
      )
    )
    ;; An unreachable cast is replaced with its unreachable operand.
    (local.set $l
      (ref.as_non_null
        (unreachable)
      )
    )
    ;; Non-subtype operand: cast must be kept.
    (local.set $l
      (ref.cast (ref $Sub)
        (local.get $any)
      )
    )
    (global.set $g
      (ref.cast (ref $Sub)
        (local.get $x)
      )
    )
    (global.set $g
      (ref.as_non_null
        (local.get $ns)
      )
    )
    ;; Non-RefAsNonNull operations like any.convert_extern must not be removed.
    (global.set $g-any
      (any.convert_extern
        (local.get $ext)
      )
    )
  )

