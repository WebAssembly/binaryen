;; NOTE: Assertions have been generated by update_lit_checks.py and should not be edited.
;; RUN: wasm-opt %s --strip-refining-casts --traps-never-happen -all -S -o - | filecheck %s --check-prefix TNH
;; RUN: wasm-opt %s --strip-refining-casts                      -all -S -o - | filecheck %s --check-prefix NO_TNH

(module
