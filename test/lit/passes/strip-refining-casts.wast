  ;; NO_TNH-NEXT:    (ref.cast (ref $Sub)
  ;; NO_TNH-NEXT:     (local.get $ns)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (ref.test (ref $SubSub)
  ;; NO_TNH-NEXT:    (ref.as_non_null
  ;; NO_TNH-NEXT:     (local.get $ns)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (ref.test (ref $Super)
  ;; NO_TNH-NEXT:    (ref.as_non_null
  ;; NO_TNH-NEXT:     (local.get $ns)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (ref.test (ref none)
  ;; NO_TNH-NEXT:    (ref.cast (ref $Sub)
  ;; NO_TNH-NEXT:     (local.get $s)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $ref-test (param $s (ref $Super)) (param $ns (ref null $Super))
    ;; Undecided ref.test: casts on the input do not affect the outcome and can
    ;; be removed.
    (drop
      (ref.test (ref $SubSub)
        (ref.cast (ref $Sub)
          (local.get $s)
        )
      )
    )
    (drop
      (ref.test (ref $SubSub)
        (ref.cast (ref $Sub)
          (local.get $ns)
        )
      )
    )
    (drop
      (ref.test (ref $SubSub)
        (ref.as_non_null
          (local.get $ns)
        )
      )
    )
    ;; Decided ref.test (always 1 if non-trapping): the ref.as_non_null
    ;; determines the outcome, so it is left for OptimizeInstructions to
    ;; resolve.
    (drop
      (ref.test (ref $Super)
        (ref.as_non_null
          (local.get $ns)
        )
      )
    )
    ;; Decided ref.test (always 0 if non-trapping): $Sub and $Sub2 are disjoint,
    ;; so the cast determines the outcome and is left for OptimizeInstructions.
    (drop
      (ref.test (ref $Sub2)
        (ref.cast (ref $Sub)
          (local.get $s)
        )
      )
    )
  )

