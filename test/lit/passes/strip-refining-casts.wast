      (local.get $c)
      (ref.cast (ref $Sub)
        (local.get $any)
      )
    )
    (array.set $Arr
      (local.get $a)
      (i32.const 0)
      (ref.cast (ref $Sub)
        (local.get $s)
      )
    )
    (array.set $Arr
      (local.get $a)
      (i32.const 0)
      (ref.cast (ref $Sub)
        (local.get $any)
      )
    )
    (drop
      (struct.new $Container
        (ref.cast (ref $Sub)
          (local.get $s)
        )
      )
    )
    (drop
      (array.new $Arr
        (ref.cast (ref $Sub)
          (local.get $s)
        )
        (i32.const 2)
      )
    )
    (drop
      (array.new_fixed $Arr 2
        (ref.cast (ref $Sub)
          (local.get $s)
        )
        (ref.as_non_null
          (local.get $ns)
        )
      )
    )
  )

