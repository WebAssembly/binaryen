        (ref.cast (ref $Sub)
          (local.get $a)
        )
        (ref.cast (ref $Sub2)
          (local.get $b)
        )
        (local.get $cond)
      )
    )
    ;; Here $any is not a subtype of (ref $Super), so its cast must be kept.
