  ;; TNH:      (type $Sub (sub $Super (struct (field i32) (field i64))))
  ;; NO_TNH:      (type $Sub (sub $Super (struct (field i32) (field i64))))
  (type $Sub (sub $Super (struct (field i32) (field i64))))

