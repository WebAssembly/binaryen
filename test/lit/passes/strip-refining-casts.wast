  ;; TNH:      (global $g-any (mut anyref) (ref.null none))
  ;; NO_TNH:      (global $g-any (mut anyref) (ref.null none))
  (global $g-any (mut anyref) (ref.null any))
  ;; TNH:      (table $t 1 1 funcref)
  ;; NO_TNH:      (table $t 1 1 funcref)
  (table $t 1 1 funcref)

