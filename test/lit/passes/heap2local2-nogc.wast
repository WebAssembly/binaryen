;; NOTE: Assertions have been generated by update_lit_checks.py and should not be edited.
;; RUN: wasm-opt %s -all --disable-gc --heap2local2 -S -o - | filecheck %s

(module
  ;; CHECK:      (func $non-gc (param $x i32) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $non-gc (param $x i32) (result i32)
    ;; Without GC enabled, Heap2Local2 returns immediately.
    (i32.add
      (local.get $x)
      (i32.const 1)
    )
  )
)
