;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt -all --dae -S -o - | filecheck %s --check-prefix=NOOPT
;; RUN: foreach %s %t wasm-opt -all --dae-optimizing -S -o - | filecheck %s

;; When DAE refines the result type of a function, casts in the callers may
;; become statically known to succeed. With --dae-optimizing, the callers are
;; optimized and those casts are removed. With --dae, they are left alone.
(module
 ;; NOOPT:      (type $A (struct))
 ;; CHECK:      (type $0 (func (result (ref eq))))

 ;; CHECK:      (type $A (struct))
 (type $A (struct))

 ;; NOOPT:      (type $1 (func (result (ref eq))))

 ;; NOOPT:      (type $2 (func (result (ref (exact $A)))))

 ;; NOOPT:      (type $3 (func (param i32) (result (ref eq))))

 ;; NOOPT:      (export "direct" (func $direct))

 ;; NOOPT:      (export "local" (func $local))

 ;; NOOPT:      (export "tee" (func $tee))

 ;; NOOPT:      (export "block" (func $block))

 ;; NOOPT:      (func $make (type $2) (result (ref (exact $A)))
 ;; NOOPT-NEXT:  (struct.new_default $A)
 ;; NOOPT-NEXT: )
 ;; CHECK:      (type $2 (func (result (ref (exact $A)))))

 ;; CHECK:      (type $3 (func (param i32) (result (ref eq))))

 ;; CHECK:      (export "direct" (func $direct))

 ;; CHECK:      (export "local" (func $local))

 ;; CHECK:      (export "tee" (func $tee))

 ;; CHECK:      (export "block" (func $block))

 ;; CHECK:      (func $make (type $2) (result (ref (exact $A)))
 ;; CHECK-NEXT:  (struct.new_default $A)
 ;; CHECK-NEXT: )
 (func $make (result (ref eq))
  (struct.new $A)
 )

 ;; The cast applies directly to the call.
 ;; NOOPT:      (func $direct (type $1) (result (ref eq))
 ;; NOOPT-NEXT:  (ref.cast (ref (exact $A))
 ;; NOOPT-NEXT:   (call $make)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $direct (type $0) (result (ref eq))
 ;; CHECK-NEXT:  (call $make)
 ;; CHECK-NEXT: )
 (func $direct (export "direct") (result (ref eq))
  (ref.cast (ref $A)
   (call $make)
  )
 )

 ;; The result goes through a local.
 ;; NOOPT:      (func $local (type $1) (result (ref eq))
 ;; NOOPT-NEXT:  (local $x (ref eq))
 ;; NOOPT-NEXT:  (local.set $x
 ;; NOOPT-NEXT:   (call $make)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT:  (ref.cast (ref $A)
 ;; NOOPT-NEXT:   (local.get $x)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $local (type $0) (result (ref eq))
 ;; CHECK-NEXT:  (call $make)
 ;; CHECK-NEXT: )
 (func $local (export "local") (result (ref eq))
  (local $x (ref eq))
  (local.set $x
   (call $make)
  )
  (ref.cast (ref $A)
   (local.get $x)
  )
 )

 ;; The result goes through a local.tee, and is used twice.
 ;; NOOPT:      (func $tee (type $1) (result (ref eq))
 ;; NOOPT-NEXT:  (local $x (ref eq))
 ;; NOOPT-NEXT:  (drop
 ;; NOOPT-NEXT:   (ref.cast (ref $A)
 ;; NOOPT-NEXT:    (local.tee $x
 ;; NOOPT-NEXT:     (call $make)
 ;; NOOPT-NEXT:    )
 ;; NOOPT-NEXT:   )
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT:  (ref.cast (ref $A)
 ;; NOOPT-NEXT:   (local.get $x)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $tee (type $0) (result (ref eq))
 ;; CHECK-NEXT:  (call $make)
 ;; CHECK-NEXT: )
 (func $tee (export "tee") (result (ref eq))
  (local $x (ref eq))
  (drop
   (ref.cast (ref $A)
    (local.tee $x
     (call $make)
    )
   )
  )
  (ref.cast (ref $A)
   (local.get $x)
  )
 )

 ;; The result flows out of a block.
 ;; NOOPT:      (func $block (type $3) (param $i i32) (result (ref eq))
 ;; NOOPT-NEXT:  (ref.cast (ref (exact $A))
 ;; NOOPT-NEXT:   (block (result (ref (exact $A)))
 ;; NOOPT-NEXT:    (drop
 ;; NOOPT-NEXT:     (local.get $i)
 ;; NOOPT-NEXT:    )
 ;; NOOPT-NEXT:    (call $make)
 ;; NOOPT-NEXT:   )
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $block (type $3) (param $0 i32) (result (ref eq))
 ;; CHECK-NEXT:  (call $make)
 ;; CHECK-NEXT: )
 (func $block (export "block") (param $i i32) (result (ref eq))
  (ref.cast (ref $A)
   (block (result (ref eq))
    (drop
     (local.get $i)
    )
    (call $make)
   )
  )
 )
)

;; A caller that is also modified later in the same iteration: $caller calls
;; $make, whose result is refined, and $drop-param, whose parameter is removed.
;; The cast is removed after both changes.
(module
 ;; NOOPT:      (type $A (struct))
 ;; CHECK:      (type $A (struct))
 (type $A (struct))

 ;; NOOPT:      (type $1 (func (result (ref (exact $A)))))

 ;; NOOPT:      (type $2 (func))

 ;; NOOPT:      (type $3 (func (result (ref eq))))

 ;; NOOPT:      (export "caller" (func $caller))

 ;; NOOPT:      (func $make (type $1) (result (ref (exact $A)))
 ;; NOOPT-NEXT:  (struct.new_default $A)
 ;; NOOPT-NEXT: )
 ;; CHECK:      (type $1 (func (result (ref (exact $A)))))

 ;; CHECK:      (type $2 (func))

 ;; CHECK:      (type $3 (func (result (ref eq))))

 ;; CHECK:      (export "caller" (func $caller))

 ;; CHECK:      (func $make (type $1) (result (ref (exact $A)))
 ;; CHECK-NEXT:  (struct.new_default $A)
 ;; CHECK-NEXT: )
 (func $make (result (ref eq))
  (struct.new $A)
 )

 ;; NOOPT:      (func $drop-param (type $2)
 ;; NOOPT-NEXT:  (local $0 i32)
 ;; NOOPT-NEXT:  (local.set $0
 ;; NOOPT-NEXT:   (i32.const 42)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT:  (block
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $drop-param (type $2)
 ;; CHECK-NEXT:  (nop)
 ;; CHECK-NEXT: )
 (func $drop-param (param $unused i32)
 )

 ;; NOOPT:      (func $caller (type $3) (result (ref eq))
 ;; NOOPT-NEXT:  (call $drop-param)
 ;; NOOPT-NEXT:  (ref.cast (ref (exact $A))
 ;; NOOPT-NEXT:   (call $make)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $caller (type $3) (result (ref eq))
 ;; CHECK-NEXT:  (call $drop-param)
 ;; CHECK-NEXT:  (call $make)
 ;; CHECK-NEXT: )
 (func $caller (export "caller") (result (ref eq))
  (call $drop-param
   (i32.const 42)
  )
  (ref.cast (ref $A)
   (call $make)
  )
 )
)

;; A chain of calls. Once $inner's result is refined, optimizing $middle
;; removes its cast and its local, which lets a later iteration refine the
;; result of $middle to an exact type, and then remove the cast in $outer.
;; Without optimization, the result of $middle is only refined to the type of
;; its cast.
(module
 ;; NOOPT:      (type $A (struct))
 ;; CHECK:      (type $A (struct))
 (type $A (struct))

 ;; NOOPT:      (type $1 (func (result (ref (exact $A)))))

 ;; NOOPT:      (type $2 (func (result (ref $A))))

 ;; NOOPT:      (type $3 (func (result (ref eq))))

 ;; NOOPT:      (export "outer" (func $outer))

 ;; NOOPT:      (func $inner (type $1) (result (ref (exact $A)))
 ;; NOOPT-NEXT:  (struct.new_default $A)
 ;; NOOPT-NEXT: )
 ;; CHECK:      (type $1 (func (result (ref (exact $A)))))

 ;; CHECK:      (type $2 (func (result (ref eq))))

 ;; CHECK:      (export "outer" (func $outer))

 ;; CHECK:      (func $inner (type $1) (result (ref (exact $A)))
 ;; CHECK-NEXT:  (struct.new_default $A)
 ;; CHECK-NEXT: )
 (func $inner (result (ref eq))
  (struct.new $A)
 )

 ;; NOOPT:      (func $middle (type $2) (result (ref $A))
 ;; NOOPT-NEXT:  (local $x (ref eq))
 ;; NOOPT-NEXT:  (local.set $x
 ;; NOOPT-NEXT:   (call $inner)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT:  (ref.cast (ref $A)
 ;; NOOPT-NEXT:   (local.get $x)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $middle (type $1) (result (ref (exact $A)))
 ;; CHECK-NEXT:  (call $inner)
 ;; CHECK-NEXT: )
 (func $middle (result (ref eq))
  (local $x (ref eq))
  (local.set $x
   (call $inner)
  )
  (ref.cast (ref $A)
   (local.get $x)
  )
 )

 ;; NOOPT:      (func $outer (type $3) (result (ref eq))
 ;; NOOPT-NEXT:  (ref.cast (ref $A)
 ;; NOOPT-NEXT:   (call $middle)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $outer (type $2) (result (ref eq))
 ;; CHECK-NEXT:  (call $middle)
 ;; CHECK-NEXT: )
 (func $outer (export "outer") (result (ref eq))
  (ref.cast (ref $A)
   (call $middle)
  )
 )
)
