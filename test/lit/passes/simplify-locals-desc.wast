;; NOTE: Assertions have been generated by update_lit_checks.py and should not be edited.

;; RUN: wasm-opt %s --simplify-locals -all -S -o - | filecheck %s

(module
  (rec
    (type $struct (descriptor $desc) (struct))
    (type $desc (describes $struct) (struct))
  )

  (func $test (param $ref (ref null $struct)) (result (ref $struct))
    ;; The tee below can be removed - nothing reads from it - and after that,
    ;; we must still validate properly: the br_on must send a non-null value to
    ;; the block and return it.
    (local $temp (ref $desc))
    (block $block (result (ref $struct))
      (drop
        (br_on_cast_desc_eq_fail $block (ref null $struct) (ref null $struct)
          (local.get $ref)
          (local.tee $temp
            (ref.as_non_null
              (ref.null none)
            )
          )
        )
      )
      (unreachable)
    )
  )
)

