 ;; CHECK:      (func $throw (type $func-void)
 ;; CHECK-NEXT:  (local $val eqref)
 ;; CHECK-NEXT:  (throw $tag-eq
 ;; CHECK-NEXT:   (local.get $val)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $throw
  (local $val i31ref)
  ;; Require typeof($val) <: eqref.
  (throw $tag-eq
   (local.get $val)
  )
 )

