 ;; CHECK-NEXT:  (local $exn exnref)
 ;; CHECK-NEXT:  (throw_ref
 ;; CHECK-NEXT:   (local.get $exn)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $throw-ref
  (local $exn nullexnref)
  ;; Require typeof($exn) <: exnref.
  (throw_ref
   (local.get $exn)
