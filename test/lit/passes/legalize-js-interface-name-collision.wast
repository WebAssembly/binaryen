;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: wasm-opt %s --legalize-js-interface -S -o - | filecheck %s

;; The module already has functions named like the ones the pass would create
;; for the illegal import. The pass must pick fresh names instead of reusing
;; (or failing to add) the existing ones.

(module
 (import "env" "imp" (func $imp (param i64) (result i32)))
 ;; CHECK:      (type $0 (func (param i64) (result i32)))

 ;; CHECK:      (type $1 (func (result f32)))

 ;; CHECK:      (type $2 (func (result i32)))

 ;; CHECK:      (type $3 (func (param i32 i32) (result i32)))

 ;; CHECK:      (import "env" "imp" (func $legalimport$imp_4 (param i32 i32) (result i32)))

 ;; CHECK:      (func $legalfunc$imp (param $0 i64) (result i32)
 ;; CHECK-NEXT:  (i32.const 7)
 ;; CHECK-NEXT: )
 (func $legalfunc$imp (param i64) (result i32)
  (i32.const 7)
 )
 ;; CHECK:      (func $legalimport$imp (result f32)
 ;; CHECK-NEXT:  (f32.const 8)
 ;; CHECK-NEXT: )
 (func $legalimport$imp (result f32)
  (f32.const 8)
 )
 ;; CHECK:      (func $f (result i32)
 ;; CHECK-NEXT:  (call $legalfunc$imp_4
 ;; CHECK-NEXT:   (i64.const 1)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $f (result i32)
  (call $imp
   (i64.const 1)
  )
 )
)
;; CHECK:      (func $legalfunc$imp_4 (param $0 i64) (result i32)
;; CHECK-NEXT:  (call $legalimport$imp_4
;; CHECK-NEXT:   (i32.wrap_i64
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (i32.wrap_i64
;; CHECK-NEXT:    (i64.shr_u
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:     (i64.const 32)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
