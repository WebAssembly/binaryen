  ;; RTRIP-STACK-IR-NEXT:  end
  ;; RTRIP-STACK-IR-NEXT: )
  (func $outer-stack-survives (param $a i32) (param $b i32) (result i32)
    ;; A value left on the outer stack underneath a none-typed parameterized
    ;; block round-trips without clobbering the outer value.
    (local $z i32)
    (local $x i32)
    (local.set $z
      (i32.add
        (local.get $a)
        (i32.const 1)
      )
    )
    (local.set $x
      (i32.add
        (local.get $b)
        (i32.const 2)
      )
    )
    (block $in
      (br_if $in
        (local.get $x)
      )
    )
    (local.get $z)
  )

