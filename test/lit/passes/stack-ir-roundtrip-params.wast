  ;; RTRIP-STACK-IR:      (func $nested-blocks-hoist-across-none (type $1) (param $a i32) (param $b i32) (result i32)
  ;; RTRIP-STACK-IR-NEXT:  (local $x i32)
  ;; RTRIP-STACK-IR-NEXT:  (local $y i32)
  ;; RTRIP-STACK-IR-NEXT:  (local $scratch i32)
  ;; RTRIP-STACK-IR-NEXT:  (local $scratch_5 i32)
  ;; RTRIP-STACK-IR-NEXT:  local.get $a
  ;; RTRIP-STACK-IR-NEXT:  i32.const 1
  ;; RTRIP-STACK-IR-NEXT:  i32.add
  ;; RTRIP-STACK-IR-NEXT:  local.get $b
  ;; RTRIP-STACK-IR-NEXT:  i32.const 2
  ;; RTRIP-STACK-IR-NEXT:  i32.add
  ;; RTRIP-STACK-IR-NEXT:  block $b1 (type $1) (param i32 i32) (result i32)
  ;; RTRIP-STACK-IR-NEXT:   local.get $a
  ;; RTRIP-STACK-IR-NEXT:   if
  ;; RTRIP-STACK-IR-NEXT:    i32.const 10
  ;; RTRIP-STACK-IR-NEXT:    br $b1
  ;; RTRIP-STACK-IR-NEXT:   end
  ;; RTRIP-STACK-IR-NEXT:   block $b2 (type $1) (param i32 i32) (result i32)
  ;; RTRIP-STACK-IR-NEXT:    local.get $b
  ;; RTRIP-STACK-IR-NEXT:    if
  ;; RTRIP-STACK-IR-NEXT:     i32.const 20
  ;; RTRIP-STACK-IR-NEXT:     br $b2
  ;; RTRIP-STACK-IR-NEXT:    end
  ;; RTRIP-STACK-IR-NEXT:    block $b3 (type $1) (param i32 i32) (result i32)
  ;; RTRIP-STACK-IR-NEXT:     local.get $a
  ;; RTRIP-STACK-IR-NEXT:     i32.eqz
  ;; RTRIP-STACK-IR-NEXT:     if
  ;; RTRIP-STACK-IR-NEXT:      i32.const 30
  ;; RTRIP-STACK-IR-NEXT:      br $b3
  ;; RTRIP-STACK-IR-NEXT:     end
  ;; RTRIP-STACK-IR-NEXT:     i32.add
  ;; RTRIP-STACK-IR-NEXT:    end
  ;; RTRIP-STACK-IR-NEXT:   end
  ;; RTRIP-STACK-IR-NEXT:  end
  ;; RTRIP-STACK-IR-NEXT: )
  (func $nested-blocks-hoist-across-none (param $a i32) (param $b i32) (result i32)
    ;; None-typed instructions before nested parameterized blocks or before
    ;; consuming block inputs hoist the input local.gets directly without
    ;; allocating extra scratch locals or synthetic wrapper blocks.
    (local $x i32)
    (local $y i32)
    (local.set $x
      (i32.add
        (local.get $a)
        (i32.const 1)
      )
    )
    (local.set $y
      (i32.add
        (local.get $b)
        (i32.const 2)
      )
    )
    (block $b1 (result i32)
      (if
        (local.get $a)
        (then
          (br $b1
            (i32.const 10)
          )
        )
      )
      (block $b2 (result i32)
        (if
          (local.get $b)
          (then
            (br $b2
              (i32.const 20)
            )
          )
        )
        (block $b3 (result i32)
          (if
            (i32.eqz
              (local.get $a)
            )
            (then
              (br $b3
                (i32.const 30)
              )
            )
          )
          (i32.add
            (local.get $x)
            (local.get $y)
          )
        )
      )
    )
  )

