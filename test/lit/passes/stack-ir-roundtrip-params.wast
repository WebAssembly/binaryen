;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; Check that block parameters emitted by StackIR round-trip cleanly through
;; IRBuilder without introducing extra scratch locals or wrapper blocks, and
;; that re-emitting StackIR after round-tripping reproduces the same
;; parameterized blocks.

;; RUN: wasm-opt %s -all --optimize-level=3 --generate-stack-ir --optimize-stack-ir --print-stack-ir | filecheck %s --check-prefix=STACK-IR
;; RUN: wasm-opt %s -all --optimize-level=3 --generate-stack-ir --optimize-stack-ir --roundtrip -S -o - | filecheck %s --check-prefix=RTRIP-IR
;; RUN: wasm-opt %s -all --optimize-level=3 --generate-stack-ir --optimize-stack-ir --roundtrip --print-stack-ir | filecheck %s --check-prefix=RTRIP-STACK-IR

(module
  ;; STACK-IR:      (type $0 (func (param i32 i32) (result i32)))

  ;; STACK-IR:      (type $struct (struct))
  ;; RTRIP-IR:      (type $struct (struct))
  ;; RTRIP-STACK-IR:      (type $struct (struct))
  (type $struct (struct))
  ;; STACK-IR:      (type $2 (func (param i32) (result i32)))

  ;; STACK-IR:      (type $3 (func (param i32 i64) (result i32)))

  ;; STACK-IR:      (type $4 (func (param i32 i64)))

  ;; STACK-IR:      (type $5 (func (param (ref $struct) i32) (result (ref $struct))))

  ;; STACK-IR:      (type $6 (func (param i32 i64 f32) (result i32)))

  ;; STACK-IR:      (type $7 (func (param i32)))

  ;; STACK-IR:      (type $8 (func (param (ref $struct)) (result (ref $struct))))

  ;; STACK-IR:      (type $9 (func (param i32 f32) (result i32)))

  ;; STACK-IR:      (func $single-block-param (type $2) (param $a i32) (result i32)
  ;; STACK-IR-NEXT:  (local $x i32)
  ;; STACK-IR-NEXT:  local.get $a
  ;; STACK-IR-NEXT:  i32.const 1
  ;; STACK-IR-NEXT:  i32.add
  ;; STACK-IR-NEXT:  block $b (type $2) (param i32) (result i32)
  ;; STACK-IR-NEXT:   i32.eqz
  ;; STACK-IR-NEXT:   if
  ;; STACK-IR-NEXT:    i32.const 10
  ;; STACK-IR-NEXT:    br $b
  ;; STACK-IR-NEXT:   end
  ;; STACK-IR-NEXT:   i32.const 20
  ;; STACK-IR-NEXT:  end
  ;; STACK-IR-NEXT: )
