  ;; RTRIP-IR-NEXT:    (local.get $a)
  ;; RTRIP-IR-NEXT:    (then
  ;; RTRIP-IR-NEXT:     (br $b1
  ;; RTRIP-IR-NEXT:      (i32.const 10)
  ;; RTRIP-IR-NEXT:     )
  ;; RTRIP-IR-NEXT:    )
  ;; RTRIP-IR-NEXT:   )
  ;; RTRIP-IR-NEXT:   (block $b2 (result i32)
  ;; RTRIP-IR-NEXT:    (if
  ;; RTRIP-IR-NEXT:     (local.get $b)
  ;; RTRIP-IR-NEXT:     (then
  ;; RTRIP-IR-NEXT:      (br $b2
