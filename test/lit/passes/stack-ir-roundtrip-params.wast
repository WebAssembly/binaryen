    (local $y i64)
    (local $z f32)
    (local.set $x
      (i32.add
        (local.get $a)
        (i32.const 1)
      )
    )
    (block $b1 (result i32)
      (local.set $y
        (i64.add
          (local.get $b)
          (i64.const 2)
        )
      )
      (block $b2 (result i32)
        (if
          (i32.wrap_i64
            (local.get $y)
          )
          (then
            (br $b2
              (i32.const 10)
