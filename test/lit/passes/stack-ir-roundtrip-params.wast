  ;; RTRIP-IR:      (type $2 (func (param i32) (result i32)))

  ;; RTRIP-IR:      (type $3 (func (param i32 i64) (result i32)))

  ;; RTRIP-IR:      (type $4 (func (param (ref $struct) i32) (result (ref $struct))))

  ;; RTRIP-IR:      (type $5 (func (param i32 i64 f32) (result i32)))

  ;; RTRIP-IR:      (func $single-block-param (type $2) (param $a i32) (result i32)
  ;; RTRIP-IR-NEXT:  (local $x i32)
  ;; RTRIP-IR-NEXT:  (local $scratch i32)
  ;; RTRIP-IR-NEXT:  (local.set $scratch
  ;; RTRIP-IR-NEXT:   (i32.add
  ;; RTRIP-IR-NEXT:    (local.get $a)
  ;; RTRIP-IR-NEXT:    (i32.const 1)
  ;; RTRIP-IR-NEXT:   )
  ;; RTRIP-IR-NEXT:  )
  ;; RTRIP-IR-NEXT:  (block $b (result i32)
  ;; RTRIP-IR-NEXT:   (if
  ;; RTRIP-IR-NEXT:    (i32.eqz
  ;; RTRIP-IR-NEXT:     (local.get $scratch)
  ;; RTRIP-IR-NEXT:    )
  ;; RTRIP-IR-NEXT:    (then
  ;; RTRIP-IR-NEXT:     (br $b
  ;; RTRIP-IR-NEXT:      (i32.const 10)
  ;; RTRIP-IR-NEXT:     )
  ;; RTRIP-IR-NEXT:    )
  ;; RTRIP-IR-NEXT:   )
  ;; RTRIP-IR-NEXT:   (i32.const 20)
  ;; RTRIP-IR-NEXT:  )
  ;; RTRIP-IR-NEXT: )
  ;; RTRIP-STACK-IR:      (type $1 (func (param i32 i32) (result i32)))

  ;; RTRIP-STACK-IR:      (type $2 (func (param i32) (result i32)))

  ;; RTRIP-STACK-IR:      (type $3 (func (param i32 i64) (result i32)))

  ;; RTRIP-STACK-IR:      (type $4 (func (param i32 i64)))

  ;; RTRIP-STACK-IR:      (type $5 (func (param (ref $struct) i32) (result (ref $struct))))

  ;; RTRIP-STACK-IR:      (type $6 (func (param i32 i64 f32) (result i32)))

  ;; RTRIP-STACK-IR:      (type $7 (func (param i32)))

  ;; RTRIP-STACK-IR:      (type $8 (func (param (ref $struct)) (result (ref $struct))))

  ;; RTRIP-STACK-IR:      (type $9 (func (param i32 f32) (result i32)))

  ;; RTRIP-STACK-IR:      (func $single-block-param (type $2) (param $a i32) (result i32)
  ;; RTRIP-STACK-IR-NEXT:  (local $x i32)
  ;; RTRIP-STACK-IR-NEXT:  (local $scratch i32)
  ;; RTRIP-STACK-IR-NEXT:  local.get $a
  ;; RTRIP-STACK-IR-NEXT:  i32.const 1
  ;; RTRIP-STACK-IR-NEXT:  i32.add
  ;; RTRIP-STACK-IR-NEXT:  block $b (type $2) (param i32) (result i32)
  ;; RTRIP-STACK-IR-NEXT:   i32.eqz
  ;; RTRIP-STACK-IR-NEXT:   if
  ;; RTRIP-STACK-IR-NEXT:    i32.const 10
  ;; RTRIP-STACK-IR-NEXT:    br $b
  ;; RTRIP-STACK-IR-NEXT:   end
  ;; RTRIP-STACK-IR-NEXT:   i32.const 20
  ;; RTRIP-STACK-IR-NEXT:  end
  ;; RTRIP-STACK-IR-NEXT: )
  (func $single-block-param (param $a i32) (result i32)
    ;; A single value threaded into a block parameter round-trips using a single
    ;; scalar scratch local and re-emits the same parameterized block.
    (local $x i32)
    (local.set $x
      (i32.add
        (local.get $a)
        (i32.const 1)
      )
    )
    (block $b (result i32)
      (if
        (i32.eqz
          (local.get $x)
        )
        (then
          (br $b
            (i32.const 10)
          )
        )
      )
      (i32.const 20)
    )
  )

  ;; STACK-IR:      (func $nested-blocks-tunnel-two-params (type $3) (param $a i32) (param $b i64) (result i32)
  ;; STACK-IR-NEXT:  (local $x i32)
  ;; STACK-IR-NEXT:  (local $y i64)
  ;; STACK-IR-NEXT:  local.get $a
  ;; STACK-IR-NEXT:  i32.const 1
  ;; STACK-IR-NEXT:  i32.add
  ;; STACK-IR-NEXT:  local.get $b
  ;; STACK-IR-NEXT:  i64.const 2
  ;; STACK-IR-NEXT:  i64.add
  ;; STACK-IR-NEXT:  block $b1 (type $3) (param i32 i64) (result i32)
  ;; STACK-IR-NEXT:   block $b2 (type $4) (param i32 i64)
  ;; STACK-IR-NEXT:    block $b3 (type $4) (param i32 i64)
  ;; STACK-IR-NEXT:     i32.wrap_i64
  ;; STACK-IR-NEXT:     i32.add
  ;; STACK-IR-NEXT:     br_if $b3
  ;; STACK-IR-NEXT:     br $b2
  ;; STACK-IR-NEXT:    end
  ;; STACK-IR-NEXT:    i32.const 10
  ;; STACK-IR-NEXT:    br $b1
  ;; STACK-IR-NEXT:   end
  ;; STACK-IR-NEXT:   i32.const 20
  ;; STACK-IR-NEXT:  end
  ;; STACK-IR-NEXT: )
  ;; RTRIP-IR:      (func $nested-blocks-tunnel-two-params (type $3) (param $a i32) (param $b i64) (result i32)
  ;; RTRIP-IR-NEXT:  (local $x i32)
  ;; RTRIP-IR-NEXT:  (local $y i64)
  ;; RTRIP-IR-NEXT:  (local $scratch i32)
  ;; RTRIP-IR-NEXT:  (local $scratch_5 i64)
  ;; RTRIP-IR-NEXT:  (local.set $scratch
  ;; RTRIP-IR-NEXT:   (i32.add
  ;; RTRIP-IR-NEXT:    (local.get $a)
  ;; RTRIP-IR-NEXT:    (i32.const 1)
  ;; RTRIP-IR-NEXT:   )
  ;; RTRIP-IR-NEXT:  )
  ;; RTRIP-IR-NEXT:  (local.set $scratch_5
  ;; RTRIP-IR-NEXT:   (i64.add
  ;; RTRIP-IR-NEXT:    (local.get $b)
  ;; RTRIP-IR-NEXT:    (i64.const 2)
  ;; RTRIP-IR-NEXT:   )
  ;; RTRIP-IR-NEXT:  )
  ;; RTRIP-IR-NEXT:  (block $b1 (result i32)
  ;; RTRIP-IR-NEXT:   (block $b2
  ;; RTRIP-IR-NEXT:    (block $b3
  ;; RTRIP-IR-NEXT:     (br_if $b3
  ;; RTRIP-IR-NEXT:      (i32.add
  ;; RTRIP-IR-NEXT:       (local.get $scratch)
  ;; RTRIP-IR-NEXT:       (i32.wrap_i64
  ;; RTRIP-IR-NEXT:        (local.get $scratch_5)
  ;; RTRIP-IR-NEXT:       )
  ;; RTRIP-IR-NEXT:      )
  ;; RTRIP-IR-NEXT:     )
  ;; RTRIP-IR-NEXT:     (br $b2)
  ;; RTRIP-IR-NEXT:    )
  ;; RTRIP-IR-NEXT:    (br $b1
  ;; RTRIP-IR-NEXT:     (i32.const 10)
  ;; RTRIP-IR-NEXT:    )
  ;; RTRIP-IR-NEXT:   )
  ;; RTRIP-IR-NEXT:   (i32.const 20)
  ;; RTRIP-IR-NEXT:  )
  ;; RTRIP-IR-NEXT: )
  ;; RTRIP-STACK-IR:      (func $nested-blocks-tunnel-two-params (type $3) (param $a i32) (param $b i64) (result i32)
  ;; RTRIP-STACK-IR-NEXT:  (local $x i32)
  ;; RTRIP-STACK-IR-NEXT:  (local $y i64)
  ;; RTRIP-STACK-IR-NEXT:  (local $scratch i32)
  ;; RTRIP-STACK-IR-NEXT:  (local $scratch_5 i64)
  ;; RTRIP-STACK-IR-NEXT:  local.get $a
  ;; RTRIP-STACK-IR-NEXT:  i32.const 1
  ;; RTRIP-STACK-IR-NEXT:  i32.add
  ;; RTRIP-STACK-IR-NEXT:  local.get $b
  ;; RTRIP-STACK-IR-NEXT:  i64.const 2
  ;; RTRIP-STACK-IR-NEXT:  i64.add
  ;; RTRIP-STACK-IR-NEXT:  block $b1 (type $3) (param i32 i64) (result i32)
  ;; RTRIP-STACK-IR-NEXT:   block $b2 (type $4) (param i32 i64)
  ;; RTRIP-STACK-IR-NEXT:    block $b3 (type $4) (param i32 i64)
  ;; RTRIP-STACK-IR-NEXT:     i32.wrap_i64
  ;; RTRIP-STACK-IR-NEXT:     i32.add
  ;; RTRIP-STACK-IR-NEXT:     br_if $b3
  ;; RTRIP-STACK-IR-NEXT:     br $b2
  ;; RTRIP-STACK-IR-NEXT:    end
  ;; RTRIP-STACK-IR-NEXT:    i32.const 10
  ;; RTRIP-STACK-IR-NEXT:    br $b1
  ;; RTRIP-STACK-IR-NEXT:   end
  ;; RTRIP-STACK-IR-NEXT:   i32.const 20
  ;; RTRIP-STACK-IR-NEXT:  end
  ;; RTRIP-STACK-IR-NEXT: )
  (func $nested-blocks-tunnel-two-params (param $a i32) (param $b i64) (result i32)
    ;; Multiple values threaded through nested blocks round-trip using one
    ;; scalar scratch local per input (no tuple locals or per-block copies) by
    ;; tunneling the outer scratch locals through the inner blocks.
    (local $x i32)
    (local $y i64)
    (local.set $x
      (i32.add
        (local.get $a)
        (i32.const 1)
      )
    )
    (local.set $y
      (i64.add
        (local.get $b)
        (i64.const 2)
      )
    )
    (block $b1 (result i32)
      (block $b2
        (block $b3
          (br_if $b3
            (i32.add
              (local.get $x)
              (i32.wrap_i64
                (local.get $y)
              )
            )
          )
          (br $b2)
        )
        (br $b1
          (i32.const 10)
        )
      )
      (i32.const 20)
    )
  )

