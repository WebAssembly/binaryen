  ;; RTRIP-IR-NEXT:      )
  ;; RTRIP-IR-NEXT:     )
  ;; RTRIP-IR-NEXT:    )
  ;; RTRIP-IR-NEXT:    (block $b3 (result i32)
  ;; RTRIP-IR-NEXT:     (if
