;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: wasm-opt %s -all --type-ssa --preserve-type-order -S -o - | filecheck %s

;; These tests are for ChildTyper more than TypeSSA. They check that
;; ChildTyper does not crash when visiting instructions that require type
;; immediate information, whether or not that information is available. These
;; instructions are not sources of exactness for non-descriptor types that
;; TypeSSA would consider optimizing.

(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $desc-struct (sub (descriptor $desc) (struct (field anyref))))
    (type $desc-struct (sub (descriptor $desc) (struct (field anyref))))
    ;; CHECK:       (type $desc (sub (describes $desc-struct) (struct)))
    (type $desc (sub (describes $desc-struct) (struct)))
  )
  ;; CHECK:      (type $i8-array (array (mut i8)))
  (type $i8-array (array (field (mut i8))))
  ;; CHECK:      (type $any-array (array (mut anyref)))
  (type $any-array (array (field (mut anyref))))
  ;; CHECK:      (type $func-empty (func))
  (type $func-empty (func))
  ;; CHECK:      (type $cont-empty (cont $func-empty))
  (type $cont-empty (cont $func-empty))

  ;; CHECK:      (type $6 (func (param anyref (ref null (exact $desc)))))

  ;; CHECK:      (type $7 (func (param anyref)))

  ;; CHECK:      (type $8 (func (param (ref null $i8-array))))

  ;; CHECK:      (type $9 (func (param (ref null $any-array))))

  ;; CHECK:      (type $10 (func (param (ref null $func-empty))))

  ;; CHECK:      (data $data "")
  (data $data "")
  ;; CHECK:      (elem $elem anyref)
  (elem $elem anyref)

  ;; CHECK:      (func $ref-cast-desc-eq (type $6) (param $any anyref) (param $desc-ref (ref null (exact $desc)))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.cast_desc_eq (ref (exact $desc-struct))
  ;; CHECK-NEXT:    (local.get $any)
  ;; CHECK-NEXT:    (local.get $desc-ref)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-cast-desc-eq (param $any anyref) (param $desc-ref (ref null (exact $desc)))
    (drop
      (ref.cast_desc_eq (ref (exact $desc-struct))
        (local.get $any)
        (local.get $desc-ref)
      )
    )
  )

  ;; CHECK:      (func $ref-cast-desc-eq-bot (type $7) (param $any anyref)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable RefCast we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (local.get $any)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-cast-desc-eq-bot (param $any anyref)
    (drop
      (ref.cast_desc_eq (ref (exact $desc-struct))
        (local.get $any)
        (ref.null none)
      )
    )
  )

  ;; CHECK:      (func $array-get (type $8) (param $i8-ref (ref null $i8-array))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (array.get_u $i8-array
  ;; CHECK-NEXT:    (local.get $i8-ref)
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-get (param $i8-ref (ref null $i8-array))
    (drop
      (array.get_u $i8-array
        (local.get $i8-ref)
        (i32.const 0)
      )
    )
  )

  ;; CHECK:      (func $array-get-bot (type $func-empty)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable ArrayGet we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-get-bot
    (drop
      (array.get_u $i8-array
        (ref.null none)
        (i32.const 0)
      )
    )
  )

  ;; CHECK:      (func $array-load (type $8) (param $i8-ref (ref null $i8-array))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.load (type $i8-array)
  ;; CHECK-NEXT:    (local.get $i8-ref)
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-load (param $i8-ref (ref null $i8-array))
    (drop
      (i32.load (type $i8-array)
        (local.get $i8-ref)
        (i32.const 0)
      )
    )
  )

  ;; CHECK:      (func $array-load-bot (type $func-empty)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable ArrayLoad we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-load-bot
    (drop
      (i32.load (type $i8-array)
        (ref.null none)
        (i32.const 0)
      )
    )
  )

  ;; CHECK:      (func $array-store (type $8) (param $i8-ref (ref null $i8-array))
  ;; CHECK-NEXT:  (i32.store (type $i8-array)
  ;; CHECK-NEXT:   (local.get $i8-ref)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-store (param $i8-ref (ref null $i8-array))
    (i32.store (type $i8-array)
      (local.get $i8-ref)
      (i32.const 0)
      (i32.const 0)
    )
  )

  ;; CHECK:      (func $array-store-bot (type $func-empty)
  ;; CHECK-NEXT:  (block ;; (replaces unreachable ArrayStore we can't emit)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-store-bot
    (i32.store (type $i8-array)
      (ref.null none)
      (i32.const 0)
      (i32.const 0)
    )
  )

  ;; CHECK:      (func $array-copy-bot-dest (type $8) (param $i8-ref (ref null $i8-array))
  ;; CHECK-NEXT:  (block ;; (replaces unreachable ArrayCopy we can't emit)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (local.get $i8-ref)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-copy-bot-dest (param $i8-ref (ref null $i8-array))
    (array.copy $i8-array $i8-array
      (ref.null none)
      (i32.const 0)
      (local.get $i8-ref)
      (i32.const 0)
      (i32.const 0)
    )
  )

  ;; CHECK:      (func $array-copy-bot-src (type $8) (param $i8-ref (ref null $i8-array))
  ;; CHECK-NEXT:  (block ;; (replaces unreachable ArrayCopy we can't emit)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (local.get $i8-ref)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-copy-bot-src (param $i8-ref (ref null $i8-array))
    (array.copy $i8-array $i8-array
      (local.get $i8-ref)
      (i32.const 0)
      (ref.null none)
      (i32.const 0)
      (i32.const 0)
    )
  )

  ;; CHECK:      (func $array-init-data (type $8) (param $i8-ref (ref null $i8-array))
  ;; CHECK-NEXT:  (array.init_data $i8-array $data
  ;; CHECK-NEXT:   (local.get $i8-ref)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-init-data (param $i8-ref (ref null $i8-array))
    (array.init_data $i8-array $data
      (local.get $i8-ref)
      (i32.const 0)
      (i32.const 0)
      (i32.const 0)
    )
  )

  ;; CHECK:      (func $array-init-data-bot (type $func-empty)
  ;; CHECK-NEXT:  (block ;; (replaces unreachable ArrayInitData we can't emit)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-init-data-bot
    (array.init_data $i8-array $data
      (ref.null none)
      (i32.const 0)
      (i32.const 0)
      (i32.const 0)
    )
  )

  ;; CHECK:      (func $array-init-elem (type $9) (param $any-arr-ref (ref null $any-array))
  ;; CHECK-NEXT:  (array.init_elem $any-array $elem
  ;; CHECK-NEXT:   (local.get $any-arr-ref)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-init-elem (param $any-arr-ref (ref null $any-array))
    (array.init_elem $any-array $elem
      (local.get $any-arr-ref)
      (i32.const 0)
      (i32.const 0)
      (i32.const 0)
    )
  )

  ;; CHECK:      (func $array-init-elem-bot (type $func-empty)
  ;; CHECK-NEXT:  (block ;; (replaces unreachable ArrayInitElem we can't emit)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-init-elem-bot
    (array.init_elem $any-array $elem
      (ref.null none)
      (i32.const 0)
      (i32.const 0)
      (i32.const 0)
    )
  )

  ;; CHECK:      (func $cont-new (type $10) (param $func (ref null $func-empty))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (cont.new $cont-empty
  ;; CHECK-NEXT:    (local.get $func)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cont-new (param $func (ref null $func-empty))
    (drop
      (cont.new $cont-empty
        (local.get $func)
      )
    )
  )

  ;; CHECK:      (func $cont-new-unreachable (type $func-empty)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable ContNew we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cont-new-unreachable
    (drop
      (cont.new $cont-empty
        (unreachable)
      )
    )
  )
)
