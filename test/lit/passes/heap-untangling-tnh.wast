;; NOTE: Assertions have been generated by update_lit_checks.py and should not be edited.

;; RUN: foreach %s %t wasm-opt --heap-untangling      -all -S -o - | filecheck %s
;; RUN: foreach %s %t wasm-opt --heap-untangling -tnh -all -S -o - | filecheck %s --check-prefix=TNH__

(module
  ;; CHECK:      (type $struct (struct (field (mut i32))))
  ;; TNH__:      (type $struct (struct (field (mut i32))))
  (type $struct (struct (field (mut i32))))

  ;; CHECK:      (func $no-param-value (type $1) (param $ref (ref null $struct)) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $ref
  ;; CHECK-NEXT:     (struct.new $struct
  ;; CHECK-NEXT:      (i32.const 1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $ref
  ;; CHECK-NEXT:     (struct.new $struct
  ;; CHECK-NEXT:      (i32.const 2)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.get $struct 0
  ;; CHECK-NEXT:   (local.get $ref)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; TNH__:      (func $no-param-value (type $1) (param $ref (ref null $struct)) (param $x i32) (result i32)
  ;; TNH__-NEXT:  (if
  ;; TNH__-NEXT:   (local.get $x)
  ;; TNH__-NEXT:   (then
  ;; TNH__-NEXT:    (local.set $ref
  ;; TNH__-NEXT:     (struct.new $struct
  ;; TNH__-NEXT:      (i32.const 1)
  ;; TNH__-NEXT:     )
  ;; TNH__-NEXT:    )
  ;; TNH__-NEXT:    (local.set $ref
  ;; TNH__-NEXT:     (struct.new $struct
  ;; TNH__-NEXT:      (i32.const 2)
  ;; TNH__-NEXT:     )
  ;; TNH__-NEXT:    )
  ;; TNH__-NEXT:   )
  ;; TNH__-NEXT:  )
  ;; TNH__-NEXT:  (struct.get $struct 0
  ;; TNH__-NEXT:   (local.get $ref)
  ;; TNH__-NEXT:  )
  ;; TNH__-NEXT: )
  (func $no-param-value (param $ref (ref null $struct)) (param $x i32) (result i32)
    ;; Do not optimize here because the param's incoming value, which is
    ;; unknown, may be used.
    (if
      (local.get $x)
      (then
        (local.set $ref
          (struct.new $struct (i32.const 1))
        )
        (local.set $ref
          (struct.new $struct (i32.const 2))
        )
      )
    )
    (struct.get $struct 0
      (local.get $ref)
    )
  )

  ;; CHECK:      (func $maybe-var-value (type $2) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (local $ref (ref null $struct))
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $ref
  ;; CHECK-NEXT:     (struct.new $struct
  ;; CHECK-NEXT:      (i32.const 1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $ref
  ;; CHECK-NEXT:     (struct.new $struct
  ;; CHECK-NEXT:      (i32.const 2)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.get $struct 0
  ;; CHECK-NEXT:   (local.get $ref)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; TNH__:      (func $maybe-var-value (type $2) (param $x i32) (result i32)
  ;; TNH__-NEXT:  (local $ref (ref null $struct))
  ;; TNH__-NEXT:  (local $2 i32)
  ;; TNH__-NEXT:  (if
  ;; TNH__-NEXT:   (local.get $x)
  ;; TNH__-NEXT:   (then
  ;; TNH__-NEXT:    (block
  ;; TNH__-NEXT:     (local.set $ref
  ;; TNH__-NEXT:      (struct.new $struct
  ;; TNH__-NEXT:       (i32.const 1)
  ;; TNH__-NEXT:      )
  ;; TNH__-NEXT:     )
  ;; TNH__-NEXT:     (local.set $2
  ;; TNH__-NEXT:      (struct.get $struct 0
  ;; TNH__-NEXT:       (local.get $ref)
  ;; TNH__-NEXT:      )
  ;; TNH__-NEXT:     )
  ;; TNH__-NEXT:    )
  ;; TNH__-NEXT:    (block
  ;; TNH__-NEXT:     (local.set $ref
  ;; TNH__-NEXT:      (struct.new $struct
  ;; TNH__-NEXT:       (i32.const 2)
  ;; TNH__-NEXT:      )
  ;; TNH__-NEXT:     )
  ;; TNH__-NEXT:     (local.set $2
  ;; TNH__-NEXT:      (struct.get $struct 0
  ;; TNH__-NEXT:       (local.get $ref)
  ;; TNH__-NEXT:      )
  ;; TNH__-NEXT:     )
  ;; TNH__-NEXT:    )
  ;; TNH__-NEXT:   )
  ;; TNH__-NEXT:  )
  ;; TNH__-NEXT:  (local.get $2)
  ;; TNH__-NEXT: )
  (func $maybe-var-value (param $x i32) (result i32)
    (local $ref (ref null $struct))
    ;; As above, but now $ref is a var, not a param. If traps never happen, we
    ;; can assume the null initial value is not read (as it would trap), so we
    ;; can optimize there.
    (if
      (local.get $x)
      (then
        (local.set $ref
          (struct.new $struct (i32.const 1))
        )
        (local.set $ref
          (struct.new $struct (i32.const 2))
        )
      )
    )
    (struct.get $struct 0
      (local.get $ref)
    )
  )
)

