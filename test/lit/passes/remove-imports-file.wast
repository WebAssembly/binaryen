;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --remove-imports=@%S/remove-imports-file.txt -all -S -o - | filecheck %s

;; Test a response file as the input to this pass. env.foo, other.baz,
;; env.log.warn will be removed.
(module
  (import "env" "foo" (func $foo))
  ;; CHECK:      (type $0 (func))

  ;; CHECK:      (import "env" "keep" (func $keep (type $0)))
  (import "env" "keep" (func $keep))
  (import "other" "baz" (func $baz (result i32)))
  (import "env" "log.warn" (func $log.warn))

  ;; CHECK:      (func $test (type $0)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (call $keep)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  (func $test
    (call $foo)
    (call $keep)
    (drop
      (call $baz)
    )
    (call $log.warn)
  )
)
