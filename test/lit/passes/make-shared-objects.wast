    (block $label (result funcref)
      (br_on_cast_fail $label funcref funcref (local.get 0))
    )
  )

  ;; CHECK:      (func $br-on-cast-nullfuncref (type $2) (param $0 (ref null (shared i31))) (result (ref null (shared i31)))
  ;; CHECK-NEXT:  (block $label (result (ref null (shared i31)))
  ;; CHECK-NEXT:   (br_on_cast $label (ref null (shared i31)) (ref null (shared none))
  ;; CHECK-NEXT:    (local.get $0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
