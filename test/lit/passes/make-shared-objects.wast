    )
  )

  ;; CHECK:      (func $br-on-cast-fail-funcref (type $2) (param $0 (ref null (shared i31))) (result (ref null (shared i31)))
  ;; CHECK-NEXT:  (block $label (result (ref null (shared i31)))
  ;; CHECK-NEXT:   (br_on_cast_fail $label (ref null (shared i31)) (ref null (shared i31))
