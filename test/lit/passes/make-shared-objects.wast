;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-opt -all --make-shared-objects -S -o - | filecheck %s

(module
  ;; Check lowering of basic heap types.
  ;; CHECK:      (type $0 (func (param (ref null (shared none))) (result (ref null (shared none)))))

  ;; CHECK:      (type $1 (func (param (ref (shared none))) (result (ref (shared none)))))

  ;; CHECK:      (type $2 (func (param (ref null (shared i31))) (result (ref null (shared i31)))))

  ;; CHECK:      (type $3 (func (param (ref (shared i31))) (result (ref (shared i31)))))

  ;; CHECK:      (type $4 (func (param (ref null (shared any))) (result (ref null (shared any)))))

  ;; CHECK:      (type $5 (func (param (ref (shared any))) (result (ref (shared any)))))

  ;; CHECK:      (type $6 (func (param (ref null (shared eq))) (result (ref null (shared eq)))))

  ;; CHECK:      (type $7 (func (param (ref (shared eq))) (result (ref (shared eq)))))

  ;; CHECK:      (type $8 (func (param (ref null (shared struct))) (result (ref null (shared struct)))))

  ;; CHECK:      (type $9 (func (param (ref (shared struct))) (result (ref (shared struct)))))

  ;; CHECK:      (type $10 (func (param (ref null (shared array))) (result (ref null (shared array)))))

  ;; CHECK:      (type $11 (func (param (ref (shared array))) (result (ref (shared array)))))

  ;; CHECK:      (func $funcref (type $2) (param $0 (ref null (shared i31))) (result (ref null (shared i31)))
  ;; CHECK-NEXT:  (local $1 (ref null (shared i31)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $funcref (param funcref) (result funcref)
    (local funcref)
    (local.get 0)
  )

  ;; CHECK:      (func $shared-funcref (type $3) (param $0 (ref (shared i31))) (result (ref (shared i31)))
  ;; CHECK-NEXT:  (local $1 (ref (shared i31)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $shared-funcref (param (ref (shared func))) (result (ref (shared func)))
    (local (ref (shared func)))
    (local.get 0)
  )

  ;; CHECK:      (func $nullfuncref (type $0) (param $0 (ref null (shared none))) (result (ref null (shared none)))
  ;; CHECK-NEXT:  (local $1 (ref null (shared none)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $nullfuncref (param nullfuncref) (result nullfuncref)
    (local nullfuncref)
    (local.get 0)
  )

  ;; CHECK:      (func $shared-nullfuncref (type $1) (param $0 (ref (shared none))) (result (ref (shared none)))
  ;; CHECK-NEXT:  (local $1 (ref (shared none)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $shared-nullfuncref (param (ref (shared nofunc))) (result (ref (shared nofunc)))
    (local (ref (shared nofunc)))
    (local.get 0)
  )

  ;; CHECK:      (func $anyref (type $4) (param $0 (ref null (shared any))) (result (ref null (shared any)))
  ;; CHECK-NEXT:  (local $1 (ref null (shared any)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $anyref (param anyref) (result anyref)
    (local anyref)
    (local.get 0)
  )

  ;; CHECK:      (func $shared-anyref (type $5) (param $0 (ref (shared any))) (result (ref (shared any)))
  ;; CHECK-NEXT:  (local $1 (ref (shared any)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $shared-anyref (param (ref (shared any))) (result (ref (shared any)))
    (local (ref (shared any)))
    (local.get 0)
  )

  ;; CHECK:      (func $eqref (type $6) (param $0 (ref null (shared eq))) (result (ref null (shared eq)))
  ;; CHECK-NEXT:  (local $1 (ref null (shared eq)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $eqref (param eqref) (result eqref)
    (local eqref)
    (local.get 0)
  )

  ;; CHECK:      (func $shared-eqref (type $7) (param $0 (ref (shared eq))) (result (ref (shared eq)))
  ;; CHECK-NEXT:  (local $1 (ref (shared eq)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $shared-eqref (param (ref (shared eq))) (result (ref (shared eq)))
    (local (ref (shared eq)))
    (local.get 0)
  )

  ;; CHECK:      (func $structref (type $8) (param $0 (ref null (shared struct))) (result (ref null (shared struct)))
  ;; CHECK-NEXT:  (local $1 (ref null (shared struct)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $structref (param structref) (result structref)
    (local structref)
    (local.get 0)
  )

  ;; CHECK:      (func $shared-structref (type $9) (param $0 (ref (shared struct))) (result (ref (shared struct)))
  ;; CHECK-NEXT:  (local $1 (ref (shared struct)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $shared-structref (param (ref (shared struct))) (result (ref (shared struct)))
    (local (ref (shared struct)))
    (local.get 0)
  )

  ;; CHECK:      (func $arrayref (type $10) (param $0 (ref null (shared array))) (result (ref null (shared array)))
  ;; CHECK-NEXT:  (local $1 (ref null (shared array)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $arrayref (param arrayref) (result arrayref)
    (local arrayref)
    (local.get 0)
  )

  ;; CHECK:      (func $shared-arrayref (type $11) (param $0 (ref (shared array))) (result (ref (shared array)))
  ;; CHECK-NEXT:  (local $1 (ref (shared array)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $shared-arrayref (param (ref (shared array))) (result (ref (shared array)))
    (local (ref (shared array)))
    (local.get 0)
  )

  ;; CHECK:      (func $nullref (type $0) (param $0 (ref null (shared none))) (result (ref null (shared none)))
  ;; CHECK-NEXT:  (local $1 (ref null (shared none)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $nullref (param nullref) (result nullref)
    (local nullref)
    (local.get 0)
  )

  ;; CHECK:      (func $shared-nullref (type $1) (param $0 (ref (shared none))) (result (ref (shared none)))
  ;; CHECK-NEXT:  (local $1 (ref (shared none)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $shared-nullref (param (ref (shared none))) (result (ref (shared none)))
    (local (ref (shared none)))
    (local.get 0)
  )

  ;; TODO: Handle exnref, contref.
)

;; Recursive function types should be updated correctly.
(module
  ;; CHECK:      (type $func (func (param (ref (shared i31))) (result (ref (shared i31)))))
  (type $func (func (param (ref $func)) (result (ref $func))))
  ;; CHECK:      (func $f (type $func) (param $0 (ref (shared i31))) (result (ref (shared i31)))
  ;; CHECK-NEXT:  (local $1 (ref (shared i31)))
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $f (type $func) (param (ref $func)) (result (ref $func))
    (local (ref $func))
    (local.get 0)
  )
)

(module
  ;; Struct and array types should become shared. Function references inside
  ;; them should become shared i31refs. Shared struct and array types should
  ;; remain shared. Function types should become unshared. Distinct shared and
  ;; and unshared types can be merged, but that's ok because their values can
  ;; never flow into the same locations.
  (type $func (func))
  ;; CHECK:      (type $array (shared (array (ref (shared i31)))))

  ;; CHECK:      (type $shared-func (func))

  ;; CHECK:      (type $struct (shared (struct (field (ref (shared i31))) (field i32))))
  (type $struct (struct (field (ref $func)) (field i32)))
  (type $array (array (ref (exact $func))))

  (type $shared-func (shared (func)))
  ;; CHECK:      (type $shared-struct (shared (struct (field (ref null (shared i31))))))
  (type $shared-struct (shared (struct (field (ref null (exact $shared-func))))))
  (type $shared-array (shared (array (ref $shared-func))))

  ;; CHECK:      (type $4 (func (param (ref $struct) (ref $array) (ref $shared-struct) (ref $array))))

  ;; CHECK:      (func $use-types (type $4) (param $0 (ref $struct)) (param $1 (ref $array)) (param $2 (ref $shared-struct)) (param $3 (ref $array))
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  (func $use-types (param (ref $struct) (ref $array) (ref $shared-struct) (ref $shared-array))
    (nop)
  )
  ;; CHECK:      (func $f (type $shared-func)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  (func $f (type $func)
    (nop)
  )
  ;; CHECK:      (func $f-shared (type $shared-func)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  (func $f-shared (type $shared-func)
    (nop)
  )
)

(module
  ;; Rec groups containing mutually recursive struct, array, and function types
  ;; should be preserved.
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $rec-func (func (param (ref $rec-struct))))
    (type $rec-func (func (param (ref $rec-struct))))
    ;; CHECK:       (type $rec-struct (shared (struct (field (ref $rec-array)) (field (ref (shared i31))))))
    (type $rec-struct (struct (field (ref $rec-array)) (field (ref $rec-func))))
    ;; CHECK:       (type $rec-array (shared (array (ref $rec-struct))))
    (type $rec-array (array (ref $rec-struct)))
  )
  ;; CHECK:      (type $3 (func (param (ref $rec-struct) (ref $rec-array) (ref (shared i31)))))

  ;; CHECK:      (func $rec-group (type $3) (param $0 (ref $rec-struct)) (param $1 (ref $rec-array)) (param $2 (ref (shared i31)))
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  (func $rec-group (param (ref $rec-struct) (ref $rec-array) (ref $rec-func))
    (nop)
  )
)

(module
  ;; Function supertypes are preserved.
  ;; CHECK:      (type $parent (sub (func)))
  (type $parent (sub (shared (func))))
  ;; CHECK:      (type $child (sub $parent (func)))
  (type $child (sub $parent (shared (func))))
  ;; CHECK:      (func $f1 (type $parent)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  (func $f1 (type $parent)
    (nop)
  )
  ;; CHECK:      (func $f2 (type $child)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  (func $f2 (type $child)
    (nop)
  )
)

(module
  ;; Struct descriptor and described types become shared correctly.
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $struct (shared (descriptor $desc) (struct (field i32))))
    (type $struct (descriptor $desc) (struct (field i32)))
    ;; CHECK:       (type $desc (shared (describes $struct) (struct (field i32))))
    (type $desc (describes $struct) (struct (field i32)))
  )
  ;; CHECK:      (type $2 (func (param (ref $struct) (ref $desc))))

  ;; CHECK:      (func $descriptors (type $2) (param $0 (ref $struct)) (param $1 (ref $desc))
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  (func $descriptors (param (ref $struct) (ref $desc))
    (nop)
  )
)

;; Check that references to different functions are consistently assigned
;; different indices. This module does not use the references with a call or
;; cast, so it does not get the new table.
(module
  ;; CHECK:      (type $f (func))
  (type $f (func))
  ;; CHECK:      (type $1 (func (result (ref null (shared none)))))

  ;; CHECK:      (type $2 (func (result (ref null (shared i31)))))

  ;; CHECK:      (type $3 (func (result (ref (shared i31)))))

  ;; CHECK:      (func $target1 (type $f)
  ;; CHECK-NEXT: )
  (func $target1 (type $f))
  ;; CHECK:      (func $target2 (type $f)
  ;; CHECK-NEXT: )
  (func $target2 (type $f))

  ;; CHECK:      (func $ref-null-nofunc (type $1) (result (ref null (shared none)))
  ;; CHECK-NEXT:  (ref.null (shared none))
  ;; CHECK-NEXT: )
  (func $ref-null-nofunc (result (ref null nofunc))
    ;; (ref.null nofunc) becomes (ref.null (shared none)).
    (ref.null nofunc)
  )

  ;; CHECK:      (func $ref-null-shared-nofunc (type $1) (result (ref null (shared none)))
  ;; CHECK-NEXT:  (ref.null (shared none))
  ;; CHECK-NEXT: )
  (func $ref-null-shared-nofunc (result (ref null (shared nofunc)))
    ;; Same with a shared nofunc.
    (ref.null (shared nofunc))
  )

  ;; CHECK:      (func $ref-func (type $2) (result (ref null (shared i31)))
  ;; CHECK-NEXT:  (ref.i31_shared
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-func (result funcref)
    ;; ref.func becomes a shared i31.
    (ref.func $target1)
  )

  ;; CHECK:      (func $other-ref-func (type $3) (result (ref (shared i31)))
  ;; CHECK-NEXT:  (ref.i31_shared
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $other-ref-func (result (ref (exact $f)))
    ;; Different referenced function, different i31 value.
    (ref.func $target2)
  )

  ;; CHECK:      (func $multiple-ref-func (type $f)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.i31_shared
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.i31_shared
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.i31_shared
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $multiple-ref-func
    ;; Mapping of functions to i31 values should be consistent.
    (drop (ref.func $target1))
    (drop (ref.func $target1))
    (drop (ref.func $target2))
  )
)

;; Test replacement of references in module locations and lowering of calls.
(module
  (type $sig (func (param i32) (result i32)))
  ;; CHECK:      (type $0 (func (result i32)))

  ;; CHECK:      (type $shared-sig (func (param i32) (result i32)))
  (type $shared-sig (shared (func (param i32) (result i32))))

  ;; CHECK:      (type $2 (func))

  ;; CHECK:      (type $struct (shared (struct (field (ref null (shared i31))))))
  (type $struct (struct (field (ref null func))))

  (func $effect (import "" "") (result i32))

  ;; CHECK:      (type $4 (func (param (ref (shared i31)) i32) (result i32)))

  ;; CHECK:      (type $5 (func (param (ref (shared i31))) (result i32)))

  ;; CHECK:      (type $6 (func (param i32 i32) (result i32)))

  ;; CHECK:      (import "" "" (func $effect (type $0) (result i32)))

  ;; CHECK:      (global $g (ref null (shared i31)) (ref.i31_shared
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: ))
  (global $g (ref null func) (ref.func $a))

  ;; CHECK:      (global $g-struct (ref null $struct) (struct.new $struct
  ;; CHECK-NEXT:  (ref.i31_shared
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: ))
  (global $g-struct (ref null $struct) (struct.new $struct (ref.func $b)))

  ;; CHECK:      (table $t-init 1 1 (ref null (shared i31)) (ref.i31_shared
  ;; CHECK-NEXT:  (i32.const 3)
  ;; CHECK-NEXT: ))
  (table $t-init 1 1 (ref null func) (ref.func $c))

  ;; CHECK:      (table $t 1 1 (ref null (shared i31)))
  (table $t 1 1 (ref null $sig))
  ;; CHECK:      (table $t-shared 1 1 (ref null (shared i31)))
  (table $t-shared 1 1 (ref null (shared func)))

  ;; CHECK:      (table $funcs 4 4 funcref)

  ;; CHECK:      (elem $elem (ref null (shared i31)) (item (ref.i31_shared
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: )))
  (elem $elem funcref (ref.func $d))

  ;; CHECK:      (elem $funcs (table $funcs) (i32.const 0) func $a $b $d $c)

  ;; CHECK:      (func $a (type $2)
  ;; CHECK-NEXT: )
  (func $a)
  ;; CHECK:      (func $b (type $2)
  ;; CHECK-NEXT: )
  (func $b)
  ;; CHECK:      (func $c (type $2)
  ;; CHECK-NEXT: )
  (func $c)
  ;; CHECK:      (func $d (type $2)
  ;; CHECK-NEXT: )
  (func $d)

  ;; CHECK:      (func $call-ref (type $4) (param $0 (ref (shared i31))) (param $1 i32) (result i32)
  ;; CHECK-NEXT:  (call_indirect $funcs (type $shared-sig)
  ;; CHECK-NEXT:   (local.get $1)
  ;; CHECK-NEXT:   (i31.get_u
  ;; CHECK-NEXT:    (local.get $0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $call-ref (param (ref $sig) i32) (result i32)
    (call_ref $sig (local.get 1) (local.get 0))
  )

  ;; CHECK:      (func $unreachable-call-ref (type $0) (result i32)
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $unreachable-call-ref (result i32)
    (call_ref $sig (i32.const 0) (unreachable))
  )

  ;; CHECK:      (func $unreachable-call-ref-effect (type $0) (result i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $effect)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $unreachable-call-ref-effect (result i32)
    (call_ref $sig (call $effect) (unreachable))
  )

  ;; CHECK:      (func $null-call-ref (type $0) (result i32)
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $null-call-ref (result i32)
    (call_ref $sig (i32.const 0) (ref.null nofunc))
  )

  ;; CHECK:      (func $null-call-ref-effect (type $0) (result i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $effect)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $null-call-ref-effect (result i32)
    (call_ref $sig (call $effect) (ref.null nofunc))
  )

  ;; CHECK:      (func $shared-call-ref (type $5) (param $0 (ref (shared i31))) (result i32)
  ;; CHECK-NEXT:  (call_indirect $funcs (type $shared-sig)
  ;; CHECK-NEXT:   (i32.const 42)
  ;; CHECK-NEXT:   (i31.get_u
  ;; CHECK-NEXT:    (local.get $0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $shared-call-ref (param (ref $shared-sig)) (result i32)
    (call_ref $shared-sig (i32.const 42) (local.get 0))
  )

  ;; CHECK:      (func $shared-unreachable-call-ref (type $0) (result i32)
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $shared-unreachable-call-ref (result i32)
    (call_ref $shared-sig (i32.const 0) (unreachable))
  )

  ;; CHECK:      (func $shared-unreachable-call-ref-effect (type $0) (result i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $effect)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $shared-unreachable-call-ref-effect (result i32)
    (call_ref $shared-sig (call $effect) (unreachable))
  )

  ;; CHECK:      (func $shared-null-call-ref (type $0) (result i32)
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $shared-null-call-ref (result i32)
    (call_ref $shared-sig (i32.const 0) (ref.null (shared nofunc)))
  )

  ;; CHECK:      (func $shared-null-call-ref-effect (type $0) (result i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $effect)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $shared-null-call-ref-effect (result i32)
    (call_ref $shared-sig (call $effect) (ref.null (shared nofunc)))
  )

  ;; CHECK:      (func $return-call-ref (type $4) (param $0 (ref (shared i31))) (param $1 i32) (result i32)
  ;; CHECK-NEXT:  (return_call_indirect $funcs (type $shared-sig)
  ;; CHECK-NEXT:   (local.get $1)
  ;; CHECK-NEXT:   (i31.get_u
  ;; CHECK-NEXT:    (local.get $0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $return-call-ref (param (ref $sig) i32) (result i32)
    (return_call_ref $sig (local.get 1) (local.get 0))
  )

  ;; call_indirect lowering
  ;; CHECK:      (func $call-indirect (type $6) (param $0 i32) (param $1 i32) (result i32)
  ;; CHECK-NEXT:  (call_indirect $funcs (type $shared-sig)
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:   (i31.get_u
  ;; CHECK-NEXT:    (table.get $t
  ;; CHECK-NEXT:     (local.get $1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $call-indirect (param i32 i32) (result i32)
    (call_indirect $t (type $sig) (local.get 0) (local.get 1))
  )

  ;; Unreachable call_indirect lowering.
  ;; CHECK:      (func $unreachable-call-indirect (type $0) (result i32)
  ;; CHECK-NEXT:  (call_indirect $funcs (type $shared-sig)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i31.get_u
  ;; CHECK-NEXT:    (table.get $t
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $unreachable-call-indirect (result i32)
    (call_indirect $t (type $sig) (i32.const 0) (unreachable))
  )

  ;; call_indirect lowering of shared function.
  ;; CHECK:      (func $shared-call-indirect (type $shared-sig) (param $0 i32) (result i32)
  ;; CHECK-NEXT:  (call_indirect $funcs (type $shared-sig)
  ;; CHECK-NEXT:   (i32.const 42)
  ;; CHECK-NEXT:   (i31.get_u
  ;; CHECK-NEXT:    (table.get $t-shared
  ;; CHECK-NEXT:     (local.get $0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $shared-call-indirect (param i32) (result i32)
    (call_indirect $t-shared (type $shared-sig) (i32.const 42) (local.get 0))
  )

  ;; unreachable call_indirect
  ;; CHECK:      (func $unreachable-param-call-indirect (type $shared-sig) (param $0 i32) (result i32)
  ;; CHECK-NEXT:  (call_indirect $funcs (type $shared-sig)
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:   (i31.get_u
  ;; CHECK-NEXT:    (table.get $t
  ;; CHECK-NEXT:     (local.get $0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $unreachable-param-call-indirect (param i32) (result i32)
    (call_indirect $t (type $sig) (unreachable) (local.get 0))
  )
)

;; Test lowering of ref.test and ref.cast.
(module
  (type $sig (func (param i32) (result i32)))
  ;; CHECK:      (type $shared-sig (func (param i32) (result i32)))
  (type $shared-sig (shared (func (param i32) (result i32))))
  ;; CHECK:      (type $1 (func (param (ref null (shared i31))) (result i32)))

  ;; CHECK:      (type $2 (func (param (ref null (shared i31))) (result (ref null (shared i31)))))

  ;; CHECK:      (type $struct (shared (struct (field i32))))
  (type $struct (struct (field i32)))

  ;; ref.test of funcref
  ;; CHECK:      (type $4 (func (param (ref null (shared i31))) (result (ref (shared i31)))))

  ;; CHECK:      (type $5 (func (param (ref (shared i31))) (result i32)))

  ;; CHECK:      (type $6 (func (result i32)))

  ;; CHECK:      (type $7 (func (param (ref null (shared i31))) (result (ref (shared none)))))

  ;; CHECK:      (type $8 (func (param (ref null (shared i31))) (result (ref null (shared none)))))

  ;; CHECK:      (type $9 (func (param (ref (shared i31))) (result (ref (shared i31)))))

  ;; CHECK:      (type $10 (func (result (ref null (shared i31)))))

  ;; CHECK:      (type $11 (func (param (ref null $struct)) (result i32)))

  ;; CHECK:      (type $12 (func (param (ref null $struct)) (result (ref null $struct))))

  ;; CHECK:      (table $funcs 0 0 funcref)

  ;; CHECK:      (elem $funcs (i32.const 0))

  ;; CHECK:      (func $ref-test-func (type $1) (param $0 (ref null (shared i31))) (result i32)
  ;; CHECK-NEXT:  (ref.test (ref (shared i31))
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-test-func (param funcref) (result i32)
    (ref.test (ref func) (local.get 0))
  )

  ;; CHECK:      (func $ref-test-funcref (type $1) (param $0 (ref null (shared i31))) (result i32)
  ;; CHECK-NEXT:  (ref.test (ref null (shared i31))
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-test-funcref (param funcref) (result i32)
    (ref.test (ref null func) (local.get 0))
  )

