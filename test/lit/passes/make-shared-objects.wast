  ;; CHECK:      (func $ref-cast-non-func (type $12) (param $0 (ref null $struct)) (result (ref null $struct))
  ;; CHECK-NEXT:  (ref.cast (ref null $struct)
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-cast-non-func (param (ref null $struct)) (result (ref null $struct))
    ;; This should not be changed.
    (ref.cast (ref null $struct) (local.get 0))
  )

  ;; CHECK:      (func $br-on-cast-funcref (type $2) (param $0 (ref null (shared i31))) (result (ref null (shared i31)))
  ;; CHECK-NEXT:  (block $label (result (ref null (shared i31)))
