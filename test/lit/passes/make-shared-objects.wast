  (func $ref-cast-shared-no-nulls (param (ref (shared func))) (result (ref $shared-sig))
    (ref.cast (ref $shared-sig) (local.get 0))
  )

  ;; CHECK:      (func $ref-cast-shared-non-nullable (type $4) (param $0 (ref null (shared i31))) (result (ref (shared i31)))
  ;; CHECK-NEXT:  (local $1 (ref null (shared i31)))
