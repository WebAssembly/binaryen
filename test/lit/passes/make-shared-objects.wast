  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (if (result (ref (shared i31)))
  ;; CHECK-NEXT:     (ref.test (ref $shared-sig)
  ;; CHECK-NEXT:      (table.get $funcs
  ;; CHECK-NEXT:       (i31.get_u
  ;; CHECK-NEXT:        (local.get $1)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (ref.as_non_null
  ;; CHECK-NEXT:       (local.get $1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (else
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-cast-shared-non-nullable (param (ref null (shared func))) (result (ref $shared-sig))
    (ref.cast (ref $shared-sig) (local.get 0))
  )

  ;; CHECK:      (func $ref-cast-shared-nullable (type $2) (param $0 (ref null (shared i31))) (result (ref null (shared i31)))
  ;; CHECK-NEXT:  (local $1 (ref null (shared i31)))
  ;; CHECK-NEXT:  (if (result (ref null (shared i31)))
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (local.tee $1
  ;; CHECK-NEXT:     (local.get $0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.get $1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (if (result (ref null (shared i31)))
  ;; CHECK-NEXT:     (ref.test (ref null $shared-sig)
  ;; CHECK-NEXT:      (table.get $funcs
  ;; CHECK-NEXT:       (i31.get_u
  ;; CHECK-NEXT:        (local.get $1)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (local.get $1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (else
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-cast-shared-nullable (param (ref null (shared func))) (result (ref null $shared-sig))
    (ref.cast (ref null $shared-sig) (local.get 0))
  )

  ;; CHECK:      (func $ref-cast-shared-nullable-exact (type $2) (param $0 (ref null (shared i31))) (result (ref null (shared i31)))
  ;; CHECK-NEXT:  (local $1 (ref null (shared i31)))
  ;; CHECK-NEXT:  (if (result (ref null (shared i31)))
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (local.tee $1
  ;; CHECK-NEXT:     (local.get $0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.get $1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (if (result (ref null (shared i31)))
  ;; CHECK-NEXT:     (ref.test (ref null (exact $shared-sig))
  ;; CHECK-NEXT:      (table.get $funcs
  ;; CHECK-NEXT:       (i31.get_u
  ;; CHECK-NEXT:        (local.get $1)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (local.get $1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (else
