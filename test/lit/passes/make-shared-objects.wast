  (func $br-on-cast-nullfuncref (param funcref) (result funcref)
    (block $label (result funcref)
      (br_on_cast $label funcref nullfuncref (local.get 0))
    )
  )

  ;; CHECK:      (func $br-on-cast-fail-nullfuncref (type $2) (param $0 (ref null (shared i31))) (result (ref null (shared i31)))
  ;; CHECK-NEXT:  (block $label (result (ref null (shared i31)))
  ;; CHECK-NEXT:   (br_on_cast_fail $label (ref null (shared i31)) (ref null (shared none))
  ;; CHECK-NEXT:    (local.get $0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $br-on-cast-fail-nullfuncref (param funcref) (result funcref)
    (block $label (result funcref)
      (br_on_cast_fail $label funcref nullfuncref (local.get 0))
    )
  )

  ;; TODO: other br_on_cast{_fail} lowering
)

(module
  (type $sig (func (param i32) (result i32)))

  ;; Test that types in if, loop, result

  ;; Test that function types in globals, tables, element segments, and tags are updated.
  ;; CHECK:      (type $0 (func (param (ref null (shared i31)))))

  ;; CHECK:      (type $1 (func (param i32) (result (ref null (shared i31)))))

  ;; CHECK:      (global $g (ref null (shared i31)) (ref.null (shared none)))
  (global $g (ref null $sig) (ref.null $sig))
  ;; CHECK:      (table $t 1 1 (ref null (shared i31)) (ref.null (shared none)))
  (table $t 1 1 (ref null $sig) (ref.null $sig))
  ;; CHECK:      (elem $e (ref null (shared i31)) (item (ref.null (shared none))))
  (elem $e (ref null $sig) (ref.null $sig))
  ;; CHECK:      (tag $tag (type $0) (param (ref null (shared i31))))
  (tag $tag (param (ref null $sig)))

  ;; CHECK:      (func $control-types (type $1) (param $0 i32) (result (ref null (shared i31)))
  ;; CHECK-NEXT:  (if (result (ref null (shared none)))
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (ref.null (shared none))
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (ref.null (shared none))
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $control-types (param i32) (result (ref null $sig))
    (if (result (ref null $sig)) (local.get 0)
      (then (ref.null $sig))
      (else (ref.null $sig))
    )
  )
)

(module
  ;; Name collisions with the "funcs" table and "funcs" elements segment are handled correctly.
  ;; CHECK:      (type $f (func))
  (type $f (func))
  ;; CHECK:      (table $funcs 1 1 (ref null (shared i31)))
  (table $funcs 1 1 funcref)
  ;; CHECK:      (table $funcs_1 1 1 funcref)

  ;; CHECK:      (elem $funcs (table $funcs) (i32.const 0) (ref null (shared i31)) (item (ref.i31_shared
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: )))
  (elem $funcs (table $funcs) (i32.const 0) func $target)
  ;; CHECK:      (elem $funcs_1 (table $funcs_1) (i32.const 0) func $target)

  ;; CHECK:      (func $target (type $f)
  ;; CHECK-NEXT: )
  (func $target (type $f))

  ;; CHECK:      (func $name-collision (type $f)
  ;; CHECK-NEXT:  (call_indirect $funcs_1 (type $f)
  ;; CHECK-NEXT:   (i31.get_u
  ;; CHECK-NEXT:    (ref.i31_shared
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $name-collision
    (call_ref $f (ref.func $target))
  )
)

(module
  ;; We want public types to be updated as well.
  (type $sig (func))
  ;; CHECK:      (import "" "" (global $g-funcref (ref null (shared i31))))
  (import "" "" (global $g-funcref funcref))
  ;; CHECK:      (import "" "" (global $g-sig (ref null (shared i31))))
  (import "" "" (global $g-sig (ref null $sig)))
)
