  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-cast-shared-nullable-exact (param (ref null (shared func))) (result (ref null $shared-sig))
    (ref.cast (ref null (exact $shared-sig)) (local.get 0))
  )

  ;; CHECK:      (func $ref-cast-null-input (type $10) (result (ref null (shared i31)))
  ;; CHECK-NEXT:  (ref.cast (ref null (shared none))
  ;; CHECK-NEXT:   (ref.null (shared none))
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-cast-null-input (result (ref null $sig))
    (ref.cast (ref null $sig) (ref.null nofunc))
  )

  ;; CHECK:      (func $ref-cast-unreachable-input (type $10) (result (ref null (shared i31)))
  ;; CHECK-NEXT:  (block ;; (replaces unreachable RefCast we can't emit)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-cast-unreachable-input (result (ref null $sig))
    (ref.cast (ref null $sig) (unreachable))
