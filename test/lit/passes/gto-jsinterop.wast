    ;; CHECK:       (type $sub-desc (sub $super-desc (describes $sub) (struct (field externref))))
    (type $sub-desc (sub $super-desc (describes $sub) (struct (field externref i64))))
  )

  ;; CHECK:       (type $4 (func))

