  (func $export (result (ref null $super))
    (unreachable)
  )

  ;; CHECK:      (func $use-sub (type $4)
  ;; CHECK-NEXT:  (local $0 (ref null $sub))
  ;; CHECK-NEXT: )
  (func $use-sub
    (local (ref null $sub))
  )
)

