;; NOTE: Assertions have been generated by update_lit_checks.py and should not be edited.

;; RUN: wasm-opt %s --constraint-analysis -all -S -o - | filecheck %s

(module
  ;; CHECK:      (type $A (struct (field i32)))
  (type $A (struct (field i32)))
  ;; CHECK:      (type $Array (array (mut i32)))
  (type $Array (array (mut i32)))
  ;; CHECK:      (type $MutA (struct (field (mut i32))))
  (type $MutA (struct (field (mut i32))))
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $DescStruct (descriptor $Desc) (struct (field (mut i32))))
    (type $DescStruct (descriptor $Desc) (struct (field (mut i32))))
    ;; CHECK:       (type $Desc (describes $DescStruct) (struct (field i32)))
    (type $Desc (describes $DescStruct) (struct (field i32)))
  )
  ;; CHECK:      (type $Func (func (param i32) (result i32)))

  ;; CHECK:      (type $SharedStruct (shared (struct (field (mut i32)))))
  (type $SharedStruct (shared (struct (field (mut i32)))))
  ;; CHECK:      (type $SharedArray (shared (array (mut i32))))
  (type $SharedArray (shared (array (mut i32))))
  (type $Func (func (param i32) (result i32)))

  ;; CHECK:      (import "a" "c" (func $get-nullable (type $26) (result (ref null $A))))
  (import "a" "c" (func $get-nullable (result (ref null $A))))
  ;; CHECK:      (import "a" "d" (func $may-throw (type $27) (result i32)))
  (import "a" "d" (func $may-throw (result i32)))
  ;; CHECK:      (tag $tag (type $25))
  (tag $tag)

  ;; CHECK:      (func $non-null-direct (type $9) (param $a (ref null $A))
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (struct.new_default $A)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $non-null-direct (param $a (ref null $A))
    (local.set $a
      (struct.new_default $A)
    )
    ;; Direct checks after assigning a non-null struct: ref.is_null is 0 and
    ;; ref.eq with null is 0.
    (drop
      (ref.is_null
        (local.get $a)
      )
    )
    (drop
      (ref.eq
        (local.get $a)
        (ref.null eq)
      )
    )
  )

  ;; CHECK:      (func $non-null-indirect (type $8) (param $a (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $a
  ;; CHECK-NEXT:     (struct.new_default $A)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: )
  (func $non-null-indirect (param $a (ref null $A)) (result i32)
    ;; The param is nullable, but if it is null then we assign a non-null
    ;; value.
    (if
      (ref.is_null
        (local.get $a)
      )
      (then
        (local.set $a
          (struct.new_default $A)
        )
      )
    )
    ;; At this point, the param is certainly not null, so this is 0.
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $nullable-set-and-overwrite (type $9) (param $a (ref null $A))
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (struct.new_default $A)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (call $get-nullable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (struct.new_default $A)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (ref.null none)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $nullable-set-and-overwrite (param $a (ref null $A))
    (local.set $a
      (struct.new_default $A)
    )
    ;; Known non-null -> 0.
    (drop
      (ref.is_null
        (local.get $a)
      )
    )
    ;; Overwrite with a nullable call -> cannot optimize.
    (local.set $a
      (call $get-nullable)
    )
    (drop
      (ref.is_null
        (local.get $a)
      )
    )
    ;; Overwrite with non-null again -> 0.
    (local.set $a
      (struct.new_default $A)
    )
    (drop
      (ref.is_null
        (local.get $a)
      )
    )
    ;; Overwrite with null -> 1.
    (local.set $a
      (ref.null $A)
    )
    (drop
      (ref.is_null
        (local.get $a)
      )
    )
  )

  ;; CHECK:      (func $from-non-null-param (type $28) (param $a (ref null $A)) (param $b (ref $A)) (result i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $a
  ;; CHECK-NEXT:     (local.get $b)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: )
  (func $from-non-null-param (param $a (ref null $A)) (param $b (ref $A)) (result i32)
    ;; Assigning a non-nullable param to a nullable local proves non-null.
    (if
      (ref.is_null
        (local.get $a)
      )
      (then
        (local.set $a
          (local.get $b)
        )
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $from-non-null-tee (type $8) (param $a (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (local $b (ref $A))
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (local.tee $b
  ;; CHECK-NEXT:    (struct.new_default $A)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: )
  (func $from-non-null-tee (param $a (ref null $A)) (result i32)
    (local $b (ref $A))
    ;; Assigning from a tee of a non-nullable local proves $a is non-null.
    (local.set $a
      (local.tee $b
        (struct.new_default $A)
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $from-nullable-tee (type $9) (param $a (ref null $A))
  ;; CHECK-NEXT:  (local $b (ref null $A))
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (local.tee $b
  ;; CHECK-NEXT:    (struct.new_default $A)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $from-nullable-tee (param $a (ref null $A))
    (local $b (ref null $A))
    ;; Assigning from a tee of a nullable local proves both $b and $a non-null.
    (local.set $a
      (local.tee $b
        (struct.new_default $A)
      )
    )
    (drop
      (ref.is_null
        (local.get $a)
      )
    )
    (drop
      (ref.is_null
        (local.get $b)
      )
    )
  )

  ;; CHECK:      (func $fallthrough-ref-as-non-null (type $8) (param $a (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (ref.as_non_null
  ;; CHECK-NEXT:    (call $get-nullable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: )
  (func $fallthrough-ref-as-non-null (param $a (ref null $A)) (result i32)
    ;; ref.as_non_null wraps a nullable call. We should not be confused by the
    ;; fact that the original value that falls through is nullable: we can
    ;; use the fact that it was cast to a non-nullable value, and optimize the
    ;; ref.is_null to 0.
    (local.set $a
      (ref.as_non_null
        (call $get-nullable)
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $merge-two-non-null (type $Func) (param $c i32) (result i32)
  ;; CHECK-NEXT:  (local $a anyref)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $c)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $a
  ;; CHECK-NEXT:     (struct.new_default $A)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (local.set $a
  ;; CHECK-NEXT:     (array.new_default $Array
  ;; CHECK-NEXT:      (i32.const 10)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: )
  (func $merge-two-non-null (param $c i32) (result i32)
    (local $a anyref)
    ;; Both arms assign different non-null GC types into an anyref local.
    (if
      (local.get $c)
      (then
        (local.set $a
          (struct.new_default $A)
        )
      )
      (else
        (local.set $a
          (array.new_default $Array
            (i32.const 10)
          )
        )
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )


  ;; CHECK:      (func $merge-one-nullable-one-non-null (type $11) (param $a (ref null $A)) (param $c i32) (result i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $c)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $a
  ;; CHECK-NEXT:     (struct.new_default $A)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (local.set $a
  ;; CHECK-NEXT:     (call $get-nullable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.is_null
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $merge-one-nullable-one-non-null (param $a (ref null $A)) (param $c i32) (result i32)
    ;; Only one arm assigns a non-null value -> cannot optimize after merge.
    (if
      (local.get $c)
      (then
        (local.set $a
          (struct.new_default $A)
        )
      )
      (else
        (local.set $a
          (call $get-nullable)
        )
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; ===========================================================================
  ;; Non-nullability inferred from trapping-on-null instructions
  ;; ===========================================================================

  ;; CHECK:      (func $ref-as-non-null (type $9) (param $a (ref null $A))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.as_non_null
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-as-non-null (param $a (ref null $A))
    ;; ref.as_non_null traps on null, proving $a is non-null afterward.
    (drop
      (ref.as_non_null
        (local.get $a)
      )
    )
    (drop
      (ref.is_null
        (local.get $a)
      )
    )
    (drop
      (ref.eq
        (local.get $a)
        (ref.null eq)
      )
    )
  )

  ;; CHECK:      (func $ref-as-convert-does-not-trap (type $29) (param $a anyref) (param $e externref)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (extern.convert_any
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (any.convert_extern
  ;; CHECK-NEXT:    (local.get $e)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (local.get $e)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-as-convert-does-not-trap (param $a anyref) (param $e externref)
    ;; any.convert_extern and extern.convert_any do not trap on null, so we
    ;; must not infer non-nullability.
    (drop
      (extern.convert_any
        (local.get $a)
      )
    )
    (drop
      (ref.is_null
        (local.get $a)
      )
    )
    (drop
      (any.convert_extern
        (local.get $e)
      )
    )
    (drop
      (ref.is_null
        (local.get $e)
      )
    )
  )

  ;; CHECK:      (func $ref-as-non-null-known-null (type $8) (param $a (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (ref.null none)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.as_non_null
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-as-non-null-known-null (param $a (ref null $A)) (result i32)
    ;; ref.as_non_null on a known-null local traps, so subsequent code is
    ;; unreachable.
    (local.set $a
      (ref.null $A)
    )
    (drop
      (ref.as_non_null
        (local.get $a)
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $ref-as-non-null-in-unreachable (type $9) (param $a (ref null $A))
  ;; CHECK-NEXT:  (local $c i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-as-non-null-in-unreachable (param $a (ref null $A))
    (local $c i32)
    ;; $c defaults to 0, so the then arm is unreachable.
    (if
      (local.get $c)
      (then
        (drop
          (ref.as_non_null
            (local.get $a)
          )
        )
      )
    )
  )

  ;; CHECK:      (func $struct-get (type $8) (param $a (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.get $A 0
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: )
  (func $struct-get (param $a (ref null $A)) (result i32)
    (drop
      (struct.get $A 0
        (local.get $a)
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $struct-get-known-null (type $8) (param $a (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (ref.null none)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable StructGet we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $struct-get-known-null (param $a (ref null $A)) (result i32)
    ;; struct.get on a known-null local traps, so subsequent code is
    ;; unreachable.
    (local.set $a
      (ref.null $A)
    )
    (drop
      (struct.get $A 0
        (local.get $a)
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $struct-get-already-non-null (type $30) (param $a (ref $A)) (result i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.get $A 0
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.is_null
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $struct-get-already-non-null (param $a (ref $A)) (result i32)
    ;; Already non-nullable local: no-op for trapOnNull.
    (drop
      (struct.get $A 0
        (local.get $a)
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $struct-get-non-local-get (type $8) (param $a (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.get $A 0
  ;; CHECK-NEXT:    (local.tee $a
  ;; CHECK-NEXT:     (call $get-nullable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.is_null
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $struct-get-non-local-get (param $a (ref null $A)) (result i32)
    ;; The ref is a local.tee of a nullable call, not a bare local.get;
    ;; trapOnNull does not currently look through fallthroughs.
    (drop
      (struct.get $A 0
        (local.tee $a
          (call $get-nullable)
        )
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $struct-get-then-overwrite (type $9) (param $a (ref null $A))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.get $A 0
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (call $get-nullable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $struct-get-then-overwrite (param $a (ref null $A))
    (drop
      (struct.get $A 0
        (local.get $a)
      )
    )
    ;; Known non-null -> 0.
    (drop
      (ref.is_null
        (local.get $a)
      )
    )
    ;; Overwriting with a nullable value invalidates the constraint.
    (local.set $a
      (call $get-nullable)
    )
    (drop
      (ref.is_null
        (local.get $a)
      )
    )
  )

  ;; CHECK:      (func $struct-get-merge-both-arms (type $11) (param $a (ref null $A)) (param $c i32) (result i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $c)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (struct.get $A 0
  ;; CHECK-NEXT:      (local.get $a)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (struct.get $A 0
  ;; CHECK-NEXT:      (local.get $a)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: )
  (func $struct-get-merge-both-arms (param $a (ref null $A)) (param $c i32) (result i32)
    ;; Both arms trap on null $a -> $a is known non-null after the merge.
    (if
      (local.get $c)
      (then
        (drop
          (struct.get $A 0
            (local.get $a)
          )
        )
      )
      (else
        (drop
          (struct.get $A 0
            (local.get $a)
          )
        )
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $struct-get-merge-one-arm (type $11) (param $a (ref null $A)) (param $c i32) (result i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $c)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (struct.get $A 0
  ;; CHECK-NEXT:      (local.get $a)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.is_null
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $struct-get-merge-one-arm (param $a (ref null $A)) (param $c i32) (result i32)
    ;; Only one arm traps on null $a -> cannot optimize after the merge.
    (if
      (local.get $c)
      (then
        (drop
          (struct.get $A 0
            (local.get $a)
          )
        )
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $struct-get-contradiction-prunes-branch (type $11) (param $a (ref null $A)) (param $c i32) (result i32)
  ;; CHECK-NEXT:  (local $x i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $c)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $a
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block ;; (replaces unreachable StructGet we can't emit)
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (block
  ;; CHECK-NEXT:     (local.set $x
  ;; CHECK-NEXT:      (i32.const 1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (unreachable)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (local.set $x
  ;; CHECK-NEXT:     (i32.const 42)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 42)
  ;; CHECK-NEXT: )
  (func $struct-get-contradiction-prunes-branch (param $a (ref null $A)) (param $c i32) (result i32)
    (local $x i32)
    ;; In the then arm, $a is set to null and dereferenced, so that arm is
    ;; unreachable. Only the else arm reaches the end, proving $x == 42.
    (if
      (local.get $c)
      (then
        (local.set $a
          (ref.null $A)
        )
        (drop
          (struct.get $A 0
            (local.get $a)
          )
        )
        (local.set $x
          (i32.const 1)
        )
      )
      (else
        (local.set $x
          (i32.const 42)
        )
      )
    )
    (local.get $x)
  )

  ;; CHECK:      (func $struct-get-loop (type $15) (param $a (ref null $A)) (param $c i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.get $A 0
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (loop $l
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (br_if $l
  ;; CHECK-NEXT:    (local.get $c)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $struct-get-loop (param $a (ref null $A)) (param $c i32)
    ;; Proving $a non-null before a loop keeps it non-null inside the loop
    ;; as long as the loop does not overwrite $a.
    (drop
      (struct.get $A 0
        (local.get $a)
      )
    )
    (loop $l
      (drop
        (ref.is_null
          (local.get $a)
        )
      )
      (br_if $l
        (local.get $c)
      )
    )
  )

  ;; CHECK:      (func $struct-get-loop-overwrite (type $15) (param $a (ref null $A)) (param $c i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.get $A 0
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (loop $l
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.is_null
  ;; CHECK-NEXT:     (local.get $a)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.set $a
  ;; CHECK-NEXT:    (call $get-nullable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (br_if $l
  ;; CHECK-NEXT:    (local.get $c)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $struct-get-loop-overwrite (param $a (ref null $A)) (param $c i32)
    ;; Overwriting $a with a nullable value inside the loop prevents proving
    ;; $a non-null at the top of the loop.
    (drop
      (struct.get $A 0
        (local.get $a)
      )
    )
    (loop $l
      (drop
        (ref.is_null
          (local.get $a)
        )
      )
      (local.set $a
        (call $get-nullable)
      )
      (br_if $l
        (local.get $c)
      )
    )
  )

  ;; CHECK:      (func $struct-set (type $16) (param $a (ref null $MutA)) (result i32)
  ;; CHECK-NEXT:  (struct.set $MutA 0
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: )
  (func $struct-set (param $a (ref null $MutA)) (result i32)
    (struct.set $MutA 0
      (local.get $a)
      (i32.const 1)
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $struct-set-check-in-value (type $16) (param $a (ref null $MutA)) (result i32)
  ;; CHECK-NEXT:  (struct.set $MutA 0
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: )
  (func $struct-set-check-in-value (param $a (ref null $MutA)) (result i32)
    ;; The ref.is_null inside the value child executes *before* struct.set
    ;; traps, so it must NOT be optimized; the ref.is_null *after* struct.set
    ;; IS optimized to 0.
    (struct.set $MutA 0
      (local.get $a)
      (ref.is_null
        (local.get $a)
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $struct-set-modify-in-later-child (type $17) (param $a (ref null $MutA)) (param $b (ref null $MutA)) (result i32)
  ;; CHECK-NEXT:  (struct.set $MutA 0
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:   (block (result i32)
  ;; CHECK-NEXT:    (local.set $a
  ;; CHECK-NEXT:     (local.get $b)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.is_null
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $struct-set-modify-in-later-child (param $a (ref null $MutA)) (param $b (ref null $MutA)) (result i32)
    ;; The value child overwrites $a before struct.set executes, so we must
    ;; NOT infer $a != null afterward.
    (struct.set $MutA 0
      (local.get $a)
      (block (result i32)
        (local.set $a
          (local.get $b)
        )
        (i32.const 1)
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $struct-set-modify-nested-in-later-child (type $31) (param $a (ref null $MutA)) (param $b (ref null $MutA)) (param $c i32) (result i32)
  ;; CHECK-NEXT:  (struct.set $MutA 0
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:   (block (result i32)
  ;; CHECK-NEXT:    (if
  ;; CHECK-NEXT:     (local.get $c)
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (local.set $a
  ;; CHECK-NEXT:       (local.get $b)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.is_null
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $struct-set-modify-nested-in-later-child (param $a (ref null $MutA)) (param $b (ref null $MutA)) (param $c i32) (result i32)
    ;; Even a conditional set of $a nested inside a later child must prevent
    ;; inferring $a != null.
    (struct.set $MutA 0
      (local.get $a)
      (block (result i32)
        (if
          (local.get $c)
          (then
            (local.set $a
              (local.get $b)
            )
          )
        )
        (i32.const 1)
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $struct-set-modify-other-local (type $17) (param $a (ref null $MutA)) (param $b (ref null $MutA)) (result i32)
  ;; CHECK-NEXT:  (struct.set $MutA 0
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:   (block (result i32)
  ;; CHECK-NEXT:    (local.set $b
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: )
  (func $struct-set-modify-other-local (param $a (ref null $MutA)) (param $b (ref null $MutA)) (result i32)
    ;; Modifying a *different* local $b in the value child does not interfere
    ;; with $a, so $a is still proven non-null.
    (struct.set $MutA 0
      (local.get $a)
      (block (result i32)
        (local.set $b
          (ref.null $MutA)
        )
        (i32.const 1)
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

  ;; CHECK:      (func $struct-set-branch-in-value (type $32) (param $a (ref null $MutA)) (param $c i32) (result i32)
  ;; CHECK-NEXT:  (block $out
  ;; CHECK-NEXT:   (struct.set $MutA 0
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:    (block (result i32)
  ;; CHECK-NEXT:     (br_if $out
  ;; CHECK-NEXT:      (local.get $c)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (return
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.is_null
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $struct-set-branch-in-value (param $a (ref null $MutA)) (param $c i32) (result i32)
    ;; If the value child branches out to $out, struct.set never executes, so
    ;; $out must NOT assume $a != null, whereas the code after struct.set DOES
    ;; know $a != null.
    (block $out
      (struct.set $MutA 0
        (local.get $a)
        (block (result i32)
          (br_if $out
            (local.get $c)
          )
          (i32.const 1)
        )
      )
      (return
        (ref.is_null
          (local.get $a)
        )
      )
    )
    (ref.is_null
      (local.get $a)
    )
  )

