;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-opt -all --local-gufa -S -o - | filecheck %s

;; Basic local optimizations vs things requiring global information.
(module
  ;; CHECK:      (type $0 (func (result i32)))

  ;; CHECK:      (type $1 (func (param i32) (result i32)))

  ;; CHECK:      (type $2 (func (param i32)))

  ;; CHECK:      (import "a" "c" (global $imp-imm i32))

  ;; CHECK:      (import "a" "b" (func $import (type $0) (result i32)))
  (import "a" "b" (func $import (result i32)))
  (import "a" "c" (global $imp-imm i32))

  ;; CHECK:      (global $imm i32 (i32.const 42))
  (global $imm i32 (i32.const 42))
  ;; CHECK:      (global $mut (mut i32) (i32.const 10))
  (global $mut (mut i32) (i32.const 10))

  ;; CHECK:      (elem declare func $helper $import)
  (elem declare func $helper $import)

  ;; Uncalled function: local GUFA cannot assume it is never called, so its
  ;; parameter must NOT become unreachable.
  ;; CHECK:      (func $uncalled (type $1) (param $p i32) (result i32)
  ;; CHECK-NEXT:  (local.get $p)
  ;; CHECK-NEXT: )
  (func $uncalled (param $p i32) (result i32)
    (local.get $p)
  )

  ;; Helper returning a constant.
  ;; CHECK:      (func $helper (type $0) (result i32)
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: )
  (func $helper (result i32)
    (i32.const 1)
  )

  ;; Local constant propagation through locals and selects works, while calls
  ;; to other functions are NOT inferred from the callee body.
  ;; CHECK:      (func $local-consts (type $2) (param $c i32)
  ;; CHECK-NEXT:  (local $x i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $c)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $x
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result i32)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (call $import)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $helper)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $x
  ;; CHECK-NEXT:   (i32.const 7)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (loop $loop
  ;; CHECK-NEXT:   (local.set $x
  ;; CHECK-NEXT:    (i32.const 7)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (br_if $loop
  ;; CHECK-NEXT:    (local.get $c)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 7)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $local-consts (param $c i32)
    (local $x i32)
    (if
      (local.get $c)
      (then
        (local.set $x (i32.const 0))
      )
    )
    ;; $x is either default 0 or set to 0 -> 0.
    (drop (local.get $x))

    ;; Both arms of select are 1 -> 1.
    (drop
      (select
        (i32.const 1)
        (i32.const 1)
        (call $import)
      )
    )

    ;; Call to $helper is NOT inferred as 1 because local GUFA does not inspect
    ;; other functions.
    (drop (call $helper))

    ;; Loop/cycle where local only ever holds 7 -> 7.
    (local.set $x (i32.const 7))
    (loop $loop
      (local.set $x (local.get $x))
      (br_if $loop (local.get $c))
    )
    (drop (local.get $x))
  )

  ;; Globals: mutable globals are unknown; immutable globals preserve their
  ;; identity (so local flow optimizes to global.get) without inspecting
  ;; global initializers.
  ;; CHECK:      (func $globals (type $2) (param $c i32)
  ;; CHECK-NEXT:  (global.set $mut
  ;; CHECK-NEXT:   (i32.const 10)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $mut)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $imm)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $imm)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $imp-imm)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $globals (param $c i32)
    ;; Mutable global set to 10 locally still cannot be inferred as 10.
    (global.set $mut (i32.const 10))
    (drop (global.get $mut))

    ;; Defined immutable global is NOT replaced with 42, only kept as global.get.
    (drop (global.get $imm))

    ;; Flowing an immutable global through a select/local optimizes to global.get.
    (drop
      (select
        (global.get $imm)
        (global.get $imm)
        (local.get $c)
      )
    )
    (drop
      (select
        (global.get $imp-imm)
        (global.get $imp-imm)
        (local.get $c)
      )
    )
  )

  ;; Direct self-recursion CAN infer return values from this function alone.
  ;; CHECK:      (func $self-rec-const (type $1) (param $n i32) (result i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $n)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (return
  ;; CHECK-NEXT:     (i32.const 99)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result i32)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (call $self-rec-const
  ;; CHECK-NEXT:      (i32.const 0)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.const 99)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 99)
  ;; CHECK-NEXT: )
  (func $self-rec-const (param $n i32) (result i32)
    (if
      (local.get $n)
      (then
        (return (i32.const 99))
      )
    )
    (call $self-rec-const (i32.const 0))
  )

  ;; Direct self-recursion that also has a return_call to another function
  ;; cannot infer a constant return value.
  ;; CHECK:      (func $self-rec-return-call-other (type $1) (param $n i32) (result i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $n)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (return
  ;; CHECK-NEXT:     (i32.const 99)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.eqz
  ;; CHECK-NEXT:    (local.get $n)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (return_call $helper)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $self-rec-return-call-other
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $self-rec-return-call-other (param $n i32) (result i32)
    (if
      (local.get $n)
      (then
        (return (i32.const 99))
      )
    )
    (if
      (i32.eqz (local.get $n))
      (then
        (return_call $helper)
      )
    )
    (call $self-rec-return-call-other (i32.const 0))
  )

  ;; Infinite direct self-recursion never returns -> call result is unreachable.
  ;; CHECK:      (func $self-rec-infinite (type $0) (result i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $self-rec-infinite)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $self-rec-infinite (result i32)
    (call $self-rec-infinite)
  )

  ;; ref.func propagates locally for both defined and imported functions.
  ;; CHECK:      (func $ref-funcs (type $2) (param $c i32)
  ;; CHECK-NEXT:  (local $f funcref)
  ;; CHECK-NEXT:  (local.set $f
  ;; CHECK-NEXT:   (ref.func $helper)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.func $helper)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $f
  ;; CHECK-NEXT:   (ref.func $import)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.func $import)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-funcs (param $c i32)
    (local $f funcref)
    (local.set $f (ref.func $helper))
    (drop (local.get $f))

    (local.set $f (ref.func $import))
    (drop (local.get $f))
  )
)

;; GC references, cones, final vs open types, casts, tests, ref.eq, fields, and
;; descriptors.
(module
  (rec
    ;; CHECK:      (type $sig (func (result i32)))

    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $A (sub (struct (field anyref))))
    (type $A (sub (struct (field anyref))))
    ;; CHECK:       (type $B (sub $A (struct (field (ref $Target)))))
    (type $B (sub $A (struct (field (ref $Target)))))
    ;; CHECK:       (type $C (sub $B (struct (field (ref $Target)))))
    (type $C (sub $B (struct (field (ref $Target)))))
    ;; CHECK:       (type $FinalB (sub final $A (struct (field (ref $Target)))))
    (type $FinalB (sub final $A (struct (field (ref $Target)))))
    ;; CHECK:       (type $OpenLeaf (sub $A (struct (field anyref))))
    (type $OpenLeaf (sub $A (struct (field anyref))))
    ;; CHECK:       (type $Target (struct))
    (type $Target (struct))
    ;; CHECK:       (type $Other (struct))
    (type $Other (struct))
  )

  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $Super (sub (descriptor $SuperDesc) (struct (field i32))))
    (type $Super (sub (descriptor $SuperDesc) (struct (field i32))))
    ;; CHECK:       (type $SuperDesc (sub (describes $Super) (struct)))
    (type $SuperDesc (sub (describes $Super) (struct)))
    ;; CHECK:       (type $Sub (sub $Super (descriptor $SubDesc) (struct (field i32))))
    (type $Sub (sub $Super (descriptor $SubDesc) (struct (field i32))))
    ;; CHECK:       (type $SubDesc (sub $SuperDesc (describes $Sub) (struct)))
    (type $SubDesc (sub $SuperDesc (describes $Sub) (struct)))
  )

  ;; CHECK:      (type $12 (func))

  ;; CHECK:      (type $arr (array (mut i8)))
  (type $arr (array (mut i8)))
  (type $sig (func (result i32)))

  ;; CHECK:      (type $14 (func (param i32 (ref $FinalB) (ref $OpenLeaf))))

  ;; CHECK:      (type $15 (func (param (ref (exact $SubDesc)))))

  ;; CHECK:      (type $16 (func (param i32 (ref $sig))))

  ;; CHECK:      (import "a" "b" (func $import (type $sig) (result i32)))
  (import "a" "b" (func $import (result i32)))
  ;; CHECK:      (table $t 1 funcref)
  (table $t 1 funcref)

  ;; Unreachability from null / impossible casts / null dereferences / bottom call_ref.
  ;; CHECK:      (func $unreachability (type $12)
  ;; CHECK-NEXT:  (local $a (ref null $A))
  ;; CHECK-NEXT:  (local $arr (ref null $arr))
  ;; CHECK-NEXT:  (local $s (ref null $Super))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $unreachability
    (local $a (ref null $A))
    (local $arr (ref null $arr))
    (local $s (ref null $Super))

    ;; ref.as_non_null of null -> unreachable.
    (drop (ref.as_non_null (ref.null any)))

    ;; Exact $A cast to subtype $B -> unreachable.
    (drop
      (ref.cast (ref $B)
        (struct.new $A (ref.null any))
      )
    )

    ;; struct.get / array.get / array.load / ref.get_desc on null local -> unreachable.
    (drop (struct.get $A 0 (local.get $a)))
    (drop (array.get_u $arr (local.get $arr) (i32.const 0)))
    (drop (i32.load8_u (type $arr) (local.get $arr) (i32.const 0)))
    (drop (ref.get_desc $Super (local.get $s)))

    ;; call_ref on bottom type -> unreachable.
    (drop (call_ref $sig (ref.null nofunc)))
  )

  ;; ref.test, ref.cast, ref.eq with exact types and cones.
  ;; CHECK:      (func $cones-and-tests (type $14) (param $c i32) (param $fb (ref $FinalB)) (param $ol (ref $OpenLeaf))
  ;; CHECK-NEXT:  (local $a (ref $A))
  ;; CHECK-NEXT:  (local $a2 (ref $A))
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (struct.new $B
  ;; CHECK-NEXT:    (struct.new_default $Target)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.cast (ref (exact $B))
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $a2
  ;; CHECK-NEXT:   (struct.new $A
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (select (result (ref $A))
  ;; CHECK-NEXT:    (struct.new $A
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $fb)
  ;; CHECK-NEXT:    (local.get $c)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (select (result (ref $A))
  ;; CHECK-NEXT:    (struct.new $A
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $ol)
  ;; CHECK-NEXT:    (local.get $c)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.test (ref $C)
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.test (ref (exact $OpenLeaf))
  ;; CHECK-NEXT:    (local.get $ol)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cones-and-tests (param $c i32) (param $fb (ref $FinalB)) (param $ol (ref $OpenLeaf))
    (local $a (ref $A))
    (local $a2 (ref $A))

    ;; Exact $B: ref.test $B -> 1, ref.test $C -> 0, ref.cast refined to exact $B.
    (local.set $a (struct.new $B (struct.new $Target)))
    (drop (ref.test (ref $B) (local.get $a)))
    (drop (ref.test (ref $C) (local.get $a)))
    (drop (ref.cast (ref null $A) (local.get $a)))

    ;; ref.eq of disjoint exact types ($A vs $B) -> 0.
    (local.set $a2 (struct.new $A (ref.null any)))
    (drop (ref.eq (local.get $a) (local.get $a2)))

    ;; Cone of depth 1: select between exact $A and final $FinalB (depth 0!) ->
    ;; cone($A, 1), which excludes depth-2 subtype $C -> ref.test $C is 0!
    (local.set $a
      (select (result (ref $A))
        (struct.new $A (ref.null any))
        (local.get $fb)
        (local.get $c)
      )
    )
    (drop (ref.test (ref $C) (local.get $a)))

    ;; Open type $OpenLeaf (even with no subtypes in this module!) must NOT be
    ;; assumed to have depth 0 in local mode.
    (local.set $a
      (select (result (ref $A))
        (struct.new $A (ref.null any))
        (local.get $ol)
        (local.get $c)
      )
    )
    (drop (ref.test (ref $C) (local.get $a)))
    (drop (ref.test (ref (exact $OpenLeaf)) (local.get $ol)))
  )

  ;; Struct/array field contents are NOT tracked globally, but refined field
  ;; types and descriptor types ARE inferred from the known reference type!
  ;; CHECK:      (func $fields-and-descs (type $15) (param $d (ref (exact $SubDesc)))
  ;; CHECK-NEXT:  (local $a (ref $A))
  ;; CHECK-NEXT:  (local $s (ref $Super))
  ;; CHECK-NEXT:  (local.set $s
  ;; CHECK-NEXT:   (struct.new_desc $Sub
  ;; CHECK-NEXT:    (i32.const 123)
  ;; CHECK-NEXT:    (local.get $d)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.get $Super 0
  ;; CHECK-NEXT:    (local.get $s)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (struct.new $B
  ;; CHECK-NEXT:    (struct.new_default $Target)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $fields-and-descs (param $d (ref (exact $SubDesc)))
    (local $a (ref $A))
    (local $s (ref $Super))

    ;; Even though $Super is only created with 123 here, struct.get must NOT
    ;; infer 123 (another function could allocate $Super with another value).
    (local.set $s
      (struct.new_desc $Sub
        (i32.const 123)
        (local.get $d)
      )
    )
    (drop (struct.get $Super 0 (local.get $s)))

    ;; However, ref.get_desc on $s (known exact $Sub) knows the result is
    ;; (ref (exact $SubDesc)), so ref.test folds to 1!
    (drop
      (ref.test (ref (exact $SubDesc))
        (ref.get_desc $Super (local.get $s))
      )
    )

    ;; And struct.get $A 0 on $a (known exact $B) knows field 0 has $B's
    ;; refined type (ref $Target), so ref.test folds to 1!
    (local.set $a (struct.new $B (struct.new $Target)))
    (drop
      (ref.test (ref $Target)
        (struct.get $A 0 (local.get $a))
      )
    )
    (drop
      (ref.test (ref $Other)
        (struct.get $A 0 (local.get $a))
      )
    )
  )

  ;; Indirect calls return unknown values of the signature's result type.
  ;; CHECK:      (func $indirect-calls (type $16) (param $i i32) (param $f (ref $sig))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call_indirect $t (type $sig)
  ;; CHECK-NEXT:    (local.get $i)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call_ref $sig
  ;; CHECK-NEXT:    (local.get $f)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $indirect-calls (param $i i32) (param $f (ref $sig))
    (drop (call_indirect $t (type $sig) (local.get $i)))
    (drop (call_ref $sig (local.get $f)))
  )
)

;; Exceptions and continuations: tags are not tracked globally, so catches and
;; handlers assume any value of the tag's param types can arrive.
(module
  ;; CHECK:      (type $func (func))
  (type $func (func))
  ;; CHECK:      (type $cont (cont $func))
  (type $cont (cont $func))
  ;; CHECK:      (type $2 (func (result i32)))

  ;; CHECK:      (type $3 (func (param i32)))

  ;; CHECK:      (type $4 (func (result i32 (ref $cont))))

  ;; CHECK:      (elem declare func $noop)

  ;; CHECK:      (tag $e (type $3) (param i32))
  (tag $e (param i32))

  (elem declare func $noop)

  ;; CHECK:      (func $noop (type $func)
  ;; CHECK-NEXT: )
  (func $noop)

  ;; CHECK:      (func $try-table-no-infer (type $2) (result i32)
  ;; CHECK-NEXT:  (block $catch (result i32)
  ;; CHECK-NEXT:   (try_table (catch $e $catch)
  ;; CHECK-NEXT:    (throw $e
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $try-table-no-infer (result i32)
    ;; Even though $e is only thrown with 0 here, local GUFA must not infer 0
    ;; (or unreachable).
    (block $catch (result i32)
      (try_table (catch $e $catch)
        (throw $e (i32.const 0))
      )
    )
  )

  ;; CHECK:      (func $try-table-exnref (type $func)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block $catch (result exnref)
  ;; CHECK-NEXT:    (try_table (catch_all_ref $catch)
  ;; CHECK-NEXT:     (throw $e
  ;; CHECK-NEXT:      (i32.const 0)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $try-table-exnref
    ;; catch_all_ref materializes a non-null exnref; block must not become
    ;; unreachable.
    (drop
      (block $catch (result exnref)
        (try_table (catch_all_ref $catch)
          (throw $e (i32.const 0))
        )
      )
    )
  )

  ;; CHECK:      (func $legacy-try (type $2) (result i32)
  ;; CHECK-NEXT:  (try (result i32)
  ;; CHECK-NEXT:   (do
  ;; CHECK-NEXT:    (throw $e
  ;; CHECK-NEXT:     (i32.const 5)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (catch $e
  ;; CHECK-NEXT:    (pop i32)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $legacy-try (result i32)
    (try (result i32)
      (do
        (throw $e (i32.const 5))
      )
      (catch $e
        (pop i32)
      )
    )
  )

  ;; CHECK:      (func $resume-handler (type $func)
  ;; CHECK-NEXT:  (tuple.drop 2
  ;; CHECK-NEXT:   (block $on (type $4) (result i32 (ref $cont))
  ;; CHECK-NEXT:    (resume $cont (on $e $on)
  ;; CHECK-NEXT:     (cont.new $cont
  ;; CHECK-NEXT:      (ref.func $noop)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (return)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $resume-handler
    (tuple.drop 2
      (block $on (result i32 (ref $cont))
        (resume $cont (on $e $on)
          (cont.new $cont (ref.func $noop))
        )
        (return)
      )
    )
  )
)

;; Cast inferences that no existing local pass can perform.
;;
;; Existing passes like OptimizeInstructions and RemoveUnusedBrs use
;; GCTypeUtils::evaluateCastCheck in a peephole manner on IR types, and
;; LocalSubtyping can only refine locals to types expressible in the wasm type
;; system. Here we flow exact $A and exact $B through branches, a loop, and
;; locals; their LUB in the wasm type system is inexact (ref $A) (which allows
;; subtype $C), so even -O3 --converge --closed-world cannot optimize the casts
;; or ref.test below. Local GUFA tracks the flow of data through locals and
;; control flow using a cone of depth 1 under $A, proving that $C can never
;; arrive so the non-nullable cast definitely fails (unreachable), the nullable
;; cast can only yield null, and ref.test $C is 0.
(module
  ;; CHECK:      (type $A (sub (struct)))
  (type $A (sub (struct)))
  ;; CHECK:      (type $B (sub $A (struct)))
  (type $B (sub $A (struct)))
  ;; CHECK:      (type $C (sub $B (struct)))
  (type $C (sub $B (struct)))

  ;; CHECK:      (type $3 (func (result i32)))

  ;; CHECK:      (type $4 (func (result (ref $C))))

  ;; CHECK:      (type $5 (func (result (ref null $C))))

  ;; CHECK:      (import "env" "cond" (func $cond (type $3) (result i32)))
  (import "env" "cond" (func $cond (result i32)))

  ;; Ensure $C is instantiated in the module so even closed-world passes cannot
  ;; assume $C does not exist.
  ;; CHECK:      (export "make_c" (func $make-c))

  ;; CHECK:      (export "cast_fails" (func $cast-fails-via-flow))

  ;; CHECK:      (export "cast_null" (func $cast-null-via-flow))

  ;; CHECK:      (export "ref_test_fails" (func $ref-test-fails-via-flow))

  ;; CHECK:      (func $make-c (type $4) (result (ref $C))
  ;; CHECK-NEXT:  (struct.new_default $C)
  ;; CHECK-NEXT: )
  (func $make-c (export "make_c") (result (ref $C))
    (struct.new $C)
  )

  ;; CHECK:      (func $cast-fails-via-flow (type $4) (result (ref $C))
  ;; CHECK-NEXT:  (local $x (ref $A))
  ;; CHECK-NEXT:  (local $y (ref $A))
  ;; CHECK-NEXT:  (local.set $x
  ;; CHECK-NEXT:   (block $b (result (ref $A))
  ;; CHECK-NEXT:    (if
  ;; CHECK-NEXT:     (call $cond)
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (br $b
  ;; CHECK-NEXT:       (struct.new_default $A)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (struct.new_default $B)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (loop $loop
  ;; CHECK-NEXT:   (if
  ;; CHECK-NEXT:    (call $cond)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (local.set $x
  ;; CHECK-NEXT:      (struct.new_default $A)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (br $loop)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (if
  ;; CHECK-NEXT:    (call $cond)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (local.set $x
  ;; CHECK-NEXT:      (struct.new_default $B)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (br $loop)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $y
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $cast-fails-via-flow (export "cast_fails") (result (ref $C))
    (local $x (ref $A))
    (local $y (ref $A))
    (local.set $x
      (block $b (result (ref $A))
        (if
          (call $cond)
          (then
            (br $b (struct.new $A))
          )
        )
        (struct.new $B)
      )
    )
    (loop $loop
      (if
        (call $cond)
        (then
          (local.set $x (struct.new $A))
          (br $loop)
        )
      )
      (if
        (call $cond)
        (then
          (local.set $x (struct.new $B))
          (br $loop)
        )
      )
    )
    (local.set $y (local.get $x))
    ;; This cast definitely fails -> replaced with unreachable.
    (ref.cast (ref $C)
      (local.get $y)
    )
  )

  ;; CHECK:      (func $cast-null-via-flow (type $5) (result (ref null $C))
  ;; CHECK-NEXT:  (local $x (ref null $A))
  ;; CHECK-NEXT:  (loop $loop
  ;; CHECK-NEXT:   (if
  ;; CHECK-NEXT:    (call $cond)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (local.set $x
  ;; CHECK-NEXT:      (struct.new_default $A)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (br $loop)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (if
  ;; CHECK-NEXT:    (call $cond)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (local.set $x
  ;; CHECK-NEXT:      (struct.new_default $B)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (br $loop)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.cast nullref
  ;; CHECK-NEXT:      (local.get $x)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT: )
  (func $cast-null-via-flow (export "cast_null") (result (ref null $C))
    (local $x (ref null $A))
    (loop $loop
      (if
        (call $cond)
        (then
          (local.set $x (struct.new $A))
          (br $loop)
        )
      )
      (if
        (call $cond)
        (then
          (local.set $x (struct.new $B))
          (br $loop)
        )
      )
    )
    ;; Only null can pass this cast -> refined to ref.cast nullref + ref.null.
    (ref.cast (ref null $C)
      (local.get $x)
    )
  )

  ;; CHECK:      (func $ref-test-fails-via-flow (type $3) (result i32)
  ;; CHECK-NEXT:  (local $x (ref $A))
  ;; CHECK-NEXT:  (local.set $x
  ;; CHECK-NEXT:   (block $b (result (ref $A))
  ;; CHECK-NEXT:    (if
  ;; CHECK-NEXT:     (call $cond)
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (br $b
  ;; CHECK-NEXT:       (struct.new_default $A)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (struct.new_default $B)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (loop $loop
  ;; CHECK-NEXT:   (if
  ;; CHECK-NEXT:    (call $cond)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (local.set $x
  ;; CHECK-NEXT:      (struct.new_default $A)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (br $loop)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (if
  ;; CHECK-NEXT:    (call $cond)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (local.set $x
  ;; CHECK-NEXT:      (struct.new_default $B)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (br $loop)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: )
  (func $ref-test-fails-via-flow (export "ref_test_fails") (result i32)
    (local $x (ref $A))
    (local.set $x
      (block $b (result (ref $A))
        (if
          (call $cond)
          (then
            (br $b (struct.new $A))
          )
        )
        (struct.new $B)
      )
    )
    (loop $loop
      (if
        (call $cond)
        (then
          (local.set $x (struct.new $A))
          (br $loop)
        )
      )
      (if
        (call $cond)
        (then
          (local.set $x (struct.new $B))
          (br $loop)
        )
      )
    )
    ;; $C can never arrive -> folds to 0.
    (ref.test (ref $C)
      (local.get $x)
    )
  )
)
