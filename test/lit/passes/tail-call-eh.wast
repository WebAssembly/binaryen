;; NOTE: Assertions have been generated by update_lit_checks.py and should not be edited.
;; Test tail-call optimization interaction with exception handling and GlobalEffects.

;; RUN: wasm-opt %s --tail-call --enable-tail-call --enable-exception-handling --enable-reference-types -S -o - | filecheck %s --check-prefix=NO-EFFECTS
;; RUN: wasm-opt %s --generate-global-effects --tail-call --enable-tail-call --enable-exception-handling --enable-reference-types -S -o - | filecheck %s --check-prefix=WITH-EFFECTS

(module
  ;; NO-EFFECTS:      (tag $e1 (type $0))
  ;; WITH-EFFECTS:      (tag $e1 (type $0))
  (tag $e1)
  ;; NO-EFFECTS:      (tag $e2 (type $0))
  ;; WITH-EFFECTS:      (tag $e2 (type $0))
  (tag $e2)

  ;; NO-EFFECTS:      (func $throwing-callee
  ;; NO-EFFECTS-NEXT:  (throw $e1)
  ;; NO-EFFECTS-NEXT: )
  ;; WITH-EFFECTS:      (func $throwing-callee
  ;; WITH-EFFECTS-NEXT:  (throw $e1)
  ;; WITH-EFFECTS-NEXT: )
  (func $throwing-callee
    (throw $e1)
  )

  ;; NO-EFFECTS:      (func $throwing-i32-callee (result i32)
  ;; NO-EFFECTS-NEXT:  (throw $e1)
  ;; NO-EFFECTS-NEXT: )
  ;; WITH-EFFECTS:      (func $throwing-i32-callee (result i32)
  ;; WITH-EFFECTS-NEXT:  (throw $e1)
  ;; WITH-EFFECTS-NEXT: )
  (func $throwing-i32-callee (result i32)
    (throw $e1)
  )

  ;; NO-EFFECTS:      (func $non-throwing-callee (result i32)
  ;; NO-EFFECTS-NEXT:  (i32.const 42)
  ;; NO-EFFECTS-NEXT: )
  ;; WITH-EFFECTS:      (func $non-throwing-callee (result i32)
  ;; WITH-EFFECTS-NEXT:  (i32.const 42)
  ;; WITH-EFFECTS-NEXT: )
  (func $non-throwing-callee (result i32)
    (i32.const 42)
  )

  ;; NO-EFFECTS:      (func $non-throwing-param-callee (param $x i32) (result i32)
  ;; NO-EFFECTS-NEXT:  (local.get $x)
  ;; NO-EFFECTS-NEXT: )
  ;; WITH-EFFECTS:      (func $non-throwing-param-callee (param $x i32) (result i32)
  ;; WITH-EFFECTS-NEXT:  (local.get $x)
  ;; WITH-EFFECTS-NEXT: )
  (func $non-throwing-param-callee (param $x i32) (result i32)
    (local.get $x)
  )

  ;; NO-EFFECTS:      (func $caller-throws
  ;; NO-EFFECTS-NEXT:  (block $catch
  ;; NO-EFFECTS-NEXT:   (try_table (catch_all $catch)
  ;; NO-EFFECTS-NEXT:    (call $throwing-callee)
  ;; NO-EFFECTS-NEXT:   )
  ;; NO-EFFECTS-NEXT:  )
  ;; NO-EFFECTS-NEXT: )
  ;; WITH-EFFECTS:      (func $caller-throws
  ;; WITH-EFFECTS-NEXT:  (block $catch
  ;; WITH-EFFECTS-NEXT:   (try_table (catch_all $catch)
  ;; WITH-EFFECTS-NEXT:    (call $throwing-callee)
  ;; WITH-EFFECTS-NEXT:   )
  ;; WITH-EFFECTS-NEXT:  )
  ;; WITH-EFFECTS-NEXT: )
  (func $caller-throws
    ;; Inside try_table, a call that might throw cannot be converted to return_call.
    (block $catch
      (try_table (catch_all $catch)
        (call $throwing-callee)
      )
    )
  )

  ;; NO-EFFECTS:      (func $caller-non-throwing-in-try (result i32)
  ;; NO-EFFECTS-NEXT:  (block $catch
  ;; NO-EFFECTS-NEXT:   (return
  ;; NO-EFFECTS-NEXT:    (try_table (result i32) (catch_all $catch)
  ;; NO-EFFECTS-NEXT:     (call $non-throwing-callee)
  ;; NO-EFFECTS-NEXT:    )
  ;; NO-EFFECTS-NEXT:   )
  ;; NO-EFFECTS-NEXT:  )
  ;; NO-EFFECTS-NEXT:  (i32.const 0)
  ;; NO-EFFECTS-NEXT: )
  ;; WITH-EFFECTS:      (func $caller-non-throwing-in-try (result i32)
  ;; WITH-EFFECTS-NEXT:  (block $catch
  ;; WITH-EFFECTS-NEXT:   (return
  ;; WITH-EFFECTS-NEXT:    (try_table (catch_all $catch)
  ;; WITH-EFFECTS-NEXT:     (return_call $non-throwing-callee)
  ;; WITH-EFFECTS-NEXT:    )
  ;; WITH-EFFECTS-NEXT:   )
  ;; WITH-EFFECTS-NEXT:  )
  ;; WITH-EFFECTS-NEXT:  (i32.const 0)
  ;; WITH-EFFECTS-NEXT: )
  (func $caller-non-throwing-in-try (result i32)
    ;; Inside try_table, a call to a non-throwing function CAN be converted when
    ;; GlobalEffects is available.
    (block $catch
      (return
        (try_table (result i32) (catch_all $catch)
          (call $non-throwing-callee)
        )
      )
    )
    (i32.const 0)
  )

  ;; NO-EFFECTS:      (func $caller-throwing-arg-in-try (result i32)
  ;; NO-EFFECTS-NEXT:  (block $catch
  ;; NO-EFFECTS-NEXT:   (return
  ;; NO-EFFECTS-NEXT:    (try_table (result i32) (catch_all $catch)
  ;; NO-EFFECTS-NEXT:     (call $non-throwing-param-callee
  ;; NO-EFFECTS-NEXT:      (call $throwing-i32-callee)
  ;; NO-EFFECTS-NEXT:     )
  ;; NO-EFFECTS-NEXT:    )
  ;; NO-EFFECTS-NEXT:   )
  ;; NO-EFFECTS-NEXT:  )
  ;; NO-EFFECTS-NEXT:  (i32.const 0)
  ;; NO-EFFECTS-NEXT: )
  ;; WITH-EFFECTS:      (func $caller-throwing-arg-in-try (result i32)
  ;; WITH-EFFECTS-NEXT:  (block $catch
  ;; WITH-EFFECTS-NEXT:   (return
  ;; WITH-EFFECTS-NEXT:    (try_table (catch_all $catch)
  ;; WITH-EFFECTS-NEXT:     (return_call $non-throwing-param-callee
  ;; WITH-EFFECTS-NEXT:      (call $throwing-i32-callee)
  ;; WITH-EFFECTS-NEXT:     )
  ;; WITH-EFFECTS-NEXT:    )
  ;; WITH-EFFECTS-NEXT:   )
  ;; WITH-EFFECTS-NEXT:  )
  ;; WITH-EFFECTS-NEXT:  (i32.const 0)
  ;; WITH-EFFECTS-NEXT: )
  (func $caller-throwing-arg-in-try (result i32)
    ;; Even if an argument expression may throw, ShallowEffectAnalyzer only
    ;; checks whether the call instruction itself can throw, allowing the outer
    ;; non-throwing call to be converted when GlobalEffects is available.
    (block $catch
      (return
        (try_table (result i32) (catch_all $catch)
          (call $non-throwing-param-callee
            (call $throwing-i32-callee)
          )
        )
      )
    )
    (i32.const 0)
  )

  ;; NO-EFFECTS:      (func $caller-outside-try
  ;; NO-EFFECTS-NEXT:  (return_call $throwing-callee)
  ;; NO-EFFECTS-NEXT: )
  ;; WITH-EFFECTS:      (func $caller-outside-try
  ;; WITH-EFFECTS-NEXT:  (return_call $throwing-callee)
  ;; WITH-EFFECTS-NEXT: )
  (func $caller-outside-try
    ;; Outside any active try/try_table handler, calls in tail position are
    ;; converted even when EH is enabled on the module.
    (call $throwing-callee)
  )

  ;; NO-EFFECTS:      (func $legacy-try-catch
  ;; NO-EFFECTS-NEXT:  (try
  ;; NO-EFFECTS-NEXT:   (do
  ;; NO-EFFECTS-NEXT:    (call $throwing-callee)
  ;; NO-EFFECTS-NEXT:   )
  ;; NO-EFFECTS-NEXT:   (catch_all
  ;; NO-EFFECTS-NEXT:    (return_call $throwing-callee)
  ;; NO-EFFECTS-NEXT:   )
  ;; NO-EFFECTS-NEXT:  )
  ;; NO-EFFECTS-NEXT: )
  ;; WITH-EFFECTS:      (func $legacy-try-catch
  ;; WITH-EFFECTS-NEXT:  (try
  ;; WITH-EFFECTS-NEXT:   (do
  ;; WITH-EFFECTS-NEXT:    (call $throwing-callee)
  ;; WITH-EFFECTS-NEXT:   )
  ;; WITH-EFFECTS-NEXT:   (catch_all
  ;; WITH-EFFECTS-NEXT:    (return_call $throwing-callee)
  ;; WITH-EFFECTS-NEXT:   )
  ;; WITH-EFFECTS-NEXT:  )
  ;; WITH-EFFECTS-NEXT: )
  (func $legacy-try-catch
    ;; Legacy try-catch: try body is protected by catch handler (ehDepth > 0),
    ;; while catch body is outside the handler (ehDepth == 0).
    (try
      (do
        (call $throwing-callee)
      )
      (catch_all
        (call $throwing-callee)
      )
    )
  )

  ;; NO-EFFECTS:      (func $legacy-try-multiple-catches
  ;; NO-EFFECTS-NEXT:  (try
  ;; NO-EFFECTS-NEXT:   (do
  ;; NO-EFFECTS-NEXT:    (call $throwing-callee)
  ;; NO-EFFECTS-NEXT:   )
  ;; NO-EFFECTS-NEXT:   (catch $e1
  ;; NO-EFFECTS-NEXT:    (return_call $throwing-callee)
  ;; NO-EFFECTS-NEXT:   )
  ;; NO-EFFECTS-NEXT:   (catch $e2
  ;; NO-EFFECTS-NEXT:    (return_call $throwing-callee)
  ;; NO-EFFECTS-NEXT:   )
  ;; NO-EFFECTS-NEXT:   (catch_all
  ;; NO-EFFECTS-NEXT:    (return_call $throwing-callee)
  ;; NO-EFFECTS-NEXT:   )
  ;; NO-EFFECTS-NEXT:  )
  ;; NO-EFFECTS-NEXT: )
  ;; WITH-EFFECTS:      (func $legacy-try-multiple-catches
  ;; WITH-EFFECTS-NEXT:  (try
  ;; WITH-EFFECTS-NEXT:   (do
  ;; WITH-EFFECTS-NEXT:    (call $throwing-callee)
  ;; WITH-EFFECTS-NEXT:   )
  ;; WITH-EFFECTS-NEXT:   (catch $e1
  ;; WITH-EFFECTS-NEXT:    (return_call $throwing-callee)
  ;; WITH-EFFECTS-NEXT:   )
  ;; WITH-EFFECTS-NEXT:   (catch $e2
  ;; WITH-EFFECTS-NEXT:    (return_call $throwing-callee)
  ;; WITH-EFFECTS-NEXT:   )
  ;; WITH-EFFECTS-NEXT:   (catch_all
  ;; WITH-EFFECTS-NEXT:    (return_call $throwing-callee)
  ;; WITH-EFFECTS-NEXT:   )
  ;; WITH-EFFECTS-NEXT:  )
  ;; WITH-EFFECTS-NEXT: )
  (func $legacy-try-multiple-catches
    ;; Legacy try-catch with multiple catch bodies: all catch bodies are outside
    ;; the try handler (ehDepth == 0) and should convert their tail calls.
    (try
      (do
        (call $throwing-callee)
      )
      (catch $e1
        (call $throwing-callee)
      )
      (catch $e2
        (call $throwing-callee)
      )
      (catch_all
        (call $throwing-callee)
      )
    )
  )

  ;; NO-EFFECTS:      (func $legacy-try-delegate-caller
  ;; NO-EFFECTS-NEXT:  (try
  ;; NO-EFFECTS-NEXT:   (do
  ;; NO-EFFECTS-NEXT:    (return_call $throwing-callee)
  ;; NO-EFFECTS-NEXT:   )
  ;; NO-EFFECTS-NEXT:   (delegate 0)
  ;; NO-EFFECTS-NEXT:  )
  ;; NO-EFFECTS-NEXT: )
  ;; WITH-EFFECTS:      (func $legacy-try-delegate-caller
  ;; WITH-EFFECTS-NEXT:  (try
  ;; WITH-EFFECTS-NEXT:   (do
  ;; WITH-EFFECTS-NEXT:    (return_call $throwing-callee)
  ;; WITH-EFFECTS-NEXT:   )
  ;; WITH-EFFECTS-NEXT:   (delegate 0)
  ;; WITH-EFFECTS-NEXT:  )
  ;; WITH-EFFECTS-NEXT: )
  (func $legacy-try-delegate-caller
    ;; A try block that delegates directly to the caller (0) does not catch any
    ;; exceptions locally, so tail calls inside its body can be converted.
    (try
      (do
        (call $throwing-callee)
      )
      (delegate 0)
    )
  )

  ;; NO-EFFECTS:      (func $legacy-try-delegate-outer
  ;; NO-EFFECTS-NEXT:  (try $outer
  ;; NO-EFFECTS-NEXT:   (do
  ;; NO-EFFECTS-NEXT:    (try
  ;; NO-EFFECTS-NEXT:     (do
  ;; NO-EFFECTS-NEXT:      (call $throwing-callee)
  ;; NO-EFFECTS-NEXT:     )
  ;; NO-EFFECTS-NEXT:     (delegate $outer)
  ;; NO-EFFECTS-NEXT:    )
  ;; NO-EFFECTS-NEXT:   )
  ;; NO-EFFECTS-NEXT:   (catch_all
  ;; NO-EFFECTS-NEXT:    (nop)
  ;; NO-EFFECTS-NEXT:   )
  ;; NO-EFFECTS-NEXT:  )
  ;; NO-EFFECTS-NEXT: )
  ;; WITH-EFFECTS:      (func $legacy-try-delegate-outer
  ;; WITH-EFFECTS-NEXT:  (try $outer
  ;; WITH-EFFECTS-NEXT:   (do
  ;; WITH-EFFECTS-NEXT:    (try
  ;; WITH-EFFECTS-NEXT:     (do
  ;; WITH-EFFECTS-NEXT:      (call $throwing-callee)
  ;; WITH-EFFECTS-NEXT:     )
  ;; WITH-EFFECTS-NEXT:     (delegate $outer)
  ;; WITH-EFFECTS-NEXT:    )
  ;; WITH-EFFECTS-NEXT:   )
  ;; WITH-EFFECTS-NEXT:   (catch_all
  ;; WITH-EFFECTS-NEXT:    (nop)
  ;; WITH-EFFECTS-NEXT:   )
  ;; WITH-EFFECTS-NEXT:  )
  ;; WITH-EFFECTS-NEXT: )
  (func $legacy-try-delegate-outer
    ;; A try block that delegates to an outer try with a local catch handler has
    ;; ehDepth > 0, so throwing tail calls inside its body must not be converted.
    ;; TODO: Optimize the case where a delegate targets an outer block that has
    ;; no catch handlers outside of it.
    (try $outer
      (do
        (try
          (do
            (call $throwing-callee)
          )
          (delegate $outer)
        )
      )
      (catch_all
        (nop)
      )
    )
  )

  ;; NO-EFFECTS:      (func $nested-try-tables-reset-count (result i32)
  ;; NO-EFFECTS-NEXT:  (block $catch1
  ;; NO-EFFECTS-NEXT:   (try_table (catch_all $catch1)
  ;; NO-EFFECTS-NEXT:    (block $catch2
  ;; NO-EFFECTS-NEXT:     (try_table (catch_all $catch2)
  ;; NO-EFFECTS-NEXT:      (return
  ;; NO-EFFECTS-NEXT:       (call $throwing-i32-callee)
  ;; NO-EFFECTS-NEXT:      )
  ;; NO-EFFECTS-NEXT:     )
  ;; NO-EFFECTS-NEXT:    )
  ;; NO-EFFECTS-NEXT:    (return
  ;; NO-EFFECTS-NEXT:     (call $throwing-i32-callee)
  ;; NO-EFFECTS-NEXT:    )
  ;; NO-EFFECTS-NEXT:   )
  ;; NO-EFFECTS-NEXT:  )
  ;; NO-EFFECTS-NEXT:  (return_call $throwing-i32-callee)
  ;; NO-EFFECTS-NEXT: )
  ;; WITH-EFFECTS:      (func $nested-try-tables-reset-count (result i32)
  ;; WITH-EFFECTS-NEXT:  (block $catch1
  ;; WITH-EFFECTS-NEXT:   (try_table (catch_all $catch1)
  ;; WITH-EFFECTS-NEXT:    (block $catch2
  ;; WITH-EFFECTS-NEXT:     (try_table (catch_all $catch2)
  ;; WITH-EFFECTS-NEXT:      (return
  ;; WITH-EFFECTS-NEXT:       (call $throwing-i32-callee)
  ;; WITH-EFFECTS-NEXT:      )
  ;; WITH-EFFECTS-NEXT:     )
  ;; WITH-EFFECTS-NEXT:    )
  ;; WITH-EFFECTS-NEXT:    (return
  ;; WITH-EFFECTS-NEXT:     (call $throwing-i32-callee)
  ;; WITH-EFFECTS-NEXT:    )
  ;; WITH-EFFECTS-NEXT:   )
  ;; WITH-EFFECTS-NEXT:  )
  ;; WITH-EFFECTS-NEXT:  (return_call $throwing-i32-callee)
  ;; WITH-EFFECTS-NEXT: )
  (func $nested-try-tables-reset-count (result i32)
    ;; After exiting nested try_table blocks, ehDepth is decremented back to 0,
    ;; allowing a subsequent throwing call in tail position to be converted.
    (block $catch1
      (try_table (catch_all $catch1)
        (block $catch2
          (try_table (catch_all $catch2)
            (return
              (call $throwing-i32-callee)
            )
          )
        )
        (return
          (call $throwing-i32-callee)
        )
      )
    )
    (call $throwing-i32-callee)
  )
)
