;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; Run DFE early, before the last set of opts. At that early time, we do not
;; ignore the js.called intrinsic, so we do not merge and b. We then extract b,
;; which will remain without the annotation (if we merged, the single remaining
;; function would be annotated). We then run -O3, which is the last set of opts
;; (this defines which the last set of opts is). As this is after the
;; extraction, so there is nothing to merge at that point, so we end up with
;; b, without the js.called annotation.
;;
;; If we considered the first DFE to be in the last set of opts, we'd merge a
;; and b, and the extraction would error on not finding b.
;;
;; RUN: foreach %s %t wasm-opt --duplicate-function-elimination --extract-function=b -O3 -S -o - | filecheck %s

;; The same thing happens with an -O3 instead of the DFE (-O3 runs that DFE, and
;; it is not in the set of last opts).
;; RUN: foreach %s %t wasm-opt -O3                              --extract-function=b -O3 -S -o - | filecheck %s

(module
 (@binaryen.js.called)
 (func $a (export "a") (param $x i32)
  (if
   (local.get $x)
   (then
    (unreachable)
   )
  )
 )

 ;; CHECK:      (type $0 (func (param i32)))

 ;; CHECK:      (export "b" (func $b))

 ;; CHECK:      (func $b (param $0 i32)
 ;; CHECK-NEXT:  (if
 ;; CHECK-NEXT:   (local.get $0)
 ;; CHECK-NEXT:   (then
 ;; CHECK-NEXT:    (unreachable)
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $b (export "b") (param $x i32)
  ;; b survives, and does not have the js.called annotation.
  (if
   (local.get $x)
   (then
    (unreachable)
   )
  )
 )
)

