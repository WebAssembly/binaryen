;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: wasm-opt %s --asyncify -O2 --all-features -S -o - | filecheck %s

;; Optimizations run inside Asyncify can create new reference locals, so the
;; spill tables must be set up after them. Here Heap2Local unboxes the struct
;; into locals, and the externref field becomes a local that is spilled across
;; the call.
(module
  ;; CHECK:      (type $A (struct (field externref) (field i32)))

  ;; CHECK:      (type $1 (func))

  ;; CHECK:      (type $2 (func (param i32)))

  ;; CHECK:      (type $3 (func (param externref) (result i32)))

  ;; CHECK:      (type $4 (func (result i32)))

  ;; CHECK:      (import "env" "unwind" (func $unwind (type $1)))
  (import "env" "unwind" (func $unwind))
  (memory 1)
  (type $A (struct (field externref) (field i32)))
  (func (export "run") (param $e externref) (result i32)
    (local $a (ref $A))
    (local.set $a (struct.new $A (local.get $e) (i32.const 1)))
    (call $unwind)
    (ref.is_null (struct.get $A 0 (local.get $a)))
  )
)
;; CHECK:      (global $__asyncify_state (mut i32) (i32.const 0))

;; CHECK:      (global $__asyncify_data (mut i32) (i32.const 0))

;; CHECK:      (global $__asyncify_ref_pos_A (mut i32) (i32.const 0))

;; CHECK:      (memory $0 1)

;; CHECK:      (table $__asyncify_ref_table_A 1 67108864 (ref null $A))

;; CHECK:      (export "run" (func $0))

;; CHECK:      (export "asyncify_start_unwind" (func $asyncify_start_unwind))

;; CHECK:      (export "asyncify_stop_unwind" (func $asyncify_stop_unwind))

;; CHECK:      (export "asyncify_start_rewind" (func $asyncify_start_rewind))

;; CHECK:      (export "asyncify_stop_rewind" (func $asyncify_stop_unwind))

;; CHECK:      (export "asyncify_get_state" (func $asyncify_get_state))

