      (i32.const 10)
      (i32.const 20)
    )
  )

  ;; CHECK:      (func $array-rmw-nonconstant-index (type $8) (param $idx i32) (result i32)
  ;; CHECK-NEXT:  (array.atomic.rmw.add $arr
  ;; CHECK-NEXT:   (array.new_fixed $arr 2
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.get $idx)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; HP2L2:      (func $array-rmw-nonconstant-index (type $8) (param $idx i32) (result i32)
  ;; HP2L2-NEXT:  (array.atomic.rmw.add $arr
  ;; HP2L2-NEXT:   (array.new_fixed $arr 2
  ;; HP2L2-NEXT:    (i32.const 0)
  ;; HP2L2-NEXT:    (i32.const 0)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:   (local.get $idx)
  ;; HP2L2-NEXT:   (i32.const 1)
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $array-rmw-nonconstant-index (param $idx i32) (result i32)
    ;; A non-constant index prevents the optimization, since Array2Struct
    ;; needs to know which struct field to access at compile time.
    (array.atomic.rmw.add $arr
      (array.new_fixed $arr 2
        (i32.const 0)
        (i32.const 0)
      )
      (local.get $idx)
      (i32.const 1)
    )
  )

  ;; CHECK:      (func $array-rmw-oob (type $1) (result i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  ;; HP2L2:      (func $array-rmw-oob (type $1) (result i32)
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block (result nullref)
  ;; HP2L2-NEXT:    (ref.null none)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (i32.const 1)
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (unreachable)
  ;; HP2L2-NEXT: )
  (func $array-rmw-oob (result i32)
    ;; An out-of-bounds index on a zero-size array. The access will always
    ;; trap, so we emit drops for operands and an unreachable.
    (array.atomic.rmw.add $arr
      (array.new_default $arr
        (i32.const 0)
      )
      (i32.const 0)
      (i32.const 1)
    )
  )

  ;; CHECK:      (func $array-cmpxchg-oob (type $1) (result i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 10)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 20)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  ;; HP2L2:      (func $array-cmpxchg-oob (type $1) (result i32)
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block (result nullref)
  ;; HP2L2-NEXT:    (ref.null none)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (i32.const 10)
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (i32.const 20)
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (unreachable)
  ;; HP2L2-NEXT: )
  (func $array-cmpxchg-oob (result i32)
    ;; As above, but for cmpxchg with an out-of-bounds index.
    (array.atomic.rmw.cmpxchg $arr
      (array.new_default $arr
        (i32.const 0)
      )
      (i32.const 0)
      (i32.const 10)
      (i32.const 20)
    )
  )

  ;; CHECK:      (func $array-rmw-nonzero-oob (type $9)
  ;; CHECK-NEXT:  (local $0 i32)
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $0
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $2
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.set $3
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 10)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 20)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; HP2L2:      (func $array-rmw-nonzero-oob (type $9)
  ;; HP2L2-NEXT:  (local $0 i32)
  ;; HP2L2-NEXT:  (local $1 i32)
  ;; HP2L2-NEXT:  (local $2 i32)
  ;; HP2L2-NEXT:  (local $3 i32)
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (local.set $0
  ;; HP2L2-NEXT:       (i32.const 0)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (local.set $1
  ;; HP2L2-NEXT:       (i32.const 0)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (i32.const 1)
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (unreachable)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (local.set $2
  ;; HP2L2-NEXT:       (i32.const 0)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (local.set $3
  ;; HP2L2-NEXT:       (i32.const 0)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (i32.const 10)
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (i32.const 20)
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (unreachable)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $array-rmw-nonzero-oob
    ;; Out-of-bounds atomic RMW and cmpxchg on a non-empty array allocation.
    (drop
      (array.atomic.rmw.add $arr
        (array.new_default $arr
          (i32.const 2)
        )
        (i32.const 2)
        (i32.const 1)
      )
    )
    (drop
      (array.atomic.rmw.cmpxchg $arr
        (array.new_default $arr
          (i32.const 2)
        )
        (i32.const 2)
        (i32.const 10)
        (i32.const 20)
      )
    )
  )

  ;; CHECK:      (func $rmw-other-and-unreachable (type $10) (param $i (ref null $i32)) (param $a (ref null $arr))
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.atomic.rmw.add $i32 0
  ;; CHECK-NEXT:    (local.get $i)
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (array.atomic.rmw.add $arr
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (array.atomic.rmw.cmpxchg $arr
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block ;; (replaces unreachable ArrayRMW we can't emit)
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (unreachable)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (i32.const 1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; HP2L2:      (func $rmw-other-and-unreachable (type $10) (param $i (ref null $i32)) (param $a (ref null $arr))
  ;; HP2L2-NEXT:  (local $2 i32)
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block (result nullref)
  ;; HP2L2-NEXT:    (local.set $2
  ;; HP2L2-NEXT:     (i32.const 0)
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (ref.null none)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (struct.atomic.rmw.add $i32 0
  ;; HP2L2-NEXT:    (local.get $i)
  ;; HP2L2-NEXT:    (i32.const 1)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (array.atomic.rmw.add $arr
  ;; HP2L2-NEXT:    (local.get $a)
  ;; HP2L2-NEXT:    (i32.const 0)
  ;; HP2L2-NEXT:    (i32.const 1)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (array.atomic.rmw.cmpxchg $arr
  ;; HP2L2-NEXT:    (local.get $a)
  ;; HP2L2-NEXT:    (i32.const 0)
  ;; HP2L2-NEXT:    (i32.const 1)
  ;; HP2L2-NEXT:    (i32.const 2)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (if
  ;; HP2L2-NEXT:   (i32.const 0)
  ;; HP2L2-NEXT:   (then
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block ;; (replaces unreachable ArrayRMW we can't emit)
  ;; HP2L2-NEXT:      (drop
  ;; HP2L2-NEXT:       (unreachable)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (drop
  ;; HP2L2-NEXT:       (i32.const 0)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (drop
  ;; HP2L2-NEXT:       (i32.const 1)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (unreachable)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $rmw-other-and-unreachable (param $i (ref null $i32)) (param $a (ref null $arr))
    ;; Exercise unoptimized and unreachable atomic ops alongside an optimized
    ;; allocation.
    (drop
      (struct.new_default $i32)
    )
    (drop
      (struct.atomic.rmw.add $i32 0
        (local.get $i)
        (i32.const 1)
      )
    )
    (drop
      (array.atomic.rmw.add $arr
        (local.get $a)
        (i32.const 0)
        (i32.const 1)
      )
    )
    (drop
      (array.atomic.rmw.cmpxchg $arr
        (local.get $a)
        (i32.const 0)
        (i32.const 1)
        (i32.const 2)
      )
    )
    (if
      (i32.const 0)
      (then
        (drop
          (array.atomic.rmw.add $arr
            (unreachable)
            (i32.const 0)
            (i32.const 1)
          )
        )
      )
    )
  )
)

(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $struct (struct (field (mut (ref null $array)))))
    ;; HP2L2:      (rec
    ;; HP2L2-NEXT:  (type $struct (struct (field (mut (ref null $array)))))
    (type $struct (struct (field (mut (ref null $array)))))
    ;; CHECK:       (type $array (array (mut i32)))
    ;; HP2L2:       (type $array (array (mut i32)))
    (type $array (array (field (mut i32))))
  )
  ;; CHECK:      (type $2 (func))

  ;; CHECK:      (func $cmpxchg-expected-first (type $2)
  ;; CHECK-NEXT:  (local $0 i32)
  ;; CHECK-NEXT:  (local $1 (ref null (exact $struct)))
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (local $4 (ref null $array))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null $array))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $4
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $0
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $2
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.set $3
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (block (result (ref null $array))
  ;; CHECK-NEXT:     (drop
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (local.get $4)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; HP2L2:      (type $2 (func))

  ;; HP2L2:      (func $cmpxchg-expected-first (type $2)
  ;; HP2L2-NEXT:  (local $0 (ref null $array))
  ;; HP2L2-NEXT:  (local $1 i32)
  ;; HP2L2-NEXT:  (local $2 i32)
  ;; HP2L2-NEXT:  (local $3 i32)
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block (result (ref null $array))
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (local.set $0
  ;; HP2L2-NEXT:       (ref.null none)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (local.set $1
  ;; HP2L2-NEXT:       (i32.const 0)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (local.set $2
  ;; HP2L2-NEXT:       (i32.const 0)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (local.set $3
  ;; HP2L2-NEXT:       (i32.const 0)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (local.get $0)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $cmpxchg-expected-first
    (drop
      (struct.atomic.rmw.cmpxchg $struct 0
        (struct.new_default $struct)
        ;; This will be optimized out before the previous `ref` operand because
        ;; array allocations are processed before struct allocations. If we did
        ;; not handle flows from `expected` specially, we would incorrectly
        ;; refinalize the cmpxchg to have the array replacement type, then get
        ;; confused and crash when later processing the `ref` operand.
        (array.new_default $array (i32.const 1))
        ;; Normally replacements escape and cannot be optimized, but the cmpxchg
        ;; is replaced when `expected` is processed, so we end up seeing that
        ;; this doesn't escape.
        (array.new_default $array (i32.const 2))
      )
    )
  )
)

(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $struct (struct (field (mut (ref null $array)))))
    ;; HP2L2:      (rec
    ;; HP2L2-NEXT:  (type $struct (struct (field (mut (ref null $array)))))
    (type $struct (struct (field (mut (ref null $array)))))
    ;; CHECK:       (type $array (array (mut i32)))
    ;; HP2L2:       (type $array (array (mut i32)))
    (type $array (array (field (mut i32))))
  )
  ;; CHECK:      (type $2 (func (result (ref $array))))

  ;; CHECK:      (func $cmpxchg-expected-first (type $2) (result (ref $array))
  ;; CHECK-NEXT:  (local $array (ref $array))
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (local $2 (ref null (exact $struct)))
  ;; CHECK-NEXT:  (local $3 (ref null $array))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null $array))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $3
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (local.tee $array
  ;; CHECK-NEXT:      (array.new_default $array
  ;; CHECK-NEXT:       (i32.const 2)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (block (result (ref null $array))
  ;; CHECK-NEXT:     (drop
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (local.get $3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $array)
  ;; CHECK-NEXT: )
  ;; HP2L2:      (type $2 (func (result (ref $array))))

  ;; HP2L2:      (func $cmpxchg-expected-first (type $2) (result (ref $array))
  ;; HP2L2-NEXT:  (local $array (ref $array))
  ;; HP2L2-NEXT:  (local $1 (ref null $array))
  ;; HP2L2-NEXT:  (local $2 i32)
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block (result (ref null $array))
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (local.set $1
  ;; HP2L2-NEXT:       (ref.null none)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (local.set $2
  ;; HP2L2-NEXT:       (i32.const 0)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (local.tee $array
  ;; HP2L2-NEXT:      (array.new_default $array
  ;; HP2L2-NEXT:       (i32.const 2)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (local.get $1)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (local.get $array)
  ;; HP2L2-NEXT: )
  (func $cmpxchg-expected-first (result (ref $array))
    ;; Same as before, but now the replacement still escapes. Nothing should go
    ;; wrong.
    (local $array (ref $array))
    (drop
      (struct.atomic.rmw.cmpxchg $struct 0
        (struct.new_default $struct)
        (array.new_default $array (i32.const 1))
        (local.tee $array
          (array.new_default $array (i32.const 2))
        )
      )
    )
    (local.get $array)
  )
)

(module
  (rec
    ;; CHECK:      (type $0 (func))

    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $inner (array i8))
    (type $inner (array i8))
    ;; CHECK:       (type $struct (struct (field (mut eqref))))
    (type $struct (struct (field (mut eqref))))
    ;; CHECK:       (type $array (array (mut eqref)))
    (type $array (array (field (mut eqref))))
  )
  ;; CHECK:      (func $test-cmpxchg-scratch-oob (type $0)
  ;; CHECK-NEXT:  (local $a arrayref)
  ;; CHECK-NEXT:  (local $1 (ref null (exact $struct)))
  ;; CHECK-NEXT:  (local $2 eqref)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result eqref)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $2
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (block (result eqref)
  ;; CHECK-NEXT:     (drop
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (local.get $2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  ;; HP2L2:      (type $0 (func))

  ;; HP2L2:      (func $test-cmpxchg-scratch-oob (type $0)
  ;; HP2L2-NEXT:  (local $a arrayref)
  ;; HP2L2-NEXT:  (local $1 eqref)
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block (result nullref)
  ;; HP2L2-NEXT:    (ref.null none)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block (result eqref)
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (local.set $1
  ;; HP2L2-NEXT:       (ref.null none)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (local.get $1)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (unreachable)
  ;; HP2L2-NEXT: )
  (func $test-cmpxchg-scratch-oob
    (local $a arrayref)
    ;; This allocation and set get optimized, creating the LocalGraph flower.
    (local.set $a
      (array.new_fixed $inner 0)
    )
    (drop
      ;; Then `expected` gets optimized, creating a new scratch local. Since the
      ;; flower is already created, the index of the scratch local would be out
      ;; of bounds if we tried to look it up in the original LocalGraph. This
      ;; still works fine because we reset the LocalGraph after each
      ;; optimization.
      (struct.atomic.rmw.cmpxchg $struct 0
        (struct.new_default $struct)
        (array.new_fixed $inner 0)
        (array.new_fixed $inner 0)
      )
    )
    (unreachable)
  )

  ;; CHECK:      (func $test-cmpxchg-scratch-oob-array (type $0)
  ;; CHECK-NEXT:  (local $a arrayref)
  ;; CHECK-NEXT:  (local $1 eqref)
  ;; CHECK-NEXT:  (local $2 eqref)
  ;; CHECK-NEXT:  (local $3 eqref)
  ;; CHECK-NEXT:  (local $4 eqref)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result eqref)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (local.get $1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (if
  ;; CHECK-NEXT:     (block (result i32)
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (local.get $1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (i32.const 0)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  ;; HP2L2:      (func $test-cmpxchg-scratch-oob-array (type $0)
  ;; HP2L2-NEXT:  (local $a arrayref)
  ;; HP2L2-NEXT:  (local $1 eqref)
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block (result nullref)
  ;; HP2L2-NEXT:    (ref.null none)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block (result eqref)
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (local.set $1
  ;; HP2L2-NEXT:       (ref.null none)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (local.get $1)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (unreachable)
  ;; HP2L2-NEXT: )
  (func $test-cmpxchg-scratch-oob-array
    ;; Same as above, but accessing an array type. `ref` is always processed
    ;; first, so we do not have the same problem to avoid.
    (local $a arrayref)
    (local.set $a
      (array.new_fixed $inner 0)
    )
    (drop
      (array.atomic.rmw.cmpxchg $array
        (array.new_default $array
          (i32.const 1)
        )
        (i32.const 0)
        (array.new_fixed $inner 0)
        (array.new_fixed $inner 0)
      )
    )
    (unreachable)
  )
)

(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $outer (struct (field (mut (ref $inner)))))
    ;; HP2L2:      (rec
    ;; HP2L2-NEXT:  (type $outer (struct (field (mut (ref $inner)))))
    (type $outer (struct (field (mut (ref $inner)))))
    ;; CHECK:       (type $inner (struct))
    ;; HP2L2:       (type $inner (struct))
    (type $inner (struct))

    ;; CHECK:       (type $shared-outer (shared (struct (field (mut (ref $shared-inner))))))
    ;; HP2L2:       (type $shared-outer (shared (struct (field (mut (ref $shared-inner))))))
    (type $shared-outer (shared (struct (field (mut (ref $shared-inner))))))
    ;; CHECK:       (type $shared-inner (shared (struct)))
    ;; HP2L2:       (type $shared-inner (shared (struct)))
    (type $shared-inner (shared (struct)))
  )

  ;; CHECK:      (type $4 (func))

  ;; CHECK:      (func $cmpxchg-non-nullable-field (type $4)
  ;; CHECK-NEXT:  (local $0 (ref $inner))
  ;; CHECK-NEXT:  (local $1 (ref $inner))
  ;; CHECK-NEXT:  (local $2 (ref $inner))
  ;; CHECK-NEXT:  (local $3 eqref)
  ;; CHECK-NEXT:  (local $4 (ref $inner))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref $inner))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (struct.new_default $inner)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.set $0
  ;; CHECK-NEXT:       (local.get $1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (local.get $0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (if
  ;; CHECK-NEXT:     (block (result i32)
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (local.get $0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (i32.const 0)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; HP2L2:      (type $4 (func))

  ;; HP2L2:      (func $cmpxchg-non-nullable-field (type $4)
  ;; HP2L2-NEXT:  (local $0 (ref $inner))
  ;; HP2L2-NEXT:  (local $1 (ref $inner))
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block (result (ref $inner))
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (local.set $1
  ;; HP2L2-NEXT:       (struct.new_default $inner)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (local.set $0
  ;; HP2L2-NEXT:       (local.get $1)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (local.get $0)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $cmpxchg-non-nullable-field
    (drop
      (struct.atomic.rmw.cmpxchg $outer 0
        ;; When `ref` gets optimized, we need to make sure the scratch local for
        ;; `expected` is nullable, even though the operand and field are both
        ;; non-nullable. This avoids type errors when we later optimize the
        ;; `expected` field and make it a nullref.
        (struct.new $outer
          (struct.new_default $inner)
        )
        (struct.new_default $inner)
        (struct.new_default $inner)
      )
    )
  )

  ;; CHECK:      (func $cmpxchg-non-nullable-field-shared (type $4)
  ;; CHECK-NEXT:  (local $0 (ref $shared-inner))
  ;; CHECK-NEXT:  (local $1 (ref $shared-inner))
  ;; CHECK-NEXT:  (local $2 (ref $shared-inner))
  ;; CHECK-NEXT:  (local $3 (ref null (shared eq)))
  ;; CHECK-NEXT:  (local $4 (ref $shared-inner))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref $shared-inner))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (struct.new_default $shared-inner)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.set $0
  ;; CHECK-NEXT:       (local.get $1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (local.get $0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (if
  ;; CHECK-NEXT:     (block (result i32)
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (local.get $0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (ref.null (shared none))
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (i32.const 0)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (ref.null (shared none))
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; HP2L2:      (func $cmpxchg-non-nullable-field-shared (type $4)
  ;; HP2L2-NEXT:  (local $0 (ref $shared-inner))
  ;; HP2L2-NEXT:  (local $1 (ref $shared-inner))
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block (result (ref $shared-inner))
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result (ref null (shared none)))
  ;; HP2L2-NEXT:      (local.set $1
  ;; HP2L2-NEXT:       (struct.new_default $shared-inner)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (local.set $0
  ;; HP2L2-NEXT:       (local.get $1)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null (shared none))
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result (ref null (shared none)))
  ;; HP2L2-NEXT:      (ref.null (shared none))
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result (ref null (shared none)))
  ;; HP2L2-NEXT:      (ref.null (shared none))
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (local.get $0)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $cmpxchg-non-nullable-field-shared
    (drop
      (struct.atomic.rmw.cmpxchg $shared-outer 0
        ;; Same, but now with shared types. The scratch local must be a shared
        ;; eqref.
        (struct.new $shared-outer
          (struct.new_default $shared-inner)
        )
        (struct.new_default $shared-inner)
        (struct.new_default $shared-inner)
      )
    )
  )
)

(module
  ;; CHECK:      (type $struct (struct (field (mut (ref null $struct)))))
  ;; HP2L2:      (type $struct (struct (field (mut (ref null $struct)))))
  (type $struct (struct (field (mut (ref null $struct)))))

  ;; CHECK:      (type $1 (func (result (ref null $struct))))

  ;; CHECK:      (type $2 (func (param (ref $struct)) (result (ref null $struct))))

  ;; CHECK:      (export "test" (func $cmpxchg-ref-and-expected))

  ;; CHECK:      (func $cmpxchg-ref-and-expected (type $1) (result (ref null $struct))
  ;; CHECK-NEXT:  (local $local (ref $struct))
  ;; CHECK-NEXT:  (local $1 (ref null $struct))
  ;; CHECK-NEXT:  (local $2 (ref null $struct))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null $struct))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $2
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (result (ref null $struct))
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.get $1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; HP2L2:      (type $1 (func (result (ref null $struct))))

  ;; HP2L2:      (type $2 (func (param (ref $struct)) (result (ref null $struct))))

  ;; HP2L2:      (export "test" (func $cmpxchg-ref-and-expected))

  ;; HP2L2:      (func $cmpxchg-ref-and-expected (type $1) (result (ref null $struct))
  ;; HP2L2-NEXT:  (local $local (ref $struct))
  ;; HP2L2-NEXT:  (local $1 (ref null $struct))
  ;; HP2L2-NEXT:  (local $2 (ref null $struct))
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block (result (ref null $struct))
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (local.set $1
  ;; HP2L2-NEXT:       (ref.null none)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (ref.null none)
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (local.set $2
  ;; HP2L2-NEXT:       (ref.null none)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (local.get $1)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (block (result (ref null $struct))
  ;; HP2L2-NEXT:   (drop
  ;; HP2L2-NEXT:    (ref.null none)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:   (local.get $1)
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $cmpxchg-ref-and-expected (export "test") (result (ref null $struct))
    (local $local (ref $struct))
    (drop
      ;; The allocation flows to both `ref` and `expected`. Since it does not
      ;; escape, it cannot match the value in the field, so the cmpxchg must
      ;; just drop its operands and read the field local (rather than emitting a
      ;; struct.get on the nulled-out `ref` or comparing the field local against
      ;; the nulled-out `expected` via `ref.eq`). Because the replacement is
      ;; dropped, it does not escape either and can also be optimized.
      (struct.atomic.rmw.cmpxchg $struct 0
        (local.tee $local
          (struct.new_default $struct)
        )
        (local.get $local)
        (struct.new_default $struct)
      )
    )
    (struct.get $struct 0
      (local.get $local)
    )
  )

  ;; CHECK:      (func $cmpxchg-ref-and-expected-non-null-replacement (type $2) (param $replacement (ref $struct)) (result (ref null $struct))
  ;; CHECK-NEXT:  (local $local (ref $struct))
  ;; CHECK-NEXT:  (local $2 (ref null $struct))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null $struct))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $2
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (local.get $replacement)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (result (ref null $struct))
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.get $2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; HP2L2:      (func $cmpxchg-ref-and-expected-non-null-replacement (type $2) (param $replacement (ref $struct)) (result (ref null $struct))
  ;; HP2L2-NEXT:  (local $local (ref $struct))
  ;; HP2L2-NEXT:  (local $2 (ref null $struct))
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block (result (ref null $struct))
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (local.set $2
  ;; HP2L2-NEXT:       (ref.null none)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (ref.null none)
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (local.get $replacement)
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (local.get $2)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (block (result (ref null $struct))
  ;; HP2L2-NEXT:   (drop
  ;; HP2L2-NEXT:    (ref.null none)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:   (local.get $2)
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $cmpxchg-ref-and-expected-non-null-replacement (param $replacement (ref $struct)) (result (ref null $struct))
    (local $local (ref $struct))
    (drop
      ;; The replacement is non-null and cannot be optimized, so if the cmpxchg
      ;; spuriously succeeded (e.g. by comparing the null-initialized field
      ;; against an `expected` replaced with `null`), this would return
      ;; `$replacement` instead of `null`.
      (struct.atomic.rmw.cmpxchg $struct 0
        (local.tee $local
          (struct.new_default $struct)
        )
        (local.get $local)
        (local.get $replacement)
      )
    )
    (struct.get $struct 0
      (local.get $local)
    )
  )
)

(module
  (type $array (shared (array i8)))
  ;; CHECK:      (type $struct (shared (struct (field (mut (ref null (shared array)))))))
  ;; HP2L2:      (type $struct (shared (struct (field (mut (ref null (shared array)))))))
  (type $struct (shared (struct (field (mut (ref null (shared array)))))))

  ;; CHECK:      (type $1 (func (param (ref $struct))))

  ;; CHECK:      (func $unreachable-shared-expected (type $1) (param $struct (ref $struct))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.atomic.rmw.cmpxchg $struct 0
  ;; CHECK-NEXT:    (local.get $struct)
  ;; CHECK-NEXT:    (block (result (ref null (shared none)))
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; HP2L2:      (type $1 (func (param (ref $struct))))

  ;; HP2L2:      (func $unreachable-shared-expected (type $1) (param $struct (ref $struct))
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (struct.atomic.rmw.cmpxchg $struct 0
  ;; HP2L2-NEXT:    (local.get $struct)
  ;; HP2L2-NEXT:    (block (result (ref null (shared none)))
  ;; HP2L2-NEXT:     (ref.null (shared none))
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (unreachable)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $unreachable-shared-expected (param $struct (ref $struct))
    (drop
      ;; This cmpxchg will not be optimized because it is unreachable.
      (struct.atomic.rmw.cmpxchg $struct 0
        (local.get $struct)
        ;; This `expected` allocation does not escape, so it will be optimized.
        ;; When we convert the array to a struct, we have to make sure it
        ;; becomes a shared struct so that when we later optimize out the
        ;; allocation, we know to replace it with a shared null. If we don't, we
        ;; will end up with a non-shared null here, which would be invalid.
        (array.new_fixed $array 0)
        (unreachable)
      )
    )
  )
)

(module
  ;; CHECK:      (type $array (array (mut eqref)))
  ;; HP2L2:      (type $array (array (mut eqref)))
  (type $array (array (mut eqref)))

  ;; CHECK:      (type $1 (func (param (ref $array))))

  ;; CHECK:      (type $2 (func (param (ref eq))))

  ;; CHECK:      (func $array-cmpxchg-expected (type $1) (param $array (ref $array))
  ;; CHECK-NEXT:  (local $1 eqref)
  ;; CHECK-NEXT:  (local $2 (ref null $array))
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result eqref)
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (local.get $array)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $3
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (array.atomic.get $array
  ;; CHECK-NEXT:     (local.get $2)
  ;; CHECK-NEXT:     (local.get $3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; HP2L2:      (type $1 (func (param (ref $array))))

  ;; HP2L2:      (type $2 (func (param (ref eq))))

  ;; HP2L2:      (func $array-cmpxchg-expected (type $1) (param $array (ref $array))
  ;; HP2L2-NEXT:  (local $1 eqref)
  ;; HP2L2-NEXT:  (local $2 (ref null $array))
  ;; HP2L2-NEXT:  (local $3 i32)
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block (result eqref)
  ;; HP2L2-NEXT:    (local.set $2
  ;; HP2L2-NEXT:     (local.get $array)
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (local.set $3
  ;; HP2L2-NEXT:     (i32.const 0)
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result nullref)
  ;; HP2L2-NEXT:      (local.set $1
  ;; HP2L2-NEXT:       (ref.null none)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (ref.null none)
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (ref.null none)
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (array.atomic.get $array
  ;; HP2L2-NEXT:     (local.get $2)
  ;; HP2L2-NEXT:     (local.get $3)
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $array-cmpxchg-expected (param $array (ref $array))
    (drop
      ;; We should not convert this to a struct cmpxchg because we do not
      ;; optimize the `ref`. We should still be able to optimize the `expected`
      ;; field, though.
      (array.atomic.rmw.cmpxchg $array
        (local.get $array)
        (i32.const 0)
        (array.new_default $array
          (i32.const 1)
        )
        (ref.null none)
      )
    )
  )

  ;; CHECK:      (func $array-cmpxchg-expected-null-ref (type $2) (param $x (ref eq))
  ;; CHECK-NEXT:  (local $1 eqref)
  ;; CHECK-NEXT:  (local $2 nullref)
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block $block (result (ref none))
  ;; CHECK-NEXT:    (br_on_cast_fail $block (ref none) (ref none)
  ;; CHECK-NEXT:     (block (result (ref none))
  ;; CHECK-NEXT:      (local.set $2
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.set $3
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (block (result nullref)
  ;; CHECK-NEXT:        (local.set $1
  ;; CHECK-NEXT:         (ref.null none)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:        (ref.null none)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (local.get $x)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (block ;; (replaces unreachable ArrayGet we can't emit)
  ;; CHECK-NEXT:       (drop
  ;; CHECK-NEXT:        (local.get $2)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (drop
  ;; CHECK-NEXT:        (local.get $3)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (unreachable)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; HP2L2:      (func $array-cmpxchg-expected-null-ref (type $2) (param $x (ref eq))
  ;; HP2L2-NEXT:  (local $1 eqref)
  ;; HP2L2-NEXT:  (local $2 nullref)
  ;; HP2L2-NEXT:  (local $3 i32)
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block $block (result (ref none))
  ;; HP2L2-NEXT:    (br_on_cast_fail $block (ref none) (ref none)
  ;; HP2L2-NEXT:     (block (result (ref none))
  ;; HP2L2-NEXT:      (local.set $2
  ;; HP2L2-NEXT:       (ref.null none)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (local.set $3
  ;; HP2L2-NEXT:       (i32.const 0)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (drop
  ;; HP2L2-NEXT:       (block (result nullref)
  ;; HP2L2-NEXT:        (local.set $1
  ;; HP2L2-NEXT:         (ref.null none)
  ;; HP2L2-NEXT:        )
  ;; HP2L2-NEXT:        (ref.null none)
  ;; HP2L2-NEXT:       )
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (drop
  ;; HP2L2-NEXT:       (local.get $x)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:      (block ;; (replaces unreachable ArrayGet we can't emit)
  ;; HP2L2-NEXT:       (drop
  ;; HP2L2-NEXT:        (local.get $2)
  ;; HP2L2-NEXT:       )
  ;; HP2L2-NEXT:       (drop
  ;; HP2L2-NEXT:        (local.get $3)
  ;; HP2L2-NEXT:       )
  ;; HP2L2-NEXT:       (unreachable)
  ;; HP2L2-NEXT:      )
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $array-cmpxchg-expected-null-ref (param $x (ref eq))
    ;; When `ref` is null, replacing the cmpxchg with an array.get refines the
    ;; result type from `(ref eq)` to `(ref none)`, requiring refinalization.
    (drop
      (block $block (result (ref eq))
        (br_on_cast_fail $block (ref eq) (ref eq)
          (array.atomic.rmw.cmpxchg $array
            (ref.null none)
            (i32.const 0)
            (array.new_default $array
              (i32.const 1)
            )
            (local.get $x)
          )
        )
      )
    )
  )
)

