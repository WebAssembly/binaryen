  ;; HP2L2:      (func $cmpxchg-mutual-cycle (type $2) (param $s (ref $struct))
  ;; HP2L2-NEXT:  (local $a (ref null $struct))
  ;; HP2L2-NEXT:  (local $b (ref null $struct))
  ;; HP2L2-NEXT:  (local $3 (ref null $struct))
  ;; HP2L2-NEXT:  (local $4 (ref null $struct))
