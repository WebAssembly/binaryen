  ;; HP2L2-NEXT:    (local.get $a)
  ;; HP2L2-NEXT:    (i32.const 0)
  ;; HP2L2-NEXT:    (ref.null (shared none))
  ;; HP2L2-NEXT:    (struct.new_default $s1)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (struct.atomic.rmw.cmpxchg $s0 0
  ;; HP2L2-NEXT:    (local.get $s)
  ;; HP2L2-NEXT:    (select (result (ref null (exact $s1)))
  ;; HP2L2-NEXT:     (struct.new_default $s1)
  ;; HP2L2-NEXT:     (ref.null (shared none))
  ;; HP2L2-NEXT:     (i32.const 0)
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (struct.new_default $s1)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $cmpxchg-unknown-operands (param $s (ref $s0)) (param $a (ref $a0))
    ;; Unknown (null) replacement or expected operands on struct and array
    ;; cmpxchg alongside candidate allocations, plus an expected operand that
    ;; merges a candidate allocation with null during origin propagation.
    (drop
      (struct.atomic.rmw.cmpxchg $s0 0
        (local.get $s)
        (struct.new_default $s1)
        (ref.null (shared none))
      )
    )
    (drop
      (struct.atomic.rmw.cmpxchg $s0 0
        (local.get $s)
        (ref.null (shared eq))
        (struct.new_default $s1)
      )
    )
    (drop
      (array.atomic.rmw.cmpxchg $a0
        (local.get $a)
        (i32.const 0)
        (struct.new_default $s1)
        (ref.null (shared none))
      )
    )
    (drop
      (array.atomic.rmw.cmpxchg $a0
        (local.get $a)
        (i32.const 0)
        (ref.null (shared eq))
        (struct.new_default $s1)
      )
    )
    (drop
      (struct.atomic.rmw.cmpxchg $s0 0
        (local.get $s)
        (select (result (ref null (shared eq)))
          (struct.new_default $s1)
          (ref.null (shared eq))
          (i32.const 0)
        )
        (struct.new_default $s1)
      )
    )
  )
)

