  ;; CHECK:      (func $rmw-xchg-ref (type $4) (param $0 (ref null $struct)) (result (ref null $struct))
  ;; CHECK-NEXT:  (local $1 (ref null $struct))
  ;; CHECK-NEXT:  (local $2 (ref null $struct))
  ;; CHECK-NEXT:  (local $3 (ref null $struct))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (local.set $1
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $3
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $2
  ;; CHECK-NEXT:   (local.get $1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $1
  ;; CHECK-NEXT:   (local.get $3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $2)
  ;; CHECK-NEXT: )
  (func $rmw-xchg-ref (param (ref null $struct)) (result (ref null $struct))
    (struct.atomic.rmw.xchg $struct 0
      (struct.new_default $struct)
      (local.get 0)
    )
  )

  ;; CHECK:      (func $rmw-cmpxchg-ref (type $7) (param $0 (ref null $struct)) (param $1 (ref null $struct)) (result (ref null $struct))
  ;; CHECK-NEXT:  (local $2 (ref null $struct))
  ;; CHECK-NEXT:  (local $3 (ref null $struct))
  ;; CHECK-NEXT:  (local $4 eqref)
  ;; CHECK-NEXT:  (local $5 (ref null $struct))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $4
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $5
  ;; CHECK-NEXT:   (local.get $1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $3
  ;; CHECK-NEXT:   (local.get $2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (ref.eq
  ;; CHECK-NEXT:    (local.get $2)
  ;; CHECK-NEXT:    (local.get $4)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (local.get $5)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $3)
  ;; CHECK-NEXT: )
  (func $rmw-cmpxchg-ref (param (ref null $struct) (ref null $struct)) (result (ref null $struct))
    (struct.atomic.rmw.cmpxchg $struct 0
      (struct.new_default $struct)
      (local.get 0)
      (local.get 1)
    )
  )

  ;; CHECK:      (func $rmw-acqrel (type $1) (result i32)
  ;; CHECK-NEXT:  (local $0 i32)
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (local.set $0
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $2
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $1
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $0
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (local.get $0)
  ;; CHECK-NEXT:    (local.get $2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $1)
  ;; CHECK-NEXT: )
  (func $rmw-acqrel (result i32)
    (struct.atomic.rmw.add acqrel acqrel $i32 0
      (struct.new_default $i32)
      (i32.const 1)
    )
  )

  ;; CHECK:      (func $cmpxchg-acqrel (type $1) (result i32)
  ;; CHECK-NEXT:  (local $0 i32)
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (local.set $0
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $2
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $3
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $1
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.eq
  ;; CHECK-NEXT:    (local.get $0)
  ;; CHECK-NEXT:    (local.get $2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $0
  ;; CHECK-NEXT:     (local.get $3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $1)
  ;; CHECK-NEXT: )
  (func $cmpxchg-acqrel (result i32)
    (struct.atomic.rmw.cmpxchg acqrel acqrel $i32 0
      (struct.new_default $i32)
      (i32.const 1)
      (i32.const 2)
    )
  )

  ;; CHECK:      (func $rmw-unreachable-value (type $1) (result i32)
  ;; CHECK-NEXT:  (local $0 i32)
  ;; CHECK-NEXT:  (block ;; (replaces unreachable StructRMW we can't emit)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (block (result nullref)
  ;; CHECK-NEXT:     (local.set $0
  ;; CHECK-NEXT:      (i32.const 0)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $rmw-unreachable-value (result i32)
    ;; When the value operand is unreachable, the struct.atomic.rmw.add is
    ;; unreachable and is skipped while still optimizing the struct.new_default.
    (struct.atomic.rmw.add $i32 0
      (struct.new_default $i32)
      (unreachable)
    )
  )

  ;; CHECK:      (func $cmpxchg-unreachable-expected (type $1) (result i32)
  ;; CHECK-NEXT:  (local $0 i32)
  ;; CHECK-NEXT:  (block ;; (replaces unreachable StructCmpxchg we can't emit)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (block (result nullref)
  ;; CHECK-NEXT:     (local.set $0
  ;; CHECK-NEXT:      (i32.const 0)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-unreachable-expected (result i32)
    ;; When the expected operand is unreachable, the struct.atomic.rmw.cmpxchg
    ;; is unreachable and is skipped while still optimizing the
    ;; struct.new_default.
    (struct.atomic.rmw.cmpxchg $i32 0
      (struct.new_default $i32)
      (unreachable)
      (i32.const 1)
    )
  )

  ;; CHECK:      (func $array-rmw-add (type $1) (result i32)
  ;; CHECK-NEXT:  (local $0 i32)
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (local $4 i32)
  ;; CHECK-NEXT:  (local $5 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $3
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $0
  ;; CHECK-NEXT:     (local.get $2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $1
  ;; CHECK-NEXT:     (local.get $3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $5
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $4
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $0
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (local.get $0)
  ;; CHECK-NEXT:    (local.get $5)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $4)
  ;; CHECK-NEXT: )
  (func $array-rmw-add (result i32)
    ;; Array atomic RMW with a constant index on a non-escaping fixed-size array
    ;; should be lowered to locals.
    (array.atomic.rmw.add $arr
      (array.new_fixed $arr 2
        (i32.const 0)
        (i32.const 0)
      )
      (i32.const 0)
      (i32.const 1)
    )
  )

  ;; CHECK:      (func $array-cmpxchg (type $1) (result i32)
  ;; CHECK-NEXT:  (local $0 i32)
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (local $4 i32)
  ;; CHECK-NEXT:  (local $5 i32)
  ;; CHECK-NEXT:  (local $6 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $3
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $0
  ;; CHECK-NEXT:     (local.get $2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $1
  ;; CHECK-NEXT:     (local.get $3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $5
  ;; CHECK-NEXT:   (i32.const 10)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $6
  ;; CHECK-NEXT:   (i32.const 20)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $4
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.eq
  ;; CHECK-NEXT:    (local.get $0)
  ;; CHECK-NEXT:    (local.get $5)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $0
  ;; CHECK-NEXT:     (local.get $6)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $4)
  ;; CHECK-NEXT: )
  (func $array-cmpxchg (result i32)
    ;; Array atomic cmpxchg on a non-escaping fixed-size array should be
    ;; optimized similarly.
    (array.atomic.rmw.cmpxchg $arr
      (array.new_fixed $arr 2
        (i32.const 0)
        (i32.const 0)
      )
      (i32.const 0)
      (i32.const 10)
      (i32.const 20)
    )
  )

  ;; CHECK:      (func $array-rmw-nonconstant-index (type $8) (param $idx i32) (result i32)
  ;; CHECK-NEXT:  (array.atomic.rmw.add $arr
  ;; CHECK-NEXT:   (array.new_fixed $arr 2
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.get $idx)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-rmw-nonconstant-index (param $idx i32) (result i32)
    ;; A non-constant index prevents the optimization, since we need to know
    ;; which element local to access at compile time.
    (array.atomic.rmw.add $arr
      (array.new_fixed $arr 2
        (i32.const 0)
        (i32.const 0)
      )
      (local.get $idx)
      (i32.const 1)
    )
  )

  ;; CHECK:      (func $array-rmw-oob (type $1) (result i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $array-rmw-oob (result i32)
    ;; An out-of-bounds index on a zero-size array. The access will always
    ;; trap, so we emit drops for operands and an unreachable.
    (array.atomic.rmw.add $arr
      (array.new_default $arr
        (i32.const 0)
      )
      (i32.const 0)
      (i32.const 1)
    )
  )

  ;; CHECK:      (func $array-cmpxchg-oob (type $1) (result i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 10)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 20)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $array-cmpxchg-oob (result i32)
    ;; As above, but for cmpxchg with an out-of-bounds index.
    (array.atomic.rmw.cmpxchg $arr
      (array.new_default $arr
        (i32.const 0)
      )
      (i32.const 0)
      (i32.const 10)
      (i32.const 20)
    )
  )

  ;; CHECK:      (func $array-rmw-nonzero-oob (type $9)
  ;; CHECK-NEXT:  (local $0 i32)
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $0
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $2
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.set $3
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 10)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 20)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-rmw-nonzero-oob
    ;; Out-of-bounds atomic RMW and cmpxchg on a non-empty array allocation.
    (drop
      (array.atomic.rmw.add $arr
        (array.new_default $arr
          (i32.const 2)
        )
        (i32.const 2)
        (i32.const 1)
      )
    )
    (drop
      (array.atomic.rmw.cmpxchg $arr
        (array.new_default $arr
          (i32.const 2)
        )
        (i32.const 2)
        (i32.const 10)
        (i32.const 20)
      )
    )
  )

  ;; CHECK:      (func $rmw-other-and-unreachable (type $10) (param $i (ref null $i32)) (param $a (ref null $arr))
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.atomic.rmw.add $i32 0
  ;; CHECK-NEXT:    (local.get $i)
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (array.atomic.rmw.add $arr
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (array.atomic.rmw.cmpxchg $arr
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block ;; (replaces unreachable ArrayRMW we can't emit)
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (unreachable)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (i32.const 1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $rmw-other-and-unreachable (param $i (ref null $i32)) (param $a (ref null $arr))
    ;; Exercise unoptimized and unreachable atomic ops alongside an optimized
    ;; allocation.
    (drop
      (struct.new_default $i32)
    )
    (drop
      (struct.atomic.rmw.add $i32 0
        (local.get $i)
        (i32.const 1)
      )
    )
    (drop
      (array.atomic.rmw.add $arr
        (local.get $a)
        (i32.const 0)
        (i32.const 1)
      )
    )
    (drop
      (array.atomic.rmw.cmpxchg $arr
        (local.get $a)
        (i32.const 0)
        (i32.const 1)
        (i32.const 2)
      )
    )
    (if
      (i32.const 0)
      (then
        (drop
          (array.atomic.rmw.add $arr
            (unreachable)
            (i32.const 0)
            (i32.const 1)
          )
        )
      )
    )
  )
)

(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $struct (struct (field (mut (ref null $array)))))
    (type $struct (struct (field (mut (ref null $array)))))
    ;; CHECK:       (type $array (array (mut i32)))
    (type $array (array (field (mut i32))))
  )
  ;; CHECK:      (type $2 (func))

  ;; CHECK:      (func $cmpxchg-expected-first (type $2)
  ;; CHECK-NEXT:  (local $0 (ref null $array))
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null $array))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $0
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $2
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.set $3
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-expected-first
    ;; All three operands are non-escaping allocations (mixing struct and array
    ;; types). Because `expected` does not escape, the cmpxchg can never store
    ;; `replacement`, so all three allocations are optimized.
    (drop
      (struct.atomic.rmw.cmpxchg $struct 0
        (struct.new_default $struct)
        (array.new_default $array (i32.const 1))
        (array.new_default $array (i32.const 2))
      )
    )
  )
)

(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $struct (struct (field (mut (ref null $array)))))
    (type $struct (struct (field (mut (ref null $array)))))
    ;; CHECK:       (type $array (array (mut i32)))
    (type $array (array (field (mut i32))))
  )
  ;; CHECK:      (type $2 (func (result (ref $array))))

  ;; CHECK:      (func $cmpxchg-expected-first (type $2) (result (ref $array))
  ;; CHECK-NEXT:  (local $array (ref $array))
  ;; CHECK-NEXT:  (local $1 (ref null $array))
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null $array))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $2
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (local.tee $array
  ;; CHECK-NEXT:      (array.new_default $array
  ;; CHECK-NEXT:       (i32.const 2)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $array)
  ;; CHECK-NEXT: )
  (func $cmpxchg-expected-first (result (ref $array))
    ;; Same as before, but now `replacement` escapes via a local, so only `ref`
    ;; and `expected` are optimized.
    (local $array (ref $array))
    (drop
      (struct.atomic.rmw.cmpxchg $struct 0
        (struct.new_default $struct)
        (array.new_default $array (i32.const 1))
        (local.tee $array
          (array.new_default $array (i32.const 2))
        )
      )
    )
    (local.get $array)
  )
)

(module
  (rec
    (type $inner (array i8))
    (type $struct (struct (field (mut eqref))))
    (type $array (array (field (mut eqref))))
  )
  ;; CHECK:      (type $0 (func))

  ;; CHECK:      (func $test-cmpxchg-scratch-oob (type $0)
  ;; CHECK-NEXT:  (local $a arrayref)
  ;; CHECK-NEXT:  (local $1 eqref)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result eqref)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $test-cmpxchg-scratch-oob
    ;; Adding locals while lowering allocations and struct.atomic.rmw.cmpxchg
    ;; must not interfere with local reachability analysis of earlier locals.
    (local $a arrayref)
    (local.set $a
      (array.new_fixed $inner 0)
    )
    (drop
      (struct.atomic.rmw.cmpxchg $struct 0
        (struct.new_default $struct)
        (array.new_fixed $inner 0)
        (array.new_fixed $inner 0)
      )
    )
    (unreachable)
  )

  ;; CHECK:      (func $test-cmpxchg-scratch-oob-array (type $0)
  ;; CHECK-NEXT:  (local $a arrayref)
  ;; CHECK-NEXT:  (local $1 eqref)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result eqref)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $test-cmpxchg-scratch-oob-array
    ;; Same as above, but with array.atomic.rmw.cmpxchg.
    (local $a arrayref)
    (local.set $a
      (array.new_fixed $inner 0)
    )
    (drop
      (array.atomic.rmw.cmpxchg $array
        (array.new_default $array
          (i32.const 1)
        )
        (i32.const 0)
        (array.new_fixed $inner 0)
        (array.new_fixed $inner 0)
      )
    )
    (unreachable)
  )
)

(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $outer (struct (field (mut (ref $inner)))))
    (type $outer (struct (field (mut (ref $inner)))))
    ;; CHECK:       (type $inner (struct))
    (type $inner (struct))

    ;; CHECK:       (type $shared-outer (shared (struct (field (mut (ref $shared-inner))))))
    (type $shared-outer (shared (struct (field (mut (ref $shared-inner))))))
    ;; CHECK:       (type $shared-inner (shared (struct)))
    (type $shared-inner (shared (struct)))
  )

  ;; CHECK:      (type $4 (func))

  ;; CHECK:      (func $cmpxchg-non-nullable-field (type $4)
  ;; CHECK-NEXT:  (local $0 (ref $inner))
  ;; CHECK-NEXT:  (local $1 (ref $inner))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref $inner))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (struct.new_default $inner)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.set $0
  ;; CHECK-NEXT:       (local.get $1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-non-nullable-field
    (drop
      (struct.atomic.rmw.cmpxchg $outer 0
        ;; Even when the field, `expected`, and `replacement` are non-nullable,
        ;; optimizing `expected` and `replacement` to nulls is valid because the
        ;; never-matching cmpxchg drops them and reads the `(ref $inner)` field
        ;; local.
        ;; TODO: Track struct field edges so the nested $inner allocation is
        ;; optimized too.
        (struct.new $outer
          (struct.new_default $inner)
        )
        (struct.new_default $inner)
        (struct.new_default $inner)
      )
    )
  )

  ;; CHECK:      (func $cmpxchg-non-nullable-field-shared (type $4)
  ;; CHECK-NEXT:  (local $0 (ref $shared-inner))
  ;; CHECK-NEXT:  (local $1 (ref $shared-inner))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref $shared-inner))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (struct.new_default $shared-inner)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.set $0
  ;; CHECK-NEXT:       (local.get $1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-non-nullable-field-shared
    (drop
      (struct.atomic.rmw.cmpxchg $shared-outer 0
        ;; Same, but with shared types, dropping shared nulls and reading the
        ;; `(ref $shared-inner)` field local.
        (struct.new $shared-outer
          (struct.new_default $shared-inner)
        )
        (struct.new_default $shared-inner)
        (struct.new_default $shared-inner)
      )
    )
  )
)

(module
  ;; CHECK:      (type $struct (struct (field (mut (ref null $struct)))))
  (type $struct (struct (field (mut (ref null $struct)))))

  ;; CHECK:      (type $1 (func (result (ref null $struct))))

  ;; CHECK:      (type $2 (func (param (ref $struct)) (result (ref null $struct))))

  ;; CHECK:      (export "test" (func $cmpxchg-ref-and-expected))

  ;; CHECK:      (func $cmpxchg-ref-and-expected (type $1) (result (ref null $struct))
  ;; CHECK-NEXT:  (local $local (ref $struct))
  ;; CHECK-NEXT:  (local $1 (ref null $struct))
  ;; CHECK-NEXT:  (local $2 (ref null $struct))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null $struct))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $2
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (result (ref null $struct))
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.get $1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-ref-and-expected (export "test") (result (ref null $struct))
    (local $local (ref $struct))
    (drop
      ;; The allocation flows to both `ref` and `expected`. Since it does not
      ;; escape, it cannot match the value in the field, so the cmpxchg must
      ;; just drop its operands and read the field local (rather than emitting a
      ;; struct.get on the nulled-out `ref` or comparing the field local against
      ;; the nulled-out `expected` via `ref.eq`). Because the replacement is
      ;; dropped, it does not escape either and can also be optimized.
      (struct.atomic.rmw.cmpxchg $struct 0
        (local.tee $local
          (struct.new_default $struct)
        )
        (local.get $local)
        (struct.new_default $struct)
      )
    )
    (struct.get $struct 0
      (local.get $local)
    )
  )

  ;; CHECK:      (func $cmpxchg-ref-and-expected-non-null-replacement (type $2) (param $replacement (ref $struct)) (result (ref null $struct))
  ;; CHECK-NEXT:  (local $local (ref $struct))
  ;; CHECK-NEXT:  (local $2 (ref null $struct))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null $struct))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $2
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (local.get $replacement)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (result (ref null $struct))
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.get $2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-ref-and-expected-non-null-replacement (param $replacement (ref $struct)) (result (ref null $struct))
    (local $local (ref $struct))
    (drop
      ;; The replacement is non-null and cannot be optimized, so if the cmpxchg
      ;; spuriously succeeded (e.g. by comparing the null-initialized field
      ;; against an `expected` replaced with `null`), this would return
      ;; `$replacement` instead of `null`.
      (struct.atomic.rmw.cmpxchg $struct 0
        (local.tee $local
          (struct.new_default $struct)
        )
        (local.get $local)
        (local.get $replacement)
      )
    )
    (struct.get $struct 0
      (local.get $local)
    )
  )
)

(module
  (type $array (shared (array i8)))
  ;; CHECK:      (type $struct (shared (struct (field (mut (ref null (shared array)))))))
  (type $struct (shared (struct (field (mut (ref null (shared array)))))))

  ;; CHECK:      (type $1 (func (param (ref $struct))))

  ;; CHECK:      (func $unreachable-shared-expected (type $1) (param $struct (ref $struct))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.atomic.rmw.cmpxchg $struct 0
  ;; CHECK-NEXT:    (local.get $struct)
  ;; CHECK-NEXT:    (block (result (ref null (shared none)))
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $unreachable-shared-expected (param $struct (ref $struct))
    (drop
      ;; This cmpxchg will not be optimized because it is unreachable.
      (struct.atomic.rmw.cmpxchg $struct 0
        (local.get $struct)
        ;; This `expected` allocation does not escape, so it will be optimized.
        ;; Because the array is shared, we must replace it with a shared null; a
        ;; non-shared null here would fail validation.
        (array.new_fixed $array 0)
        (unreachable)
      )
    )
  )
)

(module
  ;; CHECK:      (type $array (array (mut eqref)))
  (type $array (array (mut eqref)))
  (type $struct (struct (field (mut eqref))))

  ;; CHECK:      (type $1 (func (param (ref $array))))

  ;; CHECK:      (type $2 (func (param (ref eq))))

  ;; CHECK:      (func $array-cmpxchg-expected (type $1) (param $array (ref $array))
  ;; CHECK-NEXT:  (local $1 eqref)
  ;; CHECK-NEXT:  (local $2 (ref null $array))
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result eqref)
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (local.get $array)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $3
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (array.atomic.get $array
  ;; CHECK-NEXT:     (local.get $2)
  ;; CHECK-NEXT:     (local.get $3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-cmpxchg-expected (param $array (ref $array))
    (drop
      ;; Even when `ref` is not optimized, we can still optimize the
      ;; non-escaping `expected` allocation and replace the cmpxchg with an
      ;; array.atomic.get.
      (array.atomic.rmw.cmpxchg $array
        (local.get $array)
        (i32.const 0)
        (array.new_default $array
          (i32.const 1)
        )
        (ref.null none)
      )
    )
  )

  ;; CHECK:      (func $array-cmpxchg-expected-null-ref (type $2) (param $x (ref eq))
  ;; CHECK-NEXT:  (local $1 eqref)
  ;; CHECK-NEXT:  (local $2 nullref)
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block $block (result (ref none))
  ;; CHECK-NEXT:    (br_on_cast_fail $block (ref none) (ref none)
  ;; CHECK-NEXT:     (block (result (ref none))
  ;; CHECK-NEXT:      (local.set $2
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.set $3
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (block (result nullref)
  ;; CHECK-NEXT:        (local.set $1
  ;; CHECK-NEXT:         (ref.null none)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:        (ref.null none)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (local.get $x)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (block ;; (replaces unreachable ArrayGet we can't emit)
  ;; CHECK-NEXT:       (drop
  ;; CHECK-NEXT:        (local.get $2)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (drop
  ;; CHECK-NEXT:        (local.get $3)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (unreachable)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-cmpxchg-expected-null-ref (param $x (ref eq))
    ;; When `ref` is null, replacing the cmpxchg with an array.get refines the
    ;; result type from `(ref eq)` to `(ref none)`, requiring refinalization.
    (drop
      (block $block (result (ref eq))
        (br_on_cast_fail $block (ref eq) (ref eq)
          (array.atomic.rmw.cmpxchg $array
            (ref.null none)
            (i32.const 0)
            (array.new_default $array
              (i32.const 1)
            )
            (local.get $x)
          )
        )
      )
    )
  )
)

(module
  ;; CHECK:      (type $struct (struct (field (mut eqref))))

  ;; CHECK:      (type $array (array (mut eqref)))
  (type $array (array (mut eqref)))
  (type $struct (struct (field (mut eqref))))
  ;; CHECK:      (type $2 (func (param (ref $array))))

  ;; CHECK:      (type $3 (func (result i32)))

  ;; CHECK:      (type $4 (func (result eqref)))

  ;; CHECK:      (type $5 (func (param (ref $struct) (ref $struct)) (result eqref)))

  ;; CHECK:      (type $6 (func (param (ref $struct))))

  ;; CHECK:      (type $7 (func (param eqref) (result eqref)))

  ;; CHECK:      (import "" "" (func $effect-i32 (type $3) (result i32)))
  (import "" "" (func $effect-i32 (result i32)))
  ;; CHECK:      (import "" "" (func $effect-eq (type $4) (result eqref)))
  (import "" "" (func $effect-eq (result eqref)))

  ;; CHECK:      (func $cmpxchg-expected-ref-effects (type $5) (param $s (ref $struct)) (param $other (ref $struct)) (result eqref)
  ;; CHECK-NEXT:  (local $2 eqref)
  ;; CHECK-NEXT:  (local $3 (ref null $struct))
  ;; CHECK-NEXT:  (local.set $3
  ;; CHECK-NEXT:   (local.get $s)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (local.set $s
  ;; CHECK-NEXT:     (local.get $other)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (block (result nullref)
  ;; CHECK-NEXT:     (local.set $2
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $effect-eq)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.atomic.get $struct 0
  ;; CHECK-NEXT:   (local.get $3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-expected-ref-effects (param $s (ref $struct)) (param $other (ref $struct)) (result eqref)
    ;; Localizes `ref` before `expected` mutates `$s`, and preserves
    ;; `replacement`'s call effect before emitting struct.atomic.get.
    (struct.atomic.rmw.cmpxchg $struct 0
      (local.get $s)
      (block (result (ref $struct))
        (local.set $s
          (local.get $other)
        )
        (struct.new_default $struct)
      )
      (call $effect-eq)
    )
  )

  ;; CHECK:      (func $cmpxchg-expected-trapping-preserve-effects (type $6) (param $s (ref $struct))
  ;; CHECK-NEXT:  (local $1 eqref)
  ;; CHECK-NEXT:  (local $2 (ref null $struct))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result eqref)
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (block (result (ref $struct))
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (call $effect-i32)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.get $s)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (block (result nullref)
  ;; CHECK-NEXT:        (local.set $1
  ;; CHECK-NEXT:         (ref.null none)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:        (ref.null none)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (call $effect-eq)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (struct.atomic.get $struct 0
  ;; CHECK-NEXT:     (local.get $2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-expected-trapping-preserve-effects (param $s (ref $struct))
    ;; Even when expected traps in a failing cast, preceding side effects in
    ;; `ref` are preserved before the trap and trailing operands are dropped.
    (drop
      (struct.atomic.rmw.cmpxchg $struct 0
        (block (result (ref $struct))
          (drop
            (call $effect-i32)
          )
          (local.get $s)
        )
        (ref.cast (ref $array)
          (struct.new_default $struct)
        )
        (call $effect-eq)
      )
    )
  )

  ;; CHECK:      (func $array-cmpxchg-expected-index-effect (type $2) (param $array (ref $array))
  ;; CHECK-NEXT:  (local $1 eqref)
  ;; CHECK-NEXT:  (local $2 (ref null $array))
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result eqref)
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (local.get $array)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $3
  ;; CHECK-NEXT:     (call $effect-i32)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (call $effect-eq)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (array.atomic.get $array
  ;; CHECK-NEXT:     (local.get $2)
  ;; CHECK-NEXT:     (local.get $3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-cmpxchg-expected-index-effect (param $array (ref $array))
    (drop
      ;; The index is non-constant, but we can still optimize the expected
      ;; field. We must preserve the index and the order of its effects.
      (array.atomic.rmw.cmpxchg $array
        (local.get $array)
        (call $effect-i32)
        (array.new_default $array (i32.const 1))
        (call $effect-eq)
      )
    )
  )

  ;; CHECK:      (func $array-cmpxchg-expected-index-oob (type $2) (param $array (ref $array))
  ;; CHECK-NEXT:  (local $1 eqref)
  ;; CHECK-NEXT:  (local $2 (ref null $array))
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result eqref)
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (local.get $array)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $3
  ;; CHECK-NEXT:     (i32.const -1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result nullref)
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (ref.null none)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null none)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (call $effect-eq)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (array.atomic.get $array
  ;; CHECK-NEXT:     (local.get $2)
  ;; CHECK-NEXT:     (local.get $3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-cmpxchg-expected-index-oob (param $array (ref $array))
    (drop
      ;; Now the index is constant but surely out-of-bounds. We still optimize
      ;; the same way, leaving the array.atomic.get to trap.
      (array.atomic.rmw.cmpxchg $array
        (local.get $array)
        (i32.const -1)
        (array.new_default $array (i32.const 1))
        (call $effect-eq)
      )
    )
  )

  ;; CHECK:      (func $array-cmpxchg-ref-unoptimized-expected (type $7) (param $expected eqref) (result eqref)
  ;; CHECK-NEXT:  (local $1 eqref)
  ;; CHECK-NEXT:  (local $2 eqref)
  ;; CHECK-NEXT:  (local $3 eqref)
  ;; CHECK-NEXT:  (local $4 eqref)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result nullref)
  ;; CHECK-NEXT:    (local.set $1
  ;; CHECK-NEXT:     (ref.null none)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $3
  ;; CHECK-NEXT:   (local.get $expected)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $4
  ;; CHECK-NEXT:   (call $effect-eq)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $2
  ;; CHECK-NEXT:   (local.get $1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (ref.eq
  ;; CHECK-NEXT:    (local.get $1)
  ;; CHECK-NEXT:    (local.get $3)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $1
  ;; CHECK-NEXT:     (local.get $4)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $2)
  ;; CHECK-NEXT: )
  (func $array-cmpxchg-ref-unoptimized-expected (param $expected eqref) (result eqref)
    ;; Reference-element array with unescaped array ref and unoptimized
    ;; expected emits the eqref scratch local and ref.eq comparison.
    (array.atomic.rmw.cmpxchg $array
      (array.new_default $array
        (i32.const 1)
      )
      (i32.const 0)
      (local.get $expected)
      (call $effect-eq)
    )
  )
)

(module
  ;; CHECK:      (type $struct (shared (struct (field (mut (ref null $struct))))))
  (type $struct (shared (struct (field (mut (ref null $struct))))))
  ;; CHECK:      (type $1 (func (param (ref $struct)) (result (ref null $struct))))

  ;; CHECK:      (type $2 (func (param (ref $struct))))

  ;; CHECK:      (type $3 (func (result i32)))

  ;; CHECK:      (func $must-optimize-ref-eq (type $3) (result i32)
  ;; CHECK-NEXT:  (local $local (ref null $struct))
  ;; CHECK-NEXT:  (local $1 (ref null $struct))
  ;; CHECK-NEXT:  (local $2 (ref null $struct))
  ;; CHECK-NEXT:  (local $3 (ref null $struct))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null $struct))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (ref.null (shared none))
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (local.set $2
  ;; CHECK-NEXT:       (ref.null (shared none))
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (local.set $3
  ;; CHECK-NEXT:       (ref.null (shared none))
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.is_null
  ;; CHECK-NEXT:   (block (result (ref null $struct))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $must-optimize-ref-eq (result i32)
    ;; `ref`, `expected`, and `replacement` are all distinct non-escaping
    ;; allocations. Because `expected` cannot match the null-initialized field
    ;; of `ref`, `replacement` does not escape either: all three allocations are
    ;; optimized, the cmpxchg drops its operands without writing `replacement`
    ;; to the field local, and the trailing struct.get still reads null.
    (local $local (ref null $struct))
    (drop
      (struct.atomic.rmw.cmpxchg acqrel acqrel $struct 0
        (local.tee $local
          (struct.new_default $struct)
        )
        (struct.new_default $struct)
        (struct.new_default $struct)
      )
    )
    (ref.is_null
      (struct.get $struct 0 (local.get $local))
    )
  )

  ;; CHECK:      (func $cmpxchg-expected-and-replacement-unescaped (type $1) (param $s (ref $struct)) (result (ref null $struct))
  ;; CHECK-NEXT:  (local $1 (ref null $struct))
  ;; CHECK-NEXT:  (local $2 (ref null $struct))
  ;; CHECK-NEXT:  (local $3 (ref null $struct))
  ;; CHECK-NEXT:  (local.set $3
  ;; CHECK-NEXT:   (local.get $s)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null (shared none)))
  ;; CHECK-NEXT:    (local.set $1
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null (shared none))
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null (shared none)))
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null (shared none))
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.atomic.get $struct 0
  ;; CHECK-NEXT:   (local.get $3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-expected-and-replacement-unescaped (param $s (ref $struct)) (result (ref null $struct))
    ;; Conditional cmpxchg escape: unescaped expected allows replacement to
    ;; stay unescaped too when neither escapes elsewhere.
    (struct.atomic.rmw.cmpxchg $struct 0
      (local.get $s)
      (struct.new_default $struct)
      (struct.new_default $struct)
    )
  )

  ;; CHECK:      (func $cmpxchg-expected-escaped-escapes-replacement (type $1) (param $s (ref $struct)) (result (ref null $struct))
  ;; CHECK-NEXT:  (local $exp (ref null $struct))
  ;; CHECK-NEXT:  (local.set $exp
  ;; CHECK-NEXT:   (struct.new_default $struct)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.atomic.rmw.cmpxchg $struct 0
  ;; CHECK-NEXT:    (local.get $s)
  ;; CHECK-NEXT:    (local.get $exp)
  ;; CHECK-NEXT:    (struct.new_default $struct)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $exp)
  ;; CHECK-NEXT: )
  (func $cmpxchg-expected-escaped-escapes-replacement (param $s (ref $struct)) (result (ref null $struct))
    (local $exp (ref null $struct))
    ;; Escaping expected forces replacement to escape too.
    (local.set $exp
      (struct.new_default $struct)
    )
    (drop
      (struct.atomic.rmw.cmpxchg $struct 0
        (local.get $s)
        (local.get $exp)
        (struct.new_default $struct)
      )
    )
    (local.get $exp)
  )

  ;; CHECK:      (func $cmpxchg-self-expected-replacement (type $2) (param $s (ref $struct))
  ;; CHECK-NEXT:  (local $x (ref null $struct))
  ;; CHECK-NEXT:  (local $2 (ref null $struct))
  ;; CHECK-NEXT:  (local $3 (ref null $struct))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null (shared none)))
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null (shared none))
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null $struct))
  ;; CHECK-NEXT:    (local.set $3
  ;; CHECK-NEXT:     (local.get $s)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (struct.atomic.get $struct 0
  ;; CHECK-NEXT:     (local.get $3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-self-expected-replacement (param $s (ref $struct))
    (local $x (ref null $struct))
    ;; Self-dependency in escape graph keeps $x unescaped.
    (local.set $x
      (struct.new_default $struct)
    )
    (drop
      (struct.atomic.rmw.cmpxchg $struct 0
        (local.get $s)
        (local.get $x)
        (local.get $x)
      )
    )
  )

  ;; CHECK:      (func $cmpxchg-multi-hop-chain (type $1) (param $s (ref $struct)) (result (ref null $struct))
  ;; CHECK-NEXT:  (local $a (ref null $struct))
  ;; CHECK-NEXT:  (local $b (ref null $struct))
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (struct.new_default $struct)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $b
  ;; CHECK-NEXT:   (struct.new_default $struct)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.atomic.rmw.cmpxchg $struct 0
  ;; CHECK-NEXT:    (local.get $s)
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:    (local.get $b)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.atomic.rmw.cmpxchg $struct 0
  ;; CHECK-NEXT:    (local.get $s)
  ;; CHECK-NEXT:    (local.get $b)
  ;; CHECK-NEXT:    (struct.new_default $struct)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $a)
  ;; CHECK-NEXT: )
  (func $cmpxchg-multi-hop-chain (param $s (ref $struct)) (result (ref null $struct))
    (local $a (ref null $struct))
    (local $b (ref null $struct))
    ;; Transitive escape chain: A -> B -> C where A escapes via return.
    (local.set $a
      (struct.new_default $struct)
    )
    (local.set $b
      (struct.new_default $struct)
    )
    (drop
      (struct.atomic.rmw.cmpxchg $struct 0
        (local.get $s)
        (local.get $a)
        (local.get $b)
      )
    )
    (drop
      (struct.atomic.rmw.cmpxchg $struct 0
        (local.get $s)
        (local.get $b)
        (struct.new_default $struct)
      )
    )
    (local.get $a)
  )

  ;; CHECK:      (func $cmpxchg-mutual-cycle (type $2) (param $s (ref $struct))
  ;; CHECK-NEXT:  (local $a (ref null $struct))
  ;; CHECK-NEXT:  (local $b (ref null $struct))
  ;; CHECK-NEXT:  (local $3 (ref null $struct))
  ;; CHECK-NEXT:  (local $4 (ref null $struct))
  ;; CHECK-NEXT:  (local $5 (ref null $struct))
  ;; CHECK-NEXT:  (local $6 (ref null $struct))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null (shared none)))
  ;; CHECK-NEXT:    (local.set $3
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null (shared none))
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null (shared none)))
  ;; CHECK-NEXT:    (local.set $4
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null (shared none))
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null $struct))
  ;; CHECK-NEXT:    (local.set $5
  ;; CHECK-NEXT:     (local.get $s)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (struct.atomic.get $struct 0
  ;; CHECK-NEXT:     (local.get $5)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null $struct))
  ;; CHECK-NEXT:    (local.set $6
  ;; CHECK-NEXT:     (local.get $s)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (struct.atomic.get $struct 0
  ;; CHECK-NEXT:     (local.get $6)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-mutual-cycle (param $s (ref $struct))
    (local $a (ref null $struct))
    (local $b (ref null $struct))
    ;; Mutual escape cycle A <-> B where neither escapes elsewhere optimizes
    ;; both allocations cleanly.
    (local.set $a
      (struct.new_default $struct)
    )
    (local.set $b
      (struct.new_default $struct)
    )
    (drop
      (struct.atomic.rmw.cmpxchg $struct 0
        (local.get $s)
        (local.get $a)
        (local.get $b)
      )
    )
    (drop
      (struct.atomic.rmw.cmpxchg $struct 0
        (local.get $s)
        (local.get $b)
        (local.get $a)
      )
    )
  )
)

(module
  ;; CHECK:      (type $s1 (shared (struct)))

  ;; CHECK:      (type $a0 (shared (array (mut (ref null (shared eq))))))

  ;; CHECK:      (type $s0 (shared (struct (field (mut (ref null (shared eq)))))))
  (type $s0 (shared (struct (field (mut (ref null (shared eq)))))))
  (type $a0 (shared (array (mut (ref null (shared eq))))))
  (type $s1 (shared (struct)))

  ;; CHECK:      (type $3 (func (param (ref $a0))))

  ;; CHECK:      (type $4 (func (param (ref $s0))))

  ;; CHECK:      (type $5 (func))

  ;; CHECK:      (type $6 (func (param (ref null $s1)) (result (ref null (shared eq)))))

  ;; CHECK:      (func $cmpxchg-became-unreachable-ref (type $5)
  ;; CHECK-NEXT:  (local $x (ref null $s1))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable StructCmpxchg we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (block (result (ref null (shared none)))
  ;; CHECK-NEXT:        (ref.null (shared none))
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-became-unreachable-ref
    ;; The allocation flows into both a failing cast in `ref` and into
    ;; `expected`. During the post-order rewrite, `ref` is replaced with a
    ;; trapping block before the cmpxchg is visited, so the cmpxchg is left for
    ;; refinalization once its `ref` becomes unreachable.
    (local $x (ref null $s1))
    (drop
      (struct.atomic.rmw.cmpxchg $s0 0
        (ref.cast (ref $s0)
          (local.tee $x
            (struct.new_default $s1)
          )
        )
        (local.get $x)
        (ref.null (shared none))
      )
    )
  )

  ;; CHECK:      (func $array-cmpxchg-became-unreachable-ref (type $5)
  ;; CHECK-NEXT:  (local $x (ref null $s1))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable ArrayCmpxchg we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (block (result (ref null (shared none)))
  ;; CHECK-NEXT:        (ref.null (shared none))
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-cmpxchg-became-unreachable-ref
    ;; Same as above, for array.atomic.rmw.cmpxchg.
    (local $x (ref null $s1))
    (drop
      (array.atomic.rmw.cmpxchg $a0
        (ref.cast (ref $a0)
          (local.tee $x
            (struct.new_default $s1)
          )
        )
        (i32.const 0)
        (local.get $x)
        (ref.null (shared none))
      )
    )
  )

  ;; CHECK:      (func $array-cmpxchg-unreachable (type $3) (param $a (ref $a0))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (array.atomic.rmw.cmpxchg $a0
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (block (result (ref null (shared none)))
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-cmpxchg-unreachable (param $a (ref $a0))
    ;; An unreachable array.atomic.rmw.cmpxchg is left for DCE.
    (drop
      (array.atomic.rmw.cmpxchg $a0
        (local.get $a)
        (i32.const 0)
        (struct.new_default $s1)
        (unreachable)
      )
    )
  )

  ;; CHECK:      (func $array-rmw-xchg-ref (type $6) (param $r (ref null $s1)) (result (ref null (shared eq)))
  ;; CHECK-NEXT:  (local $1 (ref null (shared eq)))
  ;; CHECK-NEXT:  (local $2 (ref null (shared eq)))
  ;; CHECK-NEXT:  (local $3 (ref null (shared eq)))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null (shared none)))
  ;; CHECK-NEXT:    (local.set $1
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.null (shared none))
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $3
  ;; CHECK-NEXT:   (local.get $r)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $2
  ;; CHECK-NEXT:   (local.get $1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $1
  ;; CHECK-NEXT:   (local.get $3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $2)
  ;; CHECK-NEXT: )
  (func $array-rmw-xchg-ref (param $r (ref null $s1)) (result (ref null (shared eq)))
    ;; Non-escaping ref array with ref atomic RMW xchg.
    (array.atomic.rmw.xchg $a0
      (array.new_default $a0
        (i32.const 1)
      )
      (i32.const 0)
      (local.get $r)
    )
  )

  ;; CHECK:      (func $cmpxchg-unknown-replacement (type $4) (param $s (ref $s0))
  ;; CHECK-NEXT:  (local $1 (ref null $s0))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null (shared eq)))
  ;; CHECK-NEXT:    (local.set $1
  ;; CHECK-NEXT:     (local.get $s)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (struct.atomic.get $s0 0
  ;; CHECK-NEXT:     (local.get $1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-unknown-replacement (param $s (ref $s0))
    ;; Candidate expected operand with unknown null replacement on
    ;; struct.atomic.rmw.cmpxchg.
    (drop
      (struct.atomic.rmw.cmpxchg $s0 0
        (local.get $s)
        (struct.new_default $s1)
        (ref.null (shared none))
      )
    )
  )

  ;; CHECK:      (func $cmpxchg-unknown-expected (type $4) (param $s (ref $s0))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null (shared none)))
  ;; CHECK-NEXT:    (ref.null (shared none))
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.atomic.rmw.cmpxchg $s0 0
  ;; CHECK-NEXT:    (local.get $s)
  ;; CHECK-NEXT:    (ref.null (shared none))
  ;; CHECK-NEXT:    (struct.new_default $s1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-unknown-expected (param $s (ref $s0))
    ;; Unknown null expected operand forces candidate replacement to escape
    ;; while an unrelated non-escaping allocation is still optimized.
    (drop
      (struct.new_default $s1)
    )
    (drop
      (struct.atomic.rmw.cmpxchg $s0 0
        (local.get $s)
        (ref.null (shared eq))
        (struct.new_default $s1)
      )
    )
  )

  ;; CHECK:      (func $array-cmpxchg-unknown-replacement (type $3) (param $a (ref $a0))
  ;; CHECK-NEXT:  (local $1 (ref null $a0))
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref null (shared eq)))
  ;; CHECK-NEXT:    (local.set $1
  ;; CHECK-NEXT:     (local.get $a)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (array.atomic.get $a0
  ;; CHECK-NEXT:     (local.get $1)
  ;; CHECK-NEXT:     (local.get $2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-cmpxchg-unknown-replacement (param $a (ref $a0))
    ;; Candidate expected operand with unknown null replacement on
    ;; array.atomic.rmw.cmpxchg.
    (drop
      (array.atomic.rmw.cmpxchg $a0
        (local.get $a)
        (i32.const 0)
        (struct.new_default $s1)
        (ref.null (shared none))
      )
    )
  )

  ;; CHECK:      (func $array-cmpxchg-unknown-expected (type $3) (param $a (ref $a0))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (array.atomic.rmw.cmpxchg $a0
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (ref.null (shared none))
  ;; CHECK-NEXT:    (struct.new_default $s1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-cmpxchg-unknown-expected (param $a (ref $a0))
    ;; Unknown null expected operand on array.atomic.rmw.cmpxchg forces
    ;; replacement to escape.
    (drop
      (array.atomic.rmw.cmpxchg $a0
        (local.get $a)
        (i32.const 0)
        (ref.null (shared eq))
        (struct.new_default $s1)
      )
    )
  )

  ;; CHECK:      (func $cmpxchg-mixed-expected (type $4) (param $s (ref $s0))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.atomic.rmw.cmpxchg $s0 0
  ;; CHECK-NEXT:    (local.get $s)
  ;; CHECK-NEXT:    (select (result (ref null (exact $s1)))
  ;; CHECK-NEXT:     (struct.new_default $s1)
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (struct.new_default $s1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-mixed-expected (param $s (ref $s0))
    ;; Merging a candidate allocation with null in expected forces replacement
    ;; to escape.
    (drop
      (struct.atomic.rmw.cmpxchg $s0 0
        (local.get $s)
        (select (result (ref null (shared eq)))
          (struct.new_default $s1)
          (ref.null (shared eq))
          (i32.const 0)
        )
        (struct.new_default $s1)
      )
    )
  )
)

(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $outer (shared (struct (field (mut (ref $inner))))))
    (type $outer (shared (struct (field (mut (ref $inner))))))
    ;; CHECK:       (type $inner (shared (struct)))
    (type $inner (shared (struct)))
    ;; CHECK:       (type $other (shared (struct)))
    (type $other (shared (struct)))
  )

  ;; CHECK:      (type $arr (shared (array (mut (ref $inner)))))
  (type $arr (shared (array (mut (ref $inner)))))


  ;; CHECK:      (type $4 (func (param (ref $outer))))

  ;; CHECK:      (type $5 (func))

  ;; CHECK:      (type $6 (func (param (ref $arr))))

  ;; CHECK:      (type $7 (func (param (ref $arr) i32)))

  ;; CHECK:      (type $8 (func (result (ref $inner))))

  ;; CHECK:      (func $cmpxchg-trapping-expected-nonnull-replacement (type $4) (param $s (ref $outer))
  ;; CHECK-NEXT:  (local $1 (ref null $outer))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref $inner))
  ;; CHECK-NEXT:    (local.set $1
  ;; CHECK-NEXT:     (local.get $s)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (block (result (ref null (shared none)))
  ;; CHECK-NEXT:        (ref.null (shared none))
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (struct.atomic.get $outer 0
  ;; CHECK-NEXT:     (local.get $1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-trapping-expected-nonnull-replacement (param $s (ref $outer))
    ;; When expected traps in a failing cast, struct.atomic.rmw.cmpxchg never
    ;; executes, so even a non-nullable replacement cannot be written to the
    ;; heap and can be optimized away.
    (drop
      (struct.atomic.rmw.cmpxchg $outer 0
        (local.get $s)
        (ref.cast (ref null $inner)
          (struct.new_default $other)
        )
        (struct.new_default $inner)
      )
    )
  )

  ;; CHECK:      (func $cmpxchg-alloc-trapping-expected-nonnull-replacement (type $5)
  ;; CHECK-NEXT:  (local $0 (ref $inner))
  ;; CHECK-NEXT:  (local $1 (ref $inner))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref $inner))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (local.set $1
  ;; CHECK-NEXT:       (struct.new_default $inner)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.set $0
  ;; CHECK-NEXT:       (local.get $1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (block (result (ref null (shared none)))
  ;; CHECK-NEXT:        (ref.null (shared none))
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-alloc-trapping-expected-nonnull-replacement
    ;; Same when the struct reference itself is a non-escaping allocation.
    (drop
      (struct.atomic.rmw.cmpxchg $outer 0
        (struct.new $outer
          (struct.new_default $inner)
        )
        (ref.cast (ref null $inner)
          (struct.new_default $other)
        )
        (struct.new_default $inner)
      )
    )
  )

  ;; CHECK:      (func $array-cmpxchg-trapping-expected-nonnull-replacement (type $6) (param $a (ref $arr))
  ;; CHECK-NEXT:  (local $1 (ref null $arr))
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block (result (ref $inner))
  ;; CHECK-NEXT:    (local.set $1
  ;; CHECK-NEXT:     (local.get $a)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (block (result (ref null (shared none)))
  ;; CHECK-NEXT:        (ref.null (shared none))
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result (ref null (shared none)))
  ;; CHECK-NEXT:      (ref.null (shared none))
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (array.atomic.get $arr
  ;; CHECK-NEXT:     (local.get $1)
  ;; CHECK-NEXT:     (local.get $2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-cmpxchg-trapping-expected-nonnull-replacement (param $a (ref $arr))
    ;; Same for array.atomic.rmw.cmpxchg.
    (drop
      (array.atomic.rmw.cmpxchg $arr
        (local.get $a)
        (i32.const 0)
        (ref.cast (ref null $inner)
          (struct.new_default $other)
        )
        (struct.new_default $inner)
      )
    )
  )

  ;; CHECK:      (func $cmpxchg-unreachable-ref-replacement (type $4) (param $s (ref $outer))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.atomic.rmw.cmpxchg $outer 0
  ;; CHECK-NEXT:    (local.get $s)
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:    (struct.new_default $inner)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-unreachable-ref-replacement (param $s (ref $outer))
    ;; We skip unreachable struct.atomic.rmw.cmpxchg ops, and
    ;; validation still checks replacement against a reachable ref's
    ;; non-nullable field type, so replacement must not be optimized to null.
    (drop
      (struct.atomic.rmw.cmpxchg $outer 0
        (local.get $s)
        (unreachable)
        (struct.new_default $inner)
      )
    )
  )

  ;; CHECK:      (func $array-cmpxchg-unreachable-ref-replacement (type $7) (param $a (ref $arr)) (param $i i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (array.atomic.rmw.cmpxchg $arr
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:    (local.get $i)
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:    (struct.new_default $inner)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-cmpxchg-unreachable-ref-replacement (param $a (ref $arr)) (param $i i32)
    ;; We skip unreachable array.atomic.rmw.cmpxchg ops, and
    ;; validation still checks replacement against a reachable ref's
    ;; non-nullable element type, so replacement must not be optimized to null.
    (drop
      (array.atomic.rmw.cmpxchg $arr
        (local.get $a)
        (local.get $i)
        (unreachable)
        (struct.new_default $inner)
      )
    )
  )

  ;; CHECK:      (func $cmpxchg-bottom-ref-i32-expected (type $5)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable StructCmpxchg we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (struct.new_default $inner)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $cmpxchg-bottom-ref-i32-expected
    ;; A bottom nullref in ref makes struct.atomic.rmw.cmpxchg unreachable and
    ;; lets validation accept a non-reference expected operand; replacement
    ;; stays unoptimized.
    (drop
      (struct.atomic.rmw.cmpxchg $outer 0
        (ref.null (shared none))
        (i32.const 0)
        (struct.new_default $inner)
      )
    )
  )

  ;; CHECK:      (func $array-cmpxchg-bottom-ref-i32-expected (type $8) (result (ref $inner))
  ;; CHECK-NEXT:  (block ;; (replaces unreachable ArrayCmpxchg we can't emit)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.null (shared none))
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (struct.new_default $inner)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $array-cmpxchg-bottom-ref-i32-expected (result (ref $inner))
    ;; Same for array.atomic.rmw.cmpxchg, where the unreachable cmpxchg takes
    ;; its result type from replacement.
    (array.atomic.rmw.cmpxchg $arr
      (ref.null (shared none))
      (i32.const 0)
      (i32.const 0)
      (struct.new_default $inner)
    )
  )
)
