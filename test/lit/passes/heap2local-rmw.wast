  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (block (result (ref null (shared none)))
  ;; HP2L2-NEXT:      (ref.null (shared none))
  ;; HP2L2-NEXT:     )
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (local.get $1)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $cmpxchg-bot-expected-nonnull-replacement (param $s (ref $outer))
    ;; When expected traps in a failing cast, cmpxchg never executes, so even a
    ;; non-nullable replacement cannot be written to the heap and is optimized
    ;; away when --heap2local2 rewrites the cmpxchg to drop its operands.
    (drop
      (struct.atomic.rmw.cmpxchg $outer 0
        (local.get $s)
        (ref.cast (ref null $inner)
          (struct.new_default $other)
        )
        (struct.new_default $inner)
      )
    )
    ;; Same when the struct reference itself is a non-escaping allocation.
    (drop
      (struct.atomic.rmw.cmpxchg $outer 0
        (struct.new $outer
          (struct.new_default $inner)
        )
        (ref.cast (ref null $inner)
          (struct.new_default $other)
        )
        (struct.new_default $inner)
      )
    )
  )

  ;; CHECK:      (func $cmpxchg-unreachable-ref-replacement (type $5) (param $s (ref $outer)) (param $a (ref $arr)) (param $i i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.atomic.rmw.cmpxchg $outer 0
  ;; CHECK-NEXT:    (local.get $s)
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:    (struct.new_default $inner)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (array.atomic.rmw.cmpxchg $arr
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:    (local.get $i)
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:    (struct.new_default $inner)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; HP2L2:      (func $cmpxchg-unreachable-ref-replacement (type $5) (param $s (ref $outer)) (param $a (ref $arr)) (param $i i32)
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (struct.atomic.rmw.cmpxchg $outer 0
  ;; HP2L2-NEXT:    (local.get $s)
  ;; HP2L2-NEXT:    (unreachable)
  ;; HP2L2-NEXT:    (struct.new_default $inner)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (array.atomic.rmw.cmpxchg $arr
  ;; HP2L2-NEXT:    (local.get $a)
  ;; HP2L2-NEXT:    (local.get $i)
  ;; HP2L2-NEXT:    (unreachable)
  ;; HP2L2-NEXT:    (struct.new_default $inner)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $cmpxchg-unreachable-ref-replacement (param $s (ref $outer)) (param $a (ref $arr)) (param $i i32)
    ;; Optimizer skips unreachable cmpxchg ops, and validation still checks
    ;; replacement against a reachable ref's non-nullable field or element type,
    ;; so replacement must not be optimized to null.
    (drop
      (struct.atomic.rmw.cmpxchg $outer 0
        (local.get $s)
        (unreachable)
        (struct.new_default $inner)
      )
    )
    (drop
      (array.atomic.rmw.cmpxchg $arr
        (local.get $a)
        (local.get $i)
        (unreachable)
        (struct.new_default $inner)
      )
    )
  )

  ;; CHECK:      (func $cmpxchg-bottom-ref-i32-expected (type $6) (result (ref $inner))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block ;; (replaces unreachable StructCmpxchg we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.null (shared none))
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (struct.new_default $inner)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block ;; (replaces unreachable ArrayCmpxchg we can't emit)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.null (shared none))
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (struct.new_default $inner)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; HP2L2:      (func $cmpxchg-bottom-ref-i32-expected (type $6) (result (ref $inner))
  ;; HP2L2-NEXT:  (drop
  ;; HP2L2-NEXT:   (block ;; (replaces unreachable StructCmpxchg we can't emit)
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (ref.null (shared none))
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (i32.const 0)
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (struct.new_default $inner)
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (unreachable)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT:  (block ;; (replaces unreachable ArrayCmpxchg we can't emit)
  ;; HP2L2-NEXT:   (drop
  ;; HP2L2-NEXT:    (ref.null (shared none))
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:   (drop
  ;; HP2L2-NEXT:    (i32.const 0)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:   (drop
  ;; HP2L2-NEXT:    (i32.const 0)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:   (drop
  ;; HP2L2-NEXT:    (struct.new_default $inner)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:   (unreachable)
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $cmpxchg-bottom-ref-i32-expected (result (ref $inner))
    ;; A bottom nullref in ref makes the cmpxchg unreachable and lets validation
    ;; accept a non-reference expected operand; because the unreachable cmpxchg is
    ;; not rewritten, replacement stays unoptimized.
    (drop
      (struct.atomic.rmw.cmpxchg $outer 0
        (ref.null (shared none))
        (i32.const 0)
        (struct.new_default $inner)
      )
    )
    (array.atomic.rmw.cmpxchg $arr
      (ref.null (shared none))
      (i32.const 0)
      (i32.const 0)
      (struct.new_default $inner)
    )
  )
)
