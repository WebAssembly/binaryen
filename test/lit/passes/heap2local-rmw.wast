  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $array-cmpxchg-expected-index-oob (param $array (ref $array))
    (drop
