  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (drop
  ;; HP2L2-NEXT:     (ref.null (shared none))
  ;; HP2L2-NEXT:    )
  ;; HP2L2-NEXT:    (unreachable)
  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $cmpxchg-became-unreachable-ref
    ;; The allocation flows into both a failing cast in `ref` and into
    ;; `expected`. During the post-order rewrite, `ref` is replaced with a
    ;; trapping block before the cmpxchg is visited, so the cmpxchg is left for
    ;; refinalization once its `ref` becomes unreachable.
    (local $x (ref null $s1))
    (drop
      (struct.atomic.rmw.cmpxchg $s0 0
        (ref.cast (ref $s0)
          (local.tee $x
            (struct.new_default $s1)
          )
        )
        (local.get $x)
        (ref.null (shared none))
      )
    )
  )

