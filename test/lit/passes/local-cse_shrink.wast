;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-opt --local-cse --shrink-level=1 -S -o - | filecheck %s

;; Under shrink levels, a size-2 expression reused once is only worth it when
;; the new local can be merged into an existing one.

(module
  (memory 1)
  ;; CHECK:      (type $0 (func (param i32) (result i32)))

  ;; CHECK:      (memory $0 1)

  ;; CHECK:      (export "no-locals" (func $no-locals))

  ;; CHECK:      (export "with-locals" (func $with-locals))

  ;; CHECK:      (func $no-locals (param $p i32) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.load
  ;; CHECK-NEXT:    (local.get $p)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i32.load
  ;; CHECK-NEXT:    (local.get $p)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $no-locals (export "no-locals") (param $p i32) (result i32)
    (i32.add
      (i32.load
        (local.get $p)
      )
      (i32.load
        (local.get $p)
      )
    )
  )
  ;; CHECK:      (func $with-locals (param $p i32) (result i32)
  ;; CHECK-NEXT:  (local $x i32)
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (local.set $x
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (local.tee $2
  ;; CHECK-NEXT:    (i32.load
  ;; CHECK-NEXT:     (local.get $p)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.get $2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $with-locals (export "with-locals") (param $p i32) (result i32)
    (local $x i32)
    (local.set $x
      (i32.const 1)
    )
    (i32.add
      (i32.load
        (local.get $p)
      )
      (i32.load
        (local.get $p)
      )
    )
  )
)
