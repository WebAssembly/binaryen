;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt -all --dae -S -o - | filecheck %s --check-prefix=NOOPT
;; RUN: foreach %s %t wasm-opt -all --dae-optimizing -S -o - | filecheck %s

;; When a function never returns normally (it only throws, traps or loops
;; forever), no value can flow out of it, and DAE refines its reference result
;; to the non-nullable bottom type of its hierarchy. The callers then see that
;; the call never returns, and functions that tail-call it can be refined
;; further.
(module
 ;; NOOPT:      (type $0 (func (result i32)))

 ;; NOOPT:      (type $1 (func (result (ref none))))

 ;; NOOPT:      (type $2 (func (param i32)))

 ;; NOOPT:      (type $3 (func (param i32) (result (ref none))))

 ;; NOOPT:      (type $4 (func (result (ref nofunc))))

 ;; NOOPT:      (type $5 (func (result (ref noextern))))

 ;; NOOPT:      (type $6 (func (result anyref anyref)))

 ;; NOOPT:      (type $7 (func (param i32) (result i32)))

 ;; NOOPT:      (tag $exn (type $2) (param i32))
 ;; CHECK:      (type $0 (func (result i32)))

 ;; CHECK:      (type $1 (func))

 ;; CHECK:      (type $2 (func (param i32)))

 ;; CHECK:      (type $3 (func (result anyref anyref)))

 ;; CHECK:      (type $4 (func (param i32) (result i32)))

 ;; CHECK:      (tag $exn (type $2) (param i32))
 (tag $exn (param i32))

 ;; This function only throws.
 ;; NOOPT:      (export "caller" (func $caller))

 ;; NOOPT:      (export "call-traps" (func $call-traps))

 ;; NOOPT:      (export "call-loops" (func $call-loops))

 ;; NOOPT:      (export "call-func" (func $call-func))

 ;; NOOPT:      (export "call-extern" (func $call-extern))

 ;; NOOPT:      (export "call-tuple" (func $call-tuple))

 ;; NOOPT:      (func $throws (type $3) (param $x i32) (result (ref none))
 ;; NOOPT-NEXT:  (throw $exn
 ;; NOOPT-NEXT:   (local.get $x)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (export "caller" (func $caller))

 ;; CHECK:      (export "call-traps" (func $call-traps))

 ;; CHECK:      (export "call-loops" (func $call-loops))

 ;; CHECK:      (export "call-func" (func $call-func))

 ;; CHECK:      (export "call-extern" (func $call-extern))

 ;; CHECK:      (export "call-tuple" (func $call-tuple))

 ;; CHECK:      (func $throws (type $2) (param $0 i32)
 ;; CHECK-NEXT:  (throw $exn
 ;; CHECK-NEXT:   (local.get $0)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $throws (param $x i32) (result (ref eq))
  (throw $exn
   (local.get $x)
  )
 )

 ;; This function ends in an unreachable.
 ;; NOOPT:      (func $traps (type $1) (result (ref none))
 ;; NOOPT-NEXT:  (drop
 ;; NOOPT-NEXT:   (i32.const 42)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT:  (unreachable)
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $traps (type $1)
 ;; CHECK-NEXT:  (unreachable)
 ;; CHECK-NEXT: )
 (func $traps (result (ref null any))
  (drop
   (i32.const 42)
  )
  (unreachable)
 )

 ;; This function loops forever.
 ;; NOOPT:      (func $loops (type $1) (result (ref none))
 ;; NOOPT-NEXT:  (loop $l
 ;; NOOPT-NEXT:   (br $l)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $loops (type $1)
 ;; CHECK-NEXT:  (loop $l
 ;; CHECK-NEXT:   (br $l)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $loops (result anyref)
  (loop $l
   (br $l)
  )
 )

 ;; Other hierarchies.
 ;; NOOPT:      (func $func (type $4) (result (ref nofunc))
 ;; NOOPT-NEXT:  (unreachable)
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $func (type $1)
 ;; CHECK-NEXT:  (unreachable)
 ;; CHECK-NEXT: )
 (func $func (result (ref null func))
  (unreachable)
 )

 ;; NOOPT:      (func $extern (type $5) (result (ref noextern))
 ;; NOOPT-NEXT:  (unreachable)
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $extern (type $1)
 ;; CHECK-NEXT:  (unreachable)
 ;; CHECK-NEXT: )
 (func $extern (result externref)
  (unreachable)
 )

 ;; Multivalue results are left alone.
 ;; NOOPT:      (func $tuple (type $6) (result anyref anyref)
 ;; NOOPT-NEXT:  (unreachable)
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $tuple (type $3) (result anyref anyref)
 ;; CHECK-NEXT:  (unreachable)
 ;; CHECK-NEXT: )
 (func $tuple (result anyref anyref)
  (unreachable)
 )

 ;; The code after the call to a never-returning function becomes unreachable
 ;; with --dae-optimizing.
 ;; NOOPT:      (func $caller (type $7) (param $x i32) (result i32)
 ;; NOOPT-NEXT:  (local $y (ref eq))
 ;; NOOPT-NEXT:  (if
 ;; NOOPT-NEXT:   (local.get $x)
 ;; NOOPT-NEXT:   (then
 ;; NOOPT-NEXT:    (return
 ;; NOOPT-NEXT:     (i32.const 1)
 ;; NOOPT-NEXT:    )
 ;; NOOPT-NEXT:   )
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT:  (local.set $y
 ;; NOOPT-NEXT:   (call $throws
 ;; NOOPT-NEXT:    (local.get $x)
 ;; NOOPT-NEXT:   )
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT:  (i31.get_s
 ;; NOOPT-NEXT:   (ref.cast (ref i31)
 ;; NOOPT-NEXT:    (local.get $y)
 ;; NOOPT-NEXT:   )
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $caller (type $4) (param $0 i32) (result i32)
 ;; CHECK-NEXT:  (if
 ;; CHECK-NEXT:   (local.get $0)
 ;; CHECK-NEXT:   (then
 ;; CHECK-NEXT:    (return
 ;; CHECK-NEXT:     (i32.const 1)
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (call $throws
 ;; CHECK-NEXT:   (local.get $0)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (unreachable)
 ;; CHECK-NEXT: )
 (func $caller (export "caller") (param $x i32) (result i32)
  (local $y (ref eq))
  (if
   (local.get $x)
   (then
    (return
     (i32.const 1)
    )
   )
  )
  (local.set $y
   (call $throws
    (local.get $x)
   )
  )
  (i31.get_s
   (ref.cast (ref i31)
    (local.get $y)
   )
  )
 )

 ;; Each of the other functions is called from a separate function.
 ;; NOOPT:      (func $call-traps (type $0) (result i32)
 ;; NOOPT-NEXT:  (ref.is_null
 ;; NOOPT-NEXT:   (call $traps)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $call-traps (type $0) (result i32)
 ;; CHECK-NEXT:  (call $traps)
 ;; CHECK-NEXT:  (unreachable)
 ;; CHECK-NEXT: )
 (func $call-traps (export "call-traps") (result i32)
  (ref.is_null
   (call $traps)
  )
 )

 ;; NOOPT:      (func $call-loops (type $0) (result i32)
 ;; NOOPT-NEXT:  (ref.is_null
 ;; NOOPT-NEXT:   (call $loops)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $call-loops (type $0) (result i32)
 ;; CHECK-NEXT:  (call $loops)
 ;; CHECK-NEXT:  (unreachable)
 ;; CHECK-NEXT: )
 (func $call-loops (export "call-loops") (result i32)
  (ref.is_null
   (call $loops)
  )
 )

 ;; NOOPT:      (func $call-func (type $0) (result i32)
 ;; NOOPT-NEXT:  (ref.is_null
 ;; NOOPT-NEXT:   (call $func)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $call-func (type $0) (result i32)
 ;; CHECK-NEXT:  (call $func)
 ;; CHECK-NEXT:  (unreachable)
 ;; CHECK-NEXT: )
 (func $call-func (export "call-func") (result i32)
  (ref.is_null
   (call $func)
  )
 )

 ;; NOOPT:      (func $call-extern (type $0) (result i32)
 ;; NOOPT-NEXT:  (ref.is_null
 ;; NOOPT-NEXT:   (call $extern)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $call-extern (type $0) (result i32)
 ;; CHECK-NEXT:  (call $extern)
 ;; CHECK-NEXT:  (unreachable)
 ;; CHECK-NEXT: )
 (func $call-extern (export "call-extern") (result i32)
  (ref.is_null
   (call $extern)
  )
 )

 ;; NOOPT:      (func $call-tuple (type $0) (result i32)
 ;; NOOPT-NEXT:  (ref.is_null
 ;; NOOPT-NEXT:   (tuple.extract 2 0
 ;; NOOPT-NEXT:    (call $tuple)
 ;; NOOPT-NEXT:   )
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $call-tuple (type $0) (result i32)
 ;; CHECK-NEXT:  (ref.is_null
 ;; CHECK-NEXT:   (tuple.extract 2 0
 ;; CHECK-NEXT:    (call $tuple)
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $call-tuple (export "call-tuple") (result i32)
  (ref.is_null
   (tuple.extract 2 0
    (call $tuple)
   )
  )
 )
)

;; A chain of tail calls: $gV only throws, $e2 either returns an i31 or
;; tail-calls $gV, and $kG either returns an i31 or tail-calls $e2. $gV is
;; refined to (ref none), and then $e2 and $kG to (ref i31).
(module
 ;; NOOPT:      (type $0 (func (result (ref none))))

 ;; NOOPT:      (type $1 (func (param i32) (result (ref i31))))

 ;; NOOPT:      (type $2 (func (param (ref eq))))

 ;; NOOPT:      (type $3 (func (param i32) (result i32)))

 ;; NOOPT:      (global $msg (ref eq) (ref.i31
 ;; NOOPT-NEXT:  (i32.const 7)
 ;; NOOPT-NEXT: ))

 ;; NOOPT:      (tag $exn (type $2) (param (ref eq)))
 ;; CHECK:      (type $0 (func (result (ref none))))

 ;; CHECK:      (type $1 (func (param i32) (result (ref i31))))

 ;; CHECK:      (type $2 (func (param (ref eq))))

 ;; CHECK:      (type $3 (func (param i32) (result i32)))

 ;; CHECK:      (global $msg (ref eq) (ref.i31
 ;; CHECK-NEXT:  (i32.const 7)
 ;; CHECK-NEXT: ))

 ;; CHECK:      (tag $exn (type $2) (param (ref eq)))
 (tag $exn (param (ref eq)))

 (global $msg (ref eq) (ref.i31 (i32.const 7)))

 ;; NOOPT:      (export "user" (func $user))

 ;; NOOPT:      (func $gV (type $0) (result (ref none))
 ;; NOOPT-NEXT:  (local $0 (ref eq))
 ;; NOOPT-NEXT:  (local.set $0
 ;; NOOPT-NEXT:   (global.get $msg)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT:  (throw $exn
 ;; NOOPT-NEXT:   (local.get $0)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (export "user" (func $user))

 ;; CHECK:      (func $gV (type $0) (result (ref none))
 ;; CHECK-NEXT:  (throw $exn
 ;; CHECK-NEXT:   (global.get $msg)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $gV (param $0 (ref eq)) (result (ref eq))
  (throw $exn
   (local.get $0)
  )
 )

 ;; NOOPT:      (func $e2 (type $1) (param $0 i32) (result (ref i31))
 ;; NOOPT-NEXT:  (if
 ;; NOOPT-NEXT:   (local.get $0)
 ;; NOOPT-NEXT:   (then
 ;; NOOPT-NEXT:    (return
 ;; NOOPT-NEXT:     (ref.i31
 ;; NOOPT-NEXT:      (i32.const 0)
 ;; NOOPT-NEXT:     )
 ;; NOOPT-NEXT:    )
 ;; NOOPT-NEXT:   )
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT:  (return_call $gV)
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $e2 (type $1) (param $0 i32) (result (ref i31))
 ;; CHECK-NEXT:  (if
 ;; CHECK-NEXT:   (local.get $0)
 ;; CHECK-NEXT:   (then
 ;; CHECK-NEXT:    (return
 ;; CHECK-NEXT:     (ref.i31
 ;; CHECK-NEXT:      (i32.const 0)
 ;; CHECK-NEXT:     )
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (return_call $gV)
 ;; CHECK-NEXT: )
 (func $e2 (param $0 i32) (result (ref eq))
  (if
   (local.get $0)
   (then
    (return
     (ref.i31
      (i32.const 0)
     )
    )
   )
  )
  (return_call $gV
   (global.get $msg)
  )
 )

 ;; NOOPT:      (func $kG (type $1) (param $0 i32) (result (ref i31))
 ;; NOOPT-NEXT:  (if
 ;; NOOPT-NEXT:   (i32.eqz
 ;; NOOPT-NEXT:    (local.get $0)
 ;; NOOPT-NEXT:   )
 ;; NOOPT-NEXT:   (then
 ;; NOOPT-NEXT:    (return
 ;; NOOPT-NEXT:     (ref.i31
 ;; NOOPT-NEXT:      (i32.const 1)
 ;; NOOPT-NEXT:     )
 ;; NOOPT-NEXT:    )
 ;; NOOPT-NEXT:   )
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT:  (return_call $e2
 ;; NOOPT-NEXT:   (local.get $0)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $kG (type $1) (param $0 i32) (result (ref i31))
 ;; CHECK-NEXT:  (if
 ;; CHECK-NEXT:   (i32.eqz
 ;; CHECK-NEXT:    (local.get $0)
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:   (then
 ;; CHECK-NEXT:    (return
 ;; CHECK-NEXT:     (ref.i31
 ;; CHECK-NEXT:      (i32.const 1)
 ;; CHECK-NEXT:     )
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (return_call $e2
 ;; CHECK-NEXT:   (local.get $0)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $kG (param $0 i32) (result (ref eq))
  (if
   (i32.eqz
    (local.get $0)
   )
   (then
    (return
     (ref.i31
      (i32.const 1)
     )
    )
   )
  )
  (return_call $e2
   (local.get $0)
  )
 )

 ;; This function only tail-calls $gV, so it is refined to (ref none) as well.
 ;; NOOPT:      (func $only-tail (type $0) (result (ref none))
 ;; NOOPT-NEXT:  (return_call $gV)
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $only-tail (type $0) (result (ref none))
 ;; CHECK-NEXT:  (return_call $gV)
 ;; CHECK-NEXT: )
 (func $only-tail (result (ref eq))
  (return_call $gV
   (global.get $msg)
  )
 )

 ;; NOOPT:      (func $user (type $3) (param $0 i32) (result i32)
 ;; NOOPT-NEXT:  (i32.add
 ;; NOOPT-NEXT:   (i31.get_s
 ;; NOOPT-NEXT:    (ref.cast (ref i31)
 ;; NOOPT-NEXT:     (call $kG
 ;; NOOPT-NEXT:      (local.get $0)
 ;; NOOPT-NEXT:     )
 ;; NOOPT-NEXT:    )
 ;; NOOPT-NEXT:   )
 ;; NOOPT-NEXT:   (i31.get_s
 ;; NOOPT-NEXT:    (ref.cast (ref none)
 ;; NOOPT-NEXT:     (call $only-tail)
 ;; NOOPT-NEXT:    )
 ;; NOOPT-NEXT:   )
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $user (type $3) (param $0 i32) (result i32)
 ;; CHECK-NEXT:  (i32.add
 ;; CHECK-NEXT:   (i31.get_s
 ;; CHECK-NEXT:    (call $kG
 ;; CHECK-NEXT:     (local.get $0)
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:   (block
 ;; CHECK-NEXT:    (drop
 ;; CHECK-NEXT:     (call $only-tail)
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:    (i31.get_s
 ;; CHECK-NEXT:     (unreachable)
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $user (export "user") (param $0 i32) (result i32)
  (i32.add
   (i31.get_s
    (ref.cast (ref i31)
     (call $kG
      (local.get $0)
     )
    )
   )
   (i31.get_s
    (ref.cast (ref i31)
     (call $only-tail)
    )
   )
  )
 )
)

;; Negative cases: functions that are exported or referenced cannot be
;; refined, as we do not see all their calls.
(module
 ;; NOOPT:      (type $0 (func (result (ref eq))))

 ;; NOOPT:      (type $1 (func (result (ref func))))

 ;; NOOPT:      (elem declare func $referenced)
 ;; CHECK:      (type $0 (func (result (ref eq))))

 ;; CHECK:      (type $1 (func (result (ref func))))

 ;; CHECK:      (elem declare func $referenced)
 (elem declare func $referenced)

 ;; NOOPT:      (export "exported" (func $exported))

 ;; NOOPT:      (export "user" (func $user))

 ;; NOOPT:      (func $exported (type $0) (result (ref eq))
 ;; NOOPT-NEXT:  (unreachable)
 ;; NOOPT-NEXT: )
 ;; CHECK:      (export "exported" (func $exported))

 ;; CHECK:      (export "user" (func $user))

 ;; CHECK:      (func $exported (type $0) (result (ref eq))
 ;; CHECK-NEXT:  (unreachable)
 ;; CHECK-NEXT: )
 (func $exported (export "exported") (result (ref eq))
  (unreachable)
 )

 ;; NOOPT:      (func $referenced (type $0) (result (ref eq))
 ;; NOOPT-NEXT:  (unreachable)
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $referenced (type $0) (result (ref eq))
 ;; CHECK-NEXT:  (unreachable)
 ;; CHECK-NEXT: )
 (func $referenced (result (ref eq))
  (unreachable)
 )

 ;; NOOPT:      (func $user (type $1) (result (ref func))
 ;; NOOPT-NEXT:  (drop
 ;; NOOPT-NEXT:   (call $exported)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT:  (drop
 ;; NOOPT-NEXT:   (call $referenced)
 ;; NOOPT-NEXT:  )
 ;; NOOPT-NEXT:  (ref.func $referenced)
 ;; NOOPT-NEXT: )
 ;; CHECK:      (func $user (type $1) (result (ref func))
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (call $exported)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (call $referenced)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (ref.func $referenced)
 ;; CHECK-NEXT: )
 (func $user (export "user") (result (ref func))
  (drop
   (call $exported)
  )
  (drop
   (call $referenced)
  )
  (ref.func $referenced)
 )
)
