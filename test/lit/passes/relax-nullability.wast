;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt -all --relax-nullability -S -o - | filecheck %s

;; Locals, params, and blocks are relaxed.
(module
  ;; CHECK:      (type $struct (struct))
  (type $struct (struct))

  ;; CHECK:      (type $1 (func (result (ref any))))

  ;; CHECK:      (type $2 (func (param anyref (ref null $struct)) (result (ref any))))

  ;; CHECK:      (type $3 (func (result anyref)))

  ;; CHECK:      (type $4 (func (param i32) (result (ref any))))

  ;; CHECK:      (type $5 (func (param i32 anyref anyref) (result (ref any))))

  ;; CHECK:      (type $6 (func (param anyref) (result (ref any))))

  ;; CHECK:      (type $7 (func (param anyref)))

  ;; CHECK:      (func $relax-sig (type $2) (param $ref anyref) (param $1 (ref null $struct)) (result (ref any))
  ;; CHECK-NEXT:  (ref.as_non_null
  ;; CHECK-NEXT:   (local.get $ref)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $relax-sig (param $ref (ref any)) (param (ref $struct)) (result (ref any))
    ;; Parameters and results relaxed to nullable
    (local.get $ref)
  )

  ;; CHECK:      (func $relax-locals (type $3) (result anyref)
  ;; CHECK-NEXT:  (local $a anyref)
  ;; CHECK-NEXT:  (local $s (ref null $struct))
  ;; CHECK-NEXT:  (local $i32 i32)
  ;; CHECK-NEXT:  (local.set $s
  ;; CHECK-NEXT:   (struct.new_default $struct)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $a
  ;; CHECK-NEXT:   (local.get $s)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $a)
  ;; CHECK-NEXT: )
  (func $relax-locals (result anyref)
    ;; Locals relaxed to nullable
    (local $a (ref any))
    (local $s (ref $struct))
    (local $i32 i32)
    (local.set $s (struct.new $struct))
    (local.set $a (local.get $s))
    (local.get $a)
  )

  ;; CHECK:      (func $relax-local-tee (type $1) (result (ref any))
  ;; CHECK-NEXT:  (local $s (ref null $struct))
  ;; CHECK-NEXT:  (ref.as_non_null
  ;; CHECK-NEXT:   (local.tee $s
  ;; CHECK-NEXT:    (struct.new_default $struct)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $relax-local-tee (result (ref any))
    (local $s (ref $struct))
    (local.tee $s (struct.new $struct))
  )

  ;; CHECK:      (func $relax-control-flow (type $4) (param $cond i32) (result (ref any))
  ;; CHECK-NEXT:  (local $l anyref)
  ;; CHECK-NEXT:  (ref.as_non_null
  ;; CHECK-NEXT:   (block (result anyref)
  ;; CHECK-NEXT:    (local.set $l
  ;; CHECK-NEXT:     (ref.i31
  ;; CHECK-NEXT:      (i32.const 1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (if (result anyref)
  ;; CHECK-NEXT:     (local.get $cond)
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (struct.new_default $struct)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (else
  ;; CHECK-NEXT:      (local.get $l)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $relax-control-flow (param $cond i32) (result (ref any))
    ;; Control flow re-finalization
    (local $l (ref any))
    (local.set $l (ref.i31 (i32.const 1)))
    (if (result (ref any))
      (local.get $cond)
      (then
        (struct.new $struct)
      )
      (else
        (local.get $l)
      )
    )
  )

  ;; CHECK:      (func $relax-block-loop (type $1) (result (ref any))
  ;; CHECK-NEXT:  (local $l (ref null $struct))
  ;; CHECK-NEXT:  (ref.as_non_null
  ;; CHECK-NEXT:   (block (result (ref null $struct))
  ;; CHECK-NEXT:    (local.set $l
  ;; CHECK-NEXT:     (struct.new_default $struct)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (block (result (ref null $struct))
  ;; CHECK-NEXT:     (loop (result (ref null $struct))
  ;; CHECK-NEXT:      (local.get $l)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $relax-block-loop (result (ref any))
    ;; Blocks and loops
    (local $l (ref $struct))
    (local.set $l (struct.new $struct))
    (block (result (ref $struct))
      (loop (result (ref $struct))
        (local.get $l)
      )
    )
  )

  ;; CHECK:      (func $relax-select (type $5) (param $cond i32) (param $a anyref) (param $b anyref) (result (ref any))
  ;; CHECK-NEXT:  (ref.as_non_null
  ;; CHECK-NEXT:   (select (result anyref)
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:    (local.get $b)
  ;; CHECK-NEXT:    (local.get $cond)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $relax-select (param $cond i32) (param $a (ref any)) (param $b (ref any)) (result (ref any))
    ;; Select re-finalization
    (select (result (ref any))
      (local.get $a)
      (local.get $b)
      (local.get $cond)
    )
  )

  ;; CHECK:      (func $caller (type $6) (param $x anyref) (result (ref any))
  ;; CHECK-NEXT:  (call $relax-sig
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (struct.new_default $struct)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $caller (param $x (ref any)) (result (ref any))
    ;; Internal call between relaxed functions: no casts needed
    (call $relax-sig (local.get $x) (struct.new $struct))
  )

  ;; CHECK:      (func $preserves-existing-cast (type $7) (param $ref anyref)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $relax-sig
  ;; CHECK-NEXT:    (ref.as_non_null
  ;; CHECK-NEXT:     (local.get $ref)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (struct.new_default $struct)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $preserves-existing-cast (param $ref anyref)
    ;; Existing casts in caller are preserved even when callee is relaxed to accept nullable
    (drop (call $relax-sig (ref.as_non_null (local.get $ref)) (struct.new $struct)))
  )
)

(module
  (type $struct (struct))
  ;; CHECK:      (type $shared-sig (func (param (ref any)) (result (ref any))))

  ;; CHECK:      (type $1 (func (param anyref)))

  ;; CHECK:      (type $struct-with-nonnull (struct (field (mut (ref any)))))
  (type $struct-with-nonnull (struct (field (mut (ref any)))))

  (type $shared-sig (func (param (ref any)) (result (ref any))))

  ;; Imported function sharing signature with an unrelaxable function (cannot be relaxed)
  ;; CHECK:      (type $3 (func))

  ;; CHECK:      (type $4 (func (param (ref any))))

  ;; CHECK:      (type $5 (func (result i32)))

  ;; CHECK:      (type $6 (func (param anyref) (result (ref any))))

  ;; CHECK:      (import "" "" (func $imported-not-relaxed (type $shared-sig) (param (ref any)) (result (ref any))))
  (import "" "" (func $imported-not-relaxed (type $shared-sig) (param (ref any)) (result (ref any))))

  ;; CHECK:      (global $g (mut (ref any)) (ref.i31
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: ))
  (global $g (mut (ref any)) (ref.i31 (i32.const 0)))

  ;; CHECK:      (table $0 1 1 funcref)

  ;; CHECK:      (elem $0 (i32.const 0) $referenced-via-table-not-relaxed)

  ;; CHECK:      (elem declare func $referenced-not-relaxed)

  ;; CHECK:      (tag $tag (type $4) (param (ref any)))
  (tag $tag (param (ref any)))

  (table 1 1 funcref)

  ;; CHECK:      (export "exported-not-relaxed" (func $exported-not-relaxed))

  ;; CHECK:      (export "" (func $unrelaxable-with-no-relaxable-imports-short-circuits))

  ;; CHECK:      (func $exported-not-relaxed (type $shared-sig) (param $ref (ref any)) (result (ref any))
  ;; CHECK-NEXT:  (local $l anyref)
  ;; CHECK-NEXT:  (ref.as_non_null
  ;; CHECK-NEXT:   (block (result anyref)
  ;; CHECK-NEXT:    (local.set $l
  ;; CHECK-NEXT:     (local.get $ref)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (local.tee $ref
  ;; CHECK-NEXT:      (local.get $ref)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $l)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $exported-not-relaxed (export "exported-not-relaxed") (param $ref (ref any)) (result (ref any))
    ;; Function is exported, so we can't mutate its signature. Relax its locals
    ;; but not its params.
    (local $l (ref any))
    (local.set $l (local.get $ref))

    ;; no-op tee for code coverage. Not relaxed.
    (drop (local.tee $ref (local.get $ref)))

    (local.get $l)
  )

  ;; CHECK:      (func $referenced-not-relaxed (type $shared-sig) (param $ref (ref any)) (result (ref any))
  ;; CHECK-NEXT:  (local $l anyref)
  ;; CHECK-NEXT:  (ref.as_non_null
  ;; CHECK-NEXT:   (block (result anyref)
  ;; CHECK-NEXT:    (local.set $l
  ;; CHECK-NEXT:     (local.get $ref)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $l)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $referenced-not-relaxed (type $shared-sig) (param $ref (ref any)) (result (ref any))
    ;; Function referenced via ref.func. Relax its locals but not its params.
    (local $l (ref any))
    (local.set $l (local.get $ref))
    (local.get $l)
  )

  ;; CHECK:      (func $referenced-via-table-not-relaxed (type $shared-sig) (param $ref (ref any)) (result (ref any))
  ;; CHECK-NEXT:  (local $l anyref)
  ;; CHECK-NEXT:  (ref.as_non_null
  ;; CHECK-NEXT:   (block (result anyref)
  ;; CHECK-NEXT:    (local.set $l
  ;; CHECK-NEXT:     (local.get $ref)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $l)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $referenced-via-table-not-relaxed (type $shared-sig) (param $ref (ref any)) (result (ref any))
    ;; Function referenced via elem declare. Relax its locals but not its
    ;; params.
    (local $l (ref any))
    (local.set $l (local.get $ref))
    (local.get $l)
  )

  ;; CHECK:      (func $unrelaxable-with-no-relaxable-imports-short-circuits (type $5) (result i32)
  ;; CHECK-NEXT:  (local $l i32)
  ;; CHECK-NEXT:  (local.get $l)
  ;; CHECK-NEXT: )
  (func $unrelaxable-with-no-relaxable-imports-short-circuits (export "") (result i32)
    ;; Coverage: The params weren't relaxed and no locals are relaxable. We can
    ;; short-circuit and skip traversing the function body at all
    (local $l i32)
    (local.get $l)
  )

  (elem (i32.const 0) $referenced-via-table-not-relaxed)

  ;; CHECK:      (func $takes-ref (type $3)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.func $referenced-not-relaxed)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $takes-ref
    (drop (ref.func $referenced-not-relaxed))
  )

  ;; CHECK:      (func $shares-type (type $6) (param $ref anyref) (result (ref any))
  ;; CHECK-NEXT:  (ref.as_non_null
  ;; CHECK-NEXT:   (local.get $ref)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $shares-type (type $shared-sig) (param $ref (ref any)) (result (ref any))
    ;; Shares a signature with $referenced, but still relaxable by giving this
    ;; a new heaptype rather than referencing the existing public heaptype.
    (local.get $ref)
  )

  ;; CHECK:      (func $calls-insert-nonnull (type $1) (param $x anyref)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $imported-not-relaxed
  ;; CHECK-NEXT:    (ref.as_non_null
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $exported-not-relaxed
  ;; CHECK-NEXT:    (ref.as_non_null
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $referenced-not-relaxed
  ;; CHECK-NEXT:    (ref.as_non_null
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $referenced-via-table-not-relaxed
  ;; CHECK-NEXT:    (ref.as_non_null
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $calls-insert-nonnull (param $x (ref any))
    ;; Calling unrelaxed functions from relaxed context inserts ref.as_non_null
    (drop (call $imported-not-relaxed (local.get $x)))
    (drop (call $exported-not-relaxed (local.get $x)))
    (drop (call $referenced-not-relaxed (local.get $x)))
    (drop (call $referenced-via-table-not-relaxed (local.get $x)))
  )

  ;; CHECK:      (func $throw-inserts-nonnull (type $1) (param $x anyref)
  ;; CHECK-NEXT:  (throw $tag
  ;; CHECK-NEXT:   (ref.as_non_null
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $throw-inserts-nonnull (param $x (ref any))
    (throw $tag (local.get $x))
  )

  ;; CHECK:      (func $struct-inserts-nonnull (type $1) (param $x anyref)
  ;; CHECK-NEXT:  (local $s (ref null $struct-with-nonnull))
  ;; CHECK-NEXT:  (local.set $s
  ;; CHECK-NEXT:   (struct.new $struct-with-nonnull
  ;; CHECK-NEXT:    (ref.as_non_null
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.set $struct-with-nonnull 0
  ;; CHECK-NEXT:   (local.get $s)
  ;; CHECK-NEXT:   (ref.as_non_null
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $struct-inserts-nonnull (param $x (ref any))
    (local $s (ref $struct-with-nonnull))
    (local.set $s (struct.new $struct-with-nonnull (local.get $x)))
    (struct.set $struct-with-nonnull 0 (local.get $s) (local.get $x))
  )

  ;; CHECK:      (func $global-set-inserts-nonnull (type $1) (param $ref anyref)
  ;; CHECK-NEXT:  (global.set $g
  ;; CHECK-NEXT:   (ref.as_non_null
  ;; CHECK-NEXT:    (local.get $ref)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $global-set-inserts-nonnull (param $ref (ref any))
    (global.set $g (local.get $ref))
  )

  ;; CHECK:      (func $call-unreachable (type $3)
  ;; CHECK-NEXT:  (block ;; (replaces unreachable CallRef we can't emit)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (ref.i31
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $call-unreachable
    ;; no need to relax a call to unreachable even though the signature
    ;; demands it.
    (call_ref $shared-sig (ref.i31 (i32.const 1)) (unreachable))
  )
)

;; subtyping
(module
  ;; CHECK:      (type $super (sub (func (param (ref any)))))
  (type $super (sub (func (param (ref any)))))
  (type $sub (sub $super (func (param (ref any)))))

  ;; CHECK:      (type $1 (func (param anyref)))

  ;; CHECK:      (export "super-func" (func $super-func))

  ;; CHECK:      (func $super-func (type $super) (param $0 (ref any))
  ;; CHECK-NEXT: )
  (func $super-func (export "super-func") (type $super) (param (ref any))
    ;; Referenced, not relaxed.
  )

  ;; CHECK:      (func $sub-func (type $1) (param $0 anyref)
  ;; CHECK-NEXT: )
  (func $sub-func (type $sub) (param (ref any))
    ;; Although $super-func is referenced, $sub-func is not and we don't need
    ;; to preserve the subtyping relationship. Assign it a brand new relaxed
    ;; type that doesn't participate in subtyping.
  )
)
