  ;; UNSHARED-NEXT:  )
  ;; UNSHARED-NEXT: )

  ;; UNSHARED:      (func $exported_func (type $sig) (param $f i31ref) (param $e i31ref) (result anyref)
  ;; UNSHARED-NEXT:  (call $extern_to_any
  ;; UNSHARED-NEXT:   (call $index_to_extern
  ;; UNSHARED-NEXT:    (local.get $e)
  ;; UNSHARED-NEXT:   )
  ;; UNSHARED-NEXT:  )
  ;; UNSHARED-NEXT: )
  ;; KEEP-EXTERNS:      (func $exported_func (type $sig) (param $f i31ref) (param $e externref) (result anyref)
  ;; KEEP-EXTERNS-NEXT:  (any.convert_extern
  ;; KEEP-EXTERNS-NEXT:   (local.get $e)
  ;; KEEP-EXTERNS-NEXT:  )
  ;; KEEP-EXTERNS-NEXT: )
  (func $exported_func (param $f funcref) (param $e externref) (result anyref)
    ;; Exported function taking funcref and externref and returning anyref.
    (any.convert_extern
      (local.get $e)
    )
  )

  ;; SHARED:      (func $basic-types (type $5) (param $a (ref null $array))
  ;; SHARED-NEXT:  (local $nf (ref null (shared none)))
  ;; SHARED-NEXT:  (local $ne (ref null (shared none)))
  ;; SHARED-NEXT:  (local $str (ref null (shared i31)))
  ;; SHARED-NEXT:  (local $eq (ref null (shared eq)))
  ;; SHARED-NEXT:  (nop)
  ;; SHARED-NEXT: )
  ;; UNSHARED:      (func $basic-types (type $5) (param $a (ref null $array))
  ;; UNSHARED-NEXT:  (local $nf nullref)
  ;; UNSHARED-NEXT:  (local $ne nullref)
  ;; UNSHARED-NEXT:  (local $str i31ref)
  ;; UNSHARED-NEXT:  (local $eq eqref)
  ;; UNSHARED-NEXT:  (nop)
  ;; UNSHARED-NEXT: )
  ;; KEEP-EXTERNS:      (func $basic-types (type $5) (param $a (ref null $array))
  ;; KEEP-EXTERNS-NEXT:  (local $nf nullref)
  ;; KEEP-EXTERNS-NEXT:  (local $ne nullexternref)
  ;; KEEP-EXTERNS-NEXT:  (local $str stringref)
  ;; KEEP-EXTERNS-NEXT:  (local $eq eqref)
  ;; KEEP-EXTERNS-NEXT:  (nop)
  ;; KEEP-EXTERNS-NEXT: )
  (func $basic-types (param $a (ref null $array))
    ;; Test lowering of array and basic heap types in parameters and locals.
    (local $nf nullfuncref)
    (local $ne nullexternref)
    (local $str stringref)
    (local $eq eqref)
    (nop)
  )

  ;; SHARED:      (func $ref-func-and-global (type $6) (param $s (ref $struct))
  ;; SHARED-NEXT:  (struct.set $struct 0
  ;; SHARED-NEXT:   (local.get $s)
  ;; SHARED-NEXT:   (ref.i31_shared
  ;; SHARED-NEXT:    (i32.const 0)
  ;; SHARED-NEXT:   )
  ;; SHARED-NEXT:  )
  ;; SHARED-NEXT:  (struct.set $struct 1
  ;; SHARED-NEXT:   (local.get $s)
  ;; SHARED-NEXT:   (global.get $imported_global)
  ;; SHARED-NEXT:  )
  ;; SHARED-NEXT: )
  ;; UNSHARED:      (func $ref-func-and-global (type $6) (param $s (ref $struct))
  ;; UNSHARED-NEXT:  (struct.set $struct 0
  ;; UNSHARED-NEXT:   (local.get $s)
  ;; UNSHARED-NEXT:   (ref.i31
  ;; UNSHARED-NEXT:    (i32.const 0)
  ;; UNSHARED-NEXT:   )
  ;; UNSHARED-NEXT:  )
  ;; UNSHARED-NEXT:  (struct.set $struct 1
  ;; UNSHARED-NEXT:   (local.get $s)
  ;; UNSHARED-NEXT:   (global.get $imported_global)
  ;; UNSHARED-NEXT:  )
  ;; UNSHARED-NEXT: )
  ;; KEEP-EXTERNS:      (func $ref-func-and-global (type $6) (param $s (ref $struct))
  ;; KEEP-EXTERNS-NEXT:  (struct.set $struct 0
  ;; KEEP-EXTERNS-NEXT:   (local.get $s)
  ;; KEEP-EXTERNS-NEXT:   (ref.i31
  ;; KEEP-EXTERNS-NEXT:    (i32.const 0)
  ;; KEEP-EXTERNS-NEXT:   )
  ;; KEEP-EXTERNS-NEXT:  )
  ;; KEEP-EXTERNS-NEXT:  (struct.set $struct 1
  ;; KEEP-EXTERNS-NEXT:   (local.get $s)
  ;; KEEP-EXTERNS-NEXT:   (global.get $imported_global)
  ;; KEEP-EXTERNS-NEXT:  )
  ;; KEEP-EXTERNS-NEXT: )
  (func $ref-func-and-global (param $s (ref $struct))
    ;; Store ref.func and an imported externref global into struct fields.
    (struct.set $struct 0
      (local.get $s)
      (ref.func $exported_func)
    )
    (struct.set $struct 1
      (local.get $s)
      (global.get $imported_global)
    )
  )

  ;; SHARED:      (func $call-ref (type $7) (param $s (ref $struct)) (param $f (ref (shared i31)))
  ;; SHARED-NEXT:  (struct.set $struct 2
  ;; SHARED-NEXT:   (local.get $s)
  ;; SHARED-NEXT:   (call_indirect $funcs (type $sig)
  ;; SHARED-NEXT:    (struct.get $struct 0
  ;; SHARED-NEXT:     (local.get $s)
  ;; SHARED-NEXT:    )
  ;; SHARED-NEXT:    (struct.get $struct 1
  ;; SHARED-NEXT:     (local.get $s)
  ;; SHARED-NEXT:    )
  ;; SHARED-NEXT:    (i31.get_u
  ;; SHARED-NEXT:     (local.get $f)
  ;; SHARED-NEXT:    )
  ;; SHARED-NEXT:   )
  ;; SHARED-NEXT:  )
  ;; SHARED-NEXT: )
  ;; UNSHARED:      (func $call-ref (type $7) (param $s (ref $struct)) (param $f (ref i31))
  ;; UNSHARED-NEXT:  (struct.set $struct 2
  ;; UNSHARED-NEXT:   (local.get $s)
  ;; UNSHARED-NEXT:   (call_indirect $funcs (type $sig)
  ;; UNSHARED-NEXT:    (struct.get $struct 0
  ;; UNSHARED-NEXT:     (local.get $s)
  ;; UNSHARED-NEXT:    )
  ;; UNSHARED-NEXT:    (struct.get $struct 1
  ;; UNSHARED-NEXT:     (local.get $s)
  ;; UNSHARED-NEXT:    )
  ;; UNSHARED-NEXT:    (i31.get_u
  ;; UNSHARED-NEXT:     (local.get $f)
  ;; UNSHARED-NEXT:    )
  ;; UNSHARED-NEXT:   )
  ;; UNSHARED-NEXT:  )
  ;; UNSHARED-NEXT: )
  ;; KEEP-EXTERNS:      (func $call-ref (type $7) (param $s (ref $struct)) (param $f (ref i31))
  ;; KEEP-EXTERNS-NEXT:  (struct.set $struct 2
  ;; KEEP-EXTERNS-NEXT:   (local.get $s)
  ;; KEEP-EXTERNS-NEXT:   (call_indirect $funcs (type $sig)
  ;; KEEP-EXTERNS-NEXT:    (struct.get $struct 0
  ;; KEEP-EXTERNS-NEXT:     (local.get $s)
  ;; KEEP-EXTERNS-NEXT:    )
  ;; KEEP-EXTERNS-NEXT:    (struct.get $struct 1
  ;; KEEP-EXTERNS-NEXT:     (local.get $s)
  ;; KEEP-EXTERNS-NEXT:    )
  ;; KEEP-EXTERNS-NEXT:    (i31.get_u
  ;; KEEP-EXTERNS-NEXT:     (local.get $f)
  ;; KEEP-EXTERNS-NEXT:    )
  ;; KEEP-EXTERNS-NEXT:   )
  ;; KEEP-EXTERNS-NEXT:  )
  ;; KEEP-EXTERNS-NEXT: )
  (func $call-ref (param $s (ref $struct)) (param $f (ref $sig))
    ;; Lower call_ref to call_indirect over the $funcs table.
    (struct.set $struct 2
      (local.get $s)
      (call_ref $sig
        (struct.get $struct 0
          (local.get $s)
        )
        (struct.get $struct 1
          (local.get $s)
        )
        (local.get $f)
      )
    )
  )

  ;; SHARED:      (func $call-imported-func-and-convert (type $8) (param $s (ref $struct)) (result (ref null (shared i31)))
  ;; SHARED-NEXT:  (tuple.drop 2
