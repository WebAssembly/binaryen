  ;; SHARED-NEXT:  (i32.const 0)
  ;; SHARED-NEXT: ))

  ;; SHARED:      (table $funcs 1 1 funcref)

  ;; SHARED:      (table $externs 1 externref)

  ;; SHARED:      (elem $funcs (table $funcs) (i32.const 0) func $exported_func)

  ;; SHARED:      (elem $externs (table $externs) (i32.const 0) externref (item (global.get $imported_global$import)))

  ;; SHARED:      (export "exported_func" (func $exported_func$export))

  ;; SHARED:      (func $imported_func (type $4) (param $0 (ref null (shared i31))) (param $1 (ref null (shared i31))) (result (ref null (shared i31)) (ref null (shared i31)))
  ;; SHARED-NEXT:  (local $2 (tuple (ref null (shared i31)) externref))
