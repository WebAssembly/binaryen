  ;; KEEP-EXTERNS-NEXT:  )
  ;; KEEP-EXTERNS-NEXT: )
  (func $test-tag (param $e externref) (result externref)
    ;; Throw and catch an externref tag with i31ref table conversions.
    (try (result externref)
      (do
