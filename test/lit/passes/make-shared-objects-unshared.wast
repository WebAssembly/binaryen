  ;; UNSHARED:      (func $imported_func (type $4) (param $0 i31ref) (param $1 i31ref) (result i31ref i31ref)
  ;; UNSHARED-NEXT:  (local $2 (tuple i31ref externref))
  ;; UNSHARED-NEXT:  (local.set $2
  ;; UNSHARED-NEXT:   (call $imported_func$import
  ;; UNSHARED-NEXT:    (local.get $0)
  ;; UNSHARED-NEXT:    (call $index_to_extern
  ;; UNSHARED-NEXT:     (local.get $1)
  ;; UNSHARED-NEXT:    )
  ;; UNSHARED-NEXT:   )
  ;; UNSHARED-NEXT:  )
  ;; UNSHARED-NEXT:  (tuple.make 2
  ;; UNSHARED-NEXT:   (tuple.extract 2 0
  ;; UNSHARED-NEXT:    (local.get $2)
  ;; UNSHARED-NEXT:   )
  ;; UNSHARED-NEXT:   (call $extern_to_index
  ;; UNSHARED-NEXT:    (tuple.extract 2 1
  ;; UNSHARED-NEXT:     (local.get $2)
  ;; UNSHARED-NEXT:    )
