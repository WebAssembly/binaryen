  ;; SHARED-NEXT:  (call $extern_to_any
  ;; SHARED-NEXT:   (call $index_to_extern
  ;; SHARED-NEXT:    (local.get $e)
  ;; SHARED-NEXT:   )
  ;; SHARED-NEXT:  )
  ;; SHARED-NEXT: )
  ;; UNSHARED:      (global $imported_global i31ref (ref.i31
