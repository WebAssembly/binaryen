;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt -all --closed-world --relax-nullability -S -o - | filecheck %s

(module

 ;; CHECK:      (rec
 ;; CHECK-NEXT:  (type $public-func (func (param (ref any)) (result (ref any))))

 ;; CHECK:       (type $brand (struct))

 ;; CHECK:      (rec
 ;; CHECK-NEXT:  (type $2 (func (param (ref null $public-func) anyref) (result (ref any))))

 ;; CHECK:       (type $3 (func (param (ref null $private-func) anyref) (result (ref any))))

 ;; CHECK:       (type $4 (func))

 ;; CHECK:       (type $private-func (func (param anyref) (result (ref any))))
 (type $private-func (func (param (ref any)) (result (ref any))))

 (rec
  (type $public-func (func (param (ref any)) (result (ref any))))
  (type $brand (struct))
 )

 ;; CHECK:      (type $6 (func (param anyref) (result (ref any))))

 ;; CHECK:      (elem declare func $private1 $private2 $public $public-type-but-private)

 ;; CHECK:      (export "public" (func $public))

 ;; CHECK:      (func $private1 (type $private-func) (param $ref anyref) (result (ref any))
 ;; CHECK-NEXT:  (local $l anyref)
 ;; CHECK-NEXT:  (ref.as_non_null
 ;; CHECK-NEXT:   (block (result anyref)
 ;; CHECK-NEXT:    (local.set $l
 ;; CHECK-NEXT:     (local.get $ref)
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:    (local.get $l)
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $private1 (type $private-func) (param $ref (ref any)) (result (ref any))
  (local $l (ref any))
  (local.set $l (local.get $ref))
  (local.get $l)
 )

 ;; CHECK:      (func $private2 (type $private-func) (param $ref anyref) (result (ref any))
 ;; CHECK-NEXT:  (ref.as_non_null
 ;; CHECK-NEXT:   (local.get $ref)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $private2 (type $private-func) (param $ref (ref any)) (result (ref any))
  (local.get $ref)
 )

 ;; CHECK:      (func $public (type $public-func) (param $ref (ref any)) (result (ref any))
 ;; CHECK-NEXT:  (local.get $ref)
 ;; CHECK-NEXT: )
 (func $public (export "public") (type $public-func) (param $ref (ref any)) (result (ref any))
  (local.get $ref)
 )

 ;; CHECK:      (func $public-type-but-private (type $public-func) (param $ref (ref any)) (result (ref any))
 ;; CHECK-NEXT:  (local.get $ref)
 ;; CHECK-NEXT: )
 (func $public-type-but-private (type $public-func) (param $ref (ref any)) (result (ref any))
  ;; This function has a public signature and may be called indirectly, so we
  ;; can't relax this, and we can't give it a private signature either.
  (local.get $ref)
 )

 ;; CHECK:      (func $public-type-but-not-indirectly-called (type $6) (param $ref anyref) (result (ref any))
 ;; CHECK-NEXT:  (ref.as_non_null
 ;; CHECK-NEXT:   (local.get $ref)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $public-type-but-not-indirectly-called (type $public-func) (param $ref (ref any)) (result (ref any))
  ;; This function has a public signature but is never called indirectly. We can
  ;; still relax it by giving it a new private type.
  (local.get $ref)
 )

 ;; CHECK:      (func $reference (type $4)
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $private1)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $private2)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $public)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $public-type-but-private)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $reference
  (drop (ref.func $private1))
  (drop (ref.func $private2))
  (drop (ref.func $public))
  (drop (ref.func $public-type-but-private))
 )

 ;; CHECK:      (func $calls-private (type $3) (param $f (ref null $private-func)) (param $ref anyref) (result (ref any))
 ;; CHECK-NEXT:  (call_ref $private-func
 ;; CHECK-NEXT:   (local.get $ref)
 ;; CHECK-NEXT:   (local.get $f)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $calls-private (param $f (ref $private-func)) (param $ref (ref any)) (result (ref any))
  ;; private-func was relaxed, so no need for ref.as_non_null
  (call_ref $private-func (local.get $ref) (local.get $f))
 )

 ;; CHECK:      (func $calls-public (type $2) (param $f (ref null $public-func)) (param $ref anyref) (result (ref any))
 ;; CHECK-NEXT:  (call_ref $public-func
 ;; CHECK-NEXT:   (ref.as_non_null
 ;; CHECK-NEXT:    (local.get $ref)
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:   (local.get $f)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $calls-public (param $f (ref $public-func)) (param $ref (ref any)) (result (ref any))
  ;; public-func wasn't relaxed, insert ref.as_non_null
  (call_ref $public-func (local.get $ref) (local.get $f))
 )
)

;; Public supertype with private subtype. The subtype is relaxed.
(module
 ;; CHECK:      (type $public-super (sub (func (param (ref any)))))
 (type $public-super (sub (func (param (ref any)))))
 ;; CHECK:      (rec
 ;; CHECK-NEXT:  (type $1 (func))

 ;; CHECK:       (type $private-sub (sub $public-super (func (param anyref))))
 (type $private-sub (sub $public-super (func (param (ref any)))))
 ;; CHECK:      (elem declare func $private $public)

 ;; CHECK:      (export "public" (func $public))

 ;; CHECK:      (func $public (type $public-super) (param $0 (ref any))
 ;; CHECK-NEXT: )
 (func $public (export "public") (type $public-super) (param (ref any)))


 ;; A subtype of a public func can still be relaxed if it's private.
 ;; Subtyping is preserved when relaxing.
 ;; CHECK:      (func $private (type $private-sub) (param $0 anyref)
 ;; CHECK-NEXT: )
 (func $private (type $private-sub) (param (ref any)))

 ;; CHECK:      (func $reference (type $1)
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $public)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $private)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $reference
  (drop (ref.func $public))
  (drop (ref.func $private))
 )
)

;; Public supertype with private subtype. Nothing can be relaxed.
(module
 ;; CHECK:      (type $private-super (sub (func (param (ref any)))))
 (type $private-super (sub (func (param (ref any)))))
 ;; CHECK:      (type $public-sub (sub $private-super (func (param (ref any)))))
 (type $public-sub (sub $private-super (func (param (ref any)))))
 ;; $private-super can't be relaxed since $public-sub can't be and relaxing the
 ;; supertype would make the subtyping relationship invalid.
 ;; CHECK:      (type $2 (func))

 ;; CHECK:      (elem declare func $private $public)

 ;; CHECK:      (export "public" (func $public))

 ;; CHECK:      (func $private (type $private-super) (param $0 (ref any))
 ;; CHECK-NEXT: )
 (func $private (type $private-super) (param (ref any)))

 ;; CHECK:      (func $public (type $public-sub) (param $0 (ref any))
 ;; CHECK-NEXT: )
 (func $public (export "public") (type $public-sub) (param (ref any)))

 ;; CHECK:      (func $reference (type $2)
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $public)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $private)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $reference
  (drop (ref.func $public))
  (drop (ref.func $private))
 )
)

;; Private supertype and private subtype. Both are relaxed
(module
 ;; CHECK:      (rec
 ;; CHECK-NEXT:  (type $private-super (sub (func (param anyref))))
 (type $private-super (sub (func (param (ref any)))))
 ;; CHECK:       (type $1 (func))

 ;; CHECK:       (type $private-sub (sub $private-super (func (param anyref))))
 (type $private-sub (sub $private-super (func (param (ref any)))))
 ;; CHECK:      (elem declare func $sub $super)

 ;; CHECK:      (func $super (type $private-super) (param $0 anyref)
 ;; CHECK-NEXT: )
 (func $super (type $private-super) (param (ref any)))

 ;; CHECK:      (func $sub (type $private-sub) (param $0 anyref)
 ;; CHECK-NEXT: )
 (func $sub (type $private-sub) (param (ref any)))

 ;; CHECK:      (func $reference (type $1)
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $super)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $sub)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $reference
  (drop (ref.func $super))
  (drop (ref.func $sub))
 )
)
