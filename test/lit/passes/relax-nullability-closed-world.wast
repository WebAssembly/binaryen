;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt -all --closed-world --relax-nullability -S -o - | filecheck %s

(module
  ;; CHECK:      (type $private-struct (struct (field (mut anyref))))
  (type $private-struct (struct (field (mut (ref any)))))

  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $public-struct (struct (field (mut (ref any)))))
    (type $public-struct (struct (field (mut (ref any)))))
    ;; CHECK:       (type $brand (struct))
    (type $brand (struct))
  )

  (func $public (import "" "") (param (ref $public-struct)) (result (ref $public-struct)))

  ;; CHECK:      (type $3 (func (param (ref $public-struct)) (result (ref $public-struct))))

  ;; CHECK:      (type $4 (func (param anyref)))

  ;; CHECK:      (import "" "" (func $public (type $3) (param (ref $public-struct)) (result (ref $public-struct))))

  ;; CHECK:      (func $private-is-relaxed (type $4) (param $ref anyref)
  ;; CHECK-NEXT:  (local $private-relaxed (ref null $private-struct))
  ;; CHECK-NEXT:  (local $public-not-relaxed (ref null $public-struct))
  ;; CHECK-NEXT:  (local.set $private-relaxed
  ;; CHECK-NEXT:   (struct.new $private-struct
  ;; CHECK-NEXT:    (local.get $ref)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.set $private-struct 0
  ;; CHECK-NEXT:   (local.get $private-relaxed)
  ;; CHECK-NEXT:   (local.get $ref)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $public-not-relaxed
  ;; CHECK-NEXT:   (struct.new $public-struct
  ;; CHECK-NEXT:    (ref.as_non_null
  ;; CHECK-NEXT:     (local.get $ref)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.set $public-struct 0
  ;; CHECK-NEXT:   (local.get $public-not-relaxed)
  ;; CHECK-NEXT:   (ref.as_non_null
  ;; CHECK-NEXT:    (local.get $ref)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $private-is-relaxed (param $ref (ref any))
    (local $private-relaxed (ref $private-struct))
    (local $public-not-relaxed (ref $public-struct))

    ;; The ref in the private struct is relaxed to nullable.
    ;; struct.new and struct.set don't need ref.as_non_null
    (local.set $private-relaxed (struct.new $private-struct (local.get $ref)))
    (struct.set $private-struct 0 (local.get $private-relaxed) (local.get $ref))

    ;; The public struct is not relaxed and struct.new and struct.set require
    ;; ref.as_non_null.
    (local.set $public-not-relaxed (struct.new $public-struct (local.get $ref)))
    (struct.set $public-struct 0 (local.get $public-not-relaxed) (local.get $ref))
  )
)
