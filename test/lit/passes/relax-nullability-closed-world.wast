;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt -all --closed-world --relax-nullability -S -o - | filecheck %s

(module

 ;; CHECK:      (rec
 ;; CHECK-NEXT:  (type $public-func (func (param (ref any)) (result (ref any))))

 ;; CHECK:       (type $brand (struct))

 ;; CHECK:      (rec
 ;; CHECK-NEXT:  (type $2 (func (param (ref null $public-func) anyref) (result (ref any))))

 ;; CHECK:       (type $3 (func (param (ref null $private-func) anyref) (result (ref any))))

 ;; CHECK:       (type $4 (func))

 ;; CHECK:       (type $private-func (func (param anyref) (result (ref any))))
 (type $private-func (func (param (ref any)) (result (ref any))))

 (rec
  (type $public-func (func (param (ref any)) (result (ref any))))
  (type $brand (struct))
 )

 ;; CHECK:      (type $6 (func (param anyref) (result (ref any))))

 ;; CHECK:      (elem declare func $private1 $private2 $public $public-type-but-private)

 ;; CHECK:      (export "public" (func $public))

 ;; CHECK:      (func $private1 (type $private-func) (param $ref anyref) (result (ref any))
 ;; CHECK-NEXT:  (local $l anyref)
 ;; CHECK-NEXT:  (ref.as_non_null
 ;; CHECK-NEXT:   (block (result anyref)
 ;; CHECK-NEXT:    (local.set $l
 ;; CHECK-NEXT:     (local.get $ref)
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:    (local.get $l)
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $private1 (type $private-func) (param $ref (ref any)) (result (ref any))
  ;; private function, may be relaxed
  (local $l (ref any))
  (local.set $l (local.get $ref))
  (local.get $l)
 )

 ;; CHECK:      (func $private2 (type $private-func) (param $ref anyref) (result (ref any))
 ;; CHECK-NEXT:  (ref.as_non_null
 ;; CHECK-NEXT:   (local.get $ref)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $private2 (type $private-func) (param $ref (ref any)) (result (ref any))
  ;; private function, may be relaxed
  (local.get $ref)
 )

 ;; CHECK:      (func $public (type $public-func) (param $ref (ref any)) (result (ref any))
 ;; CHECK-NEXT:  (local.get $ref)
 ;; CHECK-NEXT: )
 (func $public (export "public") (type $public-func) (param $ref (ref any)) (result (ref any))
  ;; public function, we're not allowed to change its signature.
  (local.get $ref)
 )

 ;; CHECK:      (func $public-type-but-private (type $public-func) (param $ref (ref any)) (result (ref any))
 ;; CHECK-NEXT:  (local.get $ref)
 ;; CHECK-NEXT: )
 (func $public-type-but-private (type $public-func) (param $ref (ref any)) (result (ref any))
  ;; This function has a public signature and may be called indirectly, so we
  ;; can't relax this, and we can't give it a private signature either.
  (local.get $ref)
 )

 ;; CHECK:      (func $public-type-but-not-indirectly-called (type $6) (param $ref anyref) (result (ref any))
 ;; CHECK-NEXT:  (ref.as_non_null
 ;; CHECK-NEXT:   (local.get $ref)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $public-type-but-not-indirectly-called (type $public-func) (param $ref (ref any)) (result (ref any))
  ;; This function has a public signature but is never called indirectly. We can
  ;; still relax it by giving it a new private type.
  (local.get $ref)
 )

 ;; CHECK:      (func $reference (type $4)
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $private1)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $private2)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $public)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $public-type-but-private)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $reference
  (drop (ref.func $private1))
  (drop (ref.func $private2))
  (drop (ref.func $public))
  (drop (ref.func $public-type-but-private))
 )

 ;; CHECK:      (func $calls-private (type $3) (param $f (ref null $private-func)) (param $ref anyref) (result (ref any))
 ;; CHECK-NEXT:  (call_ref $private-func
 ;; CHECK-NEXT:   (local.get $ref)
 ;; CHECK-NEXT:   (local.get $f)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $calls-private (param $f (ref $private-func)) (param $ref (ref any)) (result (ref any))
  ;; private-func was relaxed, so no need for ref.as_non_null
  (call_ref $private-func (local.get $ref) (local.get $f))
 )

 ;; CHECK:      (func $calls-public (type $2) (param $f (ref null $public-func)) (param $ref anyref) (result (ref any))
 ;; CHECK-NEXT:  (call_ref $public-func
 ;; CHECK-NEXT:   (ref.as_non_null
 ;; CHECK-NEXT:    (local.get $ref)
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:   (local.get $f)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $calls-public (param $f (ref $public-func)) (param $ref (ref any)) (result (ref any))
  ;; public-func wasn't relaxed, insert ref.as_non_null
  (call_ref $public-func (local.get $ref) (local.get $f))
 )
)

;; Public supertype with private subtype. The subtype is relaxed.
(module
 ;; CHECK:      (type $public-super (sub (func (param (ref any)))))
 (type $public-super (sub (func (param (ref any)))))
 ;; CHECK:      (rec
 ;; CHECK-NEXT:  (type $1 (func))

 ;; CHECK:       (type $private-sub (sub $public-super (func (param anyref))))
 (type $private-sub (sub $public-super (func (param (ref any)))))
 ;; CHECK:      (elem declare func $private $public)

 ;; CHECK:      (export "public" (func $public))

 ;; CHECK:      (func $public (type $public-super) (param $0 (ref any))
 ;; CHECK-NEXT: )
 (func $public (export "public") (type $public-super) (param (ref any)))


 ;; A subtype of a public func can still be relaxed if it's private.
 ;; Subtyping is preserved when relaxing.
 ;; CHECK:      (func $private (type $private-sub) (param $0 anyref)
 ;; CHECK-NEXT: )
 (func $private (type $private-sub) (param (ref any)))

 ;; CHECK:      (func $reference (type $1)
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $public)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $private)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $reference
  (drop (ref.func $public))
  (drop (ref.func $private))
 )
)

;; Public supertype with private subtype. Nothing can be relaxed.
(module
 ;; CHECK:      (type $private-super (sub (func (param (ref any)))))
 (type $private-super (sub (func (param (ref any)))))
 ;; CHECK:      (type $public-sub (sub $private-super (func (param (ref any)))))
 (type $public-sub (sub $private-super (func (param (ref any)))))
 ;; $private-super can't be relaxed since $public-sub can't be and relaxing the
 ;; supertype would make the subtyping relationship invalid.
 ;; CHECK:      (type $2 (func))

 ;; CHECK:      (elem declare func $private $public)

 ;; CHECK:      (export "public" (func $public))

 ;; CHECK:      (func $private (type $private-super) (param $0 (ref any))
 ;; CHECK-NEXT: )
 (func $private (type $private-super) (param (ref any)))

 ;; CHECK:      (func $public (type $public-sub) (param $0 (ref any))
 ;; CHECK-NEXT: )
 (func $public (export "public") (type $public-sub) (param (ref any)))

 ;; CHECK:      (func $reference (type $2)
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $public)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $private)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $reference
  (drop (ref.func $public))
  (drop (ref.func $private))
 )
)

;; Private supertype and private subtype. Both are relaxed
(module
 ;; CHECK:      (rec
 ;; CHECK-NEXT:  (type $private-super (sub (func (param anyref))))
 (type $private-super (sub (func (param (ref any)))))
 ;; CHECK:       (type $1 (func))

 ;; CHECK:       (type $private-sub (sub $private-super (func (param anyref))))
 (type $private-sub (sub $private-super (func (param (ref any)))))
 ;; CHECK:      (elem declare func $sub $super)

 ;; CHECK:      (func $super (type $private-super) (param $0 anyref)
 ;; CHECK-NEXT: )
 (func $super (type $private-super) (param (ref any)))

 ;; CHECK:      (func $sub (type $private-sub) (param $0 anyref)
 ;; CHECK-NEXT: )
 (func $sub (type $private-sub) (param (ref any)))

 ;; CHECK:      (func $reference (type $1)
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $super)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.func $sub)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $reference
  (drop (ref.func $super))
  (drop (ref.func $sub))
 )
)

(module
  ;; CHECK:      (type $0 (func (param anyref)))

  ;; CHECK:      (rec
  ;; CHECK-NEXT:  (type $super (sub (func (param (ref any)))))
  (type $super (sub (func (param (ref any)))))
  ;; CHECK:       (type $2 (func))

  ;; CHECK:       (type $3 (func (result (ref any))))

  ;; CHECK:       (type $sub-tag (sub $super (func (param (ref any)))))
  (type $sub-tag (sub $super (func (param (ref any)))))

  ;; CHECK:      (elem declare func $func-with-super-type $func-with-tag-type)

  ;; CHECK:      (tag $t (type $sub-tag) (param (ref any)))
  (tag $t (type $sub-tag))

  ;; CHECK:      (func $throws (type $3) (result (ref any))
  ;; CHECK-NEXT:  (block $catch (result (ref any))
  ;; CHECK-NEXT:   (try_table (catch $t $catch)
  ;; CHECK-NEXT:    (throw $t
  ;; CHECK-NEXT:     (ref.i31
  ;; CHECK-NEXT:      (i32.const 1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (ref.i31
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $throws (result (ref any))
    ;; tag types are not relaxed
    (block $catch (result (ref any))
      (try_table (catch $t $catch)
        (throw $t (ref.i31 (i32.const 1)))
      )
      (ref.i31 (i32.const 2))
    )
  )

  ;; CHECK:      (func $reference (type $2)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.func $func-with-tag-type)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.func $func-with-super-type)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $reference
    (drop (ref.func $func-with-tag-type))
    (drop (ref.func $func-with-super-type))
  )

  ;; CHECK:      (func $func-with-tag-type (type $sub-tag) (param $0 (ref any))
  ;; CHECK-NEXT: )
  (func $func-with-tag-type (type $sub-tag) (param (ref any))
    ;; shares a signature with a tag and therefore can't be relaxed
  )

  ;; CHECK:      (func $func-with-super-type (type $super) (param $0 (ref any))
  ;; CHECK-NEXT: )
  (func $func-with-super-type (type $super) (param (ref any))
    ;; is a supertype of a tag type and therefore can't be relaxed
  )

  ;; CHECK:      (func $func-with-tag-type-but-private (type $0) (param $0 anyref)
  ;; CHECK-NEXT: )
  (func $func-with-tag-type-but-private (type $sub-tag) (param (ref any))
    ;; this shared a signature with a tag but is private so it can be given a
    ;; new private relaxed type
  )

  ;; CHECK:      (func $func-with-super-type-but-private (type $0) (param $0 anyref)
  ;; CHECK-NEXT: )
  (func $func-with-super-type-but-private (type $super) (param (ref any))
    ;; same as above but with the supertype
  )
)

;; Do not relax continuation function signatures: cont.bind enforces structural
;; subtyping between distinct continuation signatures without nominal
;; declared subtyping, so relaxing $sig-out while $sig-in stays unrelaxable
;; causes a validation error.
(module
  ;; CHECK:      (type $sig-in (func (param i32 (ref any))))
  (type $sig-in (func (param i32 (ref any))))
  ;; CHECK:      (rec
  ;; CHECK-NEXT:  (type $super-sig-out (sub (func (param (ref any)))))

  ;; CHECK:       (type $sig-out (sub $super-sig-out (func (param (ref any)))))

  ;; CHECK:       (type $3 (func))

  ;; CHECK:       (type $sub-sig-out (sub $sig-out (func (param anyref))))

  ;; CHECK:       (type $cont-out (cont $sig-out))

  ;; CHECK:       (type $cont-in (cont $sig-in))
  (type $cont-in (cont $sig-in))

  (type $super-sig-out (sub (func (param (ref any)))))
  (type $sig-out (sub $super-sig-out (func (param (ref any)))))
  (type $sub-sig-out (sub $sig-out (func (param (ref any)))))

  (type $cont-out (cont $sig-out))

  ;; CHECK:       (type $7 (func (result (ref $cont-out))))

  ;; CHECK:      (elem declare func $f $uses-sub-sig-out $uses-super-sig-out)

  ;; CHECK:      (export "f" (func $f))

  ;; CHECK:      (func $bind (type $7) (result (ref $cont-out))
  ;; CHECK-NEXT:  (cont.bind $cont-in $cont-out
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (cont.new $cont-in
  ;; CHECK-NEXT:    (ref.func $f)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $bind (result (ref $cont-out))
    ;; The param of $cont-in flows into $cont-out, so it would be wrong to relax
    ;; $sig-in without relaxing $sig-out. Instead just give up relaxing any
    ;; types involved in continuations, or their supertypes.
    (cont.bind $cont-in $cont-out
      (i32.const 0)
      (cont.new $cont-in
        (ref.func $f)
      )
    )
  )

  ;; CHECK:      (func $f (type $sig-in) (param $i i32) (param $x (ref any))
  ;; CHECK-NEXT: )
  (func $f (export "f") (type $sig-in) (param $i i32) (param $x (ref any))
    ;; Make $sig-in unrelaxable. $sig-out is unrelaxable as a result.
  )

  ;; CHECK:      (func $uses-super-sig-out (type $super-sig-out) (param $0 (ref any))
  ;; CHECK-NEXT: )
  (func $uses-super-sig-out (type $super-sig-out) (param (ref any))
    ;; supertype of continuation type, not relaxable because the continuation
    ;; type is not relaxable and we'd break the subtype relationship.
  )

  ;; CHECK:      (func $uses-sub-sig-out (type $sub-sig-out) (param $0 anyref)
  ;; CHECK-NEXT: )
  (func $uses-sub-sig-out (type $sub-sig-out) (param (ref any))
    ;; subtype of continuation type, relaxable
  )

  ;; CHECK:      (func $reference (type $3)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.func $uses-super-sig-out)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.func $uses-sub-sig-out)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $reference
    (drop (ref.func $uses-super-sig-out))
    (drop (ref.func $uses-sub-sig-out))
  )

)
