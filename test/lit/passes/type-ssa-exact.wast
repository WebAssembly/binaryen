  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-cast (param $used (ref (exact $used-in-ref-cast)))
    (drop
      (ref.cast (ref (exact $used-in-ref-cast))
        (local.get $used)
      )
    )
    (drop
      (struct.new $used-in-ref-cast
        (ref.null none)
      )
    )
  )

