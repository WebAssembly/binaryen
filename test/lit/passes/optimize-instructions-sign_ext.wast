  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (local.get $temp)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i32-local-i16
    ;; As above with i16.
    (local $temp i32)
    (local.set $temp
      (i32.load16_s
        (i32.const 22)
      )
    )
    (drop
      (i32.extend16_s
        (local.get $temp)
      )
    )
  )

