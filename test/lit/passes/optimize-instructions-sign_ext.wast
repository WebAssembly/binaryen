  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (local.get $temp)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i32-local-i16-mismatch-good
    ;; As above with in i8/i16 mismatch, but in the direction we can handle.
    (local $temp i32)
    (local.set $temp
