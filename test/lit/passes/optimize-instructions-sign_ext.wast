  ;; CHECK-NEXT:     (local.get $y64)
  ;; CHECK-NEXT:     (i64.const 65535)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
