  (func $test-handler-elimination
    ;; Handler elimination test: dead handler blocks are removed in full
    ;; pipeline.
    (block $handler (result (ref $cont-none))
      (resume $cont-none (on $tag $handler)
        (cont.new $cont-none (ref.func $pure))
      )
      (return)
    )
    (drop)
  )

