  (func $struct-rmw-ok (param $used (ref (exact $used-in-struct-rmw-ok))) (param $ref (ref $struct-rmw-inexact))
    (drop
      ;; But this time the operand is not required to be exact.
      (struct.atomic.rmw.xchg $struct-rmw-inexact 0
        (local.get $ref)
        (local.get $used)
      )
    )
    (drop
