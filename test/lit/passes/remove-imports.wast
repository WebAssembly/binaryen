;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --remove-imports -all -S -o - | filecheck %s

;; All imports will be removed.
(module
  (import "env" "foo" (func $foo))
  (import "env" "bar" (func $bar))
  (import "other" "baz" (func $baz (result i32)))

  ;; CHECK:      (type $0 (func))

  ;; CHECK:      (func $test (type $0)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $test
    (call $foo)
    (call $bar)
    (drop
      (call $baz)
    )
  )
)
