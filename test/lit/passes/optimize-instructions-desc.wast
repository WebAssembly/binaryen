  ;; NTRAP-NEXT:  )
  ;; NTRAP-NEXT: )
  (func $cast-desc-eq-unreachable-desc
    (drop
      ;; Don't crash on an unreachable descriptor.
      (ref.cast_desc_eq (ref $struct)
        (ref.null none)
        (unreachable)
      )
    )
  )

