;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; The default pipeline runs constant-arrays-to-data only in the last set of
;; opts, as converting to array.new_data inhibits other opts.

;; RUN: wasm-opt %s -O2                               -all -S -o - | filecheck %s --check-prefix=LAST
;; RUN: wasm-opt %s -O2 --expect-later-toolchain-opts -all -S -o - | filecheck %s --check-prefix=NOT-LAST
;; RUN: wasm-opt %s -O2 --type-finalizing             -all -S -o - | filecheck %s --check-prefix=LAST
;; RUN: wasm-opt %s -O2 -O2                           -all -S -o - | filecheck %s --check-prefix=LAST

(module
  ;; LAST:      (type $i32 (array (mut i32)))
  ;; NOT-LAST:      (type $i32 (array (mut i32)))
  (type $i32 (array (mut i32)))

  ;; LAST:      (type $1 (func (result (ref $i32))))

  ;; LAST:      (data $constant-array-data "\00\ca\9a;\00l\ca\88\00\ab\90A\00\8c\86G\00m|M\00NrS\00/hY\00\10^_")

  ;; LAST:      (export "i32" (func $i32))

  ;; LAST:      (func $i32 (type $1) (result (ref $i32))
  ;; LAST-NEXT:  (array.new_data $i32 $constant-array-data
  ;; LAST-NEXT:   (i32.const 0)
  ;; LAST-NEXT:   (i32.const 8)
  ;; LAST-NEXT:  )
  ;; LAST-NEXT: )
  ;; NOT-LAST:      (type $1 (func (result (ref $i32))))

  ;; NOT-LAST:      (export "i32" (func $i32))

  ;; NOT-LAST:      (func $i32 (type $1) (result (ref $i32))
  ;; NOT-LAST-NEXT:  (array.new_fixed $i32 8
  ;; NOT-LAST-NEXT:   (i32.const 1000000000)
  ;; NOT-LAST-NEXT:   (i32.const -2000000000)
  ;; NOT-LAST-NEXT:   (i32.const 1100000000)
  ;; NOT-LAST-NEXT:   (i32.const 1200000000)
  ;; NOT-LAST-NEXT:   (i32.const 1300000000)
  ;; NOT-LAST-NEXT:   (i32.const 1400000000)
  ;; NOT-LAST-NEXT:   (i32.const 1500000000)
  ;; NOT-LAST-NEXT:   (i32.const 1600000000)
  ;; NOT-LAST-NEXT:  )
  ;; NOT-LAST-NEXT: )
  (func $i32 (export "i32") (result (ref $i32))
    (array.new_fixed $i32 8
      (i32.const 1000000000)
      (i32.const -2000000000)
      (i32.const 1100000000)
      (i32.const 1200000000)
      (i32.const 1300000000)
      (i32.const 1400000000)
      (i32.const 1500000000)
      (i32.const 1600000000)
    )
  )
)
