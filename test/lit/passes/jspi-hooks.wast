  ;; CHECK:      (export "__jspi_enter" (func $enter))

  ;; CHECK:      (export "__jspi_exit" (func $exit))

  ;; CHECK:      (export "__jspi_suspend" (func $suspend))

  ;; CHECK:      (export "__jspi_resume" (func $resume))

  ;; CHECK:      (export "main" (func $byn$jspi-hooks$export$main))

