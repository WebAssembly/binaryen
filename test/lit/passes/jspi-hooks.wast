  ;; CHECK:      (func $exit (param $0 i64) (param $1 i32)
  ;; CHECK-NEXT: )
  (func $exit (export "__jspi_exit") (param i64 i32))
  ;; CHECK:      (func $suspend (result i64)
  ;; CHECK-NEXT:  (i64.const 0)
  ;; CHECK-NEXT: )
  (func $suspend (export "__jspi_suspend") (result i64) (i64.const 0))
  ;; CHECK:      (func $resume (param $0 i64) (param $1 i32)
  ;; CHECK-NEXT: )
