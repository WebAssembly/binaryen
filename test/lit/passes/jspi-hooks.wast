(module

  ;; CHECK:      (type $0 (func (result i64)))

  ;; CHECK:      (type $1 (func (param i64 i32)))

  ;; CHECK:      (type $2 (func))

  ;; CHECK:      (type $3 (func (param externref)))

  ;; CHECK:      (import "env" "__jspi_jstag" (tag $tag (type $3) (param externref)))
