)

;; Nothing matches: the module is untouched and no hook is required.

;; CHECK:      (func $byn$jspi-hooks$export$main
;; CHECK-NEXT:  (local $0 i64)
;; CHECK-NEXT:  (local $1 exnref)
;; CHECK-NEXT:  (local.set $0
;; CHECK-NEXT:   (call $enter)
;; CHECK-NEXT:  )
