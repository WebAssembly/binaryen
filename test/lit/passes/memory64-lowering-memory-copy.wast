;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-opt --memory64-lowering --enable-memory64 --enable-multimemory --enable-bulk-memory -S -o - | filecheck %s

;; Test that memory.copy with mixed 32/64-bit memories correctly handles the
;; size operand type.
(module
  ;; CHECK:      (type $0 (func (param i64 i64 i64)))

  ;; CHECK:      (type $1 (func (param i64 i32 i32)))

  ;; CHECK:      (type $2 (func (param i32 i64 i32)))

  ;; CHECK:      (memory $m64 1)
  (memory $m64 i64 1)
  ;; CHECK:      (memory $m32 1)
  (memory $m32 1)

  ;; CHECK:      (func $copy-64-to-64 (param $dest i64) (param $src i64) (param $size i64)
  ;; CHECK-NEXT:  (memory.copy $m64 $m64
  ;; CHECK-NEXT:   (i32.wrap_i64
  ;; CHECK-NEXT:    (local.get $dest)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i32.wrap_i64
  ;; CHECK-NEXT:    (local.get $src)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i32.wrap_i64
  ;; CHECK-NEXT:    (local.get $size)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $copy-64-to-64 (param $dest i64) (param $src i64) (param $size i64)
    (memory.copy $m64 $m64
      (local.get $dest)
      (local.get $src)
      (local.get $size)
    )
  )

  ;; CHECK:      (func $copy-32-to-64 (param $dest i64) (param $src i32) (param $size i32)
  ;; CHECK-NEXT:  (memory.copy $m64 $m32
  ;; CHECK-NEXT:   (i32.wrap_i64
  ;; CHECK-NEXT:    (local.get $dest)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.get $src)
  ;; CHECK-NEXT:   (local.get $size)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $copy-32-to-64 (param $dest i64) (param $src i32) (param $size i32)
    (memory.copy $m64 $m32
      (local.get $dest)
      (local.get $src)
      (local.get $size)
    )
  )

  ;; CHECK:      (func $copy-64-to-32 (param $dest i32) (param $src i64) (param $size i32)
  ;; CHECK-NEXT:  (memory.copy $m32 $m64
  ;; CHECK-NEXT:   (local.get $dest)
  ;; CHECK-NEXT:   (i32.wrap_i64
  ;; CHECK-NEXT:    (local.get $src)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.get $size)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $copy-64-to-32 (param $dest i32) (param $src i64) (param $size i32)
    (memory.copy $m32 $m64
      (local.get $dest)
      (local.get $src)
      (local.get $size)
    )
  )
)
