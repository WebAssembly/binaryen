;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt -all --i64-to-i32-lowering -S -o - | filecheck %s

;; A return_call_indirect must keep the results of its original signature.

(module
 ;; CHECK:      (type $void (func))
 (type $void (func))
 (type $i64-param (func (param i64) (result i32)))
 (table 1 funcref)

 ;; CHECK:      (type $1 (func (result i32)))

 ;; CHECK:      (type $2 (func (param i32 i32) (result i32)))

 ;; CHECK:      (global $i64toi32_i32$HIGH_BITS (mut i32) (i32.const 0))

 ;; CHECK:      (table $0 1 funcref)

 ;; CHECK:      (func $void (type $void)
 ;; CHECK-NEXT:  (return_call_indirect $0 (type $void)
 ;; CHECK-NEXT:   (i32.const 0)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $void
  (return_call_indirect (type $void)
   (i32.const 0)
  )
 )

 ;; CHECK:      (func $i64-param (type $1) (result i32)
 ;; CHECK-NEXT:  (local $i64toi32_i32$0 i32)
 ;; CHECK-NEXT:  (return_call_indirect $0 (type $2)
 ;; CHECK-NEXT:   (block (result i32)
 ;; CHECK-NEXT:    (local.set $i64toi32_i32$0
 ;; CHECK-NEXT:     (i32.const 0)
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:    (i32.const 1)
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:   (local.get $i64toi32_i32$0)
 ;; CHECK-NEXT:   (i32.const 0)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $i64-param (result i32)
  (return_call_indirect (type $i64-param)
   (i64.const 1)
   (i32.const 0)
  )
 )
)
