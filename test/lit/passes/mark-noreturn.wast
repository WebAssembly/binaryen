;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --mark-noreturn -all -S -o - | filecheck %s

(module
 ;; CHECK:      (type $0 (func))

 ;; CHECK:      (type $1 (func (result i32)))

 ;; CHECK:      (type $2 (func (result anyref)))

 ;; CHECK:      (@binaryen.noreturn)
 ;; CHECK-NEXT: (func $none (type $0)
 ;; CHECK-NEXT:  (nop)
 ;; CHECK-NEXT: )
 (func $none
  ;; Nothing happens here.
  (nop)
 )

 ;; CHECK:      (@binaryen.noreturn)
 ;; CHECK-NEXT: (func $none-noreturn (type $0)
 ;; CHECK-NEXT:  (unreachable)
 ;; CHECK-NEXT: )
 (func $none-noreturn
  ;; This never returns, and will be annotated with @binaryen.noreturn.
  (unreachable)
 )

 ;; CHECK:      (@binaryen.noreturn)
 ;; CHECK-NEXT: (func $i32 (type $1) (result i32)
 ;; CHECK-NEXT:  (i32.const 42)
 ;; CHECK-NEXT: )
 (func $i32 (result i32)
  ;; Nothing happens here.
  (i32.const 42)
 )

 ;; CHECK:      (@binaryen.noreturn)
 ;; CHECK-NEXT: (func $i32-noreturn (type $1) (result i32)
 ;; CHECK-NEXT:  (unreachable)
 ;; CHECK-NEXT: )
 (func $i32-noreturn (result i32)
  ;; This never returns, and will be annotated with @binaryen.noreturn.
  (unreachable)
 )

 ;; CHECK:      (func $gc (type $2) (result anyref)
 ;; CHECK-NEXT:  (ref.null none)
 ;; CHECK-NEXT: )
 (func $gc (result anyref)
  ;; Nothing happens here.
  (ref.null any)
 )

 ;; CHECK:      (@binaryen.noreturn)
 ;; CHECK-NEXT: (func $gc-noreturn (type $2) (result anyref)
 ;; CHECK-NEXT:  (unreachable)
 ;; CHECK-NEXT: )
 (func $gc-noreturn (result anyref)
  ;; This never returns, and will be annotated with @binaryen.noreturn.
  (unreachable)
 )
)
