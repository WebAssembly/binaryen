  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; HP2L2:      (type $2 (func))

  ;; HP2L2:      (func $test (type $2)
  ;; HP2L2-NEXT:  (local $desc (ref $desc))
  ;; HP2L2-NEXT:  (local $func funcref)
  ;; HP2L2-NEXT:  (local $2 funcref)
  ;; HP2L2-NEXT:  (local $3 (ref (exact $desc)))
  ;; HP2L2-NEXT:  (local $4 (ref (exact $desc)))
  ;; HP2L2-NEXT:  (drop
