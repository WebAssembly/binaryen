  ;; HP2L2-NEXT:   )
  ;; HP2L2-NEXT:  )
  ;; HP2L2-NEXT: )
  (func $cast-desc-eq-success
    (local $desc (ref null (exact $super.desc)))
    (local.set $desc
      (struct.new $super.desc)
    )
    (drop
      (ref.cast_desc_eq (ref (exact $super))
        (struct.new_desc $super
          (local.get $desc)
        )
        (local.get $desc)
      )
    )
  )

