;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-opt --gsi -all --closed-world -S -o - | filecheck %s

(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $super (sub (descriptor $super.desc) (struct)))
    (type $super (sub (descriptor $super.desc) (struct)))
    ;; CHECK:       (type $super.desc (sub (describes $super) (struct)))
    (type $super.desc (sub (describes $super) (struct)))

    ;; CHECK:       (type $A (sub $super (descriptor $A.desc) (struct)))
    (type $A (sub $super (descriptor $A.desc) (struct)))
    ;; CHECK:       (type $A.desc (sub $super.desc (describes $A) (struct)))
    (type $A.desc (sub $super.desc (describes $A) (struct)))

    ;; CHECK:       (type $B (sub $super (descriptor $B.desc) (struct)))
    (type $B (sub $super (descriptor $B.desc) (struct)))
    ;; CHECK:       (type $B.desc (sub $super.desc (describes $B) (struct)))
    (type $B.desc (sub $super.desc (describes $B) (struct)))

    ;; CHECK:       (type $two (sub (descriptor $two.desc) (struct)))
    (type $two (sub (descriptor $two.desc) (struct)))
    ;; CHECK:       (type $two.desc (sub (describes $two) (struct)))
    (type $two.desc (sub (describes $two) (struct)))

    ;; CHECK:       (type $three (sub (descriptor $three.desc) (struct)))
    (type $three (sub (descriptor $three.desc) (struct)))
    ;; CHECK:       (type $three.desc (sub (describes $three) (struct)))
    (type $three.desc (sub (describes $three) (struct)))
  )

  ;; CHECK:      (type $10 (func (param (ref $super) (ref $A) (ref $B))))

  ;; CHECK:      (type $11 (func (param (ref $two) (ref $three))))

  ;; CHECK:      (global $A.unnested.desc (ref (exact $A.desc)) (struct.new_default $A.desc))

  ;; CHECK:      (global $A (ref $A) (struct.new_default_desc $A
  ;; CHECK-NEXT:  (global.get $A.unnested.desc)
  ;; CHECK-NEXT: ))
  (global $A (ref $A) (struct.new_desc $A
    (struct.new $A.desc)
  ))

  ;; CHECK:      (global $B.unnested.desc (ref (exact $B.desc)) (struct.new_default $B.desc))

  ;; CHECK:      (global $two.unnested.desc (ref (exact $two.desc)) (struct.new_default $two.desc))

  ;; CHECK:      (global $two2.unnested.desc (ref (exact $two.desc)) (struct.new_default $two.desc))

  ;; CHECK:      (global $B (ref $B) (struct.new_default_desc $B
  ;; CHECK-NEXT:  (global.get $B.unnested.desc)
  ;; CHECK-NEXT: ))
  (global $B (ref $B) (struct.new_desc $B
    (struct.new $B.desc)
  ))

  ;; CHECK:      (global $two (ref $two) (struct.new_default_desc $two
  ;; CHECK-NEXT:  (global.get $two.unnested.desc)
  ;; CHECK-NEXT: ))
  (global $two (ref $two) (struct.new_desc $two
    (struct.new $two.desc)
  ))

  ;; CHECK:      (global $two2 (ref $two) (struct.new_default_desc $two
  ;; CHECK-NEXT:  (global.get $two2.unnested.desc)
  ;; CHECK-NEXT: ))
  (global $two2 (ref $two) (struct.new_desc $two
    (struct.new $two.desc)
  ))

  ;; CHECK:      (global $three (ref $three) (struct.new_default_desc $three
  ;; CHECK-NEXT:  (struct.new_default $three.desc)
  ;; CHECK-NEXT: ))
  (global $three (ref $three) (struct.new_desc $three
    (struct.new $three.desc)
  ))

  ;; CHECK:      (global $three2 (ref $three) (struct.new_default_desc $three
  ;; CHECK-NEXT:  (struct.new_default $three.desc)
  ;; CHECK-NEXT: ))
  (global $three2 (ref $three) (struct.new_desc $three
    (struct.new $three.desc)
  ))

  ;; CHECK:      (global $three3 (ref $three) (struct.new_default_desc $three
  ;; CHECK-NEXT:  (struct.new_default $three.desc)
  ;; CHECK-NEXT: ))
  (global $three3 (ref $three) (struct.new_desc $three
    (struct.new $three.desc)
  ))

  ;; CHECK:      (func $family (type $10) (param $super (ref $super)) (param $A (ref $A)) (param $B (ref $B))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (select (result (ref $super.desc))
  ;; CHECK-NEXT:    (global.get $A.unnested.desc)
  ;; CHECK-NEXT:    (global.get $B.unnested.desc)
  ;; CHECK-NEXT:    (ref.eq
  ;; CHECK-NEXT:     (ref.as_non_null
  ;; CHECK-NEXT:      (local.get $super)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (global.get $A)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.get_desc $A
  ;; CHECK-NEXT:    (block (result (ref $A))
  ;; CHECK-NEXT:     (drop
  ;; CHECK-NEXT:      (ref.as_non_null
  ;; CHECK-NEXT:       (local.get $A)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (global.get $A)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.get_desc $B
  ;; CHECK-NEXT:    (block (result (ref $B))
  ;; CHECK-NEXT:     (drop
  ;; CHECK-NEXT:      (ref.as_non_null
  ;; CHECK-NEXT:       (local.get $B)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (global.get $B)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $family (param $super (ref $super)) (param $A (ref $A)) (param $B (ref $B))
    ;; We can optimize the super with a select, as the value must be from one of
    ;; $A and $B.
    (drop
      (ref.get_desc $super
        (local.get $super)
      )
    )
    ;; We can optimize the refs of the siblings.
    (drop
      (ref.get_desc $A
        (local.get $A)
      )
    )
    (drop
      (ref.get_desc $B
        (local.get $B)
      )
    )
  )

  ;; CHECK:      (func $others (type $11) (param $two (ref $two)) (param $three (ref $three))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (select (result (ref (exact $two.desc)))
  ;; CHECK-NEXT:    (global.get $two.unnested.desc)
  ;; CHECK-NEXT:    (global.get $two2.unnested.desc)
  ;; CHECK-NEXT:    (ref.eq
  ;; CHECK-NEXT:     (ref.as_non_null
  ;; CHECK-NEXT:      (local.get $two)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (global.get $two)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.get_desc $three
  ;; CHECK-NEXT:    (local.get $three)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $others (param $two (ref $two)) (param $three (ref $three))
    ;; We optimize $two, which has two values.
    (drop
      (ref.get_desc $two
        (local.get $two)
      )
    )
    ;; $three has three, which we do not optimize (it would take multiple
    ;; comparisons).
    (drop
      (ref.get_desc $three
        (local.get $three)
      )
    )
  )
)

(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $super (sub (descriptor $super.desc) (struct)))
    (type $super (sub (descriptor $super.desc) (struct)))
    ;; CHECK:       (type $super.desc (sub (describes $super) (struct)))
    (type $super.desc (sub (describes $super) (struct)))
    ;; CHECK:       (type $sub (sub $super (descriptor $sub.desc) (struct)))
    (type $sub (sub $super (descriptor $sub.desc) (struct)))
    ;; CHECK:       (type $sub.desc (sub $super.desc (describes $sub) (struct)))
    (type $sub.desc (sub $super.desc (describes $sub) (struct)))

    ;; CHECK:       (type $super2 (sub (descriptor $super2.desc) (struct)))
    (type $super2 (sub (descriptor $super2.desc) (struct)))
    ;; CHECK:       (type $super2.desc (sub (describes $super2) (struct)))
    (type $super2.desc (sub (describes $super2) (struct)))
    ;; CHECK:       (type $sub2 (sub $super2 (descriptor $sub2.desc) (struct)))
    (type $sub2 (sub $super2 (descriptor $sub2.desc) (struct)))
    ;; CHECK:       (type $sub2.desc (sub $super2.desc (describes $sub2) (struct)))
    (type $sub2.desc (sub $super2.desc (describes $sub2) (struct)))

    ;; CHECK:       (type $other (sub (descriptor $other.desc) (struct)))
    (type $other (sub (descriptor $other.desc) (struct)))
    ;; CHECK:       (type $other.desc (sub (describes $other) (struct)))
    (type $other.desc (sub (describes $other) (struct)))
  )

  ;; CHECK:      (type $10 (func (param (ref $super)) (result (ref $super.desc))))

  ;; CHECK:      (type $11 (func (param (ref $super2)) (result (ref $super2.desc))))

  ;; CHECK:      (type $12 (func (param (ref $sub)) (result (ref $sub.desc))))

  ;; CHECK:      (type $13 (func (param (ref (exact $super))) (result (ref (exact $super.desc)))))

  ;; CHECK:      (type $14 (func (param (ref $other)) (result (ref $other.desc))))

  ;; CHECK:      (global $g (ref $super) (struct.new_default_desc $sub
  ;; CHECK-NEXT:  (struct.new_default $sub.desc)
  ;; CHECK-NEXT: ))
  (global $g (ref $super) (struct.new_desc $sub (struct.new $sub.desc)))
  ;; CHECK:      (global $g-sub (ref (exact $sub2)) (struct.new_default_desc $sub2
  ;; CHECK-NEXT:  (struct.new_default $sub2.desc)
  ;; CHECK-NEXT: ))
  (global $g-sub (ref (exact $sub2)) (struct.new_desc $sub2 (struct.new $sub2.desc)))
  ;; CHECK:      (global $g-structref structref (struct.new_default_desc $other
  ;; CHECK-NEXT:  (struct.new_default $other.desc)
  ;; CHECK-NEXT: ))
  (global $g-structref structref (struct.new_desc $other (struct.new $other.desc)))

  ;; CHECK:      (func $super-op (type $10) (param $x (ref $super)) (result (ref $super.desc))
  ;; CHECK-NEXT:  (ref.get_desc $super
  ;; CHECK-NEXT:   (block (result (ref $super))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.as_non_null
  ;; CHECK-NEXT:      (local.get $x)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (global.get $g)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $super-op (param $x (ref $super)) (result (ref $super.desc))
    ;; The global has type (ref $super), which already produces (ref $super.desc),
    ;; so no cast is needed.
    (ref.get_desc $super
      (local.get $x)
    )
  )

  ;; CHECK:      (func $refine-op (type $11) (param $x (ref $super2)) (result (ref $super2.desc))
  ;; CHECK-NEXT:  (block $b (result (ref (exact $sub2.desc)))
  ;; CHECK-NEXT:   (ref.get_desc $sub2
  ;; CHECK-NEXT:    (block (result (ref (exact $sub2)))
  ;; CHECK-NEXT:     (drop
  ;; CHECK-NEXT:      (ref.as_non_null
  ;; CHECK-NEXT:       (local.get $x)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (global.get $g-sub)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $refine-op (param $x (ref $super2)) (result (ref $super2.desc))
    ;; The global has type (ref (exact $sub2)), which produces the more refined
    ;; type (ref (exact $sub2.desc)), so no cast is needed and the enclosing
    ;; block's result type is refined.
    (block $b (result (ref $super2.desc))
      (ref.get_desc $super2
        (local.get $x)
      )
    )
  )

  ;; CHECK:      (func $sub-op (type $12) (param $x (ref $sub)) (result (ref $sub.desc))
  ;; CHECK-NEXT:  (ref.get_desc $sub
  ;; CHECK-NEXT:   (block (result (ref $sub))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.as_non_null
  ;; CHECK-NEXT:      (local.get $x)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.cast (ref $sub)
  ;; CHECK-NEXT:     (global.get $g)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $sub-op (param $x (ref $sub)) (result (ref $sub.desc))
    ;; Reading the descriptor from (ref $super) would produce the less refined
    ;; type (ref $super.desc), so we must cast the global.get to (ref $sub).
    (ref.get_desc $sub
      (local.get $x)
    )
  )

  ;; CHECK:      (func $exact-op (type $13) (param $x (ref (exact $super))) (result (ref (exact $super.desc)))
  ;; CHECK-NEXT:  (ref.get_desc $super
  ;; CHECK-NEXT:   (block (result (ref (exact $super)))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.as_non_null
  ;; CHECK-NEXT:      (local.get $x)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.cast (ref (exact $super))
  ;; CHECK-NEXT:     (global.get $g)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $exact-op (param $x (ref (exact $super))) (result (ref (exact $super.desc)))
    ;; Reading the descriptor from inexact (ref $super) would produce inexact
    ;; (ref $super.desc), so we must cast the global.get to (ref (exact $super)).
    (ref.get_desc $super
      (local.get $x)
    )
  )

  ;; CHECK:      (func $non-struct-global (type $14) (param $x (ref $other)) (result (ref $other.desc))
  ;; CHECK-NEXT:  (ref.get_desc $other
  ;; CHECK-NEXT:   (block (result (ref $other))
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (ref.as_non_null
  ;; CHECK-NEXT:      (local.get $x)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (ref.cast (ref $other)
  ;; CHECK-NEXT:     (global.get $g-structref)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $non-struct-global (param $x (ref $other)) (result (ref $other.desc))
    ;; The global's declared type (structref) does not have a descriptor, so we
    ;; must cast the global.get to (ref $other).
    (ref.get_desc $other
      (local.get $x)
    )
  )
)

