(module
  ;; CHECK:      (type $s (struct))
  (type $s (struct))
  ;; CHECK:      (func $test (type $0)
  ;; CHECK-NEXT:  (local $0 (ref $s))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (local.set $0
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $test
    (drop
      (tuple.extract 2 1
        (block (result i32 (ref $s))
          (unreachable)
        )
      )
    )
  )
)

(module
  (type $s (struct))
  ;; CHECK:      (func $test (type $0) (result anyref)
  ;; CHECK-NEXT:  (block $b (result anyref)
  ;; CHECK-NEXT:   (block ;; (replaces unreachable RefCast we can't emit)
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (br_if $b
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:      (i32.const 0)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $test (result anyref)
    (block $b (result anyref)
      (br_if $b
        (block (result (ref $s))
          (unreachable)
        )
        (i32.const 0)
      )
    )
  )
)

(module
  ;; CHECK:      (type $s (struct))
  (type $s (struct))
  ;; CHECK:      (func $test (type $0) (result i32 anyref)
  ;; CHECK-NEXT:  (local $0 i32)
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (local $2 (ref $s))
  ;; CHECK-NEXT:  (local $scratch (tuple i32 (ref $s)))
  ;; CHECK-NEXT:  (local $scratch_4 i32)
  ;; CHECK-NEXT:  (block $b (type $0) (result i32 anyref)
  ;; CHECK-NEXT:   (local.set $1
  ;; CHECK-NEXT:    (local.set $2
  ;; CHECK-NEXT:     (block
  ;; CHECK-NEXT:      (unreachable)
  ;; CHECK-NEXT:      (local.set $0
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (block (result i32)
  ;; CHECK-NEXT:     (local.set $scratch_4
  ;; CHECK-NEXT:      (tuple.extract 2 0
  ;; CHECK-NEXT:       (local.tee $scratch
  ;; CHECK-NEXT:        (br_if $b
  ;; CHECK-NEXT:         (tuple.make 2
  ;; CHECK-NEXT:          (local.get $1)
  ;; CHECK-NEXT:          (local.get $2)
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:         (local.get $0)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (drop
  ;; CHECK-NEXT:      (tuple.extract 2 1
  ;; CHECK-NEXT:       (local.get $scratch)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (local.get $scratch_4)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (tuple.make 2
  ;; CHECK-NEXT:    (local.get $1)
  ;; CHECK-NEXT:    (local.get $2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $test (result i32 anyref)
    (block $b (result i32 anyref)
      (br_if $b
        (block (result i32 (ref $s))
          (unreachable)
        )
        (i32.const 0)
      )
    )
  )
)
