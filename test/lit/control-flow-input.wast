  ;; CHECK-NEXT:    (pop i32)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $try-catch (result i32)
    i32.const 0
    try (param i32) (result i32)
    catch $e
    end
  )

  ;; CHECK:      (func $try-catch-all (type $1) (result i32)
  ;; CHECK-NEXT:  (local $scratch i32)
