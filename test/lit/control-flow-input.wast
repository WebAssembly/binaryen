;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; Check that control flow input is correctly parsed using scratch locals. The
;; binary input file is generated from this file using WABT's wat2wasm
;; --enable-all --debug-names and should be regenerated when new tests are added
;; here.

;; RUN: wasm-opt -all %s -S -o - | filecheck %s
;; RUN: wasm-opt -all %s.wasm -S -o - | filecheck %s

(module
  ;; CHECK:      (type $0 (func (result i32 i64)))

  ;; CHECK:      (type $1 (func (result i32)))

  ;; CHECK:      (type $2 (func))

  ;; CHECK:      (type $id (func (param i32) (result i32)))
  (type $id (func (param i32) (result i32)))

  ;; CHECK:      (type $4 (func (param i32)))

  ;; CHECK:      (type $5 (func (param i64) (result i32 i64)))

  ;; CHECK:      (type $6 (func (result funcref)))

  ;; CHECK:      (type $7 (func (result i64)))

  ;; CHECK:      (type $8 (func (result f32)))

  ;; CHECK:      (tag $e (type $4) (param i32))
  (tag $e (param i32))

  ;; CHECK:      (func $block (type $1) (result i32)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (result i32)
  ;; CHECK-NEXT:   (local.get $scratch)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block (result i32)
    i32.const 0
    block (param i32) (result i32)
    end
  )

  ;; CHECK:      (func $block-multivalue (type $0) (result i32 i64)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local $scratch_1 i64)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $scratch_1
  ;; CHECK-NEXT:   (i64.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (type $0) (result i32 i64)
  ;; CHECK-NEXT:   (tuple.make 2
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:    (local.get $scratch_1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-multivalue (result i32 i64)
    i32.const 0
    i64.const 1
    block (param i32 i64) (result i32 i64)
    end
  )

  ;; CHECK:      (func $block-multivalue-tuple-input (type $0) (result i32 i64)
  ;; CHECK-NEXT:  (local $scratch (tuple i32 i64))
  ;; CHECK-NEXT:  (local $scratch_1 i32)
  ;; CHECK-NEXT:  (local $scratch_2 i64)
  ;; CHECK-NEXT:  (local.set $scratch_1
  ;; CHECK-NEXT:   (tuple.extract 2 0
  ;; CHECK-NEXT:    (local.tee $scratch
  ;; CHECK-NEXT:     (block (type $0) (result i32 i64)
  ;; CHECK-NEXT:      (tuple.make 2
  ;; CHECK-NEXT:       (i32.const 0)
  ;; CHECK-NEXT:       (i64.const 1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $scratch_2
  ;; CHECK-NEXT:   (tuple.extract 2 1
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (type $0) (result i32 i64)
  ;; CHECK-NEXT:   (tuple.make 2
  ;; CHECK-NEXT:    (local.get $scratch_1)
  ;; CHECK-NEXT:    (local.get $scratch_2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-multivalue-tuple-input (result i32 i64)
    block (result i32 i64)
      i32.const 0
      i64.const 1
    end
    block (param i32 i64) (result i32 i64)
    end
  )

  ;; CHECK:      (func $block-multivalue-nop-input (type $0) (result i32 i64)
  ;; CHECK-NEXT:  (local $scratch i64)
  ;; CHECK-NEXT:  (local $scratch_1 i32)
  ;; CHECK-NEXT:  (local $scratch_2 i64)
  ;; CHECK-NEXT:  (local.set $scratch_1
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $scratch_2
  ;; CHECK-NEXT:   (block (result i64)
  ;; CHECK-NEXT:    (nop)
  ;; CHECK-NEXT:    (local.set $scratch
  ;; CHECK-NEXT:     (i64.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (nop)
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (type $0) (result i32 i64)
  ;; CHECK-NEXT:   (tuple.make 2
  ;; CHECK-NEXT:    (local.get $scratch_1)
  ;; CHECK-NEXT:    (local.get $scratch_2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-multivalue-nop-input (result i32 i64)
    i32.const 0
    nop
    i64.const 1
    nop
    block (param i32 i64) (result i32 i64)
    end
  )

  ;; CHECK:      (func $block-multivalue-unreachable-input (type $0) (result i32 i64)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local $scratch_1 i64)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (f32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $scratch_1
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (type $0) (result i32 i64)
  ;; CHECK-NEXT:   (tuple.make 2
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:    (local.get $scratch_1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-multivalue-unreachable-input (result i32 i64)
    f32.const 0
    unreachable
    block (param i32 i64) (result i32 i64)
    end
  )

  ;; CHECK:      (func $block-drop (type $2)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-drop
    i32.const 0
    block (param i32)
      drop
    end
  )

  ;; CHECK:      (func $block-multivalue-drop (type $2)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local $scratch_1 i64)
  ;; CHECK-NEXT:  (local $scratch_2 i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $scratch_1
  ;; CHECK-NEXT:   (i64.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (block (result i32)
  ;; CHECK-NEXT:     (local.set $scratch_2
  ;; CHECK-NEXT:      (local.get $scratch)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (drop
  ;; CHECK-NEXT:      (local.get $scratch_1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (local.get $scratch_2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-multivalue-drop
    i32.const 0
    i64.const 1
    block (param i32 i64)
      drop
      drop
    end
  )

  ;; CHECK:      (func $block-passthrough-nop (type $1) (result i32)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local $scratch_1 i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (result i32)
  ;; CHECK-NEXT:   (local.set $scratch_1
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (nop)
  ;; CHECK-NEXT:   (local.get $scratch_1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-passthrough-nop (result i32)
    i32.const 0
    block (param i32) (result i32)
      nop
    end
  )

  ;; CHECK:      (func $block-passthrough-type (type $1) (result i32)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (result i32)
  ;; CHECK-NEXT:   (local.get $scratch)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-passthrough-type (result i32)
    i32.const 0
    block (type $id)
    end
  )

  ;; CHECK:      (func $block-tunnel (type $1) (result i32)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (result i32)
  ;; CHECK-NEXT:   (block (result i32)
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-tunnel (result i32)
    ;; A parameter tunneled through nested blocks should reuse a single scratch
    ;; local.
    i32.const 0
    block (param i32) (result i32)
      block (param i32) (result i32)
      end
    end
  )

  ;; CHECK:      (func $block-tunnel-multivalue (type $0) (result i32 i64)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local $scratch_1 i64)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $scratch_1
  ;; CHECK-NEXT:   (i64.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (type $0) (result i32 i64)
  ;; CHECK-NEXT:   (block (type $0) (result i32 i64)
  ;; CHECK-NEXT:    (tuple.make 2
  ;; CHECK-NEXT:     (local.get $scratch)
  ;; CHECK-NEXT:     (local.get $scratch_1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-tunnel-multivalue (result i32 i64)
    ;; Multiple parameters tunneled through nested blocks should reuse the same
    ;; scratch locals.
    i32.const 0
    i64.const 1
    block (param i32 i64) (result i32 i64)
      block (param i32 i64) (result i32 i64)
      end
    end
  )

  ;; CHECK:      (func $block-tunnel-suffix (type $0) (result i32 i64)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local $scratch_1 i64)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $scratch_1
  ;; CHECK-NEXT:   (i64.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (type $0) (result i32 i64)
  ;; CHECK-NEXT:   (tuple.make 2
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:    (block (result i64)
  ;; CHECK-NEXT:     (local.get $scratch_1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-tunnel-suffix (result i32 i64)
    ;; An inner block that only consumes a suffix of the enclosing block's
    ;; parameters should still reuse the corresponding scratch local.
    i32.const 0
    i64.const 1
    block (param i32 i64) (result i32 i64)
      block (param i64) (result i64)
      end
    end
  )

  ;; CHECK:      (func $block-tunnel-partial (type $5) (param $x i64) (result i32 i64)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local $scratch_2 i64)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (type $0) (result i32 i64)
  ;; CHECK-NEXT:   (local.set $scratch_2
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (block (type $0) (result i32 i64)
  ;; CHECK-NEXT:    (tuple.make 2
  ;; CHECK-NEXT:     (local.get $scratch)
  ;; CHECK-NEXT:     (local.get $scratch_2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-tunnel-partial (param $x i64) (result i32 i64)
    ;; A parameter tunneled alongside a newly pushed parameter should still
    ;; reuse the enclosing block's scratch local.
    i32.const 0
    block (param i32) (result i32 i64)
      local.get $x
      block (param i32 i64) (result i32 i64)
      end
    end
  )

  ;; CHECK:      (func $block-tunnel-other-local (type $id) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local $scratch_2 i32)
  ;; CHECK-NEXT:  (local $scratch_3 i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $scratch_2
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (result i32)
  ;; CHECK-NEXT:   (drop
  ;; CHECK-NEXT:    (i32.add
  ;; CHECK-NEXT:     (local.get $scratch)
  ;; CHECK-NEXT:     (local.get $scratch_2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.set $scratch_3
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (block (result i32)
  ;; CHECK-NEXT:    (local.get $scratch_3)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-tunnel-other-local (param $x i32) (result i32)
    ;; A local.get of a different local at a stack position corresponding to an
    ;; enclosing block's input should not be mistaken for that input's scratch
    ;; local.
    i32.const 0
    i32.const 1
    block (param i32 i32) (result i32)
      i32.add
      drop
      local.get $x
      block (param i32) (result i32)
        ;; $x should not be treated like a scratch input local here.
      end
    end
  )

  ;; CHECK:      (func $block-tunnel-subtype (type $6) (result funcref)
  ;; CHECK-NEXT:  (local $scratch (ref null $id))
  ;; CHECK-NEXT:  (local $scratch_1 funcref)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (ref.null nofunc)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (result funcref)
  ;; CHECK-NEXT:   (local.set $scratch_1
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (block (result funcref)
  ;; CHECK-NEXT:    (local.get $scratch_1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-tunnel-subtype (result funcref)
    ;; A parameter whose type is widened in a nested block cannot reuse the
    ;; narrower scratch local because keeping the narrower type on the stack
    ;; would allow us to parse invalid WAT that requires the narrower type.
    ref.null $id
    block (param (ref null $id)) (result funcref)
      block (param funcref) (result funcref)
      end
    end
  )

  ;; CHECK:      (func $loop (type $1) (result i32)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (loop (result i32)
  ;; CHECK-NEXT:   (local.get $scratch)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $loop (result i32)
    i32.const 0
    loop (param i32) (result i32)
    end
  )

  ;; CHECK:      (func $loop-branch (type $2)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (loop $label0
  ;; CHECK-NEXT:   (block $label1
  ;; CHECK-NEXT:    (local.set $scratch
  ;; CHECK-NEXT:     (block $label (result i32)
  ;; CHECK-NEXT:      (br $label
  ;; CHECK-NEXT:       (local.get $scratch)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (br $label1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (br $label0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $loop-branch
    i32.const 0
    loop (param i32)
      br 0
    end
  )

  ;; CHECK:      (func $loop-branch-cond (type $1) (result i32)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (loop $label0 (result i32)
  ;; CHECK-NEXT:   (block $label1 (result i32)
  ;; CHECK-NEXT:    (local.set $scratch
  ;; CHECK-NEXT:     (block $label (result i32)
  ;; CHECK-NEXT:      (br $label1
  ;; CHECK-NEXT:       (br_if $label
  ;; CHECK-NEXT:        (local.get $scratch)
  ;; CHECK-NEXT:        (i32.const 1)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (br $label0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $loop-branch-cond (result i32)
    i32.const 0
    loop (param i32) (result i32)
      i32.const 1
      br_if 0
    end
  )

  ;; CHECK:      (func $loop-branch-cond-drop (type $2)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (loop $label0
  ;; CHECK-NEXT:   (block $label1
  ;; CHECK-NEXT:    (local.set $scratch
  ;; CHECK-NEXT:     (block $label (result i32)
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (br_if $label
  ;; CHECK-NEXT:        (local.get $scratch)
  ;; CHECK-NEXT:        (i32.const 1)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (br $label1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (br $label0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $loop-branch-cond-drop
    i32.const 0
    loop (param i32)
      i32.const 1
      br_if 0
      drop
    end
  )

  ;; CHECK:      (func $loop-branch-cond-new-val (type $7) (result i64)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (loop $label0 (result i64)
  ;; CHECK-NEXT:   (block $label1 (result i64)
  ;; CHECK-NEXT:    (local.set $scratch
  ;; CHECK-NEXT:     (block $label (result i32)
  ;; CHECK-NEXT:      (br $label1
  ;; CHECK-NEXT:       (block (result i64)
  ;; CHECK-NEXT:        (drop
  ;; CHECK-NEXT:         (br_if $label
  ;; CHECK-NEXT:          (local.get $scratch)
  ;; CHECK-NEXT:          (i32.const 1)
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:        (i64.const 2)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (br $label0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $loop-branch-cond-new-val (result i64)
    i32.const 0
    loop (param i32) (result i64)
      i32.const 1
      br_if 0
      drop
      i64.const 2
    end
  )

  ;; CHECK:      (func $nested-loops-multivalue (type $0) (result i32 i64)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local $scratch_1 i64)
  ;; CHECK-NEXT:  (local $scratch_2 (tuple i32 i64))
  ;; CHECK-NEXT:  (local $scratch_3 (tuple i32 i64))
  ;; CHECK-NEXT:  (block $label2 (type $0) (result i32 i64)
  ;; CHECK-NEXT:   (local.set $scratch
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.set $scratch_1
  ;; CHECK-NEXT:    (i64.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (loop $label10
  ;; CHECK-NEXT:    (block $label11
  ;; CHECK-NEXT:     (local.set $scratch_3
  ;; CHECK-NEXT:      (block $label1 (type $0) (result i32 i64)
  ;; CHECK-NEXT:       (loop $label0
  ;; CHECK-NEXT:        (block $label3
  ;; CHECK-NEXT:         (local.set $scratch_2
  ;; CHECK-NEXT:          (block $label (type $0) (result i32 i64)
  ;; CHECK-NEXT:           (br_table $label $label1 $label2
  ;; CHECK-NEXT:            (tuple.make 2
  ;; CHECK-NEXT:             (local.get $scratch)
  ;; CHECK-NEXT:             (local.get $scratch_1)
  ;; CHECK-NEXT:            )
  ;; CHECK-NEXT:            (i32.const 2)
  ;; CHECK-NEXT:           )
  ;; CHECK-NEXT:           (br $label3)
  ;; CHECK-NEXT:          )
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:         (local.set $scratch
  ;; CHECK-NEXT:          (tuple.extract 2 0
  ;; CHECK-NEXT:           (local.get $scratch_2)
  ;; CHECK-NEXT:          )
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:         (local.set $scratch_1
  ;; CHECK-NEXT:          (tuple.extract 2 1
  ;; CHECK-NEXT:           (local.get $scratch_2)
  ;; CHECK-NEXT:          )
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:         (br $label0)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (br $label11)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (local.set $scratch
  ;; CHECK-NEXT:      (tuple.extract 2 0
  ;; CHECK-NEXT:       (local.get $scratch_3)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (local.set $scratch_1
  ;; CHECK-NEXT:      (tuple.extract 2 1
  ;; CHECK-NEXT:       (local.get $scratch_3)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (br $label10)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $nested-loops-multivalue (result i32 i64)
    i32.const 0
    i64.const 1
    loop (param i32 i64)
      loop (param i32 i64)
        i32.const 2
        br_table 0 1 2
      end
    end
    unreachable
  )

  ;; CHECK:      (func $block-loop-tunnel (type $1) (result i32)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (result i32)
  ;; CHECK-NEXT:   (loop $label0 (result i32)
  ;; CHECK-NEXT:    (block $label1 (result i32)
  ;; CHECK-NEXT:     (local.set $scratch
  ;; CHECK-NEXT:      (block $label (result i32)
  ;; CHECK-NEXT:       (br $label1
  ;; CHECK-NEXT:        (br_if $label
  ;; CHECK-NEXT:         (local.get $scratch)
  ;; CHECK-NEXT:         (i32.const 1)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (br $label0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $block-loop-tunnel (result i32)
    ;; A parameter tunneled from a block into a loop should reuse the same
    ;; scratch local.
    i32.const 0
    block (param i32) (result i32)
      loop (param i32) (result i32)
        i32.const 1
        br_if 0
      end
    end
  )

  ;; CHECK:      (func $if (type $1) (result i32)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if (result i32)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $if (result i32)
    i32.const 0
    i32.const 1
    if (param i32) (result i32)
    end
  )

  ;; CHECK:      (func $if-new-val (type $1) (result i32)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if (result i32)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (local.get $scratch)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $if-new-val (result i32)
    i32.const 0
    i32.const 1
    if (param i32) (result i32)
      drop
      i32.const 2
    end
  )

  ;; CHECK:      (func $if-multivalue (type $0) (result i32 i64)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local $scratch_1 i64)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $scratch_1
  ;; CHECK-NEXT:   (i64.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if (type $0) (result i32 i64)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (tuple.make 2
  ;; CHECK-NEXT:     (local.get $scratch)
  ;; CHECK-NEXT:     (local.get $scratch_1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (tuple.make 2
  ;; CHECK-NEXT:     (local.get $scratch)
  ;; CHECK-NEXT:     (local.get $scratch_1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $if-multivalue (result i32 i64)
    i32.const 0
    i64.const 1
    i32.const 2
    if (param i32 i64) (result i32 i64)
    end
  )

  ;; CHECK:      (func $if-else (type $1) (result i32)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if (result i32)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $if-else (result i32)
    i32.const 0
    i32.const 1
    if (param i32) (result i32)
    else
    end
  )

  ;; CHECK:      (func $if-else-drop (type $2)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (local.get $scratch)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (local.get $scratch)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $if-else-drop
    i32.const 0
    i32.const 1
    if (param i32)
      drop
    else
      drop
    end
  )

  ;; CHECK:      (func $if-else-multivalue (type $8) (result f32)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local $scratch_1 i64)
  ;; CHECK-NEXT:  (local $scratch_2 i32)
  ;; CHECK-NEXT:  (local $scratch_3 i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $scratch_1
  ;; CHECK-NEXT:   (i64.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if (result f32)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result i32)
  ;; CHECK-NEXT:      (local.set $scratch_2
  ;; CHECK-NEXT:       (local.get $scratch)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (local.get $scratch_1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.get $scratch_2)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (f32.const 3)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (block (result i32)
  ;; CHECK-NEXT:      (local.set $scratch_3
  ;; CHECK-NEXT:       (local.get $scratch)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (drop
  ;; CHECK-NEXT:       (local.get $scratch_1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.get $scratch_3)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (f32.const 4)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $if-else-multivalue (result f32)
    i32.const 0
    i64.const 1
    i32.const 2
    if (param i32 i64) (result f32)
      drop
      drop
      f32.const 3
    else
      drop
      drop
      f32.const 4
    end
  )

  ;; CHECK:      (func $if-tunnel (type $1) (result i32)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if (result i32)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (if (result i32)
  ;; CHECK-NEXT:     (i32.const 2)
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (local.get $scratch)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (else
  ;; CHECK-NEXT:      (local.get $scratch)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (local.get $scratch)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $if-tunnel (result i32)
    ;; A parameter tunneled through nested ifs and blocks should reuse the same
    ;; scratch local in both arms.
    i32.const 0
    i32.const 1
    if (param i32) (result i32)
      i32.const 2
      if (param i32) (result i32)
      end
    else
      block (param i32) (result i32)
      end
    end
  )

  ;; CHECK:      (func $if-tunnel-nop (type $1) (result i32)
  ;; CHECK-NEXT:  (local $scratch i32)
  ;; CHECK-NEXT:  (local $scratch_1 i32)
  ;; CHECK-NEXT:  (local $scratch_2 i32)
  ;; CHECK-NEXT:  (local.set $scratch
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block (result i32)
  ;; CHECK-NEXT:   (local.set $scratch_2
  ;; CHECK-NEXT:    (block (result i32)
  ;; CHECK-NEXT:     (local.set $scratch_1
  ;; CHECK-NEXT:      (local.get $scratch)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (nop)
  ;; CHECK-NEXT:     (local.get $scratch_1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (if (result i32)
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (local.get $scratch_2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (else
  ;; CHECK-NEXT:     (local.get $scratch_2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $if-tunnel-nop (result i32)
    ;; A none-typed instruction before an if wraps the outer input in a block
    ;; when popping the if input, requiring a new scratch local for the if.
    i32.const 0
    block (param i32) (result i32)
      nop
      i32.const 1
      if (param i32) (result i32)
      end
    end
  )

  ;; CHECK:      (func $try (type $1) (result i32)
